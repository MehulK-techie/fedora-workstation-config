<?xml version="1.0" encoding="utf-8"?>
<!-- MK Notes for Android: the phone app (assets/notes-web) in a WebView, so it
     works offline and opens like any app. Built by scripts/build-apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.mehulk.mknotes"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <!-- Only to reach MK Notes on your laptop over Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="MK Notes"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing: the laptop's "Android app" QR code is an mknotes:// link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mknotes" />
            </intent-filter>
        </activity>
    </application>
</manifest>
