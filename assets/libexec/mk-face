#!/usr/bin/python3 -I
"""mk-face: is the person at the camera this user? MK Workstation's own face
check (Howdy's replacement: Howdy and dlib don't build on Fedora 45). OpenCV
only (python3-opencv): YuNet finds the face, SFace turns it into 128 numbers,
and those are compared with the ones saved when you enrolled.

Root only (installed to /usr/local/libexec by scripts/setup-face-auth.sh):
  mk-face enroll USER        look at the camera ~6 s: saves /var/lib/mk-face/USER.npy
  mk-face verify USER [S]    exit 0 when USER's face is seen within S seconds (default 4)
  mk-face forget USER        delete USER's face
  mk-face status USER        enrolled or not
  mk-face --pam              for pam_exec: PAM_USER's face, 3.5 s, silent; exit 0 = match
  mk-face serve              the warm engine (mk-face.socket starts it; see below)

A match: three looks in a row over the threshold, spread over at least 450 ms, each of them
well lit and sharp, and not a frozen picture (a feed whose frames are identical). One lucky
frame, a dim shadow or a blur never opens anything. If no face shows at all in the first
1.2 s the check ends there, so the password prompt isn't kept waiting.

Fast: loading OpenCV and the models takes ~0.7 s each time. `mk-face serve` keeps them loaded
for 2 minutes after the last use (systemd starts it on /run/mk-face.sock, on demand; it exits
when idle, so it costs nothing in between). The lock screen warms it as the screen locks;
--pam uses it when it's there and does the work itself when it isn't. Only root may ask it to
verify (the socket checks who's calling); anyone may ask it to warm up, which opens nothing.

Limits, plainly: an ordinary webcam has no depth or infrared, so a good photo held steady in
good light, or a video of you, can still pass: the checks above stop the easy cases, not a
determined one. Face is a convenience, never the only way in: the password always works, and the PAM line is "sufficient".
--pam refuses unless the user's session is the one at the computer (seat0,
local), so nobody signed in remotely can use the camera to get in.
"""
import os
import pwd
import subprocess
import sys
import time

MODELS = "/usr/local/share/mk-face"
DETECTOR = os.path.join(MODELS, "face_detection_yunet_2023mar.onnx")
RECOGNIZER = os.path.join(MODELS, "face_recognition_sface_2021dec.onnx")
DATA = "/var/lib/mk-face"
CONF = "/etc/mk-face.conf"          # DEVICE=/dev/video0, THRESHOLD=0.45, SHARPNESS=30 (optional)
THRESHOLD = 0.45                    # SFace cosine similarity; OpenCV suggests 0.363, this is stricter
SAMPLES = 12
SOCKET = "/run/mk-face.sock"
IDLE_EXIT = 120.0                   # the warm engine leaves this long after its last use (s)
NEED_FRAMES = 3                     # looks in a row over the threshold...
NEED_SPAN = 0.45                    # ...spread over at least this long (s)
NO_FACE_GIVE_UP = 1.2               # nobody at the camera: straight on to the password (s)
BRIGHT_MIN, BRIGHT_MAX = 45.0, 215.0  # the face's mean brightness (0-255): not a shadow, not blown out
CONTRAST_MIN = 18.0                 # its standard deviation: not a flat grey patch
SHARP_MIN = 30.0                    # variance of the Laplacian on the 112 px aligned face: not a blur


def conf():
    out = {}
    try:
        with open(CONF) as f:
            for line in f:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.split("=", 1)
                    out[k.strip().upper()] = v.strip()
    except OSError:
        pass
    return out


def models():
    import cv2
    det = cv2.FaceDetectorYN.create(DETECTOR, "", (320, 240), 0.9, 0.3, 5000)
    rec = cv2.FaceRecognizerSF.create(RECOGNIZER, "")
    return det, rec


def camera():
    import cv2
    dev = conf().get("DEVICE", "/dev/video0")
    cap = cv2.VideoCapture(dev, cv2.CAP_V4L2)
    if not cap.isOpened():
        return None
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    return cap


def largest_face(det, frame):
    h, w = frame.shape[:2]
    det.setInputSize((w, h))
    _ok, found = det.detect(frame)
    if found is None or len(found) == 0:
        return None
    return max(found, key=lambda f: f[2] * f[3])


def feature(rec, frame, face):
    return rec.feature(rec.alignCrop(frame, face))


def model_path(user):
    return os.path.join(DATA, f"{user}.npy")


def enroll(user, seconds=8.0):
    import numpy as np
    det, rec = models()
    cap = camera()
    if cap is None:
        print("No camera found (set DEVICE= in /etc/mk-face.conf).", file=sys.stderr)
        return 3
    feats, end, last = [], time.monotonic() + seconds, 0.0
    print("Look at the camera; turn your head a little now and then...")
    while time.monotonic() < end and len(feats) < SAMPLES:
        ok, frame = cap.read()
        if not ok:
            continue
        face = largest_face(det, frame)
        if face is None or time.monotonic() - last < 0.4:
            continue
        last = time.monotonic()
        feats.append(feature(rec, frame, face)[0])
        print(f"  {len(feats)}/{SAMPLES}")
    cap.release()
    if len(feats) < 5:
        print("Not enough clear looks at a face: more light, face the camera, try again.", file=sys.stderr)
        return 1
    os.makedirs(DATA, mode=0o700, exist_ok=True)
    os.chmod(DATA, 0o700)
    path = model_path(user)
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        np.save(f, np.array(feats, dtype=np.float32))
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    print(f"Saved {len(feats)} looks for {user}.")
    return 0


class Judge:
    """Decides a match from the frames, one at a time (no camera in here, so it can be tested).
    feed(t, score, quality_ok, shape) -> True once NEED_FRAMES good matching looks in a row
    span NEED_SPAN seconds and the feed isn't frozen. SHAPE: the face's five landmarks relative
    to its box (a tuple of floats); a live camera never gives the same ones twice."""

    def __init__(self, threshold):
        self.threshold = threshold
        self.run = []                 # (t, score, shape) of the matching looks in a row
        self.best = -1.0
        self.saw_face = False

    def no_face(self):
        self.run = []

    def feed(self, t, score, quality_ok, shape):
        self.saw_face = True
        self.best = max(self.best, score)
        if not quality_ok:
            return False              # (too dark, too flat or blurred: not counted, not held against you)
        if score < self.threshold:
            self.run = []
            return False
        self.run.append((t, score, shape))
        if len(self.run) < NEED_FRAMES or self.run[-1][0] - self.run[0][0] < NEED_SPAN:
            return False
        # a frozen feed (a still injected as video): every look identical to the last
        frozen = all(a[1] == b[1] and a[2] == b[2] for a, b in zip(self.run, self.run[1:]))
        if frozen:
            self.run = self.run[-1:]
            return False
        return True


def quality(cv2, crop, sharp_min=SHARP_MIN):
    """Is this aligned face (112 x 112) lit and sharp enough to count?"""
    grey = cv2.cvtColor(crop, cv2.COLOR_BGR2GRAY)
    mean, std = cv2.meanStdDev(grey)
    if not BRIGHT_MIN <= float(mean[0][0]) <= BRIGHT_MAX or float(std[0][0]) < CONTRAST_MIN:
        return False
    return float(cv2.Laplacian(grey, cv2.CV_64F).var()) >= sharp_min


def shape_of(face):
    """The five landmarks relative to the face's box, rounded: the same picture gives the same ones."""
    x, y, w, h = (float(v) for v in face[:4])
    w, h = max(w, 1.0), max(h, 1.0)
    return tuple(round((float(face[4 + i]) - (x if i % 2 == 0 else y)) / (w if i % 2 == 0 else h), 4) for i in range(10))


def verify(user, seconds=4.0, quiet=False, engine=None):
    """0: a match (see Judge), 1: no match, 2: not enrolled, 3: no camera. ENGINE: (det, rec) kept
    loaded by the warm service; made here otherwise."""
    import cv2
    import numpy as np
    path = model_path(user)
    if not os.path.exists(path):
        return 2
    known = np.load(path)
    threshold = float(conf().get("THRESHOLD", THRESHOLD))
    sharp_min = float(conf().get("SHARPNESS", SHARP_MIN))     # (a soft webcam: lower it in /etc/mk-face.conf)
    det, rec = engine or models()
    cap = camera()
    if cap is None:
        return 3
    judge = Judge(threshold)
    start = time.monotonic()
    end = start + seconds
    try:
        while time.monotonic() < end:
            ok, frame = cap.read()
            now = time.monotonic()
            if not ok:
                continue
            face = largest_face(det, frame)
            if face is None:
                judge.no_face()
                if not judge.saw_face and now - start > NO_FACE_GIVE_UP:
                    break                       # nobody there: don't keep the password waiting
                continue
            crop = rec.alignCrop(frame, face)
            f = rec.feature(crop)
            score = max(rec.match(f, k.reshape(1, -1), cv2.FaceRecognizerSF_FR_COSINE) for k in known)
            if judge.feed(now, float(score), quality(cv2, crop, sharp_min), shape_of(face)):
                if not quiet:
                    print(f"Match ({score:.2f} >= {threshold}, {NEED_FRAMES} looks over "
                          f"{judge.run[-1][0] - judge.run[0][0]:.2f} s).")
                return 0
    finally:
        cap.release()
    if not quiet:
        print(f"No match (best {judge.best:.2f}, needs {NEED_FRAMES} looks in a row of {threshold} over "
              f"{NEED_SPAN} s, lit and sharp)." if judge.saw_face else "No face seen.")
    return 1


def at_the_seat(user):
    """True when seat0's active session is a local one of USER (who alone can be facing the camera)."""
    def loginctl(*args):
        try:
            return subprocess.run(["loginctl", *args], capture_output=True, text=True, timeout=3).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return ""
    session = loginctl("show-seat", "seat0", "--property=ActiveSession", "--value")
    if not session:
        return False
    props = dict(line.split("=", 1) for line in
                 loginctl("show-session", "--", session, "--property=Name", "--property=Remote").splitlines()
                 if "=" in line)
    return props.get("Name") == user and props.get("Remote") == "no"


def pam():
    user = os.environ.get("PAM_USER", "")
    if os.environ.get("PAM_TYPE") != "auth" or not user or os.environ.get("PAM_RHOST"):
        return 1
    if not os.path.exists(model_path(user)):
        return 1                                # not enrolled: straight on to the password
    service = os.environ.get("PAM_SERVICE", "")
    # the lock screen and login run before / outside the session; anything else (sudo,
    # polkit) only for the person at the computer
    if not service.startswith("gdm") and not at_the_seat(user):
        return 1
    rc = ask_warm(user, 3.5)
    if rc is None:                              # no warm engine: do it here
        rc = verify(user, 3.5, quiet=True)
    return 0 if rc == 0 else 1


# ----- the warm engine
def ask_warm(user, seconds):
    """VERIFY through the warm service: its answer (0-3), or None when it isn't there."""
    import socket
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1.0)
            s.connect(SOCKET)
            s.settimeout(seconds + 4.0)
            s.sendall(f"VERIFY {user} {seconds}\n".encode())
            answer = s.makefile().readline().strip()
        return int(answer) if answer in ("0", "1", "2", "3") else None
    except (OSError, ValueError):
        return None


def serve():
    """systemd hands over the listening socket (fd 3). One request a connection, one at a time:
    WARM (anyone: loads the models, stays IDLE_EXIT s) or VERIFY USER SECONDS (root only, by
    SO_PEERCRED). Leaves when nothing has asked for IDLE_EXIT seconds."""
    import socket
    import struct
    if os.environ.get("LISTEN_FDS") != "1":
        print("mk-face serve is started by mk-face.socket.", file=sys.stderr)
        return 2
    server = socket.socket(fileno=3)
    engine = models()
    while True:
        server.settimeout(IDLE_EXIT)
        try:
            conn, _addr = server.accept()
        except (socket.timeout, TimeoutError):
            return 0                            # idle: gone until the next connection starts it again
        with conn:
            try:
                conn.settimeout(2.0)
                _pid, uid, _gid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                words = conn.makefile().readline().split()
                if words[:1] == ["WARM"]:
                    conn.sendall(b"OK\n")
                elif words[:1] == ["VERIFY"] and len(words) == 3 and uid == 0:
                    pwd.getpwnam(words[1])
                    conn.settimeout(None)
                    rc = verify(words[1], min(10.0, max(0.5, float(words[2]))), quiet=True, engine=engine)
                    conn.sendall(f"{rc}\n".encode())
                else:
                    conn.sendall(b"NO\n")
            except Exception:                   # noqa: BLE001 (one bad request never takes the service down)
                pass


def main(argv):
    if os.geteuid() != 0:
        print("mk-face runs as root (use mk-face-auth).", file=sys.stderr)
        return 1
    if argv[:1] == ["--pam"]:
        try:
            return pam()
        except Exception:                       # never in the way of the password
            return 1
    if argv[:1] == ["serve"]:
        return serve()
    if len(argv) < 2 or argv[0] not in ("enroll", "verify", "forget", "status"):
        print(__doc__.strip())
        return 2
    cmd, user = argv[0], argv[1]
    try:
        pwd.getpwnam(user)
    except KeyError:
        print(f"No user {user}.", file=sys.stderr)
        return 2
    if not all(os.path.exists(p) for p in (DETECTOR, RECOGNIZER)) and cmd in ("enroll", "verify"):
        print("The face models aren't installed: sudo ./scripts/setup-face-auth.sh", file=sys.stderr)
        return 4
    if cmd == "enroll":
        return enroll(user)
    if cmd == "verify":
        rc = verify(user, float(argv[2]) if len(argv) > 2 else 4.0)
        if rc == 2:
            print(f"{user} has no face enrolled (mk-face-auth --enroll).")
        elif rc == 3:
            print("No camera found (set DEVICE= in /etc/mk-face.conf).")
        return rc
    if cmd == "forget":
        try:
            os.remove(model_path(user))
            print(f"Forgot {user}'s face.")
        except FileNotFoundError:
            print(f"{user} had no face enrolled.")
        return 0
    print("enrolled" if os.path.exists(model_path(user)) else "not enrolled")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
