#!/usr/bin/python3
"""mk-face-auth: "is the person at the camera the user who's asking?" for MK's
own apps (MK Notes' lock, the MK unlock dialog). The root half of in-app Face
ID, installed by setup.sh to /usr/local/libexec.

systemd starts one copy per connection on /run/mk-face-auth.sock
(mk-face-auth.socket, Accept=yes). It asks the kernel who connected
(SO_PEERCRED), so an app can only check its own user's face, then runs the
PAM service mk-auth (/etc/pam.d/mk-auth: pam_howdy only) for that user.
The client sends one request line (nothing within a second counts as CHECK):
  CHECK                  is it the user?
  KEY <folder path>      is it the user? then hand over that folder's mk-lock
                         key, from the caller's own root-only store
                         (/var/lib/mk-lock/UID, the one mk-lock-key keeps)
and gets one line back:
  OK                     the face matched (CHECK)
  OK <base64 key>        the face matched; the key (KEY)
  NO <reason>            it didn't, or there was nothing to compare with
  BUSY                   another check is running, or one ran under 3 s ago
A face hands over a folder key only where it already guards sudo
(pam_howdy in /etc/pam.d/sudo): an IR camera, or a regular webcam you
explicitly trusted in register-face.sh. A printed photo can fool a regular
webcam, so otherwise KEY answers NO and the folder takes your password.
Only the user of seat0's active, local session is checked (not a remote or
background session): anyone else gets NO, so another account can't keep the
camera busy for the person at the computer.
No password is ever checked here: a root service trying passwords for any
local caller would be a guessing oracle (and could trip pam_faillock).
"""
import base64
import ctypes
import ctypes.util
import fcntl
import hashlib
import os
import pwd
import re
import signal
import socket
import struct
import subprocess
import sys
import time

SERVICE = "mk-auth"
MODELS = "/etc/howdy/models"
STATE = "/run/mk-face-auth"
KEYS = "/var/lib/mk-lock"
SUDO_PAM = "/etc/pam.d/sudo"
MIN_GAP = 3.0       # seconds between two checks for one user
TIME_LIMIT = 20     # seconds for the whole check

PAM_SUCCESS = 0
PAM_PROMPT_ECHO_OFF, PAM_PROMPT_ECHO_ON, PAM_ERROR_MSG, PAM_TEXT_INFO = 1, 2, 3, 4


class PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]


class PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_void_p), ("resp_retcode", ctypes.c_int)]


CONV_FUNC = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(PamMessage)),
                             ctypes.POINTER(ctypes.POINTER(PamResponse)), ctypes.c_void_p)


class PamConv(ctypes.Structure):
    _fields_ = [("conv", CONV_FUNC), ("appdata_ptr", ctypes.c_void_p)]


def authenticate(user, service=SERVICE, confdir=None):
    """(ok, last message from the PAM modules). CONFDIR is for tests only:
    main() never passes it."""
    libpam = ctypes.CDLL(ctypes.util.find_library("pam"))
    libc = ctypes.CDLL(ctypes.util.find_library("c"))
    libc.calloc.restype = ctypes.c_void_p
    libc.strdup.restype = ctypes.c_void_p
    messages = []

    def conv(n, msgs, resp, _data):
        # Face-only stack: nothing to type. Prompts get an empty answer;
        # info and error texts are kept for the reply.
        replies = libc.calloc(n, ctypes.sizeof(PamResponse))
        if not replies:
            return 5  # PAM_BUF_ERR
        for i in range(n):
            m = msgs[i].contents
            if m.msg_style in (PAM_ERROR_MSG, PAM_TEXT_INFO) and m.msg:
                messages.append(m.msg.decode(errors="replace").strip())
            elif m.msg_style in (PAM_PROMPT_ECHO_OFF, PAM_PROMPT_ECHO_ON):
                ctypes.cast(replies, ctypes.POINTER(PamResponse))[i].resp = libc.strdup(b"")
        resp[0] = ctypes.cast(replies, ctypes.POINTER(PamResponse))
        return PAM_SUCCESS

    callback = CONV_FUNC(conv)
    handle = ctypes.c_void_p()
    pam_conv = PamConv(callback, None)
    if confdir:
        rc = libpam.pam_start_confdir(service.encode(), user.encode(), ctypes.byref(pam_conv),
                                      confdir.encode(), ctypes.byref(handle))
    else:
        rc = libpam.pam_start(service.encode(), user.encode(), ctypes.byref(pam_conv), ctypes.byref(handle))
    if rc != PAM_SUCCESS:
        return False, "PAM couldn't start"
    rc = libpam.pam_authenticate(handle, 0)
    libpam.pam_end(handle, rc)
    return rc == PAM_SUCCESS, (messages[-1] if messages else "")


def peer_uid(conn):
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    _pid, uid, _gid = struct.unpack("3i", creds)
    return uid


def loginctl(*args):
    try:
        return subprocess.run(["loginctl", *args], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def at_the_seat(uid):
    """True when the session in front of the screen (seat0's active session)
    is a local one of UID: the only user who can be facing the camera."""
    session = loginctl("show-seat", "seat0", "--property=ActiveSession", "--value")
    if not session:
        return False
    props = dict(line.split("=", 1) for line in
                 loginctl("show-session", "--", session, "--property=User", "--property=Remote").splitlines()
                 if "=" in line)
    return props.get("User") == str(uid) and props.get("Remote") == "no"


def read_request(conn):
    """("CHECK", None) or ("KEY", path); None for anything else."""
    conn.settimeout(1.0)
    try:
        line = conn.makefile("rb").readline(4200).decode(errors="strict").rstrip("\n")
    except (OSError, UnicodeDecodeError, socket.timeout):
        line = ""
    conn.settimeout(None)
    if line in ("", "CHECK"):
        return "CHECK", None
    if line.startswith("KEY /") and "\0" not in line:
        return "KEY", line[4:]
    return None


def folder_key(uid, path):
    """The key mk-lock-key stored for UID's folder PATH, or None."""
    name = hashlib.sha256(path.encode()).hexdigest() + ".key"
    try:
        with open(os.path.join(KEYS, str(uid), name), "rb") as f:
            return f.read(4096)
    except OSError:
        return None


def face_trusted_for_keys():
    """True when Howdy also guards sudo: the camera was trusted that far."""
    try:
        with open(SUDO_PAM) as f:
            return any(re.match(r"\s*auth\s.*\bpam_howdy\.so\b", line) for line in f)
    except OSError:
        return False


def answer(conn, text):
    try:
        conn.sendall((text + "\n").encode())
    except OSError:
        pass


def main():
    if os.geteuid() != 0:
        print("mk-face-auth runs as root, started by mk-face-auth.socket", file=sys.stderr)
        return 1
    conn = socket.socket(fileno=sys.stdin.fileno())
    signal.alarm(TIME_LIMIT)
    try:
        uid = peer_uid(conn)
        user = pwd.getpwuid(uid).pw_name
    except (OSError, KeyError):
        answer(conn, "NO unknown caller")
        return 0
    request = read_request(conn)
    if request is None:
        answer(conn, "NO bad request")
        return 0
    kind, path = request
    if kind == "KEY" and not face_trusted_for_keys():
        answer(conn, "NO this camera can't open folders (use your password)")
        return 0
    if kind == "KEY" and folder_key(uid, path) is None:
        answer(conn, "NO no key stored for that folder")
        return 0
    # Only the person at the computer (seat0's active, local session) can be in
    # front of the camera; anyone else could only keep it busy for them.
    if not at_the_seat(uid):
        answer(conn, "NO not the active session")
        return 0
    if not os.path.exists(os.path.join(MODELS, f"{user}.dat")):
        answer(conn, "NO no face enrolled (mk face)")
        return 0
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    lock = open(os.path.join(STATE, "lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        answer(conn, "BUSY")
        return 0
    stamp = os.path.join(STATE, user)
    try:
        if time.time() - os.path.getmtime(stamp) < MIN_GAP:
            answer(conn, "BUSY")
            return 0
    except OSError:
        pass
    open(stamp, "w").close()
    ok, message = authenticate(user)
    if not ok:
        answer(conn, f"NO {message or 'not recognized'}")
    elif kind == "KEY":
        key = folder_key(uid, path)
        answer(conn, "OK " + base64.b64encode(key).decode() if key is not None else "NO key gone")
    else:
        answer(conn, "OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
