#!/bin/bash
# mk-face-enroll: add, list or remove Howdy face models for the user who ran
# it, from MK Control Center (no terminal). Runs through pkexec; polkit asks
# for an administrator's password (auth_admin_keep): a face model is a way
# into the account, like a password.
#   pkexec /usr/local/libexec/mk-face-enroll list
#   pkexec /usr/local/libexec/mk-face-enroll add LABEL      (exit 3: LABEL exists)
#   pkexec /usr/local/libexec/mk-face-enroll remove LABEL
# Only the caller's own account (PKEXEC_UID). Existing models are never
# cleared; labels are unique per account.
set -euo pipefail
uid=${PKEXEC_UID:-}
if [[ ! "$uid" =~ ^[0-9]+$ ]]; then
    echo "mk-face-enroll: run it through pkexec" >&2
    exit 2
fi
user=$(getent passwd "$uid" | cut -d: -f1)
[[ -n "$user" ]] || { echo "mk-face-enroll: unknown user" >&2; exit 2; }
command -v howdy > /dev/null || { echo "Howdy isn't installed (run ./setup.sh)" >&2; exit 4; }
action=${1:-}
label=${2:-}
if [[ "$action" != list ]] && [[ ! "$label" =~ ^[A-Za-z0-9_][A-Za-z0-9_\ -]{0,23}$ ]]; then
    echo "A label is 1-24 letters, digits, spaces, - or _" >&2
    exit 2
fi
# "ID,date,label" rows, as Howdy prints them in --plain mode
models() { howdy -U "$user" --plain list 2> /dev/null | grep -E '^[0-9]+,' || true; }
find_id() { models | awk -F, -v want="$1" '$3 == want { print $1; exit }'; }
case "$action" in
    list) models ;;
    add)
        if [[ -n "$(find_id "$label")" ]]; then
            echo "A face model named \"$label\" already exists" >&2
            exit 3
        fi
        # Never wait for ever on a busy camera; nothing else is touched.
        timeout 30 howdy -y -U "$user" add "$label"
        ;;
    remove)
        id=$(find_id "$label")
        [[ -n "$id" ]] || { echo "No face model named \"$label\"" >&2; exit 3; }
        howdy -y -U "$user" remove "$id"
        ;;
    *) echo "Usage: mk-face-enroll list | add LABEL | remove LABEL" >&2; exit 2 ;;
esac
