#!/bin/bash
# mk-security-scan: the root half of `mk security` (installed by setup.sh to
# /usr/local/libexec, run through pkexec: polkit asks for your fingerprint or
# password first). It only reads, unless asked for one of the fixes listed in
# fix() below, by name.
#
# scan: quick checks only, a few seconds (Lynis's index from its last report).
# scan deep: also rkhunter, chkrootkit, ClamAV (files changed in the last 14
# days in Downloads, Desktop and /tmp) and a fresh Lynis audit, each with a
# time limit and at the lowest CPU and disk priority. One scan at a time.
#
# Run as mk-security-scan it only scans: its polkit action lets the person at
# the computer run it without a password (it only reads). Run as
# mk-security-fix (a second copy) it only applies fixes, and polkit asks for
# an administrator as for any pkexec.
#
# scan virus: ClamAV alone, quickly: files changed in the last 14 days in
# Downloads, 25 MB at most each (~10 s, most of it loading the signatures).
#
# Output, one line each (read by mk-security):
#   FINDING|high|medium|low|ID|title|detail|fix command
#   PASS|ID|title
#   LYNIS|hardening index
#   NOTE|text
set -uo pipefail
export LC_ALL=C

if [[ $EUID -ne 0 ]]; then
    echo "mk-security-scan runs as root (through pkexec, from mk security)" >&2
    exit 1
fi
uid=${PKEXEC_UID:-0}
home=$(getent passwd "$uid" | cut -d: -f6)

# Fields can hold names other programs chose (process names): no "|" (the
# field separator) and no control characters may get through.
clean() { printf '%s' "$1" | tr -d '|[:cntrl:]'; }
finding() { printf 'FINDING|%s|%s|%s|%s|%s\n' "$1" "$2" "$(clean "$3")" "$(clean "$4")" "$(clean "$5")"; }
pass() { printf 'PASS|%s|%s\n' "$1" "$(clean "$2")"; }
note() { printf 'NOTE|%s\n' "$(clean "$1")"; }

# Run a slow tool for at most $1 seconds, at the lowest CPU and disk priority.
slow() {
    local limit=$1
    shift
    timeout --kill-after=5 "$limit" nice -n 19 ionice -c 3 "$@"
}

# ClamAV over FILES (a list), time-limited, at the lowest priority.
clam() {
    local list=$1 limit=$2 infected=0
    if [[ -s "$list" ]]; then
        infected=$(slow "$limit" clamscan -i --no-summary --max-filesize=200M --file-list="$list" 2> /dev/null | grep -c 'FOUND$' || true)
    fi
    echo "$infected"
}

virus() {
    if ! command -v clamscan > /dev/null; then
        note "ClamAV isn't installed (sudo dnf install clamav clamav-freshclam)"
        return
    fi
    local list n infected
    list=$(mktemp)
    [[ -d "$home/Downloads" ]] && find "$home/Downloads" -xdev -type f -mtime -14 -size -25M 2> /dev/null | head -n 2000 > "$list"
    n=$(wc -l < "$list")
    infected=$(clam "$list" 60)
    rm -f "$list"
    if (( infected > 0 )); then
        finding high malware "ClamAV: $infected infected file(s) in Downloads" "Details: clamscan -r -i ~/Downloads" ""
    else
        pass malware "ClamAV: nothing in $n recent file(s) in Downloads"
    fi
}

scan() {
    local deep=${1:-}
    # --- the basics Fedora ships with
    if [[ "$(getenforce 2> /dev/null)" == "Enforcing" ]]; then
        pass selinux "SELinux is enforcing"
    else
        finding high selinux "SELinux isn't enforcing" "It confines services so a hacked one can't take over the system" "mk security fix selinux"
    fi
    if systemctl is-active -q firewalld; then
        zone=$(firewall-cmd --get-default-zone 2> /dev/null)
        pass firewall "Firewall is on (zone: ${zone:-?})"
    else
        finding high firewall "The firewall is off" "Anything listening on the network can be reached" "mk security fix firewall"
    fi
    if ! command -v mokutil > /dev/null; then
        note "Secure Boot not checked: mokutil isn't installed (sudo dnf install mokutil)"
    elif mokutil --sb-state 2> /dev/null | grep -q enabled; then
        pass secureboot "Secure Boot is on"
    else
        finding low secureboot "Secure Boot is off" "Boot-level malware isn't blocked; turn it on in the firmware (BIOS) settings" ""
    fi
    if lsblk -rno FSTYPE 2> /dev/null | grep -q crypto_LUKS; then
        pass encryption "The disk is encrypted"
    else
        finding medium encryption "The disk isn't encrypted" "A lost or stolen laptop gives away every file; only a reinstall with encryption fixes this" ""
    fi
    # --- updates
    # dnf5 prints a column header even with -q: count only advisory rows.
    # -C: from the cached metadata (mk update refreshes it); never a download here.
    sec=$(timeout 20 dnf -q -C updateinfo list --security 2> /dev/null | awk '$2 == "security"' | wc -l)
    if (( sec > 0 )); then
        finding high updates "$sec security update(s) waiting" "Known holes stay open until they're installed" "mk security fix updates"
    else
        pass updates "No security updates waiting"
    fi
    if systemctl is-enabled -q dnf5-automatic.timer 2> /dev/null || systemctl is-enabled -q dnf-automatic.timer 2> /dev/null; then
        pass autoupdates "Security updates install by themselves"
    else
        finding medium autoupdates "Security updates wait for you to install them" "Fixes for known holes arrive later than they could" "mk security fix autoupdates"
    fi
    # --- accounts and remote access
    roots=$(awk -F: '$3 == 0 && $1 != "root" { print $1 }' /etc/passwd | paste -sd ' ')
    if [[ -n "$roots" ]]; then
        finding high uid0 "Extra all-powerful accounts: $roots" "Only root should have user id 0" ""
    else
        pass uid0 "Only root has administrator user id 0"
    fi
    empty=$(awk -F: '($2 == "" ) { print $1 }' /etc/shadow | grep -vx guest | paste -sd ' ')
    if [[ -n "$empty" ]]; then
        finding high emptypw "Accounts without a password: $empty" "Anyone at the keyboard can log in as them" ""
    else
        pass emptypw "Every account has a password (except an MK guest account, if on)"
    fi
    if systemctl is-active -q sshd; then
        if sshd -T 2> /dev/null | grep -qx 'permitrootlogin yes'; then
            finding high sshroot "SSH accepts root logins" "Attackers try root first" "mk security fix ssh"
        fi
        if sshd -T 2> /dev/null | grep -qx 'passwordauthentication yes'; then
            finding medium sshpw "SSH accepts passwords" "Keys can't be guessed; passwords can. Use ssh keys, then fix" "mk security fix ssh"
        fi
        note "SSH server is running (turn it off if you don't log in remotely: sudo systemctl disable --now sshd)"
    fi
    # --- network: what listens beyond this computer
    # TCP servers only: UDP "listeners" are mostly apps' own client sockets.
    open=$(ss -Htlpn 2> /dev/null | awk '$4 !~ /^(127\.|\[::1\]|::1|\[?::ffff:127\.)/ { n = split($4, a, ":"); match($0, /users:\(\("([^"]+)"/, m); name = m[1]; gsub(/[^A-Za-z0-9._-]/, "_", name); print a[n] "/tcp (" (name ? name : "?") ")" }' | sort -u | paste -sd, | sed 's/,/, /g')
    if [[ -n "$open" ]]; then
        finding low ports "Listening to the network: $open" "Each one is a door; the firewall decides who gets in" ""
    else
        pass ports "Nothing listens to the network"
    fi
    # --- your home folder
    if [[ -n "$home" && -d "$home" ]]; then
        ww=$(find "$home" -xdev -type f -perm -0002 -not -path '*/.cache/*' 2> /dev/null | head -100000 | wc -l)
        if (( ww > 0 )); then
            # Behind a private home folder (700) nobody else can reach them: low.
            level=medium
            [[ "$(stat -c %a "$home")" == 700 ]] && level=low
            finding "$level" worldwrite "$ww file(s) in your home anyone could change" "Usually copied from another system (e.g. a browser profile); safe to fix" "mk security fix permissions"
        else
            pass worldwrite "No files in your home that anyone can change"
        fi
        if [[ "$(stat -c %a "$home")" =~ [1-7]$ ]]; then
            finding medium homeperm "Other accounts can look into your home folder" "Your files are visible to every user on this computer" "mk security fix permissions"
        fi
    fi
    # --- running programs started from places only temporary files belong
    local odd="" pid exe
    for pid in /proc/[0-9]*; do
        exe=$(readlink "$pid/exe" 2> /dev/null) || continue
        case "$exe" in
            /tmp/*|/var/tmp/*|/dev/shm/*) odd+="${odd:+, }$(basename "$exe") (${pid#/proc/})" ;;
        esac
    done
    if [[ -n "$odd" ]]; then
        finding medium tmpexec "Programs running from a temporary folder: $odd" "Malware often hides there; installers and build tools sometimes do too" ""
    else
        pass tmpexec "No programs running from temporary folders"
    fi
    # --- Lynis: its last hardening index, quick; a fresh audit with deep
    if command -v lynis > /dev/null; then
        if [[ "$deep" == deep ]]; then
            slow 300 lynis audit system --quick --no-colors --quiet > /dev/null 2>&1
        fi
        index=$(awk -F= '/^hardening_index=/ { print $2 }' /var/log/lynis-report.dat 2> /dev/null)
        [[ -n "$index" ]] && printf 'LYNIS|%s\n' "$index"
        warns=$(grep -c '^warning\[\]=' /var/log/lynis-report.dat 2> /dev/null || true)
        (( warns > 0 )) && note "Lynis: $warns warning(s), $(grep -c '^suggestion\[\]=' /var/log/lynis-report.dat) suggestion(s) (sudo lynis show details, or /var/log/lynis-report.dat)"
        [[ -z "$index" ]] && note "Lynis hasn't audited yet: mk security deep"
    else
        note "Lynis isn't installed (sudo dnf install lynis)"
    fi
    if [[ "$deep" != deep ]]; then
        note "Quick scan. Rootkit and virus checks: mk security deep (a few minutes, low priority)"
        return
    fi
    # --- rootkit checks
    if command -v rkhunter > /dev/null; then
        [[ -s /var/lib/rkhunter/db/rkhunter.dat ]] || slow 120 rkhunter --propupd --nocolors > /dev/null 2>&1
        warn=$(slow 180 rkhunter --check --sk --nocolors --rwo 2> /dev/null | grep -c '^Warning' || true)
        if (( warn > 0 )); then
            finding medium rkhunter "rkhunter: $warn warning(s)" "Often harmless after updates; read: sudo rkhunter --check --sk --rwo" ""
        else
            pass rkhunter "rkhunter found nothing"
        fi
    else
        note "rkhunter isn't installed (sudo dnf install rkhunter)"
    fi
    if command -v chkrootkit > /dev/null; then
        hits=$(slow 120 chkrootkit -q 2> /dev/null | grep -v -E '^$|not (infected|found)|nothing found' | grep -c -i -E 'infected|suspicious|warning' || true)
        if (( hits > 0 )); then
            finding high chkrootkit "chkrootkit: $hits suspicious result(s)" "Read: sudo chkrootkit -q" ""
        else
            pass chkrootkit "chkrootkit found nothing"
        fi
    else
        note "chkrootkit isn't installed (sudo dnf install chkrootkit)"
    fi
    # --- viruses in what arrived lately: files changed in the last 14 days in
    # Downloads, Desktop and /tmp, skipping code checkouts and build trees.
    if command -v clamscan > /dev/null; then
        command -v freshclam > /dev/null && slow 60 freshclam --quiet > /dev/null 2>&1
        list=$(mktemp)
        for d in "$home/Downloads" "$home/Desktop" /tmp; do
            [[ -d "$d" ]] && find "$d" -xdev \( -name .git -o -name node_modules -o -name .venv -o -name build \
                -o -name __pycache__ \) -prune -o -type f -mtime -14 -size -200M -print 2> /dev/null
        done | head -n 5000 > "$list"
        infected=$(clam "$list" 240)
        rm -f "$list"
        if (( infected > 0 )); then
            finding high malware "ClamAV: $infected infected file(s) in Downloads, Desktop or /tmp" "Details: clamscan -r -i ~/Downloads ~/Desktop" ""
        else
            pass malware "ClamAV found nothing in recent files (Downloads, Desktop, /tmp)"
        fi
    else
        note "ClamAV isn't installed (sudo dnf install clamav clamav-freshclam)"
    fi
}

fix() {
    case "$1" in
        selinux)
            setenforce 1
            sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
            echo "SELinux is enforcing (now and after reboots)." ;;
        firewall)
            systemctl enable --now firewalld
            echo "Firewall on." ;;
        updates)
            dnf upgrade -y --security
            echo "Security updates installed." ;;
        ssh)
            install -d /etc/ssh/sshd_config.d
            printf '# MK security fix\nPermitRootLogin no\nPasswordAuthentication no\n' > /etc/ssh/sshd_config.d/40-mk-hardening.conf
            systemctl try-reload-or-restart sshd
            echo "SSH: no root logins, keys only (undo: delete /etc/ssh/sshd_config.d/40-mk-hardening.conf)." ;;
        autoupdates)
            # Security updates only, installed daily; the rest stays manual (mk update).
            rpm -q dnf5-plugin-automatic > /dev/null || dnf install -y dnf5-plugin-automatic
            conf=/etc/dnf/automatic.conf
            [[ -f "$conf" && ! -f "$conf.bak" ]] && cp -a "$conf" "$conf.bak"
            install -d /etc/dnf
            printf '# MK security fix: security updates, installed daily\n[commands]\nupgrade_type = security\napply_updates = yes\n' > "$conf"
            systemctl enable --now dnf5-automatic.timer
            echo "Security updates now install by themselves each day." ;;
        permissions)
            [[ -n "$home" && -d "$home" ]] || exit 1
            chmod 700 "$home"
            find "$home" -xdev -type f -perm -0002 -not -path '*/.cache/*' -exec chmod o-w {} +
            echo "Home folder private; nobody else can change your files." ;;
        *) echo "Unknown fix: $1" >&2; exit 2 ;;
    esac
}

# Which half this copy is: mk-security-scan scans, mk-security-fix fixes.
role=scan
[[ "$(basename "$0")" == mk-security-fix ]] && role=fix
if [[ "${1:-scan}" != "$role" ]]; then
    echo "$(basename "$0") only does: $role" >&2
    exit 2
fi

case "${1:-scan}" in
    scan)
        # One scan at a time: a second one waits for nothing, it just stops.
        exec 9> /run/mk-security-scan.lock
        if ! flock -n 9; then
            echo "NOTE|Another security scan is still running; wait for it to finish"
            exit 0
        fi
        if [[ "${2:-}" == virus ]]; then virus; else scan "${2:-}"; fi
        exit 0 ;;
    fix) fix "${2:-}" ;;
    *) echo "Usage: mk-security-scan [scan | fix NAME]" >&2; exit 2 ;;
esac
