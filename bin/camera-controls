.mk-booth-sticker { font-size: 22px; padding: 2px 6px; min-width: 36px; }
.mk-booth-photo { border-radius: 12px; }
.mk-booth-cell-label { background: alpha(black, 0.55); color: white; border-radius: 99px; padding: 2px 10px;
                       font-weight: 700; font-size: 0.9em; }
