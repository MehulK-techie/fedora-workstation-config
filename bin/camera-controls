             ("🎨 Artistic", ("cyberpunk", "popart", "duotone")),
             ("🤪 Fun", ("distort", "vhs", "pixel")))
GRID_LOOKS = [key for _name, row in GRID_ROWS for key in row]
STICKERS = "😀😂😍🥳😎🤩😜🥰🤪😇👻🤖👑🎉🎈🎂🌈⭐✨🔥💖💯👍✌️🙌🍕🍿🌸🦄🐶🐱"
COLORS = [("White", (1, 1, 1)), ("Black", (0.08, 0.08, 0.1)), ("Pink", (1, 0.35, 0.65)),
          ("Yellow", (1, 0.85, 0.15)), ("Blue", (0.25, 0.6, 1)), ("Green", (0.3, 0.9, 0.45)),
          ("Red", (0.92, 0.22, 0.22)), ("Orange", (1.0, 0.55, 0.1))]
# Lettering for text and captions: Pango picks the first installed family.
FONTS = {"marker": ("Sharpie marker", "Permanent Marker, Patrick Hand, Comic Neue, Sans Bold"),
         "typewriter": ("Retro typewriter", "Courier Prime, Nimbus Mono PS, Liberation Mono, Monospace Bold"),
         "serif": ("Editorial serif", "Playfair Display, Noto Serif, DejaVu Serif, Serif Bold Italic"),
         "lcd": ("Digital LCD", "DSEG7 Classic, DejaVu Sans Mono, Monospace Bold"),
         "times": ("Times serif", "Times New Roman, Liberation Serif, Nimbus Roman, Serif"),
         "script": ("Signature script", "Z003, URW Chancery L, Cursive, Serif Italic"),
         "sans": ("Clean sans", "Sans Bold")}
DEVELOP_SECONDS = 3.0
CSS = b"""
.mk-booth-countdown { font-size: 120px; font-weight: 900; color: white; text-shadow: 0 4px 24px rgba(0,0,0,0.6); }
.mk-booth-flash { background: white; }
.mk-booth-shutter { min-width: 64px; min-height: 64px; border-radius: 32px; padding: 0;
