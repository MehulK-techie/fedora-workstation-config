""" + "".join(f".mk-chip-{name.lower()} {{ background: rgb({round(r * 255)}, {round(g * 255)}, {round(b * 255)}); }}\n"
              for name, (r, g, b) in COLORS).encode()

# ---------------------------------------------------------------- webcam hardware controls (v4l2)
CTRL_RE = re.compile(r"^\s*(\w+)\s+0x[0-9a-f]+\s+\((int|bool)\)\s*:\s*(?:min=(-?\d+)\s+max=(-?\d+)\s+step=(\d+)\s+)?"
                     r"default=(-?\d+)\s+value=(-?\d+)")
SLIDERS = [("brightness", "Brightness"), ("contrast", "Contrast"), ("saturation", "Saturation"),
           ("gamma", "Gamma"), ("sharpness", "Sharpness"), ("white_balance_temperature", "White balance")]


def v4l2(*args):
    try:
        return subprocess.run(["v4l2-ctl", *args], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def find_camera():
    """The first /dev/video* that captures video (skips metadata nodes)."""
    for dev in sorted(glob.glob("/dev/video*"), key=lambda d: int(re.sub(r"\D", "", d) or 0)):
        caps = re.search(r"Device Caps\s*:\s*(0x[0-9a-fA-F]+)", v4l2("-d", dev, "--info"))
        if caps and int(caps.group(1), 16) & 0x1:
            return dev
    return None


def list_controls(dev):
    out = {}
    for line in v4l2("-d", dev, "--list-ctrls").splitlines():
        m = CTRL_RE.match(line)
        if m:
            name, kind, lo, hi, step, default, value = m.groups()
            out[name] = {"kind": kind, "min": int(lo or 0), "max": int(hi or 1), "step": int(step or 1),
                         "default": int(default), "value": int(value)}
    return out


def set_control(dev, name, value):
    subprocess.Popen(["v4l2-ctl", "-d", dev, f"--set-ctrl={name}={int(value)}"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------------------------------------------------------- drawing helpers
def to_texture(img):
    img = img.convert("RGB")
    data = GLib.Bytes.new(img.tobytes())
    return Gdk.MemoryTexture.new(img.width, img.height, Gdk.MemoryFormat.R8G8B8, data, img.width * 3)


STAMP_ORANGE, STAMP_WHITE = (1.0, 0.55, 0.1), (0.96, 0.94, 0.9)
DATE_STYLES = {"digital": ("Digital (90s)", "DSEG7 Classic, Monospace Bold", STAMP_ORANGE),
               "typewriter": ("Typewriter", "Courier Prime, Liberation Mono, Monospace", (0.95, 0.92, 0.85)),
               "handwritten": ("Handwritten", "Patrick Hand, Comic Neue, Sans Italic", (1.0, 1.0, 1.0)),
               "event": ("Event badge", "DSEG7 Classic, Monospace Bold", STAMP_ORANGE),
               "clean": ("Today's date", "Sans Bold", (1.0, 1.0, 1.0))}


def draw_items(img, items, caption=None, caption_box=None, date=None, photo_box=None, caption_font="marker",
               caption_colour=(0.18, 0.16, 0.2)):
    """Text and emoji stickers drawn with Pango/cairo (which renders colour
    emoji), each turned by its angle; a Polaroid caption; a date stamp in the
    photo's corner. ITEMS: dicts with kind, text, x, y (0-1 of the image),
    size (fraction of its width), angle (degrees), colour, and for text a
    font (a FONTS key) and shadow (True for a soft drop shadow). Returns the
    image and each item's box (cx, cy, w, h, angle) in image pixels."""
    rgba = img.convert("RGBA")
    w, h = rgba.size
    # PIL RGBA -> cairo ARGB32 (BGRA in memory on little-endian machines)
    r, g, b, a = rgba.split()
    surface = cairo.ImageSurface.create_for_data(bytearray(Image.merge("RGBA", (b, g, r, a)).tobytes()),
                                                 cairo.FORMAT_ARGB32, w, h, w * 4)
    cr = cairo.Context(surface)
    boxes = []

    def text_at(text, cx, cy, px, colour, font, outline=True, angle=0.0, glow=False, shadow=False):
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription.from_string(f"{font} {max(6, px)}px"))
        layout.set_text(text, -1)
        tw, th = layout.get_pixel_size()
        cr.save()
        cr.translate(cx, cy)
        cr.rotate(math.radians(angle))
        if shadow:  # a soft drop shadow: a few offset, fading copies
            off = max(1.5, px / 16)
            for spread, alpha in ((3, 0.12), (2, 0.18), (1, 0.28)):
                cr.move_to(-tw / 2 + off, -th / 2 + off)
                PangoCairo.layout_path(cr, layout)
                cr.set_source_rgba(0, 0, 0, alpha)
                cr.set_line_width(spread * off * 0.6)
                cr.stroke_preserve()
                cr.fill()
        if glow:  # the orange digits of a 90s camera, slightly bleeding
            cr.move_to(-tw / 2, -th / 2)
            PangoCairo.layout_path(cr, layout)
            cr.set_source_rgba(*colour, 0.35)
            cr.set_line_width(max(2, px / 6))
            cr.stroke()
        if outline:  # a dark edge keeps light text readable on any photo
            cr.move_to(-tw / 2, -th / 2)
            PangoCairo.layout_path(cr, layout)
            cr.set_source_rgba(0, 0, 0, 0.55)
            cr.set_line_width(max(2, px / 10))
            cr.stroke()
        cr.move_to(-tw / 2, -th / 2)
        cr.set_source_rgb(*colour)
        PangoCairo.show_layout(cr, layout)
        cr.restore()
        return tw, th

    for item in items:
        px = round(item["size"] * w)
        angle = item.get("angle", 0.0)
        if item["kind"] == "sticker":
            tw, th = text_at(item["text"], item["x"] * w, item["y"] * h, px, (1, 1, 1), "Noto Color Emoji",
                             outline=False, angle=angle)
        else:
            font = FONTS.get(item.get("font", "sans"), FONTS["sans"])[1]
            tw, th = text_at(item["text"], item["x"] * w, item["y"] * h, px, item["colour"], font,
                             outline=not item.get("shadow"), angle=angle, shadow=item.get("shadow", False))
        boxes.append((item["x"] * w, item["y"] * h, tw, th, angle))
    if caption and caption_box:
        x, y, bw, bh = caption_box
        font = FONTS.get(caption_font, FONTS["marker"])[1]
        px = round(bh * 0.22)
        layout = PangoCairo.create_layout(cr)  # shrink a long caption to fit the card
        layout.set_font_description(Pango.FontDescription.from_string(f"{font} {px}px"))
        layout.set_text(caption, -1)
        px = max(8, min(px, round(px * bw * 0.9 / max(1, layout.get_pixel_size()[0]))))
        text_at(caption, x + bw / 2, y + bh / 2, px, caption_colour, font, outline=False)
    if date and photo_box:
        style, stamp, colour = date
        font = DATE_STYLES[style][1]
        x, y, bw, bh = photo_box
        px = max(10, round(bw * 0.035))
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription.from_string(f"{font} {px}px"))
        layout.set_text(stamp, -1)
        tw, th = layout.get_pixel_size()
        text_at(stamp, x + bw - tw / 2 - bw * 0.04, y + bh - th / 2 - bh * 0.04, px, colour,
                font, outline=colour != STAMP_ORANGE, glow=colour == STAMP_ORANGE)
    surface.flush()
    out = Image.frombuffer("RGBA", (w, h), bytes(surface.get_data()), "raw", "BGRA", 0, 1)
    return out.convert("RGB"), boxes


# ---------------------------------------------------------------- the window
class Booth(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Photo Booth", default_width=1100, default_height=760)
        Gst.init(None)
        self.dev = find_camera()
        self.look = None
        self.mirror = True
        self.frame = None          # (bytes, width, height) of the latest camera frame
        self.frame_lock = threading.Lock()
        self.pending = False
        self.last_shown = 0.0
        self.pipeline = None
        self.items = []
        self.shot = None           # the captured photo (PIL), before decorations

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.toast = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        head = Adw.HeaderBar()
        self.adjust_btn = Gtk.ToggleButton(icon_name="preferences-color-symbolic", tooltip_text="Adjust the camera")
        head.pack_end(self.adjust_btn)
        self.mirror_btn = Gtk.ToggleButton(icon_name="object-flip-horizontal-symbolic", active=True,
                                           tooltip_text="Mirror the preview and the photo, like a mirror")
        self.mirror_btn.connect("toggled", lambda b: setattr(self, "mirror", b.get_active()))
        head.pack_end(self.mirror_btn)
        view.add_top_bar(head)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self._camera_page(), "camera")
        self.stack.add_named(self._decorate_page(), "decorate")
        self.stack.add_named(Adw.StatusPage(icon_name="camera-disabled-symbolic", title="No camera",
                                            description="No webcam was found, or another app is using it. "
                                                        "Close that app and open Photo Booth again."), "none")
        self.toast.set_child(self.stack)
        view.set_content(self.toast)
        self.set_content(view)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        self.add_controller(keys)
        self.connect("close-request", lambda *_: self._stop_camera() or False)
        if self.dev or os.environ.get("MK_BOOTH_TEST"):
            self._start_camera()
        else:
            self.stack.set_visible_child_name("none")

    # ----- camera page
    def _camera_page(self):
        self.preview = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN, hexpand=True, vexpand=True,
                                   css_classes=["mk-booth-photo"])
        self.countdown = Gtk.Label(css_classes=["mk-booth-countdown"], visible=False)
        self.flash = Gtk.Box(css_classes=["mk-booth-flash"], opacity=0, can_target=False)
        # 3 x 3: nine looks live at once, click one to use it.
        self.grid_mode = False
        self.grid = Gtk.Grid(row_spacing=12, column_spacing=12, hexpand=True, vexpand=True,
                             row_homogeneous=True, column_homogeneous=True)
        row_names = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, homogeneous=True, spacing=12)
        self.grid_cells = []
        for name, _keys in GRID_ROWS:
            row_names.append(Gtk.Label(label=name, css_classes=["heading"], xalign=0, valign=Gtk.Align.CENTER,
                                       width_chars=10))
        for n, key in enumerate(GRID_LOOKS):
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, css_classes=["mk-booth-photo"],
                              cursor=Gdk.Cursor.new_from_name("pointer"))
            label = Gtk.Label(label=photo.FILTERS[key].label if key else "Original",
                              css_classes=["mk-booth-cell-label"], valign=Gtk.Align.END, halign=Gtk.Align.CENTER,
                              margin_bottom=6)
            cell = Gtk.Overlay(child=pic)
            cell.add_overlay(label)
            click = Gtk.GestureClick()
            click.connect("released", lambda *_a, k=key: self._pick_from_grid(k))
            cell.add_controller(click)
            self.grid.attach(cell, n % 3, n // 3, 1, 1)
            self.grid_cells.append((key, pic))
        self.view_stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True, vexpand=True)
        self.view_stack.add_named(self.preview, "single")
        grid_page = Gtk.Box(spacing=12)
        grid_page.append(row_names)
        grid_page.append(self.grid)
        self.view_stack.add_named(grid_page, "grid")
        overlay = Gtk.Overlay(child=self.view_stack, margin_start=16, margin_end=16, margin_top=16)
        overlay.add_overlay(self.flash)
        overlay.add_overlay(self.countdown)

        side = self._adjust_panel()
        revealer = Gtk.Revealer(child=side, transition_type=Gtk.RevealerTransitionType.SLIDE_LEFT)
        self.adjust_btn.bind_property("active", revealer, "reveal-child", 0)
        top = Gtk.Box()
        top.append(overlay)
        top.append(revealer)

        # Room under the pills for the scrollbar, so they never overlap.
        # The looks, by kind, with a search box: All / Vintage / Artistic / Fun.
        tray = Gtk.Box(spacing=12, margin_start=16, margin_end=16, margin_top=12)
        self.look_search = Gtk.SearchEntry(placeholder_text="Find a look…", width_chars=16)
        self.look_search.connect("search-changed", lambda *_: self._filter_looks())
        tray.append(self.look_search)
        cats = Gtk.Box(css_classes=["linked"])
        self.look_cat = "All"
        cat_group = None
        for cat in ("All",) + tuple(LOOK_CATEGORIES):
            c = Gtk.ToggleButton(label=cat, active=cat == "All")
            if cat_group:
                c.set_group(cat_group)
            cat_group = cat_group or c
            c.connect("toggled", lambda btn, k=cat: btn.get_active() and (setattr(self, "look_cat", k),
                                                                           self._filter_looks()))
            cats.append(c)
        tray.append(cats)
        looks = Gtk.Box(spacing=8, margin_start=16, margin_end=16, margin_top=8, margin_bottom=16)
        group = None
        self.look_buttons = {}
        for key, label in [(None, "Original")] + [(k, f.label) for k, f in photo.FILTERS.items()]:
            b = Gtk.ToggleButton(label=label, css_classes=["pill"], active=key is None)
            if group:
                b.set_group(group)
            group = group or b
            b.connect("toggled", lambda btn, k=key: btn.get_active() and setattr(self, "look", k))
            looks.append(b)
            self.look_buttons[key] = b
        scroller = Gtk.ScrolledWindow(child=looks, vscrollbar_policy=Gtk.PolicyType.NEVER,
                                      hscrollbar_policy=Gtk.PolicyType.AUTOMATIC, propagate_natural_height=True,
                                      overlay_scrolling=False, margin_start=4, margin_end=4)

        bottom = Gtk.CenterBox(margin_top=12, margin_bottom=16, margin_start=16, margin_end=16)
        self.timer_btn = Gtk.ToggleButton(icon_name="alarm-symbolic", tooltip_text="3-2-1 countdown",
                                          css_classes=["circular"], valign=Gtk.Align.CENTER)
        self.grid_btn = Gtk.ToggleButton(icon_name="view-grid-symbolic", tooltip_text="Nine looks at once (G)",
                                         css_classes=["circular"], valign=Gtk.Align.CENTER)
        self.grid_btn.connect("toggled", lambda b: self._set_grid(b.get_active()))
        left = Gtk.Box(spacing=16)
        left.append(self.timer_btn)
        left.append(self.grid_btn)
        bottom.set_start_widget(left)
        shutter = Gtk.Button(icon_name="camera-photo-symbolic", css_classes=["mk-booth-shutter"],
                             tooltip_text="Take the photo (Space)")
        shutter.connect("clicked", lambda *_: self.take())
        bottom.set_center_widget(shutter)
        folder = Gtk.Button(icon_name="folder-pictures-symbolic", tooltip_text="Your photos",
                            css_classes=["circular"], valign=Gtk.Align.CENTER)
        folder.connect("clicked", lambda *_: self._open_folder())
        bottom.set_end_widget(folder)

        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        page.append(top)
        page.append(tray)
        page.append(scroller)
        page.append(bottom)
        return page

    def _filter_looks(self):
        query = self.look_search.get_text().strip().lower()
        for key, b in self.look_buttons.items():
            in_cat = key is None or self.look_cat == "All" or key in LOOK_CATEGORIES.get(self.look_cat, ())
            b.set_visible(in_cat and (not query or query in b.get_label().lower()))

    def _adjust_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, width_request=280,
                      margin_start=12, margin_end=12, margin_top=8)
        box.append(Gtk.Label(label="Camera", css_classes=["title-4"], xalign=0))
        self.sliders = {}
        ctrls = list_controls(self.dev) if self.dev else {}
        for name, label in SLIDERS:
            c = ctrls.get(name)
            if not c or c["kind"] != "int":
                continue
            box.append(Gtk.Label(label=label, xalign=0, css_classes=["caption-heading"]))
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, c["min"], c["max"], max(1, c["step"]))
            scale.set_value(c["value"])
            scale.connect("value-changed", self._on_slider, name)
            box.append(scale)
            self.sliders[name] = (scale, c["default"])
        reset = Gtk.Button(label="Reset to hardware defaults", css_classes=["pill"], margin_top=8)
        reset.connect("clicked", lambda *_: self._reset_controls())
        box.append(reset)
        if not self.sliders:
            box.append(Gtk.Label(label="This camera has no adjustable controls.", wrap=True))
        return box

    def _on_slider(self, scale, name):
        if name == "white_balance_temperature":
            set_control(self.dev, "white_balance_automatic", 0)  # a manual value needs auto off
        set_control(self.dev, name, scale.get_value())

    def _reset_controls(self):
        for name, (scale, default) in self.sliders.items():
            scale.set_value(default)
        set_control(self.dev, "white_balance_automatic", 1)
        self.toast.add_toast(Adw.Toast(title="Camera back to its hardware defaults", timeout=2))

    # ----- live video
    def _start_camera(self):
        # Motion-JPEG at 1280x720 when the webcam offers it (most do), raw video
        # otherwise. MK_BOOTH_TEST=1 uses a test pattern (tests never film you).
        test = "videotestsrc pattern=ball ! video/x-raw,width=1280,height=720 ! videoconvert ! video/x-raw,format=RGB " \
               "! appsink name=sink emit-signals=true max-buffers=1 drop=true sync=false"
        for desc in ([test] if os.environ.get("MK_BOOTH_TEST") else []) + [f"v4l2src device={self.dev} ! image/jpeg,width=1280,height=720 ! jpegdec ! videoconvert "
                     "! video/x-raw,format=RGB ! appsink name=sink emit-signals=true max-buffers=1 drop=true sync=false",
                     f"v4l2src device={self.dev} ! videoconvert ! videoscale ! video/x-raw,format=RGB,width=1280,height=720 "
                     "! appsink name=sink emit-signals=true max-buffers=1 drop=true sync=false"]:
            try:
                pipeline = Gst.parse_launch(desc)
            except GLib.Error:
                continue
            pipeline.get_by_name("sink").connect("new-sample", self._on_sample)
            if pipeline.set_state(Gst.State.PLAYING) != Gst.StateChangeReturn.FAILURE:
                self.pipeline = pipeline
                bus = pipeline.get_bus()
                bus.add_signal_watch()
                bus.connect("message::error", self._on_error)
                return
            pipeline.set_state(Gst.State.NULL)
        self.stack.set_visible_child_name("none")

    def _on_error(self, _bus, message):
        err, _debug = message.parse_error()
        self._stop_camera()
        self.stack.set_visible_child_name("none")
        print(f"camera: {err.message}", file=sys.stderr)

    def _back_to_camera(self):
        self.stack.set_visible_child_name("camera")
        if not self.pipeline:
            self._start_camera()

    def _stop_camera(self):
        if self.pipeline:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None

    def _on_sample(self, sink):
        # The streaming thread: keep only the newest frame, draw it on the main loop.
        sample = sink.emit("pull-sample")
        caps = sample.get_caps().get_structure(0)
        buf = sample.get_buffer()
        ok, info = buf.map(Gst.MapFlags.READ)
        if ok:
            with self.frame_lock:
                self.frame = (bytes(info.data), caps.get_value("width"), caps.get_value("height"))
            buf.unmap(info)
            if not self.pending:
                self.pending = True
                GLib.idle_add(self._show_frame)
        return Gst.FlowReturn.OK

    def _latest(self):
        with self.frame_lock:
            if not self.frame:
                return None
            data, w, h = self.frame
        img = Image.frombuffer("RGB", (w, h), data, "raw", "RGB", 0, 1)
        return img.transpose(Image.Transpose.FLIP_LEFT_RIGHT) if self.mirror else img

    def _show_frame(self):
        self.pending = False
        if self.stack.get_visible_child_name() != "camera":
            return GLib.SOURCE_REMOVE
        now = time.monotonic()
        if now - self.last_shown < 1 / 30:  # 30 fps is plenty, and kinder to the battery
            return GLib.SOURCE_REMOVE
        self.last_shown = now
        img = self._latest()
        if img is None:
            return GLib.SOURCE_REMOVE
        if self.grid_mode:
            if now - getattr(self, "last_grid", 0) < 1 / 30:  # nine looks at 30 fps on 240 px tiles
                return GLib.SOURCE_REMOVE
            self.last_grid = now
            tiny = img.resize((GRID_W, round(GRID_W * img.height / img.width)), Image.Resampling.BILINEAR)
            for key, pic in self.grid_cells:
                look = photo.polaroid_photo(tiny) if key == "polaroid" else photo.apply(tiny, key) if key else tiny
                pic.set_paintable(to_texture(look))
            return GLib.SOURCE_REMOVE
        small = img.resize((PREVIEW_W, round(PREVIEW_W * img.height / img.width)), Image.Resampling.BILINEAR)
        self.preview.set_paintable(to_texture(photo.apply(small, self.look) if self.look else small))
        return GLib.SOURCE_REMOVE

    def _set_grid(self, on):
        self.grid_mode = on
        self.view_stack.set_visible_child_name("grid" if on else "single")

    def _pick_from_grid(self, key):
        self.look_buttons[key].set_active(True)
        self.grid_btn.set_active(False)

    # ----- taking the photo
    def take(self):
        if self.stack.get_visible_child_name() != "camera" or self.countdown.get_visible():
            return
        if not self.timer_btn.get_active():
            self._snap()
            return
        steps = iter(("3", "2", "1"))

        def tick():
            label = next(steps, None)
            if label is None:
                self.countdown.set_visible(False)
                self._snap()
                return GLib.SOURCE_REMOVE
            self.countdown.set_label(label)
            self.countdown.set_visible(True)
            return GLib.SOURCE_CONTINUE
        tick()
        GLib.timeout_add(1000, tick)

    def _snap(self):
        img = self._latest()
        if img is None:
            return
        # A white flash, fading out.
        self.flash.set_opacity(1)
        start = time.monotonic()

        def fade(*_):
            k = (time.monotonic() - start) / 0.35
            self.flash.set_opacity(max(0.0, 1 - k))
            return k < 1
        self.flash.add_tick_callback(fade)
        if self.look == "polaroid":
            # The look without its frame: the frame (with room for a caption)
            # is added on the decorate page, where it can be switched off.
            self.shot = photo.polaroid_photo(img)
            self.frame_on = True
        else:
            self.shot = photo.apply(img, self.look) if self.look else img
            self.frame_on = False
        self.items = []
        self.selected = None
        self.taken_at = time.localtime()
        self.frame_switch.set_active(self.frame_on)
        self.caption.set_text("")
        self._compose()
        self.stack.set_visible_child_name("decorate")
        self._develop()
        # The photo is taken: the camera goes off (its light too) while you
        # decorate, and comes back on with Retake or after saving.
        self._stop_camera()
        with self.frame_lock:
            self.frame = None

    def _develop(self):
        """The print develops: the slate over it clears over 3 s, slowly at
        first, like instant film."""
        def step(v):
            self.slate = 1 - v
            self.handles.queue_draw()
        anim = Adw.TimedAnimation.new(self.handles, 0, 1, int(DEVELOP_SECONDS * 1000),
                                      Adw.CallbackAnimationTarget.new(step))
        anim.set_easing(Adw.Easing.EASE_IN_CUBIC)
        anim.play()
        self._developing = anim

    # ----- decorate page
    def _decorate_page(self):
        self.result = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN, hexpand=True, vexpand=True,
                                  css_classes=["mk-booth-photo"], can_target=False)
        # Handles over the picture: select, move, resize from the corners,
        # rotate from the knob on top.
        self.handles = Gtk.DrawingArea(hexpand=True, vexpand=True)
        self.handles.set_draw_func(self._draw_handles)
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._drag_begin)
        drag.connect("drag-update", self._drag_update)
        drag.connect("drag-end", self._drag_end)
        self.handles.add_controller(drag)
        self.angle_label = Gtk.Label(css_classes=["mk-booth-angle"], visible=False, halign=Gtk.Align.START,
                                     valign=Gtk.Align.START, can_target=False)
        canvas = Gtk.Overlay(child=self.result, margin_start=12, margin_top=12, margin_bottom=12)
        canvas.add_overlay(self.handles)
        canvas.add_overlay(self.angle_label)
        self.slate = 0.0  # the developing print's chemical slate over the photo, 1 = opaque
        self.view_img = None
        self.view_photo_box = (0, 0, 0, 0)
        self.selected = None
        self.boxes = []

        tools = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, width_request=320,
                        margin_start=16, margin_end=16, margin_top=12, margin_bottom=16)
        tools.append(Gtk.Label(label="Add text or a sticker, then click the photo", css_classes=["heading"],
                               xalign=0, wrap=True))
        self.text_entry = Gtk.Entry(placeholder_text="Your text")
        tools.append(self.text_entry)
        colours = Gtk.Box(spacing=6)
        self.colour = COLORS[0][1]
        group = None
        for name, rgb in COLORS:
            b = Gtk.ToggleButton(tooltip_text=name, css_classes=["mk-booth-chip", f"mk-chip-{name.lower()}"],
                                 active=group is None, valign=Gtk.Align.CENTER)
            if group:
                b.set_group(group)
            group = group or b
            b.connect("toggled", lambda btn, c=rgb: btn.get_active() and self._set_colour(c))
            colours.append(b)
        tools.append(colours)
        # Lettering: font, size and a drop shadow; they apply to the selected
        # text and to the next text you place (and the font to the caption).
        font_row = Gtk.Box(spacing=8)
        font_row.append(Gtk.Label(label="Font", xalign=0, hexpand=True))
        self.font = Gtk.DropDown.new_from_strings([v[0] for v in FONTS.values()])
        self.font.connect("notify::selected", lambda *_: self._style_selected("font", self._font_key()))
        font_row.append(self.font)
        tools.append(font_row)
        size_row = Gtk.Box(spacing=8)
        size_row.append(Gtk.Label(label="Size", xalign=0))
        self.size = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 3, 24, 1)
        self.size.set_value(8)
        self.size.set_hexpand(True)
        self.size.set_draw_value(False)
        self.size.connect("value-changed", lambda sc: self._style_selected("size", sc.get_value() / 100))
        size_row.append(self.size)
        size_row.append(Gtk.Label(label="Shadow"))
        self.shadow = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.shadow.connect("notify::active", lambda sw, _p: self._style_selected("shadow", sw.get_active()))
        size_row.append(self.shadow)
        tools.append(size_row)
        flow = Gtk.FlowBox(max_children_per_line=8, selection_mode=Gtk.SelectionMode.NONE)
        self.sticker = None
        for ch in self._split_emoji(STICKERS):
            b = Gtk.Button(label=ch, css_classes=["flat", "mk-booth-sticker"])
            b.connect("clicked", lambda _b, c=ch: self._pick_sticker(c))
            flow.append(b)
        tools.append(flow)
        layer = Gtk.Box(spacing=6, css_classes=["linked"])
        for icon, tip, cb in (("go-up-symbolic", "Bring forward", lambda: self._restack(1)),
                              ("go-down-symbolic", "Send backward", lambda: self._restack(-1)),
                              ("user-trash-symbolic", "Delete (Del)", lambda: self._delete_selected())):
            b = Gtk.Button(icon_name=icon, tooltip_text=tip)
            b.connect("clicked", lambda _b, c=cb: c())
            layer.append(b)
        tools.append(Gtk.Label(label="Selected layer: drag to move, corners to resize, the top knob to turn",
                               css_classes=["caption", "dim-label"], xalign=0, wrap=True))
        tools.append(layer)

        frame_row = Gtk.Box(spacing=8)
        frame_row.append(Gtk.Label(label="Polaroid frame", hexpand=True, xalign=0))
        self.frame_switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.frame_switch.connect("notify::active", lambda sw, _p: (setattr(self, "frame_on", sw.get_active()),
                                                                    self._compose()))
        frame_row.append(self.frame_switch)
        tools.append(frame_row)
        self.frame_colour = Gtk.DropDown.new_from_strings([v[0] for v in photo.FRAME_COLOURS.values()])
        self.frame_colour.connect("notify::selected", lambda *_: self._compose())
        stock = Gtk.Box(spacing=8)
        stock.append(Gtk.Label(label="Card", xalign=0, hexpand=True))
        stock.append(self.frame_colour)
        tools.append(stock)
        leak_row = Gtk.Box(spacing=8)
        leak_row.append(Gtk.Label(label="Light leak", xalign=0, hexpand=True))
        self.leak = Gtk.DropDown.new_from_strings(["None"] + list(photo.LEAKS.values()))
        self.leak.connect("notify::selected", lambda *_: self._compose())
        leak_row.append(self.leak)
        tools.append(leak_row)
        self.caption = Gtk.Entry(placeholder_text="Caption on the frame")
        self.caption.connect("changed", lambda *_: self._compose())
        tools.append(self.caption)
        date_row = Gtk.Box(spacing=8)
        date_row.append(Gtk.Label(label="Date stamp", hexpand=True, xalign=0))
        self.date_style = Gtk.DropDown.new_from_strings([v[0] for v in DATE_STYLES.values()])
        self.date_style.connect("notify::selected", lambda *_: self._compose())
        date_row.append(self.date_style)
        self.date_switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.date_switch.connect("notify::active", lambda *_: self._compose())
        date_row.append(self.date_switch)
        tools.append(date_row)
        year_row = Gtk.Box(spacing=8)
        year_row.append(Gtk.Label(label="Year on the stamp", xalign=0, hexpand=True))
        self.year = Gtk.SpinButton.new_with_range(1970, 2099, 1)
        self.year.set_value(time.localtime().tm_year)
        self.year.connect("value-changed", lambda *_: self.date_switch.get_active() and self._compose())
        year_row.append(self.year)
        tools.append(year_row)
        stamp_row = Gtk.Box(spacing=8)
        self.event_text = Gtk.Entry(placeholder_text="Event badge text (HACKATHON, TOKYO…)", hexpand=True,
                                    max_length=16)
        self.event_text.connect("changed", lambda *_: self.date_switch.get_active() and self._compose())
        stamp_row.append(self.event_text)
        stamp_row.append(Gtk.Label(label="White"))
        self.stamp_white = Gtk.Switch(valign=Gtk.Align.CENTER, tooltip_text="Faded white stamp instead of orange")
        self.stamp_white.connect("notify::active", lambda *_: self.date_switch.get_active() and self._compose())
        stamp_row.append(self.stamp_white)
        tools.append(stamp_row)

        row = Gtk.Box(spacing=12, margin_top=12)
        retake = Gtk.Button(label="Retake", css_classes=["pill"])
        retake.connect("clicked", lambda *_: self._back_to_camera())
        save = Gtk.Button(label="Save", css_classes=["pill", "suggested-action"], hexpand=True)
        save.connect("clicked", lambda *_: self.save())
        row.append(retake)
        row.append(save)
        tools.append(row)

        page = Gtk.Box()
        page.append(canvas)
        page.append(Gtk.ScrolledWindow(child=tools, hscrollbar_policy=Gtk.PolicyType.NEVER,
                                       propagate_natural_width=True))
        return page

    @staticmethod
    def _split_emoji(text):
        """Emoji, one each: a base character plus any variation selector."""
        out = []
        for ch in text:
            if ch == "️" and out:
                out[-1] += ch
            else:
                out.append(ch)
        return out

    def _pick_sticker(self, ch):
        self.sticker = ch
        self.text_entry.set_text("")
        self.toast.add_toast(Adw.Toast(title=f"{ch} picked: click the photo to place it", timeout=2))

    def _font_key(self):
        return list(FONTS)[self.font.get_selected()]

    def _style_selected(self, key, value):
        """A lettering control changed: restyle the selected text, if any
        (fonts also restyle the caption)."""
        i = self.selected
        if i is not None and self.items[i]["kind"] == "text":
            self.items[i][key] = value
        elif key == "size" and i is not None:
            self.items[i][key] = value
        self._compose()

    def _set_colour(self, colour):
        self.colour = colour
        if self.selected is not None and self.items[self.selected]["kind"] == "text":
            self.items[self.selected]["colour"] = colour
            self._compose()

    def _composed_parts(self, base_photo=None):
        """The photo with its frame (if on), and where the photo and caption sit."""
        shot = base_photo or self.shot
        leak = self.leak.get_selected()
        if leak:
            shot = photo.light_leak(shot, list(photo.LEAKS)[leak - 1])
        if self.frame_on:
            colour = list(photo.FRAME_COLOURS)[self.frame_colour.get_selected()]
            framed, photo_box, caption_box = photo.polaroid_frame(shot, colour)
            return framed, photo_box, caption_box
        return shot, (0, 0, shot.width, shot.height), None

    def _render(self, base_photo):
        base, (px, py, pw, ph), caption_box = self._composed_parts(base_photo)
        self.view_photo_box = (px, py, pw, ph)
        # Items are kept relative to the photo, so the frame can come and go.
        placed = [dict(it, x=(px + it["x"] * pw) / base.width, y=(py + it["y"] * ph) / base.height,
                       size=it["size"] * pw / base.width) for it in self.items]
        date = None
        if self.date_switch.get_active():
            style = list(DATE_STYLES)[self.date_style.get_selected()]
            fmt = {"digital": "'%y %m %d", "typewriter": "%d %b %Y", "clean": "%-d %B %Y"}.get(style, "%d/%m/%y")
            taken = datetime.datetime(*self.taken_at[:6])
            try:  # the year you picked (a '98 print), the day it was taken
                taken = taken.replace(year=int(self.year.get_value()))
            except ValueError:  # 29 February in a year without one
                taken = taken.replace(year=int(self.year.get_value()), day=28)
            text = taken.strftime(fmt)
            if style == "event":  # HACKATHON '26: your words, the year as '26
                text = (self.event_text.get_text().strip().upper() or "MK") + taken.strftime(" '%y")
            if style == "clean":
                text = time.strftime(fmt)
            colour = STAMP_WHITE if self.stamp_white.get_active() else DATE_STYLES[style][2]
            date = (style, text, colour)
        noir = self.frame_on and list(photo.FRAME_COLOURS)[self.frame_colour.get_selected()] == "noir"
        return draw_items(base, placed, self.caption.get_text().strip() if self.frame_on else None,
                          caption_box, date, (px, py, pw, ph), caption_font=self._font_key(),
                          caption_colour=(0.93, 0.92, 0.88) if noir else (0.18, 0.16, 0.2))

    def _compose(self):
        """Redraw the editing view (on a smaller copy, so dragging is smooth)."""
        if self.shot is None:
            return
        small = self.shot.copy()
        small.thumbnail((1100, 1100))
        self.view_img, self.boxes = self._render(small)
        self.result.set_paintable(to_texture(self.view_img))
        self.handles.queue_draw()

    # ----- layers: select, move, resize, rotate
    def _to_view(self):
        """(scale, x offset, y offset) of the shown image inside the widget."""
        w, h = self.handles.get_width(), self.handles.get_height()
        iw, ih = self.view_img.size
        k = min(w / iw, h / ih)
        return k, (w - iw * k) / 2, (h - ih * k) / 2

    def _box_points(self, i):
        """The selected box's corners and rotate knob, in widget coordinates."""
        cx, cy, bw, bh, angle = self.boxes[i]
        k, ox, oy = self._to_view()
        a = math.radians(angle)
        def at(dx, dy):
            return (ox + (cx + dx * math.cos(a) - dy * math.sin(a)) * k,
                    oy + (cy + dx * math.sin(a) + dy * math.cos(a)) * k)
        corners = [at(-bw / 2 - 6, -bh / 2 - 6), at(bw / 2 + 6, -bh / 2 - 6),
                   at(bw / 2 + 6, bh / 2 + 6), at(-bw / 2 - 6, bh / 2 + 6)]
        knob = at(0, -bh / 2 - 6 - 28 / k)
        return corners, knob, (ox + cx * k, oy + cy * k)

    def _draw_handles(self, _area, cr, _w, _h):
        if self.slate > 0 and self.view_img is not None:  # the print is still developing
            k, ox, oy = self._to_view()
            px, py, pw, ph = self.view_photo_box
            cr.set_source_rgba(0.17, 0.16, 0.14, self.slate)
            cr.rectangle(ox + px * k, oy + py * k, pw * k, ph * k)
            cr.fill()
        if self.selected is None or self.selected >= len(self.boxes):
            return
        corners, knob, centre = self._box_points(self.selected)
        cr.set_source_rgba(1, 1, 1, 0.95)
        cr.set_line_width(1.5)
        cr.set_dash([5, 4])
        cr.move_to(*corners[0])
        for c in corners[1:]:
            cr.line_to(*c)
        cr.close_path()
        cr.stroke()
        cr.set_dash([])
        top_mid = ((corners[0][0] + corners[1][0]) / 2, (corners[0][1] + corners[1][1]) / 2)
        cr.move_to(*top_mid)
        cr.line_to(*knob)
        cr.stroke()
        for x, y in corners:
            cr.rectangle(x - 6, y - 6, 12, 12)
        cr.set_source_rgb(0.21, 0.52, 0.89)
        cr.fill()
        cr.arc(knob[0], knob[1], 8, 0, 2 * math.pi)
        cr.fill()

    def _hit(self, x, y):
        """What's under the pointer: ('rotate'|'scale'|'move', index) or None."""
        if self.selected is not None and self.selected < len(self.boxes):
            corners, knob, _c = self._box_points(self.selected)
            if math.dist((x, y), knob) < 14:
                return ("rotate", self.selected)
            if any(math.dist((x, y), c) < 14 for c in corners):
                return ("scale", self.selected)
        k, ox, oy = self._to_view()
        bx, by = (x - ox) / k, (y - oy) / k
        for i in reversed(range(len(self.boxes))):  # topmost first
            cx, cy, bw, bh, angle = self.boxes[i]
            a = -math.radians(angle)
            dx, dy = bx - cx, by - cy
            rx, ry = dx * math.cos(a) - dy * math.sin(a), dx * math.sin(a) + dy * math.cos(a)
            if abs(rx) <= bw / 2 + 6 and abs(ry) <= bh / 2 + 6:
                return ("move", i)
        return None

    def _drag_begin(self, _g, x, y):
        self.drag_start = (x, y)
        hit = self._hit(x, y)
        self.drag_mode = hit[0] if hit else None
        if hit:
            self.selected = hit[1]
            it = self.items[self.selected]
            _corners, _knob, centre = self._box_points(self.selected)
            self.drag_item = dict(it)
            self.drag_centre = centre
            self.drag_dist = max(1.0, math.dist((x, y), centre))
            self.drag_angle0 = math.degrees(math.atan2(y - centre[1], x - centre[0]))
        self.handles.queue_draw()

    def _drag_update(self, _g, dx, dy):
        if not self.drag_mode or self.selected is None:
            return
        it, start = self.items[self.selected], self.drag_item
        x, y = self.drag_start[0] + dx, self.drag_start[1] + dy
        base, (_px, _py, pw, ph), _cap = self._composed_parts(self.view_photo_size())
        k, _ox, _oy = self._to_view()
        if self.drag_mode == "move":
            it["x"] = min(1.0, max(0.0, start["x"] + dx / k / pw))
            it["y"] = min(1.0, max(0.0, start["y"] + dy / k / ph))
        elif self.drag_mode == "scale":
            it["size"] = min(0.9, max(0.02, start["size"] * math.dist((x, y), self.drag_centre) / self.drag_dist))
        else:
            now = math.degrees(math.atan2(y - self.drag_centre[1], x - self.drag_centre[0]))
            it["angle"] = (start.get("angle", 0.0) + now - self.drag_angle0 + 180) % 360 - 180
            self.angle_label.set_label(f"{round(it['angle'])}°")
            self.angle_label.set_margin_start(int(x) + 16)
            self.angle_label.set_margin_top(int(y) + 16)
            self.angle_label.set_visible(True)
        self._compose()

    def _drag_end(self, _g, dx, dy):
        self.angle_label.set_visible(False)
        if abs(dx) + abs(dy) < 4 and not self.drag_mode:
            self._place(*self.drag_start)  # a click on an empty spot
        elif abs(dx) + abs(dy) < 4 and self.drag_mode == "move":
            pass  # a click on a layer just selects it
        self.drag_mode = None

    def view_photo_size(self):
        small = self.shot.copy()
        small.thumbnail((1100, 1100))
        return small

    def _place(self, x, y):
        if self.shot is None:
            return
        base, (px, py, pw, ph), _cap = self._composed_parts(self.view_photo_size())
        k, ox, oy = self._to_view()
        bx, by = (x - ox) / k, (y - oy) / k
        if not (px <= bx <= px + pw and py <= by <= py + ph):
            self.selected = None
            self.handles.queue_draw()
            return
        rel = {"x": (bx - px) / pw, "y": (by - py) / ph, "angle": 0.0}
        text = self.text_entry.get_text().strip()
        if text:
            self.items.append({"kind": "text", "text": text, "colour": self.colour, "size": self.size.get_value() / 100,
                               "font": self._font_key(), "shadow": self.shadow.get_active(), **rel})
            self.text_entry.set_text("")
        elif self.sticker:
            self.items.append({"kind": "sticker", "text": self.sticker, "size": 0.12, **rel})
        else:
            self.selected = None
            self.handles.queue_draw()
            self.toast.add_toast(Adw.Toast(title="Type some text or pick a sticker first", timeout=2))
            return
        self.selected = len(self.items) - 1
        self._compose()

    def _restack(self, step):
        i = self.selected
        if i is None:
            return
        j = max(0, min(len(self.items) - 1, i + step))
        self.items.insert(j, self.items.pop(i))
        self.selected = j
        self._compose()

    def _delete_selected(self):
        if self.selected is not None:
            self.items.pop(self.selected)
            self.selected = None
            self._compose()

    def save(self):
        OUT_DIR.mkdir(parents=True, exist_ok=True)
        path = OUT_DIR / time.strftime("booth-%Y%m%d-%H%M%S.jpg")
        final, _boxes = self._render(self.shot)  # full size for the file
        final.save(path, "JPEG", quality=92)
        toast = Adw.Toast(title=f"Saved {path.name}", button_label="Open", timeout=4)
        toast.connect("button-clicked", lambda *_: Gio.AppInfo.launch_default_for_uri(path.as_uri(), None))
        self.toast.add_toast(toast)
        self._back_to_camera()

    def _open_folder(self):
        OUT_DIR.mkdir(parents=True, exist_ok=True)
        Gio.AppInfo.launch_default_for_uri(OUT_DIR.as_uri(), None)

    def _on_key(self, _c, keyval, _code, _state):
        focus = self.get_focus()
        if focus and (focus is self.look_search or focus.is_ancestor(self.look_search)):
            return False  # typing in the looks search: Space and G are letters there
        if keyval == Gdk.KEY_space and self.stack.get_visible_child_name() == "camera":
            self.take()
            return True
        if keyval in (Gdk.KEY_g, Gdk.KEY_G) and self.stack.get_visible_child_name() == "camera":
            self.grid_btn.set_active(not self.grid_btn.get_active())
            return True
        if self.stack.get_visible_child_name() == "decorate" and not self.text_entry.has_focus() \
                and not self.caption.has_focus():
            if keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
                self._delete_selected()
                return True
            if keyval == Gdk.KEY_Escape:
                if self.selected is not None:
                    self.selected = None
                    self.handles.queue_draw()
                else:
                    self._back_to_camera()
                return True
        return False


class BoothApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        (self.get_active_window() or Booth(self)).present()


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__.strip())
        return 0
    return BoothApp().run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
