#!/usr/bin/env python3
import subprocess, sys

try:
    ws_out = subprocess.check_output(["wmctrl", "-d"], text=True)
    active_ws = None
    for line in ws_out.splitlines():
        if "*" in line:
            active_ws = line.split()[0]
            break
            
    if active_ws is not None:
        win_out = subprocess.check_output(["wmctrl", "-l"], text=True)
        for line in win_out.splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1] == active_ws:
                win_id = parts[0]
                subprocess.run(["wmctrl", "-c", win_id])
except Exception:
    pass
