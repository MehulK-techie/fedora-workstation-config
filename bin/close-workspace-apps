#!/usr/bin/env python3
import subprocess, time, shutil

has_wtype = shutil.which("wtype") is not None
has_xdotool = shutil.which("xdotool") is not None

# Sequentially send Alt+F4 to active windows on the current workspace
for _ in range(12):
    if has_wtype:
        subprocess.run(["wtype", "-M", "alt", "-k", "F4", "-m", "alt"], stderr=subprocess.DEVNULL)
    elif has_xdotool:
        subprocess.run(["xdotool", "key", "--clearmodifiers", "Alt+F4"], stderr=subprocess.DEVNULL)
    time.sleep(0.06)
