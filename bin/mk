#!/usr/bin/env bash
# ==============================================================================
# MK Workstation Command Line Interface (CLI)
# ==============================================================================
set -euo pipefail

# sync.sh records the clone location here; fall back to the repo this file is in.
REPO_DIR=""
[[ -f "$HOME/.config/mk-workstation/repo-path" ]] && REPO_DIR=$(< "$HOME/.config/mk-workstation/repo-path")
[[ -d "$REPO_DIR/.git" ]] || REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -d "$REPO_DIR/.git" ]]; then
    echo "[-] Error: Can't find the MK Workstation repo. Run ./sync.sh from your clone once." >&2
    exit 1
fi

# The name from brand.conf (yours, then the installed default): `mk rename`.
brand_name() {
    local file name
    for file in "$HOME/.config/mk-workstation/brand.conf" "$HOME/.local/share/mk-workstation/config/brand.conf"; do
        name=$(sed -n 's/^NAME=//p' "$file" 2>/dev/null | head -n 1)
        [[ -n "$name" ]] && { echo "$name"; return; }
    done
    echo "MK Workstation"
}

updates_available() {
    if ! git -C "$REPO_DIR" rev-parse --abbrev-ref '@{u}' &>/dev/null; then
        echo "[-] The repo's current branch doesn't track a remote branch; can't check for updates." >&2
        exit 1
    fi
    git -C "$REPO_DIR" fetch --quiet
    [[ "$(git -C "$REPO_DIR" rev-parse HEAD)" != "$(git -C "$REPO_DIR" rev-parse '@{u}')" ]]
}

case "${1:-help}" in
    update)
        # One command keeps everything current: the repo, any app added to
        # apps/*.txt, desktop settings and extensions, then system updates.
        #   mk update --check       show what would happen, change nothing
        #   mk update --no-upgrade  skip the dnf/Flatpak system upgrade
        shift
        CHECK_ONLY=0
        UPGRADE=1
        for arg in "$@"; do
            case "$arg" in
                --check) CHECK_ONLY=1 ;;
                --no-upgrade) UPGRADE=0 ;;
                *) echo "[-] Unknown option: $arg" >&2; exit 2 ;;
            esac
        done

        echo "==> 1/4 MK Workstation repo"
        if ! git -C "$REPO_DIR" rev-parse --abbrev-ref '@{u}' &>/dev/null; then
            echo "    [*] Branch doesn't track a remote branch; using the local copy."
        elif ! git -C "$REPO_DIR" diff --quiet || ! git -C "$REPO_DIR" diff --cached --quiet; then
            echo "    [*] You have uncommitted changes; skipping the pull (run 'mk save' first)."
        elif updates_available; then
            if (( CHECK_ONLY )); then
                echo "    New version available: $(git -C "$REPO_DIR" log --oneline HEAD..'@{u}' | wc -l) new commit(s)."
            else
                git -C "$REPO_DIR" pull --ff-only
            fi
        else
            echo "    ✔ Up to date ($(git -C "$REPO_DIR" rev-parse --short HEAD))"
        fi

        echo "==> 2/4 Apps from apps/dnf-packages.txt and apps/flatpaks.txt"
        mapfile -t missing < <("$REPO_DIR/bin/mk-apps" missing)
        if (( ${#missing[@]} == 0 )); then
            echo "    ✔ Everything in the app lists is installed."
        else
            printf '    + %s\n' "${missing[@]}"
        fi

        echo "==> 3/4 Desktop settings and extensions"
        if (( CHECK_ONLY )); then
            echo "    Would re-apply settings and install any missing extensions (mk sync)."
        elif (( ${#missing[@]} )); then
            # setup.sh installs what's missing and then runs sync.sh as you.
            echo "    Installing ${#missing[@]} new app(s); your password is needed."
            sudo "$REPO_DIR/setup.sh"
        else
            "$REPO_DIR/sync.sh"
        fi

        echo "==> 4/4 System and Flatpak updates"
        if (( !UPGRADE )); then
            echo "    Skipped (--no-upgrade)."
        elif (( CHECK_ONLY )); then
            echo "    Pending: $(dnf check-update --quiet 2>/dev/null | grep -cE '^[[:alnum:]]' || true) package(s), $(flatpak remote-ls --updates --columns=application 2>/dev/null | grep -c . || true) Flatpak(s)."
        else
            flatpak update -y --noninteractive
            sudo dnf upgrade --refresh -y
        fi

        if (( CHECK_ONLY )); then
            echo "Nothing was changed. Run 'mk update' to apply."
        else
            echo "✔ MK Workstation is up to date. Run 'mk doctor' for a health check."
        fi
        ;;

    save)
        # Capture what you've added yourself: new apps, extensions and settings.
        echo "==> Adding apps you installed yourself to apps/*.txt..."
        "$REPO_DIR/bin/mk-apps" capture
        echo "==> Saving extensions and settings..."
        "$REPO_DIR/scripts/update-repo.sh"
        git -C "$REPO_DIR" add apps config
        if git -C "$REPO_DIR" diff --cached --quiet -- apps config; then
            echo "✔ Nothing new to save."
        else
            git -C "$REPO_DIR" commit -q -m "chore(mk save): capture apps, extensions and settings" -- apps config
            echo "✔ Saved as a commit. Publish it with: git -C \"$REPO_DIR\" push"
        fi
        ;;

    check)
        if updates_available; then
            notify-send -i software-update-available "$(brand_name) update" "New performance updates are available. Run 'mk update' to apply."
        fi
        ;;

    sync|apply)
        echo "==> Applying MK desktop settings..."
        "$REPO_DIR/sync.sh"
        ;;

    export)
        echo "==> Exporting this machine's GNOME settings into the repo..."
        "$REPO_DIR/scripts/update-repo.sh"
        ;;

    restore)
        # Put back the desktop settings saved just before the last `mk sync`.
        BACKUP_DIR="$HOME/.config/mk-workstation/backups"
        snapshot="${2:-$(find "$BACKUP_DIR" -name 'dconf-*.ini' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n 1 | cut -d' ' -f2- || true)}"
        if [[ -z "$snapshot" || ! -s "$snapshot" ]] || ! grep -q '^\[' "$snapshot"; then
            echo "[-] No usable settings snapshot found in $BACKUP_DIR." >&2
            exit 1
        fi
        echo "This replaces ALL your GNOME settings with the snapshot:"
        echo "    $snapshot"
        read -rp "Continue? [y/N]: " answer
        [[ "$answer" =~ ^[yY] ]] || { echo "Nothing changed."; exit 0; }
        dconf reset -f /
        dconf load / < "$snapshot"
        echo "✔ Settings restored. Log out and back in to reload extensions."
        ;;

    doctor)
        "$HOME/.local/bin/mk-doctor"
        ;;

    face)
        shift
        sudo "$REPO_DIR/register-face.sh" "$@"
        ;;

    shortcuts|hud)
        "$HOME/.local/bin/show-shortcuts"
        ;;

    fingerprint)
        # mk fingerprint [enroll [FINGER] | list | delete | settings]
        shift
        if ! command -v fprintd-enroll &> /dev/null; then
            echo "[-] fprintd isn't installed. Run: sudo dnf install fprintd fprintd-pam" >&2
            exit 1
        fi
        case "${1:-enroll}" in
            enroll)
                finger="${2:-right-index-finger}"
                echo "Enrolling $finger. Lift and touch the sensor each time it asks (about 8-12 times),"
                echo "moving your finger slightly so the whole fingertip gets recorded."
                fprintd-enroll -f "$finger" "$USER"
                if ! authselect current 2> /dev/null | grep -q with-fingerprint; then
                    echo "[*] Fingerprint login is switched off system-wide. Turn it on with: sudo ./setup.sh"
                fi
                echo "✔ Done. Add another finger with: mk fingerprint enroll left-index-finger"
                echo "  Fingers: left-/right- thumb, index-finger, middle-finger, ring-finger, little-finger"
                ;;
            list) fprintd-list "$USER" ;;
            delete)
                read -rp "Delete ALL your enrolled fingerprints? [y/N]: " answer
                [[ "$answer" =~ ^[yY] ]] && fprintd-delete "$USER"
                ;;
            settings) gnome-control-center users ;;
            *)
                echo "Usage: mk fingerprint [enroll [FINGER] | list | delete | settings]" >&2
                exit 2
                ;;
        esac
        ;;

    welcome)
        # mk welcome [on | off | test | title sir|maam|name|none | greeting "TEXT"
        #             | voice on|off|install|remove | notify on|off | edit]
        shift
        WELCOME_CONF="$HOME/.config/mk-workstation/welcome.conf"
        VOICE="$HOME/.local/bin/mk-voice"
        set_welcome() {
            mkdir -p "$(dirname "$WELCOME_CONF")"
            touch "$WELCOME_CONF"
            if grep -q "^$1=" "$WELCOME_CONF"; then
                sed -i "s|^$1=.*|$1=$2|" "$WELCOME_CONF"
            else
                echo "$1=$2" >> "$WELCOME_CONF"
            fi
        }
        case "${1:-}" in
            on|off) set_welcome WELCOME "$1"; echo "✔ Welcome light $1" ;;
            title)
                case "${2:-}" in
                    sir|maam|name|none) set_welcome TITLE "$2"; "$VOICE" render > /dev/null; "$VOICE" status | head -n 1 ;;
                    *) echo "Usage: mk welcome title sir|maam|name|none" >&2; exit 2 ;;
                esac
                ;;
            greeting)
                [[ -n "${2:-}" ]] || { echo "Usage: mk welcome greeting \"Welcome back home, {title}.\"" >&2; exit 2; }
                set_welcome GREETING "${2//|/}"; "$VOICE" render > /dev/null; "$VOICE" status | head -n 1
                ;;
            voice)
                case "${2:-on}" in
                    on|off) set_welcome VOICE "${2:-on}"; echo "✔ Spoken greeting ${2:-on}"; [[ "${2:-on}" == on ]] && "$VOICE" render > /dev/null ;;
                    install) "$VOICE" install && set_welcome VOICE on ;;
                    remove) "$VOICE" remove ;;
                    *) echo "Usage: mk welcome voice on|off|install|remove" >&2; exit 2 ;;
                esac
                ;;
            notify) set_welcome EDGE_NOTIFY "${2:-on}"; echo "✔ Edge light for notifications ${2:-on}" ;;
            edit) setsid -f "$HOME/.local/bin/mk-companion" welcome > /dev/null 2>&1 ;;
            test)
                mkdir -p "$HOME/.cache/mk-workstation"
                date > "$HOME/.cache/mk-workstation/welcome-test"
                ;;
            *)
                echo "Usage: mk welcome [on | off | test | edit | title sir|maam|name|none"
                echo "                  | greeting \"TEXT\" | voice on|off|install|remove | notify on|off]"
                "$VOICE" status
                ;;
        esac
        ;;

    sound)
        shift
        "$HOME/.local/bin/mk-sound" "$@"
        ;;

    icon)
        # mk icon [APP IMAGE | APP reset | list]   APP: companion timer shortcuts camera ocr
        shift
        ICONS="$HOME/.config/mk-workstation/icons"
        apps="companion timer shortcuts camera ocr"
        case "${1:-list}" in
            list)
                echo "Apps: $apps"
                for a in $apps; do
                    custom="MK icon"
                    for ext in svg png; do
                        [[ -f "$ICONS/$a.$ext" ]] && custom="$ICONS/$a.$ext"
                    done
                    echo "  $a: $custom"
                done
                echo "Change one: mk icon companion ~/Pictures/my-icon.png   (SVG or PNG, square works best)"
                ;;
            *)
                if [[ " $apps " != *" $1 "* ]]; then
                    echo "[-] Unknown app '$1'. Apps: $apps" >&2
                    exit 2
                fi
                mkdir -p "$ICONS"
                rm -f "$ICONS/$1.svg" "$ICONS/$1.png"
                if [[ "${2:-}" == reset ]]; then
                    echo "✔ $1 is back to the MK icon"
                elif [[ -f "${2:-}" ]]; then
                    case "${2,,}" in
                        *.svg) cp "$2" "$ICONS/$1.svg" ;;
                        *.png) cp "$2" "$ICONS/$1.png" ;;
                        *) echo "[-] Use an SVG or PNG image" >&2; exit 2 ;;
                    esac
                    echo "✔ New icon for $1"
                else
                    echo "Usage: mk icon $1 IMAGE.png|IMAGE.svg   or   mk icon $1 reset" >&2
                    exit 2
                fi
                "$REPO_DIR/sync.sh" > /dev/null && echo "  Applied (the dock may need a moment to refresh)."
                ;;
        esac
        ;;

    device)
        PYTHONPATH="$HOME/.local/share/mk-workstation/lib" python3 -m mkworkstation device
        ;;

    note|task|list)
        # Quick capture into the Companion: mk note "idea" · mk task "pay rent" 18:00
        PYTHONPATH="$HOME/.local/share/mk-workstation/lib" python3 -m mkworkstation "$@"
        ;;

    remind)
        # mk remind "stand up and stretch" 45m  (a task with a reminder)
        shift
        if (( $# < 2 )); then
            echo "Usage: mk remind \"text\" WHEN   (WHEN: 30m, 2h, 18:00, 6pm, 'tomorrow 9:00')" >&2
            exit 2
        fi
        PYTHONPATH="$HOME/.local/share/mk-workstation/lib" python3 -m mkworkstation task "$@"
        ;;

    focus)
        # mk focus [25 | 1:30 | 90s] ["label"]: start the focus timer in the background
        shift
        setsid -f "$HOME/.local/bin/mk-timer" "${1:-25}" "${@:2}" > /dev/null 2>&1
        length="${1:-25}"
        [[ "$length" =~ ^[0-9]+$ ]] && length="$length min"
        echo "✔ Focus timer started: $length${2:+ · $2}. Run mk-timer to see the countdown."
        ;;

    power)
        # Smart power profiles on laptops: mk power [status | on | off]
        shift
        case "${1:-status}" in
            status)
                if [[ -x "$HOME/.local/bin/mk-power" ]]; then
                    "$HOME/.local/bin/mk-power" status
                fi
                echo "Service: $(systemctl --user is-active mk-power.service 2>/dev/null || true)  (mk power on | off)"
                ;;
            on)
                rm -f "$HOME/.config/mk-workstation/power-off"
                "$REPO_DIR/sync.sh" > /dev/null
                echo "✔ Smart power on: $(systemctl --user is-active mk-power.service 2>/dev/null || true)"
                ;;
            off)
                mkdir -p "$HOME/.config/mk-workstation"
                touch "$HOME/.config/mk-workstation/power-off"
                systemctl --user disable --now mk-power.service &>/dev/null || true
                echo "✔ Smart power off. Pick profiles yourself in Quick Settings."
                ;;
            *)
                echo "Usage: mk power [status | on | off]" >&2
                exit 2
                ;;
        esac
        ;;

    effects)
        # full: every effect · lite: blur, window effects and genie off · auto: lite on weak hardware
        shift
        EFFECTS_FILE="$HOME/.config/mk-workstation/effects"
        case "${1:-}" in
            full|lite|auto)
                mkdir -p "$(dirname "$EFFECTS_FILE")"
                echo "$1" > "$EFFECTS_FILE"
                echo "==> Effects: $1. Applying..."
                "$REPO_DIR/sync.sh" | grep -E "Effects|✔|log out" || true
                ;;
            "")
                echo "Effects: $(cat "$EFFECTS_FILE" 2>/dev/null || echo auto)   (mk effects full | lite | auto)"
                ;;
            *)
                echo "Usage: mk effects full | lite | auto" >&2
                exit 2
                ;;
        esac
        ;;

    rename)
        # Rename the MK windows, notifications and top-bar tag on this computer.
        shift
        if [[ $# -lt 1 || -z "$1" ]]; then
            echo "Usage: mk rename \"Name\" [TAG]    (now: $(brand_name))" >&2
            exit 2
        fi
        # Default tag: the name's initials, e.g. "Riya's Desk" -> RD
        tag="${2:-$(awk '{ for (i = 1; i <= NF && i <= 3; i++) printf toupper(substr($i, 1, 1)) }' <<< "$1")}"
        mkdir -p "$HOME/.config/mk-workstation"
        printf '# Your name for MK Workstation (mk rename, or the Companion'"'"'s menu).\nNAME=%s\nSHORT=%s\n' \
            "$1" "${tag:0:6}" > "$HOME/.config/mk-workstation/brand.conf"
        echo "✔ Renamed to \"$1\" (top bar: ${tag:0:6}). Open windows update the next time they open."
        ;;

    uninstall)
        # Remove everything MK added to your account. Settings snapshots in
        # ~/.config/mk-workstation/backups are kept so you can still restore.
        echo "This removes the MK tools, daily update check, login helper, mk-* shortcuts"
        echo "and the MK top-bar extension from your account. Apps and system changes stay."
        read -rp "Continue? [y/N]: " answer
        [[ "$answer" =~ ^[yY] ]] || { echo "Nothing changed."; exit 0; }

        systemctl --user disable --now mk-update-check.timer mk-reminders.timer mk-power.service &>/dev/null || true
        rm -f "$HOME/.config/systemd/user/mk-power.service" "$HOME/.config/autostart/mk-sound.desktop"
        rm -f "$HOME"/.local/share/applications/io.github.mehulk.Mk*.desktop \
            "$HOME"/.local/share/icons/hicolor/*/apps/io.github.mehulk.Mk*
        [[ -f "$HOME/.config/gtk-4.0/gtk.css" ]] && python3 -c 'import re,sys; p=sys.argv[1]; t=open(p).read(); open(p,"w").write(re.sub(r"\n*/\* >>> MK Workstation.*?/\* <<< MK Workstation \*/\n?", "\n", t, flags=re.S).lstrip("\n"))' "$HOME/.config/gtk-4.0/gtk.css"
        rm -f "$HOME/.config/systemd/user/"mk-update-check.{service,timer} "$HOME/.config/systemd/user/"mk-reminders.{service,timer}
        systemctl --user daemon-reload &>/dev/null || true
        rm -f "$HOME/.config/burn-my-windows/profiles/mk-glide.conf"

        MEDIA_KEYS="org.gnome.settings-daemon.plugins.media-keys"
        kept=()
        while IFS= read -r path; do
            if [[ "$path" == */mk-*/ ]]; then
                dconf reset -f "$path"
            else
                kept+=("'$path'")
            fi
        done < <(gsettings get "$MEDIA_KEYS" custom-keybindings | grep -oE "'[^']+'" | tr -d "'")
        if (( ${#kept[@]} )); then
            (IFS=,; gsettings set "$MEDIA_KEYS" custom-keybindings "[${kept[*]}]")
        else
            gsettings set "$MEDIA_KEYS" custom-keybindings "@as []"
        fi

        gnome-extensions disable mk-indicator@mehulk &>/dev/null || true
        rm -rf "$HOME/.local/share/gnome-shell/extensions/mk-indicator@mehulk"
        rm -rf "$HOME/.local/share/mk-workstation/lib" "$HOME/.local/share/mk-workstation/config" "$HOME/.local/share/mk-workstation/assets"
        for tool in mk mk-apps mk-doctor mk-session mk-scratchpad mk-companion mk-timer mk-reminders mk-power mk-voice mk-sound ocr-snip show-shortcuts \
            camera-controls fix-alt-tab close-workspace-apps; do
            rm -f "$HOME/.local/bin/$tool"
        done
        rm -f "$HOME/.config/mk-workstation/repo-path"

        echo "✔ MK Workstation removed from your account."
        echo "  To restore your desktop as it was before MK, run this and log out and back in:"
        echo "    dconf reset -f / && dconf load / < ~/.config/mk-workstation/backups/original-dconf.ini"
        echo "  System-wide parts (apps, repos, face unlock, dnf.conf) are covered in docs/GUIDE.md › Undo and uninstall."
        ;;

    *)
        echo "MK Workstation CLI"
        echo "Usage: mk <command>"
        echo ""
        echo "Commands:"
        echo "  update     Update everything: repo, new apps, settings, extensions, system (--check to preview)"
        echo "  save       Capture apps, extensions and settings you added into the repo (commits locally)"
        echo "  check      Show a notification if updates are available"
        echo "  sync       Re-apply MK desktop settings (shortcuts, extensions, tweaks)"
        echo "  export     Save this machine's GNOME settings into the repo (for your fork)"
        echo "  restore    Undo the last sync: restore the settings snapshot it saved"
        echo "  doctor     Check system health: updates, codecs, extensions, face unlock"
        echo "  face       Set up face unlock (add --models N or --user NAME)"
        echo "  shortcuts  Keyboard shortcuts: see, change, add or reset them (also Super+/)"
        echo "  note       Add a note to the Companion: mk note \"idea\" [when]"
        echo "  task       Add a task: mk task \"pay rent\" [when]   (when: 30m, 2h, 18:00, tomorrow 9:00)"
        echo "  remind     Same as task, with a reminder: mk remind \"stretch\" 45m"
        echo "  list       Show notes, tasks and their reminders"
        echo "  welcome    Welcome after login: on, off, test, edit, title, greeting, voice (install), notify"
        echo "  sound      Laptop speaker tuning (EasyEffects profile): on, off, status"
        echo "  icon       Use your own image as an MK app icon: mk icon companion ~/me.png"
        echo "  device     What this computer has, and what MK tunes for it"
        echo "  fingerprint  Enroll a finger for login and sudo (list, delete, settings)"
        echo "  focus      Start the focus timer: mk focus 25 \"Writing\" (also 1:30, 90s)"
        echo "  power      Smart power profiles on laptops: status, on, off"
        echo "  effects    Visual effects: full, lite (smooth on older machines) or auto"
        echo "  rename     Rename MK's windows and top-bar tag: mk rename \"My Desk\" MD"
        echo "  uninstall  Remove MK tools, shortcuts and helpers from your account"
        ;;
esac
