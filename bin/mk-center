#!/usr/bin/env python3
"""MK Control Center: the MK tools in one window.

  mk-center [home | actions | lock | security]   (also: mk center, mk hub, the app grid)

Actions: every mk command as a card, by category, with a search box; star
the ones you use most and they stay on top (~/.config/mk-workstation/hub-pins).
Home: quick actions (free memory, vault, text from screen, speed test), power
modes, App Nap, and the desktop tools. MK Lock: lock apps with a switch, lock
and open folders and the vault, lock notebooks of MK Notes. Security: run the
security check and apply its fixes.

Everything here calls the same tools as the mk command (mk-lock, mk-security,
mk power...), so the terminal and this window always agree.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "io.github.mehulk.MkCenter"
HOME = Path.home()
BIN = HOME / ".local/bin"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "mk-workstation"
NOTES = HOME / "Notes"
PROFILES = ("org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles",
            "org.freedesktop.UPower.PowerProfiles")
CSS = b"""
.mk-action { padding: 18px 10px; border-radius: 16px; }
.mk-action image { -gtk-icon-size: 28px; }
.mk-report { font-family: monospace; font-size: 0.92em; }
.mk-card { padding: 12px 14px; border-radius: 14px; }
.mk-card .title { font-weight: 700; }
.mk-card .subtitle { font-size: 0.88em; opacity: 0.7; }
"""
PINS = CONFIG / "hub-pins"
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def tool(name):
    """An MK tool: installed copy first, then the one next to this file."""
    for candidate in (BIN / name, Path(__file__).resolve().parent / name):
        if candidate.exists():
            return str(candidate)
    return name


def run_bg(argv, done=None):
    """Run ARGV off the main loop; DONE(returncode, output) back on it."""
    def work():
        try:
            p = subprocess.run(argv, capture_output=True, text=True, timeout=600)
            result = (p.returncode, p.stdout + p.stderr)
        except (OSError, subprocess.SubprocessError) as e:
            result = (1, str(e))
        if done:
            GLib.idle_add(lambda: (done(*result), False)[1])
    threading.Thread(target=work, daemon=True).start()


def terminal(command):
    """argv that runs COMMAND (a shell line) in the desktop's terminal and
    keeps it open until Enter: Ptyxis (Fedora 41+), Console, or GNOME Terminal."""
    line = f"{command}; read -rp 'Press Enter to close'"
    for term, flag in (("ptyxis", "--"), ("kgx", "--"), ("gnome-terminal", "--")):
        if shutil.which(term):
            return [term, flag, "bash", "-c", line]
    return ["xdg-terminal-exec", "bash", "-c", line]


def mk(*args):
    return [tool("mk"), *args]


# The Actions page: (id, category, icon, title, what it does, how it runs).
# How: ("bg", argv) runs quietly and shows the last line it prints; ("show",
# argv) shows all of its output; ("term", "mk ...") needs a terminal (sudo or
# questions); ("page", name) opens another page of this window.
CATEGORIES = ("Performance", "Security & Vault", "Biometrics & Lock", "Screensavers & Wallpapers",
