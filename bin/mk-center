def read_list(name):
    try:
        return [x.strip() for x in (CONFIG / name).read_text().splitlines() if x.strip() and not x.startswith("#")]
    except OSError:
        return []


def is_open(path):
    return os.path.ismount(path)


def load_css():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                              Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


class Center(Adw.ApplicationWindow):
    def __init__(self, app, page="home"):
        super().__init__(application=app, title="MK Control Center", default_width=980, default_height=760)
        load_css()
        self.toast = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        head = Adw.HeaderBar()
        self.stack = Adw.ViewStack()
        self.stack.add_titled_with_icon(self._home(), "home", "Home", "go-home-symbolic")
        self.stack.add_titled_with_icon(self._actions(), "actions", "Actions", "view-grid-symbolic")
        self.stack.add_titled_with_icon(self._lock(), "lock", "MK Lock", "changes-prevent-symbolic")
        self.stack.add_titled_with_icon(self._security(), "security", "Security", "security-high-symbolic")
        head.set_title_widget(Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        view.add_top_bar(head)
        self.toast.set_child(self.stack)
        view.set_content(self.toast)
        self.set_content(view)
        self.stack.set_visible_child_name(page)

    def say(self, text):
        self.toast.add_toast(Adw.Toast(title=text, timeout=3))

    # ---------------------------------------------------------------- home
    def _home(self):
        page = Adw.PreferencesPage()
        quick = Adw.PreferencesGroup(title="Quick actions")
        grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
        # Free memory lives in the top bar's monitor menu, text from the
        # screen on Super+Shift+C: not repeated here.
        actions = [("changes-prevent-symbolic", "Vault", lambda: run_bg([tool("mk-lock"), "vault"],
                                                                        lambda c, o: self.say("Vault: " + (o.strip().splitlines() or ["done"])[-1].strip("✔ ")))),
                   ("network-wireless-signal-excellent-symbolic", "Speed test",
                    lambda: run_bg([tool("mk-speedtest"), "--gui", "--start"])),
                   ("preferences-desktop-wallpaper-symbolic", "Live wallpaper", lambda: self._toggle_live_wallpaper()),
                   ("accessories-text-editor-symbolic", "Quick scratchpad", lambda: run_bg([tool("mk-scratchpad")])),
                   ("weather-clear-night-symbolic", "Distraction-free",
                    lambda: run_bg(mk("exam"), lambda c, o: self.say((o.strip().splitlines() or ["Done"])[-1]))),
                   ("utilities-system-monitor-symbolic", "System health",
                    lambda: run_bg(terminal(f"{shlex.quote(tool('mk'))} doctor")))]
        for i, (icon, label, cb) in enumerate(actions):
            b = Gtk.Button(css_classes=["card", "mk-action"])
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            box.append(Gtk.Image(icon_name=icon))
            box.append(Gtk.Label(label=label))
            b.set_child(box)
            b.connect("clicked", lambda _b, c=cb: c())
            grid.attach(b, i % 3, i // 3, 1, 1)
        quick.add(grid)
        page.add(quick)

        # Power modes live in GNOME's Quick Settings (top right): not repeated here.
        power = Adw.PreferencesGroup(title="Performance")
        nap = Adw.ActionRow(title="App Nap", subtitle=self._nap_text())
        power.add(nap)
        page.add(power)

        desk = Adw.PreferencesGroup(title="Desktop")
        conf = saver_conf.conf()
        self.live_row = Adw.SwitchRow(title="Live wallpaper",
                                      subtitle="A screensaver scene behind your windows; pauses when a window fills the screen",
                                      active=conf.get("LIVE_WALLPAPER", "off") == "on")
        self.live_row.connect("notify::active", lambda r, _p: saver_conf.set_conf("LIVE_WALLPAPER", "on" if r.get_active() else "off"))
        desk.add(self.live_row)
        scenes = ["aurora", "web", "knight", "matrix"]
        names = ["Aurora", "Web Hang", "Night Watch", "Terminal Stream"]
        scene_row = Adw.ComboRow(title="Live wallpaper scene", model=Gtk.StringList.new(names))
        current = conf.get("LIVE_SCENE", "aurora")
        scene_row.set_selected(scenes.index(current) if current in scenes else 0)
        scene_row.connect("notify::selected", lambda r, _p: saver_conf.set_conf("LIVE_SCENE", scenes[r.get_selected()]))
        desk.add(scene_row)
        for title, sub, argv in (("Screensaver", "Pick a scene or shuffle; the lock screen too", [tool("mk-screensaver"), "settings"]),
                                 ("Keyboard shortcuts", "Every shortcut and gesture, live", [tool("show-shortcuts")]),
                                 ("Photo Booth", "Your webcam with live looks and stickers", [tool("camera-controls")]),
                                 ("Tour", "The walkthrough again", [tool("mk-tour")]),
                                 ("Health check", "mk doctor, in a terminal", terminal(f"{shlex.quote(tool('mk'))} doctor")),
                                 ("Update everything", "mk update, in a terminal", terminal(f"{shlex.quote(tool('mk'))} update"))):
            r = Adw.ActionRow(title=title, subtitle=sub, activatable=True)
            r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            r.connect("activated", lambda _r, a=argv: run_bg(a))
            desk.add(r)
        page.add(desk)
        return page

    def _toggle_live_wallpaper(self):
        self.live_row.set_active(not self.live_row.get_active())
        self.say("Live wallpaper " + ("on" if self.live_row.get_active() else "off"))

    # ---------------------------------------------------------------- actions
    def _actions(self):
        self.pins = read_list(PINS.name)
        self.cards = {}
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                      margin_top=18, margin_bottom=24, margin_start=24, margin_end=24)
        self.action_search = Gtk.SearchEntry(placeholder_text="Find an action…", hexpand=True)
        self.action_search.connect("search-changed", lambda *_: self._fill_actions())
        box.append(self.action_search)
        self.action_groups = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.action_groups)
        self._fill_actions()
        clamp = Adw.Clamp(maximum_size=1000, child=box)
        return Gtk.ScrolledWindow(child=clamp, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)

    def _fill_actions(self):
        while child := self.action_groups.get_first_child():
            self.action_groups.remove(child)
        query = self.action_search.get_text().strip().lower()
        shown = [a for a in ACTIONS if not query or query in f"{a[1]} {a[3]} {a[4]}".lower()]
        pinned = [a for pin in self.pins for a in shown if a[0] == pin]
        sections = ([("Pinned", pinned)] if pinned else []) + \
            [(c, [a for a in shown if a[1] == c]) for c in CATEGORIES]
        for title, actions in sections:
            if not actions:
                continue
            self.action_groups.append(Gtk.Label(label=title, xalign=0, css_classes=["heading"]))
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                               min_children_per_line=2, max_children_per_line=4,
                               column_spacing=10, row_spacing=10)
            for action in actions:
                flow.append(self._card(action))
            self.action_groups.append(flow)
        if not shown:
            self.action_groups.append(Adw.StatusPage(icon_name="edit-find-symbolic", title="No action matches"))

    def _card(self, action):
        ident, cat, icon, title, sub, _how = action
        row = Gtk.Box(spacing=12)
        row.append(Gtk.Image(icon_name=icon, pixel_size=24, valign=Gtk.Align.CENTER))
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        text.append(Gtk.Label(label=title, xalign=0, css_classes=["title"], ellipsize=3))
        text.append(Gtk.Label(label=sub, xalign=0, css_classes=["subtitle"], wrap=True, lines=2, ellipsize=3))
        row.append(text)
        button = Gtk.Button(child=row, css_classes=["card", "mk-card", f"mk-cat-{CATEGORY_COLOUR[cat]}"], hexpand=True)
        button.connect("clicked", lambda b: (self._pulse(b), self._run_action(action)))
        star = Gtk.Button(icon_name="starred-symbolic" if ident in self.pins else "non-starred-symbolic",
                          css_classes=["flat", "circular"], valign=Gtk.Align.CENTER,
                          tooltip_text="Unpin" if ident in self.pins else "Pin to the top")
        star.connect("clicked", lambda _b: self._toggle_pin(ident))
        outer = Gtk.Box(spacing=4)
        outer.append(button)
        outer.append(star)
        return outer

    def _pulse(self, widget):
        """A quick dip and back in opacity: the card was clicked."""
        target = Adw.CallbackAnimationTarget.new(lambda v: widget.set_opacity(1 - 0.35 * math.sin(v * math.pi)))
        Adw.TimedAnimation.new(widget, 0, 1, 260, target).play()

    def _toggle_pin(self, ident):
        self.pins = [p for p in self.pins if p != ident] if ident in self.pins else self.pins + [ident]
        CONFIG.mkdir(parents=True, exist_ok=True)
        PINS.write_text("".join(f"{p}\n" for p in self.pins))
        self._fill_actions()

    def _run_action(self, action):
        _id, _cat, _icon, title, _sub, (how, what) = action
        if how == "page":
            self.stack.set_visible_child_name(what)
        elif how == "dialog":
            (self._face_dialog if what == "face" else self._finger_dialog)()
        elif how == "term":
            mk_cmd = shlex.quote(tool("mk"))
            run_bg(terminal(mk_cmd + what[2:] if what.startswith("mk ") else what))
        elif how == "show":
            run_bg(what, lambda _c, out: self._show_output(title, out))
        else:
            self.say(f"{title}…")
            run_bg(what, lambda c, out: self.say(
                (ANSI.sub("", out).strip().splitlines() or [title + (" done" if c == 0 else " failed")])[-1].strip("✔ ")))

    def _show_output(self, title, out):
        label = Gtk.Label(label=ANSI.sub("", out).strip() or "(nothing)", xalign=0, selectable=True,
                          wrap=True, css_classes=["mk-report"])
        dialog = Adw.AlertDialog(heading=title)
        dialog.set_extra_child(Gtk.ScrolledWindow(child=label, min_content_height=200, max_content_height=440,
                                                  propagate_natural_height=True))
        dialog.add_response("close", "Close")
        dialog.present(self)

    def _nap_text(self):
        try:
            napping = json.loads((Path(GLib.get_user_cache_dir()) / "mk-workstation/app-nap.json").read_text())
        except (OSError, ValueError):
            napping = {}
        if napping:
            return "Paused now: " + ", ".join(k.removesuffix(".desktop") for k in napping)
        return "Pauses apps you left minimized when memory runs short; nothing is paused now"

    # ---------------------------------------------------------------- MK Lock
    def _lock(self):
        tabs = Adw.ViewStack()
        tabs.add_titled_with_icon(self._lock_apps(), "apps", "Apps", "view-app-grid-symbolic")
        tabs.add_titled_with_icon(self._lock_folders(), "folders", "Folders & Vault", "folder-symbolic")
        tabs.add_titled_with_icon(self._lock_notes(), "notes", "Notes", "accessories-text-editor-symbolic")
        tabs.add_titled_with_icon(self._lock_biometrics(), "biometrics", "Face & Fingerprint", "camera-web-symbolic")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        bar = Adw.ViewSwitcher(stack=tabs, policy=Adw.ViewSwitcherPolicy.WIDE, halign=Gtk.Align.CENTER,
                               margin_top=6)
        box.append(bar)
        tabs.set_vexpand(True)
        box.append(tabs)
        return box

    def _lock_apps(self):
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(title="Lock apps",
                                     description="A locked app asks for your fingerprint, face or password before it "
                                                 "starts from the app grid, dock or search.")
        search = Gtk.SearchEntry(placeholder_text="Search apps", margin_bottom=8)
        group.set_header_suffix(search)
        locked = set(read_list("locked-apps"))
        rows = []
        apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show() and a.get_id()),
                      key=lambda a: a.get_display_name().lower())
        seen = set()
        for app in apps:
            app_id = app.get_id().removesuffix(".desktop")
            if app_id in seen:
                continue
            seen.add(app_id)
            row = Adw.SwitchRow(title=app.get_display_name(), subtitle=app_id, active=app_id in locked)
            icon = app.get_icon()
            row.add_prefix(Gtk.Image(gicon=icon, pixel_size=32) if icon else Gtk.Image(icon_name="application-x-executable"))
            row.connect("notify::active", self._toggle_app, app_id)
            group.add(row)
            rows.append((row, f"{app.get_display_name()} {app_id}".lower()))

        def filter_rows(entry):
            q = entry.get_text().lower()
            for row, text in rows:
                row.set_visible(q in text)
        search.connect("search-changed", filter_rows)
        page.add(group)
        return page

    def _toggle_app(self, row, _param, app_id):
        """Locking or unlocking an app asks who you are first (face,
        fingerprint or password, MK's unlock window); a confirmation lasts
        two minutes. Not confirmed: the switch goes back."""
        if getattr(self, "_reverting", False):
            return
        want = row.get_active()

        def apply():
            self._lock_ok_until = time.monotonic() + 120
            run_bg([tool("mk-lock"), "app", "add" if want else "remove", app_id],
                   lambda c, o: self.say((o.strip().splitlines() or ["Done"])[-1].strip("✔[-] ")))

        if time.monotonic() < getattr(self, "_lock_ok_until", 0):
            apply()
            return
        self._reverting = True
        row.set_active(not want)   # until it's confirmed
        self._reverting = False
        done = []

        def confirmed():
            done.append(True)
            self._reverting = True
            row.set_active(want)
            self._reverting = False
            apply()
        dialog = auth.UnlockDialog("Confirm it's you", None, confirmed)
        dialog.connect("closed", lambda *_: done or self.say("Not confirmed; the lock didn't change"))
        dialog.present(self)

    def _lock_folders(self):
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(title="Locked folders",
                                     description="Encrypted on disk; open after your fingerprint, face or password. "
                                                 "They close when the screen locks. Drop a folder here to lock it.")
        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="Lock a folder", css_classes=["flat"])
        add.connect("clicked", lambda *_: self._pick_folder())
        group.set_header_suffix(add)
        self.folder_group = group
        self.folder_rows = []
        self._fill_folders()
        page.add(group)
        vault = Adw.PreferencesGroup(title="Vault", description="A hidden encrypted folder of your own (~/.vault).")
        vrow = Adw.ActionRow(title="Open or close the vault", activatable=True)
        vrow.add_suffix(Gtk.Image(icon_name="changes-prevent-symbolic"))
        vrow.connect("activated", lambda *_: run_bg([tool("mk-lock"), "vault"], lambda c, o: self._fill_folders()))
        vault.add(vrow)
        allrow = Adw.ActionRow(title="Lock all now", subtitle="Close every open locked folder and the vault",
                               activatable=True)
        allrow.add_suffix(Gtk.Image(icon_name="system-lock-screen-symbolic"))
        allrow.connect("activated", lambda *_: run_bg([tool("mk-lock"), "close-all"],
                                                      lambda c, o: (self._fill_folders(), self.say("Everything is locked"))))
        vault.add(allrow)
        page.add(vault)
        drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
        drop.connect("drop", lambda _t, value, *_: [self._lock_folder(f.get_path()) for f in value.get_files()
                                                     if f.get_path() and os.path.isdir(f.get_path())] or True)
        page.add_controller(drop)
        return page

    def _fill_folders(self):
        for row in self.folder_rows:
            self.folder_group.remove(row)
        self.folder_rows = []
        for folder in read_list("locked-folders"):
            row = Adw.SwitchRow(title=Path(folder).name, subtitle=folder, active=is_open(folder))
            row.add_prefix(Gtk.Image(icon_name="folder-open-symbolic" if is_open(folder) else "folder-symbolic"))
            row.set_tooltip_text("On: open (decrypted) · Off: closed")
            row.connect("notify::active", lambda r, _p, f=folder: run_bg(
                [tool("mk-lock"), "folder", "open" if r.get_active() else "close", f],
                lambda c, o: (self._fill_folders(), c and self.say((o.strip().splitlines() or ["Failed"])[-1]))))
            self.folder_group.add(row)
            self.folder_rows.append(row)
        if not self.folder_rows:
            empty = Adw.ActionRow(title="No locked folders yet", subtitle="Use + or drop a folder here")
            self.folder_group.add(empty)
            self.folder_rows.append(empty)

    def _pick_folder(self):
        def chosen(d, res):
            try:
                folder = d.select_folder_finish(res)
            except GLib.Error:
                return
            self._lock_folder(folder.get_path())
        Gtk.FileDialog(title="Lock a folder").select_folder(self, None, chosen)

    def _lock_folder(self, path):
        self.say(f"Encrypting {Path(path).name}…")
        run_bg([tool("mk-lock"), "folder", "add", path],
               lambda c, o: (self._fill_folders(), self.say((o.strip().splitlines() or ["Done"])[-1].strip("✔[-] "))))

    # ---------------------------------------------------------------- face and fingerprint
    def _lock_biometrics(self):
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(title="Sign in with your face or finger",
                                     description="New faces are added next to the ones you have; nothing is "
                                                 "cleared. Each face or finger is recorded once.")
        for title, sub, icon, fn in (
                ("Add a face", "You, or a guest such as a hackathon judge: then try it at once",
                 "camera-web-symbolic", self._face_dialog),
                ("Enroll a finger", "You or someone else; asks which finger, never the same one twice",
                 "auth-fingerprint-symbolic", self._finger_dialog),
                ("Full face setup", "Camera, light and several looks (in a terminal: it asks questions)",
                 "utilities-terminal-symbolic", lambda: run_bg(terminal(f"{shlex.quote(tool('mk'))} face"))),
                ("Try Face ID", "The unlock window MK's apps use", "security-high-symbolic", self._try_face)):
            row = Adw.ActionRow(title=title, subtitle=sub, activatable=True)
            row.add_prefix(Gtk.Image(icon_name=icon))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated", lambda _r, f=fn: f())
            group.add(row)
        page.add(group)
        return page

    def _try_face(self):
        dialog = auth.UnlockDialog("Try Face ID", None, lambda: self.say("Face ID: it's you ✓"))
        dialog.present(self)

    def _face_dialog(self):
        """Record one face model for this account: yours (primary) or a
        guest's (a judge at a demo), named so it's never recorded twice."""
        dlg = Adw.AlertDialog(heading="Add a face",
                              body="Sit about an arm's length from the camera, facing the light.")
        box = Adw.PreferencesGroup()
        who = Adw.ComboRow(title="Enroll for", model=Gtk.StringList.new(["You (primary)", "Guest"]))
        name = Adw.EntryRow(title="Name of this face model", text="primary_model")
        who.connect("notify::selected", lambda r, _p: name.set_text(["primary_model", "guest"][r.get_selected()]))
        box.add(who)
        box.add(name)
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label", "caption"],
                         label="A guest's face unlocks YOUR account (login, sudo, locked apps). "
                               "Remove it after the demo with Remove this model.")
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        holder.append(box)
        holder.append(note)
        dlg.set_extra_child(holder)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("remove", "Remove this model")
        dlg.add_response("record", "Record")
        dlg.set_response_appearance("record", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("record")

        def answered(_d, response):
            label = name.get_text().strip()
            if response not in ("record", "remove") or not label:
                return
            if not shutil.which("howdy"):
                self.say("Face unlock needs Howdy: run ./setup.sh (it installs it)")
                return
            # Howdy itself (sudo howdy add) in a terminal: you see what it
            # does and answer its questions (replace? close the camera app?).
            cmd = f"{shlex.quote(tool('mk-face-add'))} {shlex.quote(label)}" + (" --remove" if response == "remove" else "")
            run_bg(terminal(cmd, "Face Enrollment"))
            self.say("Face enrollment is in the terminal window; then use Try Face ID")
        dlg.connect("response", answered)
        dlg.present(self)

    def _finger_dialog(self):
        """Enroll a finger with fprintd, in this window: who and which finger;
        a finger that's already enrolled is only scanned again if you say so."""
        if not shutil.which("fprintd-enroll"):
            self.say("fprintd isn't installed: sudo dnf install fprintd fprintd-pam")
            return
        dlg = Adw.Dialog(title="Enroll a finger", content_width=420)
        box = Adw.PreferencesGroup(description="Lift and touch the reader until it's done.")
        who = Adw.ComboRow(title="Enroll for", model=Gtk.StringList.new(["You (primary)", "Someone else"]))
        user = Adw.EntryRow(title="Their account name", visible=False)
        who.connect("notify::selected", lambda r, _p: user.set_visible(r.get_selected() == 1))
        finger = Adw.ComboRow(title="Finger", model=Gtk.StringList.new([f[0] for f in FINGERS]))
        for row in (who, user, finger):
            box.add(row)
        self.enrolled = Adw.PreferencesGroup(title="Enrolled fingers")
        self.enroll_ring = FingerRing()
        self.enroll_pill = Gtk.Label(visible=False, css_classes=["mk-warn-pill"], halign=Gtk.Align.CENTER)
        self.enroll_text = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"])
        start = Gtk.Button(label="Enroll", css_classes=["pill", "suggested-action"], halign=Gtk.Align.CENTER)
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=18,
                         margin_start=18, margin_end=18)
        holder.append(box)
        holder.append(self.enrolled)
        holder.append(self.enroll_ring)
        holder.append(self.enroll_pill)
        holder.append(self.enroll_text)
        holder.append(start)
        view = Adw.ToolbarView(content=holder)
        view.add_top_bar(Adw.HeaderBar())
        dlg.set_child(view)

        def enroll(_b):
            account = user.get_text().strip() if who.get_selected() == 1 else GLib.get_user_name()
            if not re.fullmatch(r"[a-z_][a-z0-9_.-]{0,31}", account or ""):
                self.enroll_text.set_label("Type their account name first.")
                return
            label, fname = FINGERS[finger.get_selected()]
            listed = subprocess.run(["fprintd-list", account], capture_output=True, text=True, timeout=10).stdout
            if re.search(rf"\b{re.escape(fname)}\b", listed):
                again = Adw.AlertDialog(heading="This finger is already registered",
                                        body=f"{label} already signs in {account}. Choose another finger or re-enroll it.")
                again.add_response("no", "Choose another")
                again.add_response("yes", "Re-enroll")
                again.connect("response", lambda _a, r: r == "yes" and self._run_enroll(account, fname, True))
                again.present(self)
                return
            self._run_enroll(account, fname, False)
        start.connect("clicked", enroll)
        account_of = lambda: user.get_text().strip() if who.get_selected() == 1 else GLib.get_user_name()  # noqa: E731
        who.connect("notify::selected", lambda *_: self._list_fingers(account_of()))
        user.connect("apply", lambda *_: self._list_fingers(account_of()))
        user.set_show_apply_button(True)
        self._list_fingers(GLib.get_user_name())
        self._finger_dlg = dlg
        # closing the dialog always gives the reader back
        dlg.connect("closed", lambda *_: (self._fp_release(), setattr(self, "_finger_dlg", None)))
        dlg.present(self)

    def _run_enroll(self, account, fname, rescan):
        """Enroll through fprintd's D-Bus API, all asynchronous: Claim the
        reader for ACCOUNT, EnrollStart, then follow EnrollStatus signals.
        The ring has as many steps as this reader needs (num-enroll-stages,
        often 8-15, not 5). The reader is always released: on completion,
        failure, Cancel or closing the dialog."""
        if getattr(self, "_fp", None):
            return
        self.enroll_ring.reset()
        self.enroll_text.set_label("Connecting to the reader…")
        self._fp_retry_pill(None)
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

        def proxy(path, iface):
            return Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None, "net.reactivated.Fprint", path, iface, None)
        try:
            manager = proxy("/net/reactivated/Fprint/Manager", "net.reactivated.Fprint.Manager")
            path = manager.call_sync("GetDefaultDevice", None, Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]
            dev = proxy(path, "net.reactivated.Fprint.Device")
        except GLib.Error as e:
            self.enroll_text.set_label("No fingerprint reader detected. Face ID with your webcam works without "
                                       "one: Add a face.")
            return
        stages = dev.get_cached_property("num-enroll-stages")
        self.enroll_ring.stages = max(1, stages.unpack()) if stages and stages.unpack() > 0 else 5
        self._fp = {"dev": dev, "claimed": False, "done": 0}

        def fail(msg):
            self.enroll_ring.fail()
            self.enroll_text.set_label(msg)
            self._fp_release()

        def on_signal(_p, _sender, signal, params):
            if signal != "EnrollStatus" or not self._fp:
                return
            result, done = params.unpack()
            if result == "enroll-stage-passed":
                self._fp["done"] += 1
                self.enroll_ring.step()
                self._fp_retry_pill(None)
                left = self.enroll_ring.stages - self._fp["done"]
                self.enroll_text.set_label(f"Good: lift and touch again ({self._fp['done']} of "
                                           f"{self.enroll_ring.stages})" if left > 0 else "Almost there…")
            elif result in ("enroll-retry-scan", "enroll-swipe-too-short", "enroll-finger-not-centered",
                            "enroll-remove-and-retry"):
                self._fp_retry_pill("Center your finger and hold it firm")  # still listening
            elif result == "enroll-completed":
                self.enroll_ring.complete()
                self.enroll_text.set_label("Done ✓ This finger now signs in")
                self._fp_retry_pill(None)
                if shutil.which("canberra-gtk-play"):
                    subprocess.Popen(["canberra-gtk-play", "-i", "complete"], stderr=subprocess.DEVNULL)
                self._fp_release()
                GLib.timeout_add(1400, lambda: (self._finger_dlg and self._finger_dlg.close(), False)[1])
            elif result == "enroll-duplicate":
                fail("That finger is already enrolled (on this or another account)")
            elif done:
                fail("It didn't work (" + result.replace("enroll-", "") + "): try again")
        self._fp["signal"] = dev.connect("g-signal", on_signal)

        def call(method, args, then):
            def finished(px, res):
                try:
                    px.call_finish(res)
                except GLib.Error as e:
                    text = e.message.split(":")[-1].strip()
                    fail("Not allowed: enrolling someone else needs an administrator"
                         if "PermissionDenied" in e.message or "NotAuthorized" in e.message else f"Reader: {text}")
                    return
                then()
            dev.call(method, args, Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 60000, None, finished)

        def start():
            self._fp["claimed"] = True
            self.enroll_text.set_label(f"Touch the reader (1 of {self.enroll_ring.stages})…")
            call("EnrollStart", GLib.Variant("(s)", (fname,)), lambda: None)

        def claimed():
            self._fp["claimed"] = True
            if rescan:  # the old print goes first, then the new scan
                call("DeleteEnrolledFinger", GLib.Variant("(s)", (fname,)), start)
            else:
                start()
        call("Claim", GLib.Variant("(s)", ("" if account == GLib.get_user_name() else account,)), claimed)

    def _list_fingers(self, account):
        """The fingers ACCOUNT has enrolled (fprintd-list), each with a
        Delete button (fprintd-delete -f; someone else's needs an admin)."""
        group = self.enrolled
        for row in getattr(self, "_finger_rows", []):
            group.remove(row)
        self._finger_rows = []
        if not re.fullmatch(r"[a-z_][a-z0-9_.-]{0,31}", account or ""):
            return
        names = dict((f, label) for label, f in FINGERS)

        def listed(code, out):
            found = re.findall(r"#\d+:\s*([a-z-]+)", out)
            if not found:
                row = Adw.ActionRow(title="No fingerprint reader detected" if "No devices" in out or code != 0 and not out
                                    else "None yet", subtitle="Face ID with your webcam works without one"
                                    if "No devices" in out else account)
                group.add(row)
                self._finger_rows.append(row)
                return
            for f in found:
                row = Adw.ActionRow(title=names.get(f, f.replace("-", " ").capitalize()), subtitle=account)
                delete = Gtk.Button(icon_name="user-trash-symbolic", css_classes=["flat"], valign=Gtk.Align.CENTER,
                                    tooltip_text="Delete this finger")
                delete.connect("clicked", lambda _b, ff=f: run_bg(["fprintd-delete", account, "-f", ff],
                                                                  lambda c, o: self._list_fingers(account)))
                row.add_suffix(delete)
                group.add(row)
                self._finger_rows.append(row)
        run_bg(["fprintd-list", account], listed)

    def _fp_retry_pill(self, text):
        self.enroll_pill.set_label(text or "")
        self.enroll_pill.set_visible(bool(text))

    def _fp_release(self):
        """Stop and release the reader without waiting on the main loop."""
        fp, self._fp = getattr(self, "_fp", None), None
        if not fp:
            return
        dev = fp["dev"]
        if fp.get("signal"):
            dev.disconnect(fp["signal"])
        if fp["claimed"]:
            def released(px, res):
                try:
                    px.call_finish(res)
                except GLib.Error:
                    pass
                dev.call("Release", None, Gio.DBusCallFlags.NONE, 5000, None, None)
            dev.call("EnrollStop", None, Gio.DBusCallFlags.NONE, 5000, None, released)

    def _lock_notes(self):
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(
            title="Lock notebooks",
            description="A notebook is a folder of MK Notes. Locked, its notes are encrypted and MK Notes "
                        "doesn't show them until you open it here (or in Files). New: make a notebook "
                        "just for private notes.")
        locked = set(read_list("locked-folders"))
        folders = sorted(p for p in NOTES.iterdir() if p.is_dir() and not p.name.startswith(".")) if NOTES.is_dir() else []
        for folder in folders:
            if folder.name in ("attachments", "Templates"):
                continue
            key = str(folder)
            row = Adw.SwitchRow(title=folder.name, subtitle="Locked" if key in locked else "Not locked",
                                active=key in locked)
            row.add_prefix(Gtk.Image(icon_name="accessories-text-editor-symbolic"))
            row.connect("notify::active", self._toggle_notebook, key)
            group.add(row)
        private = Adw.ActionRow(title="New private notebook", subtitle="~/Notes/Private, locked from the start",
                                activatable=True)
        private.add_suffix(Gtk.Image(icon_name="list-add-symbolic"))
        private.connect("activated", lambda *_: self._new_private())
        group.add(private)
        page.add(group)
        return page

    def _toggle_notebook(self, row, _p, path):
        if row.get_active():
            self._lock_folder(path)
            row.set_subtitle("Locked")
        else:
            self.say("To unlock a notebook for good: mk unlock --remove " + path)
            row.set_active(True)

    def _new_private(self):
        folder = NOTES / "Private"
        folder.mkdir(parents=True, exist_ok=True)
        if not any(folder.iterdir()):
            (folder / "Welcome.md").write_text("# Private\n\nNotes in this notebook are encrypted when it's locked.\n")
        self._lock_folder(str(folder))

    # ---------------------------------------------------------------- security
    # ---------------------------------------------------------------- security
    # The dashboard's sections, Windows Security style, and the checks in each
    # (ids from mk-security-scan and mk-security's own checks).
    SECTIONS = [
        ("Virus &amp; threat protection", "security-high-symbolic", ("malware", "rkhunter", "chkrootkit", "tmpexec")),
        ("Firewall &amp; network protection", "network-wired-symbolic",
         ("firewall", "ports", "sshroot", "sshpw", "sharing", "remote")),
        ("Account &amp; sign-in protection", "system-users-symbolic", ("uid0", "emptypw", "lock", "selinux", "signin")),
        ("Device security &amp; privacy", "drive-harddisk-symbolic",
         ("encryption", "secureboot", "updates", "autoupdates", "homeperm", "worldwrite", "vault")),
    ]

    def _security(self):
        page = Adw.PreferencesPage()
        head = Adw.PreferencesGroup()
        top = Gtk.Box(spacing=12)
        title = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        self.score = Gtk.Label(label="Security at a glance", css_classes=["title-2"], xalign=0)
        title.append(self.score)
        self.score_sub = Gtk.Label(label="The check only reads, and takes a few seconds; no password at your desk.",
                                   css_classes=["dim-label"], xalign=0, wrap=True)
        title.append(self.score_sub)
        top.append(title)
        buttons = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER)
        self.scan_btn = Gtk.Button(label="Run check", css_classes=["pill", "suggested-action"])
        self.scan_btn.connect("clicked", lambda *_: self._scan(""))
        self.virus_btn = Gtk.Button(label="Quick virus scan", css_classes=["pill"],
                                    tooltip_text="ClamAV on files from the last 14 days in Downloads (~10 s)")
        self.virus_btn.connect("clicked", lambda *_: self._scan("virus"))
        self.deep_btn = Gtk.Button(label="Deep scan", css_classes=["pill"],
                                   tooltip_text="Rootkits, viruses in recent files, a fresh Lynis audit: a few minutes")
        self.deep_btn.connect("clicked", lambda *_: self._scan("deep"))
        for btn in (self.scan_btn, self.virus_btn, self.deep_btn):
            buttons.append(btn)
        self.cancel_btn = Gtk.Button(label="Cancel scan", css_classes=["pill", "destructive-action"], visible=False)
        self.cancel_btn.connect("clicked", lambda *_: self._cancel_scan())
        buttons.append(self.cancel_btn)
        top.append(buttons)
        self.scan_bar = Gtk.ProgressBar(visible=False, show_text=True, margin_top=6)
        top.append(self.scan_bar)
        head.add(top)
        page.add(head)
        self.sec_groups = {}
        for name, icon, _ids in self.SECTIONS:
            group = Adw.PreferencesGroup(title=name)
            group.set_header_suffix(Gtk.Image(icon_name=icon, css_classes=["dim-label"]))
            page.add(group)
            self.sec_groups[name] = [group, []]
        self.notes_group = Adw.PreferencesGroup(title="Notes")
        page.add(self.notes_group)
        self.sec_results = {}
        self.note_rows = []
        self._fill_security()
        return page

    def _local_checks(self):
        """What the app can see itself: sign-in methods and the vault."""
        out = {}
        face = os.path.exists("/run/mk-face-auth.sock")
        finger = False
        try:
            finger = " - #" in subprocess.run(["fprintd-list", os.environ.get("USER", "")], capture_output=True,
                                              text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            pass
        ways = [w for w, on in (("Face ID", face), ("fingerprint", finger)) if on]
        out["signin"] = ("pass", f"Sign-in with {' and '.join(ways)} works in MK's apps", "") if ways else \
            ("low", "Only your password signs you in", "Set up face or fingerprint: Actions › Biometrics")
        vault = HOME / ".vault"
        if (HOME / ".vault.mklock").is_dir() or (HOME / "..vault.mklock").is_dir():
            out["vault"] = ("pass", "Vault: open (encrypted on disk)" if is_open(vault) else
                            "Vault: closed and encrypted", "")
        else:
            out["vault"] = ("low", "No vault yet", "Open it once (Actions › Vault) to create it")
        return out

    def _fill_security(self, notes=()):
        results = {**self.sec_results, **self._local_checks()}
        icons = {"pass": ("object-select-symbolic", "success"), "low": ("dialog-information-symbolic", "accent"),
                 "medium": ("dialog-warning-symbolic", "warning"), "high": ("dialog-error-symbolic", "error")}
        for name, _icon, ids in self.SECTIONS:
            group, rows = self.sec_groups[name]
            for row in rows:
                group.remove(row)
            rows.clear()
            for ident in ids:
                if ident not in results:
                    continue
                level, text, detail, *fix = results[ident]
                row = Adw.ActionRow(title=GLib.markup_escape_text(text), subtitle=GLib.markup_escape_text(detail))
                icon, css = icons.get(level, icons["low"])
                row.add_prefix(Gtk.Image(icon_name=icon, css_classes=[css]))
                if fix and fix[0]:
                    name_ = fix[0].split()[-1]
                    b = Gtk.Button(label="Fix", css_classes=["pill"], valign=Gtk.Align.CENTER)
                    b.connect("clicked", lambda _b, n=name_: run_bg(
                        [tool("mk-security"), "fix", n],
                        lambda c, o: (self.say((ANSI.sub("", o).strip().splitlines() or ["Done"])[-1]), self._scan(""))))
                    row.add_suffix(b)
                group.add(row)
                rows.append(row)
            group.set_visible(bool(rows))
        for row in self.note_rows:
            self.notes_group.remove(row)
        self.note_rows = [Adw.ActionRow(title=GLib.markup_escape_text(n)) for n in notes]
        for row in self.note_rows:
            self.notes_group.add(row)
        self.notes_group.set_visible(bool(notes))

    SCAN_LOG = Path(GLib.get_user_data_dir()) / "mk-security/latest-scan.log"

    def _cancel_scan(self):
        """Stop the scan: ending mk-security makes the root helper stop too
        (it watches its caller) and free the lock."""
        proc = getattr(self, "_scan_proc", None)
        if proc:
            self._scan_cancelled = True
            proc.force_exit()
            self._scan_finished("cancelled", 1, "")  # the buttons come back now

    def _scan(self, mode):
        """Run mk-security --raw MODE and read its lines as they come:
        PROGRESS|scanned|total (ClamAV's real file count) and STEP|n|of|what
        (the deep scan's stages) move the bar; the rest is the report."""
        if getattr(self, "_scan_proc", None):
            return
        for btn in (self.scan_btn, self.virus_btn, self.deep_btn):
            btn.set_sensitive(False)
        self.cancel_btn.set_visible(mode != "")
        self.scan_bar.set_visible(mode != "")
        self.scan_bar.set_fraction(0)
        self.scan_bar.set_text("Starting…")
        self.score_sub.set_label({"": "Checking… (a few seconds)", "virus": "Scanning downloads and running programs…",
                                  "deep": "Deep scan… (a few minutes, at low priority)"}[mode])
        argv = [tool("mk-security"), "--raw"] + ([mode] if mode else [])
        self._scan_cancelled = False
        try:
            proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as e:
            self._scan_finished(mode, 1, str(e.message))
            return
        self._scan_proc = proc
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
        lines = []

        def got(src, res):
            try:
                text, _n = src.read_line_finish_utf8(res)
            except GLib.Error:
                text = None
            if text is None:
                def ended(p, r):
                    p.wait_finish(r)
                    if self._scan_proc is p:  # not already cancelled
                        self._scan_finished(mode, p.get_exit_status() if p.get_if_exited() else 1, "\n".join(lines))
                proc.wait_async(None, ended)
                return
            f = text.split("|")
            if f[0] == "PROGRESS" and len(f) == 3 and f[1].isdigit() and f[2].isdigit():
                done_n, total = int(f[1]), max(1, int(f[2]))
                if mode == "virus":
                    self.scan_bar.set_fraction(min(1.0, done_n / total))
                self.scan_bar.set_text(f"{done_n:,} of {total:,} files scanned")
            elif f[0] == "STEP" and len(f) == 4 and f[1].isdigit() and f[2].isdigit():
                self.scan_bar.set_fraction((int(f[1]) - 1) / max(1, int(f[2])))
                self.scan_bar.set_text(f"Step {f[1]} of {f[2]}: {f[3]}")
            else:
                lines.append(text)
            src.read_line_async(GLib.PRIORITY_DEFAULT, None, got)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got)

    def _scan_finished(self, mode, code, out):
        self._scan_proc = None
        for btn in (self.scan_btn, self.virus_btn, self.deep_btn):
            btn.set_sensitive(True)
        self.cancel_btn.set_visible(False)
        self.scan_bar.set_visible(False)
        try:
            self.SCAN_LOG.parent.mkdir(parents=True, exist_ok=True)
            self.SCAN_LOG.write_text(f"# mk security {mode or 'check'} · {time.strftime('%Y-%m-%d %H:%M:%S')}\n{out}\n")
        except OSError:
            pass
        if self._scan_cancelled:
            self.score_sub.set_label("Scan cancelled.")
            self._scan_cancelled = False
            return
        self._scan_report(mode, code, out)

    def _scan_report(self, mode, code, out):
        if code != 0:
            self.score_sub.set_label("The check couldn't run: " +
                                     ((out.strip().splitlines() or ["run sudo ./setup.sh"])[-1]))
            return
        score, lynis, notes = 100, None, []
        for line in out.splitlines():
            f = line.split("|")
            if f[0] == "PASS" and len(f) >= 3:
                self.sec_results[f[1]] = ("pass", f[2], "")
            elif f[0] == "FINDING" and len(f) >= 6:
                level, ident = f[1], f[2]
                self.sec_results[ident] = (level, f[3], f[4], f[5])
            elif f[0] == "NOTE" and len(f) >= 2:
                notes.append(f[1])
            elif f[0] == "LYNIS" and len(f) >= 2 and f[1].isdigit():
                lynis = int(f[1])
        for level, *_ in self.sec_results.values():
            score -= {"high": 15, "medium": 7, "low": 2}.get(level, 0)
        score = max(0, score)
        if lynis is not None:
            score = (score * 2 + lynis) // 3
        verdict = "Good" if score >= 85 else "Fair" if score >= 65 else "Needs attention"
        self.score.set_label(f"{score} / 100 · {verdict}")
        self.score_sub.set_label("Checked just now" + (f"; includes the Lynis hardening index {lynis}"
                                                       if lynis is not None else "") + ".")
        self._fill_security(notes)
        if mode == "virus" and not any(lv == "high" and i == "malware" for i, (lv, *_r) in self.sec_results.items()):
            self.say("✓ No threats detected")


class FingerRing(Gtk.DrawingArea):
    """A ring that fills a step per accepted touch (as many steps as the
    reader needs), easing into place; green with a tick when the finger is
    enrolled, red when it failed."""

    def __init__(self):
        super().__init__(content_width=120, content_height=120, halign=Gtk.Align.CENTER)
        self.stages = 5   # set from the reader (num-enroll-stages)
        self.done, self.shown, self.finished, self.failed = 0, 0.0, False, False
        self.set_draw_func(self._draw)

    def reset(self):
        self.done, self.shown, self.finished, self.failed = 0, 0.0, False, False
        self.queue_draw()

    def step(self):
        self.done = min(self.stages, self.done + 1)
        self._animate()

    def complete(self):
        self.done, self.finished = self.stages, True
        self._animate()

    def fail(self):
        self.failed = True
        self.queue_draw()

    def _animate(self):
        start, end = self.shown, self.done / self.stages

        def frame(v):
            self.shown = start + (end - start) * v
            self.queue_draw()
        anim = Adw.TimedAnimation.new(self, 0, 1, 400, Adw.CallbackAnimationTarget.new(frame))
        anim.set_easing(Adw.Easing.EASE_OUT_CUBIC)
        anim.play()

    def _draw(self, _a, cr, w, h):
        cx, cy, r = w / 2, h / 2, min(w, h) / 2 - 8
        green = (0.30, 0.80, 0.45)
        accent = green if self.finished else (0.93, 0.33, 0.33) if self.failed else (0.21, 0.52, 0.89)
        cr.set_line_width(6)
        cr.set_source_rgba(1, 1, 1, 0.1)
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.stroke()
        if self.shown > 0:
            cr.set_source_rgb(*accent)
            cr.arc(cx, cy, r, -math.pi / 2, -math.pi / 2 + 2 * math.pi * self.shown)
            cr.stroke()
        cr.set_source_rgb(*accent)
        cr.set_line_width(2.2)
        if self.finished:
            cr.move_to(cx - 16, cy + 1)
            cr.line_to(cx - 5, cy + 12)
            cr.line_to(cx + 17, cy - 12)
            cr.stroke()
            return
        for k in range(4):  # a fingerprint's arcs
            cr.arc(cx, cy + 8, 7 + k * 7, math.pi * 1.1, math.pi * 1.9)
            cr.stroke()


class CenterApp(Adw.Application):
    """One window; mk-center PAGE (or mk hub) switches it to that page."""

    PAGES = ("home", "actions", "lock", "security")

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        page = {"hub": "actions"}.get(args[0], args[0]) if args else "home"
        page = page if page in self.PAGES else "home"
        window = self.get_active_window()
        if window:
            window.stack.set_visible_child_name(page)
        else:
            window = Center(self, page)
        window.present()
        return 0


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__.strip())
        return 0
    return CenterApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
