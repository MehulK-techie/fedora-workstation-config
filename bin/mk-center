for _lib in (Path(__file__).resolve().parent.parent / "lib",
             Path(GLib.get_user_data_dir()) / "mk-workstation/lib"):
    if (_lib / "mkworkstation").is_dir():
        sys.path.insert(0, str(_lib))
        break
from mkworkstation import auth, saver_conf  # noqa: E402

