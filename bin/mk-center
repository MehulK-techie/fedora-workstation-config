"""
# Card accents: security cyan, performance emerald, system purple.
CATEGORY_COLOUR = {"Performance": "emerald", "Security & Vault": "cyan", "Biometrics & Lock": "cyan",
                   "Screensavers & Wallpapers": "amber", "Notes & Focus": "blue", "System Maintenance": "purple"}
PINS = CONFIG / "hub-pins"
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def tool(name):
    """An MK tool: installed copy first, then the one next to this file."""
    for candidate in (BIN / name, Path(__file__).resolve().parent / name):
        if candidate.exists():
            return str(candidate)
    return name


def run_bg(argv, done=None):
    """Run ARGV off the main loop; DONE(returncode, output) back on it."""
    def work():
        try:
            p = subprocess.run(argv, capture_output=True, text=True, timeout=600)
            result = (p.returncode, p.stdout + p.stderr)
        except (OSError, subprocess.SubprocessError) as e:
            result = (1, str(e))
        if done:
            GLib.idle_add(lambda: (done(*result), False)[1])
    threading.Thread(target=work, daemon=True).start()


def terminal(command):
    """argv that runs COMMAND (a shell line) in the desktop's terminal and
    keeps it open until Enter: Ptyxis (Fedora 41+), Console, or GNOME Terminal."""
    line = f"{command}; read -rp 'Press Enter to close'"
    for term, flag in (("ptyxis", "--"), ("kgx", "--"), ("gnome-terminal", "--")):
        if shutil.which(term):
            return [term, flag, "bash", "-c", line]
    return ["xdg-terminal-exec", "bash", "-c", line]


def mk(*args):
    return [tool("mk"), *args]


# The Actions page: (id, category, icon, title, what it does, how it runs).
# How: ("bg", argv) runs quietly and shows the last line it prints; ("show",
# argv) shows all of its output; ("term", "mk ...") needs a terminal (sudo or
# questions); ("page", name) opens another page of this window.
CATEGORIES = ("Performance", "Security & Vault", "Biometrics & Lock", "Screensavers & Wallpapers",
