           ("Right middle", "right-middle-finger"), ("Left index", "left-index-finger"),
           ("Left thumb", "left-thumb"), ("Left middle", "left-middle-finger")]

APP_ID = "io.github.mehulk.MkCenter"
HOME = Path.home()
BIN = HOME / ".local/bin"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "mk-workstation"
NOTES = HOME / "Notes"
