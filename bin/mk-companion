#!/usr/bin/env python3
"""Companion (Super+Shift+N): notes, tasks, the focus timer and MK Notes.

Notes: add as many as you like, pin the important ones (they stay open at the
top), reorder them, and the rest fold away until you open them.
Tasks: tick them off, pin them, delete them; finished ones collect under Done.
Any note or task can remind you: in N minutes, at a time, or daily/weekly.
Reminders fire even when this window is closed (mk-reminders.timer).
Everything saves as you type, to ~/.local/share/mk-workstation/companion.json;
`mk note` / `mk task` add to it from a terminal and show up here at once.

  mk-companion            open (or bring back) the window
  mk-companion tasks      open on the task list
  mk-companion note ID    open a note (used by reminder notifications)
"""
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402


def _add_lib_path():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for candidate in (Path(__file__).resolve().parent.parent / "lib",
                      Path(data_home) / "mk-workstation/lib"):
        if (candidate / "mkworkstation").is_dir():
            sys.path.insert(0, str(candidate))
            return


_add_lib_path()
import mkworkstation as mk  # noqa: E402
from mkworkstation import companion as cstore  # noqa: E402
from mkworkstation import welcome as wconf  # noqa: E402

APP_ID = "io.github.mehulk.MkCompanion"
STORE = cstore.STORE
OLD_SCRATCHPAD = Path.home() / ".mk_scratchpad.md"

CSS = b"""
.mk-note-text { background: transparent; font-size: 1.02em; }
.mk-note-box { background: alpha(@window_fg_color, 0.04); border-radius: 12px; padding: 10px; }
.mk-title-entry { font-weight: 700; font-size: 1.1em; }
.mk-done label.title { text-decoration: line-through; opacity: 0.55; }
.mk-pinned-icon { color: @accent_color; }
.mk-hero { font-size: 1.5em; font-weight: 800; }
.mk-sub { opacity: 0.65; }
.mk-launch { border-radius: 14px; padding: 10px 16px; }
.mk-reminder-set { color: @accent_color; font-weight: 700; }
.mk-preset { border-radius: 10px; }
"""


def now():
    return time.time()


def ago(ts):
    delta = max(0, now() - ts)
    if delta < 60:
        return "just now"
    if delta < 3600:
        return f"{int(delta // 60)} min ago"
    if delta < 86400:
        return f"{int(delta // 3600)} h ago"
    return time.strftime("%d %b", time.localtime(ts))


class Store:
    """Notes and tasks in memory, saved through mkworkstation.companion.
    Imports the old scratchpad once."""

    def __init__(self):
        data = cstore.load()
        self.notes, self.tasks = data["notes"], data["tasks"]
        self._save_id = 0
        self.mtime = self._disk_mtime()
        if not STORE.exists() and OLD_SCRATCHPAD.exists():
            self._import_scratchpad()

    @staticmethod
    def _disk_mtime():
        try:
            return STORE.stat().st_mtime_ns
        except OSError:
            return 0

    def _import_scratchpad(self):
        body = []
        for line in OLD_SCRATCHPAD.read_text().splitlines():
            stripped = line.strip()
            if stripped.startswith(("- [ ]", "- [x]", "- [X]")):
                text = stripped[5:].strip()
                if text and text not in ("Task 1", "Task 2"):
                    self.add_task(text, done=stripped[3] in "xX")
            elif stripped and not stripped.startswith("#") and stripped != "-":
                body.append(line)
        if body:
            self.add_note("Scratchpad", "\n".join(body))
        self.save_now()

    def add_note(self, title="", body=""):
        note = cstore.new_note(title, body)
        self.notes.insert(0, note)
        return note

    def add_task(self, text, done=False):
        task = cstore.new_task(text, done)
        self.tasks.insert(0, task)
        return task

    def merge_from_disk(self):
        """Pick up items added elsewhere (mk note / mk task). Items already
        here keep what you see in the window. True if anything was added."""
        if self._disk_mtime() == self.mtime:
            return False
        self.mtime = self._disk_mtime()
        data, added = cstore.load(), False
        for kind in ("notes", "tasks"):
            mine = getattr(self, kind)
            known = {i["id"] for i in mine}
            for item in reversed(data[kind]):
                if item["id"] not in known:
                    mine.insert(0, item)
                    added = True
        return added

    def save(self):
        """Save soon (typing doesn't write the file on every key)."""
        if self._save_id:
            GLib.source_remove(self._save_id)
        self._save_id = GLib.timeout_add(400, self.save_now)

    def save_now(self):
        self._save_id = 0
        self.merge_from_disk()
        cstore.save({"notes": self.notes, "tasks": self.tasks})
        self.mtime = self._disk_mtime()
        return GLib.SOURCE_REMOVE


def launch(argv):
    try:
        subprocess.Popen(argv, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


def flat_button(icon, tooltip, callback):
    button = Gtk.Button(icon_name=icon, tooltip_text=tooltip, valign=Gtk.Align.CENTER)
    button.add_css_class("flat")
    button.add_css_class("circular")
    button.connect("clicked", lambda *_: callback())
    return button


def reminder_button(item, on_change):
    """⏰ button with a popover: presets, "in h/min", "at HH:MM", repeat, clear."""
    content = Adw.ButtonContent(icon_name="alarm-symbolic")
    button = Gtk.MenuButton(child=content, valign=Gtk.Align.CENTER,
                            tooltip_text="Remind me")
    button.add_css_class("flat")

    def show():
        text = cstore.describe(item)
        content.set_label(text)
        if text:
            button.add_css_class("mk-reminder-set")
        else:
            button.remove_css_class("mk-reminder-set")
    show()

    pop = Gtk.Popover()
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=10,
                  margin_bottom=10, margin_start=10, margin_end=10)
    heading = Gtk.Label(label="Remind me", xalign=0)
    heading.add_css_class("heading")
    box.append(heading)

    repeat = Gtk.DropDown.new_from_strings(["Once", "Every day", "Every week"])
    repeat.set_selected(["none", "daily", "weekly"].index(item.get("repeat", "none")))

    def set_at(ts):
        item["remind_at"] = ts
        item["repeat"] = ["none", "daily", "weekly"][repeat.get_selected()]
        show()
        on_change()
        pop.popdown()

    grid = Gtk.Grid(column_spacing=6, row_spacing=6, column_homogeneous=True)
    tomorrow9 = (datetime.now() + timedelta(days=1)).replace(hour=9, minute=0, second=0)
    evening = datetime.now().replace(hour=18, minute=0, second=0)
    presets = [("10 min", lambda: time.time() + 600), ("30 min", lambda: time.time() + 1800),
               ("1 hour", lambda: time.time() + 3600), ("3 hours", lambda: time.time() + 10800),
               ("This evening", lambda: evening.timestamp() if evening > datetime.now()
                else (evening + timedelta(days=1)).timestamp()),
               ("Tomorrow 9:00", lambda: tomorrow9.timestamp())]
    for i, (label, when) in enumerate(presets):
        b = Gtk.Button(label=label)
        b.add_css_class("mk-preset")
        b.connect("clicked", lambda *_, w=when: set_at(w()))
        grid.attach(b, i % 2, i // 2, 1, 1)
    box.append(grid)
    box.append(Gtk.Separator())

    def spin(lo, hi, value, step=1):
        sp = Gtk.SpinButton.new_with_range(lo, hi, step)
        sp.set_value(value)
        return sp

    after = Gtk.Box(spacing=6)
    hours, minutes = spin(0, 72, 0), spin(0, 59, 25)
    go_after = Gtk.Button(label="Set")
    go_after.connect("clicked", lambda *_: set_at(
        time.time() + hours.get_value_as_int() * 3600 + minutes.get_value_as_int() * 60))
    for w in (Gtk.Label(label="In"), hours, Gtk.Label(label="h"), minutes,
              Gtk.Label(label="min"), go_after):
        after.append(w)
    box.append(after)

    at = Gtk.Box(spacing=6)
    current = datetime.fromtimestamp(item["remind_at"]) if item.get("remind_at") else datetime.now()
    hh, mm = spin(0, 23, current.hour), spin(0, 59, (current.minute // 5) * 5, 5)
    go_at = Gtk.Button(label="Set")
    go_at.connect("clicked", lambda *_: set_at(
        cstore.parse_when(f"{hh.get_value_as_int()}:{mm.get_value_as_int():02d}")))
    for w in (Gtk.Label(label="At"), hh, Gtk.Label(label=":"), mm, go_at):
        at.append(w)
    box.append(at)

    row = Gtk.Box(spacing=6)
    row.append(Gtk.Label(label="Repeat", hexpand=True, xalign=0))
    row.append(repeat)
    box.append(row)

    def repeat_changed(*_):
        if item.get("remind_at"):
            item["repeat"] = ["none", "daily", "weekly"][repeat.get_selected()]
            show()
            on_change()
    repeat.connect("notify::selected", repeat_changed)

    clear = Gtk.Button(label="No reminder")
    clear.add_css_class("destructive-action")
    clear.connect("clicked", lambda *_: set_at(None))
    box.append(clear)
    pop.set_child(box)
    button.set_popover(pop)
    return button


class CompanionWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_default_size(560, 760)
        self.store = Store()
        self.open_notes = set()

        self.stack = Adw.ViewStack()
        self.notes_page = self.stack.add_titled_with_icon(
            self._build_notes(), "notes", "Notes", "accessories-text-editor-symbolic")
        self.tasks_page = self.stack.add_titled_with_icon(
            self._build_tasks(), "tasks", "Tasks", "checkbox-checked-symbolic")

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.ViewSwitcher(stack=self.stack,
                                                 policy=Adw.ViewSwitcherPolicy.WIDE))
        new = flat_button("list-add-symbolic", "New note (Ctrl+N)", self.new_item)
        header.pack_start(new)
        header.pack_end(self._build_menu())

        launchers = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, margin_top=8, margin_bottom=12)
        for icon, label, tooltip, cb in (
            ("alarm-symbolic", "Focus timer", "Countdown with a celebration", self.open_timer),
            ("accessories-text-editor-symbolic", "MK Notes", "Full notes app (Super+N)", self.launch_notes),
        ):
            content = Adw.ButtonContent(icon_name=icon, label=label)
            button = Gtk.Button(child=content, tooltip_text=tooltip)
            button.add_css_class("mk-launch")
            button.connect("clicked", lambda *_, c=cb: c())
            launchers.append(button)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.append(self.stack)
        body.append(launchers)
        self.toasts = Adw.ToastOverlay(child=body)
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(self.toasts)
        self.set_content(view)

        self.stack.connect("notify::visible-child-name", lambda *_: self._update_new_tooltip(new))
        self.refresh_title()
        self.refresh_notes()
        self.refresh_tasks()
        self.connect("close-request", lambda *_: (self.store.save_now(), False)[1])
        # `mk note` / `mk task` from a terminal: show new items straight away
        self._store_monitor = Gio.File.new_for_path(str(STORE)).monitor_file(
            Gio.FileMonitorFlags.NONE, None)
        self._store_monitor.connect("changed", self._on_store_changed)

    def _on_store_changed(self, *_):
        if self.store.merge_from_disk():
            self.refresh_notes()
            self.refresh_tasks()

    def open_note(self, note_id):
        self.stack.set_visible_child_name("notes")
        if any(n["id"] == note_id for n in self.store.notes):
            self.open_notes.add(note_id)
            self.refresh_notes(focus=note_id)

    # ---------- chrome ----------
    def refresh_title(self):
        self.set_title(f"{mk.brand()[1]} Companion")

    def _update_new_tooltip(self, button):
        on_tasks = self.stack.get_visible_child_name() == "tasks"
        button.set_tooltip_text("New task (Ctrl+N)" if on_tasks else "New note (Ctrl+N)")

    def _build_menu(self):
        menu = Gio.Menu()
        menu.append("Rename this workstation…", "win.rename")
        menu.append("Welcome greeting…", "win.welcome")
        menu.append("Keyboard shortcuts", "win.shortcuts")
        for name, cb in (("rename", self.rename_dialog), ("welcome", self.welcome_dialog),
                         ("shortcuts", lambda *_: launch([str(Path.home() / ".local/bin/show-shortcuts")]))):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", cb)
            self.add_action(action)
        new = Gio.SimpleAction.new("new", None)
        new.connect("activate", lambda *_: self.new_item())
        self.add_action(new)
        return Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=2))

    def new_item(self):
        if self.stack.get_visible_child_name() == "tasks":
            self.task_entry.grab_focus()
            return
        note = self.store.add_note()
        self.open_notes.add(note["id"])
        self.store.save()
        self.refresh_notes(focus=note["id"])

    def open_timer(self):
        if not launch([str(Path.home() / ".local/bin/mk-timer")]):
            self.toast("Focus timer isn't installed: run mk sync")

    def launch_notes(self):
        if not launch([str(Path.home() / ".local/bin/mk-notes")]):
            self.toast("MK Notes isn't installed: run mk sync")

    def welcome_dialog(self, *_):
        """What the welcome after login says, and how it sounds."""
        c = wconf.conf()
        dialog = Adw.Dialog(title="Welcome greeting", content_width=460)
        group = Adw.PreferencesGroup(
            description="Shown (and spoken, if you like) with the edge light after you log in. "
                        "{title} and {name} are filled in for you.")
        on_row = Adw.SwitchRow(title="Welcome after login", active=c["WELCOME"] != "off")
        text_row = Adw.EntryRow(title="Greeting", text=c["GREETING"])
        titles = [("sir", "Sir"), ("maam", "Ma'am"), ("name", "Your first name"), ("none", "No title")]
        title_row = Adw.ComboRow(title="Call me", model=Gtk.StringList.new([t[1] for t in titles]))
        current = c.get("TITLE", "sir").lower().replace("ma'am", "maam")
        title_row.set_selected(next((i for i, t in enumerate(titles) if t[0] == current), 0))
        sub_row = Adw.SwitchRow(title="Show the date and time", active=c["SUBTITLE"] != "off")
        voice_row = Adw.SwitchRow(title="Speak it", active=c["VOICE"] == "on")
        variety_row = Adw.SwitchRow(title="A different greeting each time",
                                    subtitle="Morning, evening, Fridays, your birthday… your line is in the mix",
                                    active=c.get("VARIETY", "on") != "off")
        birthday_row = Adw.EntryRow(title="Your birthday (MM-DD or YYYY-MM-DD, optional)", text=c.get("BIRTHDAY", ""))
        for row in (on_row, text_row, title_row, sub_row, voice_row, variety_row, birthday_row):
            group.add(row)
        preview = Gtk.Label(wrap=True)
        preview.add_css_class("title-4")

        natural = Adw.ActionRow(title="Natural British voice",
                                subtitle="Installed" if wconf.engine() == "piper"
                                else "Optional download, about 260 MB (no sudo)")
        install = Gtk.Button(label="Install" if wconf.engine() != "piper" else "Installed",
                             valign=Gtk.Align.CENTER, sensitive=wconf.engine() != "piper")
        natural.add_suffix(install)
        voice_group = Adw.PreferencesGroup()
        voice_group.add(natural)

        def save(*_):
            wconf.set_value("WELCOME", "on" if on_row.get_active() else "off")
            wconf.set_value("GREETING", text_row.get_text().strip() or "Welcome back home, {title}.")
            wconf.set_value("TITLE", titles[title_row.get_selected()][0])
            wconf.set_value("SUBTITLE", "on" if sub_row.get_active() else "off")
            wconf.set_value("VOICE", "on" if voice_row.get_active() else "off")
            wconf.set_value("VARIETY", "on" if variety_row.get_active() else "off")
            birthday = birthday_row.get_text().strip()
            if not birthday or re.fullmatch(r"(\d{4}-)?(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])", birthday):
                wconf.set_value("BIRTHDAY", birthday)
            preview.set_label(f"“{wconf.greeting()}”")
        for row, signal in ((on_row, "notify::active"), (text_row, "changed"),
                            (title_row, "notify::selected"), (sub_row, "notify::active"),
                            (voice_row, "notify::active"), (variety_row, "notify::active"),
                            (birthday_row, "changed")):
            row.connect(signal, save)
        preview.set_label(f"“{wconf.greeting()}”")

        def play(*_):
            save()
            cache = Path(GLib.get_user_cache_dir()) / "mk-workstation"
            cache.mkdir(parents=True, exist_ok=True)
            (cache / "welcome-test").write_text(str(time.time()))  # the shell replays the light
        def do_install(*_):
            install.set_sensitive(False)
            install.set_label("Installing…")
            proc = subprocess.Popen([str(Path.home() / ".local/bin/mk-voice"), "install"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            def poll():
                if proc.poll() is None:
                    return GLib.SOURCE_CONTINUE
                ok = proc.returncode == 0
                install.set_label("Installed" if ok else "Retry")
                install.set_sensitive(not ok)
                natural.set_subtitle("Installed" if ok else "Download failed; check the connection")
                return GLib.SOURCE_REMOVE
            GLib.timeout_add(500, poll)
        install.connect("clicked", do_install)
        play_btn = Gtk.Button(label="Play it now", halign=Gtk.Align.CENTER)
        play_btn.add_css_class("suggested-action")
        play_btn.add_css_class("pill")
        play_btn.connect("clicked", play)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin_top=12,
                      margin_bottom=20, margin_start=20, margin_end=20)
        for widget in (preview, group, voice_group, play_btn):
            box.append(widget)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(box)
        dialog.set_child(view)
        dialog.connect("closed", lambda *_: subprocess.Popen(
            [str(Path.home() / ".local/bin/mk-voice"), "render"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        dialog.present(self)

    def rename_dialog(self, *_):
        name, short = mk.brand()
        dialog = Adw.Dialog(title="Rename this workstation", content_width=420)
        group = Adw.PreferencesGroup(
            description="Shown in these windows, notifications and the top bar.")
        name_row = Adw.EntryRow(title="Name", text=name)
        short_row = Adw.EntryRow(title="Short tag (top bar)", text=short)
        group.add(name_row)
        group.add(short_row)
        save = Gtk.Button(label="Save", halign=Gtk.Align.CENTER)
        save.add_css_class("suggested-action")
        save.add_css_class("pill")

        def do_save(*_):
            new_name = name_row.get_text().strip() or name
            new_short = short_row.get_text().strip()[:6] or short
            mk.set_brand(new_name, new_short)
            self.refresh_title()
            self.toast(f"Renamed to {new_name}")
            dialog.close()
        save.connect("clicked", do_save)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin_top=12,
                      margin_bottom=20, margin_start=20, margin_end=20)
        box.append(group)
        box.append(save)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(box)
        dialog.set_child(view)
        dialog.present(self)

    # ---------- notes ----------
    def _build_notes(self):
        self.notes_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20,
                                 margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        clamp = Adw.Clamp(maximum_size=760, child=self.notes_box)
        return Gtk.ScrolledWindow(child=clamp, vexpand=True)

    def refresh_notes(self, focus=None):
        for child in list(self.notes_box):
            self.notes_box.remove(child)
        notes = self.store.notes
        if not notes:
            page = Adw.StatusPage(icon_name="accessories-text-editor-symbolic",
                                  title="No notes yet",
                                  description="Jot ideas, snippets, plans. Pin the ones you need often.")
            button = Gtk.Button(label="New note", halign=Gtk.Align.CENTER)
            button.add_css_class("pill")
            button.add_css_class("suggested-action")
            button.connect("clicked", lambda *_: self.new_item())
            page.set_child(button)
            self.notes_box.append(page)
            return
        pinned = [n for n in notes if n["pinned"]]
        others = [n for n in notes if not n["pinned"]]
        focus_widget = None
        for title, items, desc in (("Pinned", pinned, "Always open, always on top"),
                                   ("Notes", others, "Click a note to open it")):
            if not items:
                continue
            group = Adw.PreferencesGroup(title=title, description=desc)
            for note in items:
                row, entry = self._note_row(note)
                group.add(row)
                if note["id"] == focus:
                    focus_widget = entry
            self.notes_box.append(group)
        if focus_widget:
            GLib.idle_add(lambda: focus_widget.grab_focus() and False)

    def _note_title(self, note):
        if note["title"].strip():
            return note["title"].strip()
        first = next((ln.strip() for ln in note["body"].splitlines() if ln.strip()), "")
        return first[:60] or "Untitled note"

    def _note_subtitle(self, note):
        when = cstore.describe(note)
        return f"Edited {ago(note['updated'])}" + (f" · ⏰ {when}" if when else "")

    def _note_row(self, note):
        expanded = note["pinned"] or note["id"] in self.open_notes
        row = Adw.ExpanderRow(title=GLib.markup_escape_text(self._note_title(note)),
                              subtitle=self._note_subtitle(note),
                              expanded=expanded)
        row.set_title_lines(1)
        if note["pinned"]:
            icon = Gtk.Image(icon_name="view-pin-symbolic")
            icon.add_css_class("mk-pinned-icon")
            row.add_prefix(icon)
        row.add_suffix(flat_button("go-up-symbolic", "Move up", lambda: self._move(note, -1)))
        row.add_suffix(flat_button("go-down-symbolic", "Move down", lambda: self._move(note, 1)))
        row.add_suffix(flat_button("view-pin-symbolic", "Unpin" if note["pinned"] else "Pin to top",
                                   lambda: self._toggle_pin(note)))
        row.add_suffix(flat_button("user-trash-symbolic", "Delete", lambda: self._delete_note(note)))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=8,
                      margin_bottom=8, margin_start=8, margin_end=8)
        box.add_css_class("mk-note-box")
        entry = Gtk.Entry(text=note["title"], placeholder_text="Title")
        entry.add_css_class("flat")
        entry.add_css_class("mk-title-entry")
        text = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=4, bottom_margin=4,
                            left_margin=4, right_margin=4, accepts_tab=False)
        text.add_css_class("mk-note-text")
        text.get_buffer().set_text(note["body"])
        text.set_size_request(-1, 160)

        def changed(*_):
            buf = text.get_buffer()
            note["title"] = entry.get_text()
            note["body"] = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
            note["updated"] = now()
            row.set_title(GLib.markup_escape_text(self._note_title(note)))
            row.set_subtitle("Saved")
            self.store.save()
        entry.connect("changed", changed)
        text.get_buffer().connect("changed", changed)
        row.connect("notify::expanded", lambda r, _p: (self.open_notes.add(note["id"])
                                                       if r.get_expanded()
                                                       else self.open_notes.discard(note["id"])))
        top = Gtk.Box(spacing=6)
        entry.set_hexpand(True)
        top.append(entry)

        def reminder_changed():
            row.set_subtitle(self._note_subtitle(note))
            self.store.save()
        top.append(reminder_button(note, reminder_changed))
        box.append(top)
        box.append(text)
        row.add_row(box)
        return row, entry

    def _move(self, note, step):
        notes = self.store.notes
        i = notes.index(note)
        # move within its own section (pinned or not)
        j = i + step
        while 0 <= j < len(notes) and notes[j]["pinned"] != note["pinned"]:
            j += step
        if 0 <= j < len(notes):
            notes[i], notes[j] = notes[j], notes[i]
            self.store.save()
            self.refresh_notes()

    def _toggle_pin(self, note):
        note["pinned"] = not note["pinned"]
        self.store.save()
        self.refresh_notes()
        self.toast("Pinned" if note["pinned"] else "Unpinned")

    def _delete_note(self, note):
        index = self.store.notes.index(note)
        self.store.notes.remove(note)
        self.store.save()
        self.refresh_notes()
        toast = Adw.Toast(title=f"Deleted “{self._note_title(note)}”", button_label="Undo", timeout=5)

        def undo(*_):
            self.store.notes.insert(index, note)
            self.store.save()
            self.refresh_notes()
        toast.connect("button-clicked", undo)
        self.toasts.add_toast(toast)

    # ---------- tasks ----------
    def _build_tasks(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        add_group = Adw.PreferencesGroup()
        self.task_entry = Adw.EntryRow(title="Add a task and press Enter")
        self.task_entry.set_show_apply_button(True)
        self.task_entry.connect("apply", self._add_task)
        self.task_entry.connect("entry-activated", self._add_task)
        add_group.add(self.task_entry)
        box.append(add_group)
        self.progress = Gtk.ProgressBar(show_text=True, margin_start=4, margin_end=4)
        box.append(self.progress)
        self.tasks_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        box.append(self.tasks_box)
        clamp = Adw.Clamp(maximum_size=760, child=box)
        return Gtk.ScrolledWindow(child=clamp, vexpand=True)

    def _add_task(self, *_):
        text = self.task_entry.get_text().strip()
        if text:
            self.store.add_task(text)
            self.store.save()
            self.task_entry.set_text("")
            self.refresh_tasks()

    def refresh_tasks(self):
        for child in list(self.tasks_box):
            self.tasks_box.remove(child)
        tasks = self.store.tasks
        total, done = len(tasks), sum(t["done"] for t in tasks)
        self.progress.set_visible(total > 0)
        self.progress.set_fraction(done / total if total else 0)
        self.progress.set_text(f"{done} of {total} done" if total else "")
        pinned = [t for t in tasks if t["pinned"] and not t["done"]]
        todo = [t for t in tasks if not t["pinned"] and not t["done"]]
        finished = [t for t in tasks if t["done"]]
        if not total:
            self.tasks_box.append(Adw.StatusPage(
                icon_name="checkbox-checked-symbolic", title="Nothing to do",
                description="Add a task above. Pin the ones that matter today."))
            return
        for title, items in (("Pinned", pinned), ("To do", todo)):
            if items:
                group = Adw.PreferencesGroup(title=title)
                for task in items:
                    group.add(self._task_row(task))
                self.tasks_box.append(group)
        if finished:
            group = Adw.PreferencesGroup()
            expander = Adw.ExpanderRow(title=f"Done ({len(finished)})", subtitle="Click to show")
            clear = flat_button("edit-clear-all-symbolic", "Clear finished tasks", self._clear_done)
            expander.add_suffix(clear)
            for task in finished:
                expander.add_row(self._task_row(task))
            group.add(expander)
            self.tasks_box.append(group)

    def _task_row(self, task):
        row = Adw.ActionRow(title=GLib.markup_escape_text(task["text"]), activatable=True)
        row.set_title_lines(3)
        if task["done"]:
            row.add_css_class("mk-done")
        check = Gtk.CheckButton(active=task["done"], valign=Gtk.Align.CENTER)
        check.connect("toggled", lambda c: self._toggle_done(task, c.get_active(), row))
        row.add_prefix(check)
        row.set_activatable_widget(check)
        if not task["done"]:
            row.add_suffix(reminder_button(task, self.store.save))
            row.add_suffix(flat_button("view-pin-symbolic", "Unpin" if task["pinned"] else "Pin to top",
                                       lambda: self._toggle_task_pin(task)))
        row.add_suffix(flat_button("user-trash-symbolic", "Delete", lambda: self._delete_task(task)))
        return row

    def _toggle_done(self, task, active, row):
        task["done"] = active
        self.store.save()
        if active:
            row.add_css_class("mk-done")
            # let the strike-through show for a moment before it moves to Done
            GLib.timeout_add(450, lambda: self.refresh_tasks() and False)
        else:
            self.refresh_tasks()

    def _toggle_task_pin(self, task):
        task["pinned"] = not task["pinned"]
        self.store.save()
        self.refresh_tasks()

    def _delete_task(self, task):
        index = self.store.tasks.index(task)
        self.store.tasks.remove(task)
        self.store.save()
        self.refresh_tasks()
        toast = Adw.Toast(title="Task deleted", button_label="Undo", timeout=5)

        def undo(*_):
            self.store.tasks.insert(index, task)
            self.store.save()
            self.refresh_tasks()
        toast.connect("button-clicked", undo)
        self.toasts.add_toast(toast)

    def _clear_done(self):
        self.store.tasks = [t for t in self.store.tasks if not t["done"]]
        self.store.save()
        self.refresh_tasks()


class CompanionApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.set_accels_for_action("win.new", ["<Control>n"])
        self.set_accels_for_action("window.close", ["<Control>w", "Escape"])

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        if self.window is None:
            self.window = CompanionWindow(self)
            self.window.connect("close-request", self._on_close)
        if args and args[0] == "tasks":
            self.window.stack.set_visible_child_name("tasks")
        elif args and args[0] == "welcome":
            self.window.present()
            self.window.welcome_dialog()
        elif len(args) == 2 and args[0] == "note":
            self.window.store.merge_from_disk()
            self.window.open_note(args[1])
        self.window.refresh_title()
        self.window.present()
        return 0

    def _on_close(self, *_):
        self.window = None
        return False


if __name__ == "__main__":
    sys.exit(CompanionApp().run(sys.argv))
