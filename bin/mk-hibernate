#!/usr/bin/env bash
# mk-hibernate: the Hibernate buttons (Finder menu, Quick Settings, lock screen).
#
#   mk-hibernate            write files out (sync), lock the screen, then:
#                           - real hibernation when this computer can (a disk swap and
#                             resume= set up, logind says yes, no Secure Boot lockdown):
#                             everything saved to disk, the power goes off;
#                           - otherwise sleep (suspend to RAM): every app, tab and file
#                             stays open in memory and is back the moment you open the
#                             lid or press power. Sleep needs a little power: on a flat
#                             battery what's in memory is lost (a notification says so).
#   mk-hibernate --check    what logind allows here (no sleeping)
#
# Real hibernation is set up once with  sudo scripts/setup-hibernate.sh  (it can't
# work while Secure Boot keeps the kernel locked down).
# Attempts are logged to ~/.cache/mk-hibernate.log.
set -uo pipefail

LOG="${XDG_CACHE_HOME:-$HOME/.cache}/mk-hibernate.log"
mkdir -p "$(dirname "$LOG")"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

# logind's answer for one action: yes, no, challenge or na
can() {
    busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager "$1" 2>/dev/null \
        | sed -n 's/^s "\(.*\)"$/\1/p'
}

lockdown() {
    [[ -r /sys/kernel/security/lockdown ]] && grep -qE '\[(integrity|confidentiality)\]' /sys/kernel/security/lockdown
}

disk_ready() {
    local answer
    answer=$(can CanHibernate)
    [[ "$answer" == yes || "$answer" == challenge ]] && grep -q 'resume=' /proc/cmdline && ! lockdown
}

if [[ "${1:-}" == "--check" ]]; then
    printf 'Hibernate:                 %s\n' "$(can CanHibernate)"
    printf 'Suspend, then hibernate:   %s\n' "$(can CanSuspendThenHibernate)"
    printf 'Hybrid sleep:              %s\n' "$(can CanHybridSleep)"
    printf 'Sleep (RAM):               %s\n' "$(can CanSuspend)"
    grep -q 'resume=' /proc/cmdline || echo "No resume= on the kernel command line (sudo scripts/setup-hibernate.sh)."
    lockdown && echo "Kernel lockdown is on (Secure Boot): the kernel refuses to hibernate while it is."
    if disk_ready; then
        echo "The Hibernate buttons hibernate to disk."
    else
        echo "The Hibernate buttons sleep instead (apps stay in memory; it needs a little power)."
    fi
    exit 0
fi

sync
loginctl lock-session 2>/dev/null || true
sleep 0.4                          # (the lock screen up, the live wallpaper paused, before going down)

if disk_ready; then
    log "systemctl hibernate"
    systemctl hibernate && exit 0
    log "systemctl hibernate failed: sleeping instead"
fi

reason="hibernation isn't set up here"
lockdown && reason="Secure Boot keeps the kernel from hibernating"
log "sleep instead of hibernate ($reason)"
if command -v notify-send > /dev/null; then
    notify-send --app-name="MK Workstation" --icon=weather-clear-night-symbolic \
        "Slept instead of hibernating" \
        "$reason, so the computer slept: everything stayed open in memory. Sleep needs a little power: on a flat battery it would be lost." \
        2>/dev/null || true
fi
if systemctl suspend; then
    exit 0
fi
log "systemctl suspend failed"
echo "Couldn't hibernate or sleep ($reason; logind refused to suspend)." >&2
exit 1
