#!/usr/bin/env python3
"""MK live wallpaper: a video (or picture) on the desktop and on the lock screen.

  mk-live-wallpaper set-desktop FILE      the desktop's video (mp4, webm, mkv...) or picture
  mk-live-wallpaper set-lockscreen FILE   the lock screen's (behind the Sonoma clock)
  mk-live-wallpaper off [desktop|lockscreen|all]   back to GNOME's own (default: all)
  mk-live-wallpaper loop on|off           the lock screen's video loops, or plays once and holds
  mk-live-wallpaper hwaccel vaapi|none    the desktop's: graphics card (default) or processor
  mk-live-wallpaper audio desktop|lockscreen on|off|VOLUME
                                          sound (off by default: no audio stream at all);
                                          VOLUME 0-100 sets the level (live)
  mk-live-wallpaper automute on|off       mute the wallpaper while other media plays (default on)
  mk-live-wallpaper sync on|off           the lock screen plays the desktop's media
  mk-live-wallpaper list                  what's set
  mk-live-wallpaper set FILE              (the same as set-desktop)

Both belong to the WACK Sonoma Live Lockscreen extension: these commands write
its settings (the same as its gear in Extension Manager). The desktop's file is
also kept in ~/.config/mk/wallpaper.json ({"desktop": "...", "hwaccel": "vaapi"})
for MK Shell Engine, which plays it while that extension is off.

How it works (GNOME's way: mpvpaper and its kind need wlroots' layer-shell,
which GNOME doesn't have): this player shows the video, muted, in a plain
window, through GStreamer (the graphics card's VA-API decoder, onto a GL
surface); MK Shell Engine makes that window the desktop itself (below every
window, on every workspace, never in Alt+Tab or the overview), and on the
lock screen shows a live copy of it behind the clock. When you unlock, the
lock screen's video slows to a stop and dissolves into the desktop.

  mk-live-wallpaper run FILE [--once] [--audio VOL] [--hwaccel vaapi|none]
                                          the player (the extension starts it);
                                          stdin: play, pause, decelerate MS, volume VOL, quit
"""
import json
import os
import sys
from pathlib import Path

CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "mk" / "wallpaper.json"
TITLE = "MK Live Wallpaper"
IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".avif", ".heic", ".svg", ".bmp", ".gif", ".tif", ".tiff"}
VA_DECODERS = ("vah264dec", "vah265dec", "vavp8dec", "vavp9dec", "vaav1dec", "vampeg2dec",
               "vaapih264dec", "vaapih265dec", "vaapivp9dec", "vaapiav1dec")


def read_conf():
    try:
        conf = json.loads(CONF.read_text())
    except (OSError, ValueError):
        conf = {}
    conf.setdefault("desktop", "")
    conf.setdefault("hwaccel", "vaapi")
    return conf


LOCK_EXT = Path.home() / ".local/share/gnome-shell/extensions/wack-sonoma-lockscreen@rinzler69-wastaken.github.com"
LOCK_SCHEMA = "org.gnome.shell.extensions.wack-sonoma-lockscreen"


def lock_settings(*args):
    """gsettings for the lock screen extension (None: it isn't installed)."""
    import subprocess
    if not (LOCK_EXT / "schemas" / "gschemas.compiled").exists():
        return None
    return subprocess.run(["gsettings", "--schemadir", str(LOCK_EXT / "schemas"), *args, ],
                          capture_output=True, text=True)


def lock_get(key):
    r = lock_settings("get", LOCK_SCHEMA, key)
    return r.stdout.strip().strip("'") if r and r.returncode == 0 else None


def lock_set(key, value):
    r = lock_settings("set", LOCK_SCHEMA, key, value)
    if r is None:
        print("The lock screen is WACK Sonoma Live Lockscreen's, and it isn't installed (mk sync).", file=sys.stderr)
        return False
    return r.returncode == 0


def write_conf(conf):
    CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix(".tmp")
    tmp.write_text(json.dumps(conf, indent=2) + "\n")
    tmp.replace(CONF)


# ---------------------------------------------------------------- the player
def player(path, once=False, audio=None, hwaccel=None):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gst", "1.0")
    from gi.repository import GLib, Gst, Gtk
    try:
        gi.require_version("GstAudio", "1.0")
        from gi.repository import GstAudio
    except (ValueError, ImportError):
        GstAudio = None

    app = Gtk.Application(application_id=None)
    state = {"pipeline": None, "loop": not once, "rate": 1.0, "decel": 0}
    is_image = Path(path).suffix.lower() in IMAGE_EXT

    def video_widget():
        Gst.init(None)
        if (hwaccel or read_conf().get("hwaccel")) == "none":
            registry = Gst.Registry.get()
            for name in VA_DECODERS:
                feature = registry.lookup_feature(name)
                if feature:
                    feature.set_rank(Gst.Rank.NONE)
        playbin = Gst.ElementFactory.make("playbin", None)
        gtksink = Gst.ElementFactory.make("gtk4paintablesink", None)
        if not playbin or not gtksink:
            raise RuntimeError("GStreamer's playbin or gtk4paintablesink is missing (gstreamer1-plugin-gtk4)")
        paintable = gtksink.get_property("paintable")
        sink = gtksink
        if paintable.props.gl_context:            # straight onto a GL surface: no copies on the CPU
            sink = Gst.ElementFactory.make("glsinkbin", None)
            sink.set_property("sink", gtksink)
        playbin.set_property("uri", Gst.filename_to_uri(path))
        playbin.set_property("video-sink", sink)
        if audio is None:
            # no audio at all: the audio stream isn't decoded, and nothing ever connects to
            # PipeWire / PulseAudio (a fakesink stands in should a file force one)
            Gst.util_set_object_arg(playbin, "flags", "video+deinterlace+soft-colorbalance")
            playbin.set_property("audio-sink", Gst.ElementFactory.make("fakesink", None))
            playbin.set_property("mute", True)
        else:
            # sound on (the extension's switch): the default output, at the slider's volume
            Gst.util_set_object_arg(playbin, "flags", "video+audio+deinterlace+soft-colorbalance")
            playbin.set_property("volume", linear(audio))
        state["pipeline"] = playbin
        bus = playbin.get_bus()
        bus.add_signal_watch()

        def segment_seek(flush):
            flags = Gst.SeekFlags.SEGMENT | (Gst.SeekFlags.FLUSH if flush else Gst.SeekFlags.NONE)
            playbin.seek(state["rate"], Gst.Format.TIME, flags, Gst.SeekType.SET, 0, Gst.SeekType.NONE, -1)

        def on_message(_bus, msg):
            t = msg.type
            if t == Gst.MessageType.ASYNC_DONE and state["loop"] and not state.get("segmented"):
                state["segmented"] = True             # (gapless looping: segment seeks, no flush between)
                segment_seek(True)
            elif t == Gst.MessageType.SEGMENT_DONE and state["loop"]:
                segment_seek(False)
            elif t == Gst.MessageType.ERROR:
                err, _dbg = msg.parse_error()
                print(f"mk-live-wallpaper: {err.message}", file=sys.stderr, flush=True)
                app.quit()
        bus.connect("message", on_message)
        playbin.set_state(Gst.State.PLAYING)
        return Gtk.Picture(paintable=paintable, content_fit=Gtk.ContentFit.COVER, can_shrink=True)

    def linear(volume):
        # a slider's volume (0-1, as heard) to playbin's linear gain
        volume = min(1.0, max(0.0, float(volume)))
        if GstAudio is not None:
            return GstAudio.StreamVolume.convert_volume(GstAudio.StreamVolumeFormat.CUBIC,
                                                        GstAudio.StreamVolumeFormat.LINEAR, volume)
        return volume ** 3

    def control(cmd):
        pipeline = state["pipeline"]
        words = cmd.split()
        if not words:
            return
        if words[0] == "quit":
            app.quit()
        elif pipeline is None:
            return                                # (a picture: nothing plays)
        elif words[0] == "pause":
            pipeline.set_state(Gst.State.PAUSED)
        elif words[0] == "play":
            state["decel"] += 1                   # (cancels a slow-down under way)
            set_rate(1.0)
            pipeline.set_state(Gst.State.PLAYING)
        elif words[0] == "volume" and len(words) > 1 and audio is not None:
            try:
                pipeline.set_property("volume", linear(words[1]))
            except ValueError:
                pass
        elif words[0] == "decelerate":
            decelerate(int(words[1]) if len(words) > 1 else 600)

    def set_rate(rate):
        state["rate"] = rate
        state["pipeline"].seek(rate, Gst.Format.TIME, Gst.SeekFlags.INSTANT_RATE_CHANGE,
                               Gst.SeekType.NONE, 0, Gst.SeekType.NONE, 0)

    def decelerate(ms):
        # slow to a stop over MS (1 -> 0.6 -> 0.35 -> 0.15 -> held on the frame)
        token = state["decel"] = state["decel"] + 1
        steps = [0.6, 0.35, 0.15, 0.0]

        def step():
            if token != state["decel"] or not steps:
                return False
            rate = steps.pop(0)
            if rate == 0.0:
                state["pipeline"].set_state(Gst.State.PAUSED)
                return False
            set_rate(rate)
            return True
        GLib.timeout_add(max(30, ms // len(steps)), step)

    def on_stdin(channel, condition):
        if condition & (GLib.IOCondition.HUP | GLib.IOCondition.ERR):
            app.quit()                            # (the engine has gone)
            return False
        line = channel.readline()
        if not line:
            app.quit()
            return False
        control(line.strip())
        return True

    def activate(a):
        try:
            child = Gtk.Picture.new_for_filename(path) if is_image else video_widget()
        except Exception as e:                    # noqa: BLE001 (any failure: say why, then stop)
            print(f"mk-live-wallpaper: {e}", file=sys.stderr, flush=True)
            a.quit()
            return
        if is_image:
            child.set_content_fit(Gtk.ContentFit.COVER)
        win = Gtk.ApplicationWindow(application=a, title=TITLE, decorated=False, child=child,
                                    default_width=1280, default_height=720)
        win.present()
        if not sys.stdin.isatty():
            channel = GLib.IOChannel.unix_new(sys.stdin.fileno())
            GLib.io_add_watch(channel, GLib.PRIORITY_DEFAULT,
                              GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR, on_stdin)

    app.connect("activate", activate)
    app.connect("shutdown", lambda *_: state["pipeline"] and state["pipeline"].set_state(Gst.State.NULL))
    return app.run([sys.argv[0]])


# ---------------------------------------------------------------- the command
def main(argv):
    cmd = argv[0] if argv else "list"
    if cmd == "run" and len(argv) > 1:
        rest = argv[2:]

        def opt(name):
            return rest[rest.index(name) + 1] if name in rest[:-1] else None
        audio = opt("--audio")
        return player(argv[1], once="--once" in rest, audio=float(audio) if audio is not None else None,
                      hwaccel=opt("--hwaccel"))
    conf = read_conf()
    if cmd in ("set", "set-desktop", "set-lockscreen") and len(argv) > 1:
        path = Path(argv[1]).expanduser().resolve()
        if not path.is_file():
            print(f"No such file: {path}", file=sys.stderr)
            return 1
        if cmd == "set-lockscreen":
            if not (lock_set("background-video-path", str(path)) and lock_set("live-enabled", "true")):
                return 1
            print(f"Lock screen: {path.name}")
            return 0
        conf["desktop"] = str(path)
        write_conf(conf)
        lock_set("desktop-wallpaper-path", str(path))
        print(f"Desktop: {path.name}")
        return 0
    if cmd == "off":
        which = argv[1] if len(argv) > 1 else "all"
        for where in (("desktop", "lockscreen") if which == "all" else (which,)):
            if where == "desktop":
                conf["desktop"] = ""
                lock_set("desktop-wallpaper-path", "")
            elif where == "lockscreen":
                lock_set("background-video-path", "")
            else:
                print("off desktop | lockscreen | all", file=sys.stderr)
                return 2
        write_conf(conf)
        print("Live wallpaper off" + ("" if which == "all" else f" ({which})") + ": GNOME's own wallpaper is back.")
        return 0
    if cmd == "loop" and len(argv) > 1 and argv[1] in ("on", "off"):
        # (the lock screen extension's "at the end": 0 loops, 1 holds the last frame)
        if not lock_set("general-action-on-end", "0" if argv[1] == "on" else "1"):
            return 1
        print(f"Lock screen video: {'loops' if argv[1] == 'on' else 'plays once and holds its last frame'}")
        return 0
    if cmd == "hwaccel" and len(argv) > 1 and argv[1] in ("vaapi", "none"):
        conf["hwaccel"] = argv[1]
        write_conf(conf)
        lock_set("desktop-hwaccel", argv[1])
        print(f"Decoding: {'the graphics card (VA-API)' if argv[1] == 'vaapi' else 'the processor'}")
        return 0
    if cmd == "audio" and len(argv) > 2 and argv[1] in ("desktop", "lockscreen"):
        where, value = argv[1], argv[2]
        if value in ("on", "off"):
            ok = lock_set(f"{where}-audio-enabled", "true" if value == "on" else "false")
            msg = f"{where.capitalize()} sound {value}"
        else:
            try:
                level = min(100, max(0, int(value)))
            except ValueError:
                print("audio desktop|lockscreen on|off|0-100", file=sys.stderr)
                return 2
            ok = lock_set(f"{where}-audio-volume", f"{level / 100:.2f}")
            msg = f"{where.capitalize()} volume: {level}%"
        if not ok:
            return 1
        print(msg)
        return 0
    if cmd in ("automute", "sync") and len(argv) > 1 and argv[1] in ("on", "off"):
        key = "audio-auto-mute-on-other-media" if cmd == "automute" else "wallpaper-sync-mode"
        if not lock_set(key, "true" if argv[1] == "on" else "false"):
            return 1
        print(f"{'Auto-mute' if cmd == 'automute' else 'Same media on desktop and lock screen'}: {argv[1]}")
        return 0
    if cmd in ("list", "status"):
        desktop = lock_get("desktop-wallpaper-path")
        print(f"Desktop:     {(desktop if desktop is not None else conf['desktop']) or 'off'}")
        lock = lock_get("background-video-path")
        if lock is None:
            print("Lock screen: (WACK Sonoma Live Lockscreen isn't installed)")
        else:
            on = lock_get("live-enabled") == "true"
            loops = lock_get("general-action-on-end") in ("0", "int32 0")
            print(f"Lock screen: {lock if lock and on else 'off'}" +
                  (f" ({'loops' if loops else 'plays once'})" if lock and on else ""))
        print(f"Decoding:    {'graphics card (VA-API)' if conf['hwaccel'] != 'none' else 'processor'}")
        if lock is not None:
            for where in ("desktop", "lockscreen"):
                on = lock_get(f"{where}-audio-enabled") == "true"
                vol = lock_get(f"{where}-audio-volume") or "0"
                print(f"Sound ({where}):".ljust(13) + (f"on, {round(float(vol) * 100)}%" if on else "off"))
            print(f"Auto-mute:   {'on' if lock_get('audio-auto-mute-on-other-media') == 'true' else 'off'}")
            print(f"Sync mode:   {'on' if lock_get('wallpaper-sync-mode') == 'true' else 'off'}")
        return 0
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
