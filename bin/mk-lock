#!/usr/bin/env python3
"""mk-lock: lock apps and folders behind your fingerprint (or password).

  mk-lock app add APP          ask before APP starts (APP: name or desktop id)
  mk-lock app remove APP       stop asking
  mk-lock app list
  mk-lock folder add PATH      encrypt PATH (gocryptfs); it opens only after
                               you confirm it's you
  mk-lock folder open PATH     confirm it's you, then show the files
  mk-lock folder close PATH    hide them again (encrypted on disk)
  mk-lock folder toggle PATH   open or close (the Files right-click script)
  mk-lock folder remove PATH   decrypt PATH for good
  mk-lock folder list
  mk-lock close-all            close every open locked folder
  mk-lock vault                open or close your vault: a hidden encrypted
                               folder (~/.vault), made the first time
  mk-lock password set|remove app APP | folder PATH
                               a password of its own for that app or folder,
                               typed instead of your fingerprint when you like
  mk-lock run -- COMMAND...    confirm it's you, then run COMMAND
  mk-lock reapply              re-lock apps after their launchers changed

How sure you can be:
  * Folders are really encrypted: the files on disk are unreadable without
    the key. The key is kept by root (mk-lock-key, /var/lib/mk-lock), and
    hands it out only after polkit asks for your fingerprint or password, so
    other programs in your unlocked session can't open the folder either.
    While a folder is open, anything running as you can read its files.
  * Apps are a gate, not a vault: the app's launcher (app grid, dock, search)
    asks first. Someone at your unlocked desktop could still start the
    program from a terminal, and an app that's already running just comes
    to the front.
The confirmation is polkit's "auth_self" (io.github.mehulk.mk-lock.unlock,
installed by setup.sh): fingerprint when a finger is enrolled, else password.
An item password (mk-lock password set) is an alternative, weaker than the
fingerprint check: for a folder it unlocks a copy of the folder's key sealed
with that password (Argon2id at its "sensitive" cost + NaCl secretbox), real
encryption, but someone with a copy of your files can try passwords offline,
so it must be long (10+ characters). For an app it is only a gate: a program
running as you could replace it, just as it could start the app directly.
"""
import base64
import configparser
import errno
import getpass
import hashlib
import json
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ACTION = "io.github.mehulk.mk-lock.unlock"
KEY_HELPER = "/usr/local/libexec/mk-lock-key"
HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "mk-workstation"
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
APPS_FILE = CONFIG / "locked-apps"
FOLDERS_FILE = CONFIG / "locked-folders"
ORIGINALS = DATA_HOME / "mk-workstation/lock-originals"
USER_APPS = DATA_HOME / "applications"
SELF = str(HOME / ".local/bin/mk-lock") if (HOME / ".local/bin/mk-lock").exists() else os.path.abspath(__file__)
MARK = "X-MK-Locked"
ITEMS = DATA_HOME / "mk-workstation/lock-items"   # item passwords (sealed keys / checks)
VAULT = HOME / ".vault"


def hello():
    """MK's unlock dialog (lib/mkworkstation/auth.py: Face ID, fingerprint,
    password) when there's a screen and no terminal to ask in; else None."""
    if sys.stdin.isatty() or not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        return None
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for candidate in (Path(__file__).resolve().parent.parent / "lib", Path(data_home) / "mk-workstation/lib"):
        if (candidate / "mkworkstation").is_dir():
            sys.path.insert(0, str(candidate))
            break
    try:
        from mkworkstation import auth
    except (ImportError, ValueError):
        return None
    return auth


def die(message, code=1):
    print(f"[-] {message}", file=sys.stderr)
    sys.exit(code)


def confirm_identity():
    """polkit asks: fingerprint (if enrolled) or your password. True if it was you."""
    if not shutil.which("pkcheck"):
        die("pkcheck (polkit) isn't installed")
    result = subprocess.run(["pkcheck", "--action-id", ACTION, "--process", str(os.getpid()),
                             "--allow-user-interaction"], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if result.returncode == 0:
        return True
    if "not registered" in result.stderr or "does not exist" in result.stderr:
        die("The mk-lock polkit action isn't installed yet. Run: ./setup.sh")
    return False


# ---------------------------------------------------------------- item passwords

def _nacl():
    try:
        from nacl import pwhash, secret, utils
        return pwhash, secret, utils
    except ImportError:
        die("Item passwords need PyNaCl: sudo dnf install python3-pynacl")


def item_file(kind, ident):
    return ITEMS / (hashlib.sha256(f"{kind}:{ident}".encode()).hexdigest()[:32] + ".json")


def _box(password, salt):
    pwhash, secret, _utils = _nacl()
    key = pwhash.argon2id.kdf(secret.SecretBox.KEY_SIZE, password.encode(), salt,
                              opslimit=pwhash.argon2id.OPSLIMIT_SENSITIVE, memlimit=pwhash.argon2id.MEMLIMIT_SENSITIVE)
    return secret.SecretBox(key)


def item_seal(kind, ident, password, payload):
    """Store PAYLOAD (a folder key, or a fixed word for apps) sealed with PASSWORD."""
    pwhash, _secret, utils = _nacl()
    salt = utils.random(pwhash.argon2id.SALTBYTES)
    sealed = _box(password, salt).encrypt(payload.encode())
    ITEMS.mkdir(parents=True, exist_ok=True)
    os.chmod(ITEMS, 0o700)
    target = item_file(kind, ident)
    target.write_text(json.dumps({"salt": base64.b64encode(salt).decode(),
                                  "sealed": base64.b64encode(bytes(sealed)).decode()}))
    os.chmod(target, 0o600)


def item_open(kind, ident, password):
    """The payload, or None for a wrong password."""
    from nacl.exceptions import CryptoError
    data = json.loads(item_file(kind, ident).read_text())
    try:
        return _box(password, base64.b64decode(data["salt"])).decrypt(base64.b64decode(data["sealed"])).decode()
    except CryptoError:
        return None


def ask_password(title, text, allow_fingerprint=True):
    """('password', pw), ('fingerprint', None) or (None, None) for cancel."""
    if sys.stdin.isatty():
        hint = " (empty: use your fingerprint instead)" if allow_fingerprint else ""
        pw = getpass.getpass(f"{text}{hint}: ")
        if not pw:
            return ("fingerprint", None) if allow_fingerprint else (None, None)
        return ("password", pw)
    if not shutil.which("zenity"):
        return ("fingerprint", None) if allow_fingerprint else (None, None)
    argv = ["zenity", "--entry", "--hide-text", f"--title={title}", f"--text={text}"]
    if allow_fingerprint:
        argv.append("--extra-button=Use fingerprint")
    result = subprocess.run(argv, capture_output=True, text=True)
    if allow_fingerprint and result.stdout.strip() == "Use fingerprint":
        return ("fingerprint", None)
    if result.returncode != 0:
        return (None, None)
    return ("password", result.stdout.rstrip("\n"))


def new_password(what):
    if sys.stdin.isatty():
        first = getpass.getpass(f"New password for {what}: ")
        if len(first) < 10:
            die("Use at least 10 characters (a short sentence works well).")
        if getpass.getpass("Again: ") != first:
            die("The two didn't match.")
        return first
    kind, pw = ask_password("MK Lock", f"New password for {what} (10+ characters)", allow_fingerprint=False)
    if not pw or len(pw) < 10:
        die("No password set (it needs at least 10 characters).")
    return pw


def unlock_app(app_id):
    """True when it's you: the app's own password, or fingerprint/password via polkit."""
    auth = hello()
    if auth:
        name = app_id.removesuffix(".desktop")
        check = None
        if item_file("app", app_id).exists():
            def check(pw):
                return item_open("app", app_id, pw) == "mk-lock"
        return auth.ask(f"Open {name}", check, placeholder="The app's password")[0]
    if item_file("app", app_id).exists():
        for _attempt in range(3):
            how, pw = ask_password("MK Lock", f"Password for {app_id}")
            if how == "fingerprint":
                break
            if how is None:
                return False
            if item_open("app", app_id, pw) == "mk-lock":
                return True
            notify_gui("Wrong password")
        else:
            return False
    return confirm_identity()


def folder_key(path):
    """The folder's key: its own password, or from the root key store after polkit."""
    auth = hello()
    if auth and item_file("folder", str(path)).exists():
        return folder_key_gui(auth, path)
    if item_file("folder", str(path)).exists():
        for _attempt in range(3):
            how, pw = ask_password("MK Lock", f"Password for {path.name}")
            if how == "fingerprint":
                break
            if how is None:
                die("Cancelled; the folder stays closed.")
            key = item_open("folder", str(path), pw)
            if key:
                return key
            print("Wrong password.", file=sys.stderr)
            notify_gui("Wrong password")
        else:
            die("Wrong password three times; the folder stays closed.")
    return key_lookup(path)


def folder_key_gui(auth, path):
    """The unlock dialog for a folder with its own password: typed here, or
    "Use the system prompt…" for polkit (fingerprint or account password)
    and the root key store. No Face ID or in-app fingerprint: those only say
    "it's you" to whoever asks, so they never release a key."""
    found = {}
    check = None
    if item_file("folder", str(path)).exists():
        def check(pw):
            key = item_open("folder", str(path), pw)
            if key:
                found["key"] = key
            return bool(key)

    def system(callback):
        import threading

        def work():
            result = subprocess.run(["pkexec", KEY_HELPER, "get", str(path)], capture_output=True, text=True)
            ok = result.returncode == 0 and bool(result.stdout)
            auth.GLib.idle_add(callback, ok, result.stdout if ok else None)
        threading.Thread(target=work, daemon=True).start()
    ok, payload = auth.ask(f"Open {path.name}", check, placeholder="The folder's password",
                           face=False, fingerprint=False, system=system)
    key = found.get("key") or payload
    if not ok or not key:
        die("Not confirmed; the folder stays closed.")
    return key


def cmd_password(args):
    if len(args) < 3 or args[0] not in ("set", "remove") or args[1] not in ("app", "folder"):
        die("Usage: mk-lock password set|remove app APP | folder PATH", 2)
    action, kind, target = args
    if kind == "app":
        ident = find_app(target) or target
        if ident not in read_list(APPS_FILE):
            die(f"{ident} isn't locked. Lock it first: mk lock app {target}")
    else:
        ident = str(Path(os.path.abspath(os.path.expanduser(target))))
        if ident not in read_list(FOLDERS_FILE):
            die(f"{ident} isn't a locked folder.")
    if action == "remove":
        item_file(kind, ident).unlink(missing_ok=True)
        print(f"✔ {ident}: own password removed (fingerprint or your login password only).")
        return
    if kind == "folder":
        payload = key_lookup(Path(ident))  # proves it's you before sealing the key again
    else:
        if not confirm_identity():
            die("Not confirmed; nothing changed.")
        payload = "mk-lock"
    item_seal(kind, ident, new_password(ident), payload)
    print(f"✔ {ident} can now also be opened with its own password.")


def read_list(path):
    try:
        return [line.strip() for line in path.read_text().splitlines() if line.strip() and not line.startswith("#")]
    except OSError:
        return []


def write_list(path, items):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(f"{item}\n" for item in dict.fromkeys(items)))


# ---------------------------------------------------------------- apps

def data_dirs():
    dirs = [DATA_HOME] + [Path(d) for d in (os.environ.get("XDG_DATA_DIRS") or
                                            "/usr/local/share:/usr/share").split(":") if d]
    for extra in (DATA_HOME / "flatpak/exports/share", Path("/var/lib/flatpak/exports/share")):
        if extra not in dirs:
            dirs.append(extra)
    return [d / "applications" for d in dirs]


def find_app(query):
    """A desktop id (org.gnome.Ptyxis or org.gnome.Ptyxis.desktop) or an app name."""
    want = query[:-8] if query.endswith(".desktop") else query
    candidates = {}
    for folder in data_dirs():
        for file in sorted(folder.glob("*.desktop")) if folder.is_dir() else []:
            candidates.setdefault(file.stem, file)
    if want in candidates:
        return want
    lowered = want.lower()
    for app_id, file in candidates.items():
        entry = parse(file)
        name = entry.get("Desktop Entry", "Name", fallback="") if entry else ""
        if name.lower() == lowered or app_id.lower().endswith("." + lowered):
            return app_id
    return None


def parse(path):
    entry = configparser.ConfigParser(interpolation=None, strict=False)
    entry.optionxform = str
    try:
        entry.read(path, encoding="utf-8")
    except (configparser.Error, OSError, UnicodeDecodeError):
        return None
    return entry if entry.has_section("Desktop Entry") else None


def original_file(app_id):
    """The launcher to wrap: yours (when not already wrapped), a saved copy of
    yours, or the system's."""
    user = USER_APPS / f"{app_id}.desktop"
    entry = parse(user) if user.exists() else None
    if entry and not entry.has_option("Desktop Entry", MARK):
        ORIGINALS.mkdir(parents=True, exist_ok=True)
        shutil.copy2(user, ORIGINALS / f"{app_id}.desktop")
        return user
    saved = ORIGINALS / f"{app_id}.desktop"
    if saved.exists():
        return saved
    for folder in data_dirs()[1:]:
        if (folder / f"{app_id}.desktop").exists():
            return folder / f"{app_id}.desktop"
    return None


def wrap(app_id):
    source = original_file(app_id)
    if not source:
        die(f"No launcher found for {app_id}")
    entry = parse(source)
    if not entry:
        die(f"Can't read {source}")
    for section in entry.sections():
        if section == "Desktop Entry" or section.startswith("Desktop Action "):
            if entry.has_option(section, "Exec"):
                entry.set(section, "Exec", f"env MK_LOCK_APP={app_id} {SELF} run -- {entry.get(section, 'Exec')}")
    # D-Bus activation would skip Exec (and so the check): launch through Exec.
    entry.set("Desktop Entry", "DBusActivatable", "false")
    entry.set("Desktop Entry", MARK, "true")
    if entry.has_option("Desktop Entry", "TryExec"):
        entry.remove_option("Desktop Entry", "TryExec")
    USER_APPS.mkdir(parents=True, exist_ok=True)
    with open(USER_APPS / f"{app_id}.desktop", "w", encoding="utf-8") as f:
        entry.write(f, space_around_delimiters=False)


def unwrap(app_id):
    user = USER_APPS / f"{app_id}.desktop"
    saved = ORIGINALS / f"{app_id}.desktop"
    entry = parse(user) if user.exists() else None
    if entry and entry.has_option("Desktop Entry", MARK):
        if saved.exists():
            shutil.move(str(saved), user)
        else:
            user.unlink()


def refresh_launchers():
    subprocess.run(["update-desktop-database", "-q", str(USER_APPS)], check=False)


def cmd_app(args):
    if not args:
        die("Usage: mk-lock app add|remove|list [APP]", 2)
    action, rest = args[0], args[1:]
    locked = read_list(APPS_FILE)
    if action == "list":
        print("\n".join(locked) if locked else "No locked apps.")
        return
    if not rest:
        die(f"Usage: mk-lock app {action} APP", 2)
    app_id = find_app(rest[0]) or (rest[0] if action == "remove" else None)
    if not app_id:
        die(f"No app called {rest[0]!r}. Try its desktop id, e.g. org.gnome.Ptyxis")
    if action == "add":
        wrap(app_id)
        write_list(APPS_FILE, locked + [app_id])
        refresh_launchers()
        print(f"✔ {app_id} now asks for your fingerprint or password when it starts.")
    elif action == "remove":
        unwrap(app_id)
        write_list(APPS_FILE, [a for a in locked if a != app_id])
        refresh_launchers()
        print(f"✔ {app_id} unlocked.")
    else:
        die("Usage: mk-lock app add|remove|list [APP]", 2)


def cmd_reapply():
    for app_id in read_list(APPS_FILE):
        wrap(app_id)
    refresh_launchers()


# ---------------------------------------------------------------- folders

def cipher_dir(path):
    return path.parent / f".{path.name}.mklock"


def key_helper(action, path, key=None):
    """The root-only key store, through pkexec: polkit asks for your
    fingerprint or password before it runs (every time)."""
    if not os.path.exists(KEY_HELPER):
        die("The mk-lock key store isn't installed yet. Run: ./setup.sh")
    result = subprocess.run(["pkexec", KEY_HELPER, action, str(path)], input=key,
                            capture_output=True, text=True)
    if result.returncode in (126, 127):
        die("Not confirmed; nothing changed.")
    if result.returncode != 0:
        die(f"Key store: {result.stderr.strip() or 'failed'}")
    return result.stdout


def key_store(path, key):
    key_helper("store", path, key)


def key_lookup(path):
    key = key_helper("get", path)
    if not key:
        die(f"No key stored for {path}.")
    return key


def is_open(path):
    return os.path.ismount(path)


def clear_stale_mount(path):
    """After a crash the FUSE mount can linger dead ("Transport endpoint is
    not connected"): unmount it so the folder can be opened again."""
    try:
        os.stat(path)
    except OSError as err:
        if err.errno == errno.ENOTCONN:
            subprocess.run(["fusermount3", "-uz", str(path)], check=False)


def mount(path, key, target=None):
    """Show PATH's encrypted store decrypted, at PATH (or at TARGET)."""
    subprocess.run(["gocryptfs", "-q", "-passfile", "/dev/stdin", str(cipher_dir(path)), str(target or path)],
                   input=key, text=True, check=True)


def unmount(path):
    subprocess.run(["fusermount3", "-u", str(path)], check=True)


def need_tools():
    for tool in ("gocryptfs", "pkexec", "fusermount3"):
        if not shutil.which(tool):
            die(f"{tool} isn't installed. Run: ./setup.sh (or sudo dnf install gocryptfs polkit fuse3)")


def folder_add(path, ask=True):
    need_tools()
    if not path.is_dir() or path == HOME or HOME not in path.parents:
        die("Pick a folder inside your home folder (not your home folder itself).")
    if cipher_dir(path).exists() or is_open(path):
        die(f"{path} is already locked.")
    answer = input(f"Encrypt {path}? Its files move into an encrypted store; nothing is deleted until "
                   "the copy is checked. [y/N]: ") if ask and sys.stdin.isatty() else "y"
    if not answer.lower().startswith("y"):
        return
    key = base64.b64encode(secrets.token_bytes(32)).decode()
    key_store(path, key)  # asks for your fingerprint or password; keeps the key root-only
    cipher = cipher_dir(path)
    cipher.mkdir()
    subprocess.run(["gocryptfs", "-q", "-init", "-passfile", "/dev/stdin", str(cipher)], input=key, text=True, check=True)
    with tempfile.TemporaryDirectory(prefix=".mklock-", dir=path.parent) as tmp:
        mount(path, key, tmp)
        try:
            subprocess.run(["cp", "-a", f"{path}/.", tmp], check=True)
            same = subprocess.run(["diff", "-rq", str(path), tmp], capture_output=True).returncode == 0
        finally:
            unmount(Path(tmp))
    if not same:
        die(f"The encrypted copy didn't match, so nothing was removed. {path} is unchanged; "
            f"delete {cipher} and try again.")
    for child in path.iterdir():
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child)
        else:
            child.unlink()
    write_list(FOLDERS_FILE, read_list(FOLDERS_FILE) + [str(path)])
    print(f"✔ {path} is encrypted and closed. Open it with: mk lock open {path}")


def folder_open(path):
    need_tools()
    clear_stale_mount(path)
    if is_open(path):
        print(f"{path} is already open.")
        return
    if not cipher_dir(path).is_dir():
        die(f"{path} isn't a locked folder.")
    path.mkdir(exist_ok=True)
    if any(path.iterdir()):
        die(f"{path} has files in it while it's closed (they were never encrypted). "
            "Move them somewhere else, open it, then move them back in.")
    key = folder_key(path)  # its own password, or fingerprint/password through polkit
    mount(path, key)
    print(f"✔ {path} is open. Close it with: mk lock close {path}")


def folder_close(path):
    if not is_open(path):
        print(f"{path} is already closed.")
        return
    unmount(path)
    print(f"✔ {path} closed.")


def folder_remove(path):
    need_tools()
    if not cipher_dir(path).is_dir():
        die(f"{path} isn't a locked folder.")
    key = folder_key(path)
    if is_open(path):
        unmount(path)
    with tempfile.TemporaryDirectory(prefix=".mklock-", dir=path.parent) as tmp:
        mount(path, key, tmp)
        try:
            subprocess.run(["cp", "-a", f"{tmp}/.", str(path)], check=True)
            same = subprocess.run(["diff", "-rq", tmp, str(path)], capture_output=True).returncode == 0
        finally:
            unmount(Path(tmp))
    if not same:
        die(f"The decrypted copy didn't match; the encrypted store {cipher_dir(path)} was kept.")
    shutil.rmtree(cipher_dir(path))
    key_helper("delete", path)
    item_file("folder", str(path)).unlink(missing_ok=True)
    write_list(FOLDERS_FILE, [f for f in read_list(FOLDERS_FILE) if f != str(path)])
    print(f"✔ {path} is a normal folder again.")


def cmd_vault():
    """~/.vault: made (empty, encrypted) the first time; then open or close.
    Opened, it shows in Files."""
    need_tools()
    clear_stale_mount(VAULT)  # folder_open checks too; is_open() below needs it first
    if not cipher_dir(VAULT).is_dir():
        print("Setting up your vault: a hidden folder (~/.vault), encrypted on disk.\n"
              "Its key is kept by the system and handed out only after you confirm it's you\n"
              "(fingerprint or your password), so confirm now to create it.")
        notify_gui("Setting up your vault: confirm it's you to create it")
        VAULT.mkdir(mode=0o700, exist_ok=True)
        folder_add(VAULT, ask=False)
        print("A passphrase of its own, as well (optional): mk-lock password set folder ~/.vault")
    for private in (VAULT, cipher_dir(VAULT)):
        if private.is_dir() and not is_open(private):
            os.chmod(private, 0o700)
    if is_open(VAULT):
        folder_close(VAULT)
        notify_gui("Vault closed")
        return
    folder_open(VAULT)
    subprocess.Popen(["gio", "open", str(VAULT)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def notify_gui(text):
    """Errors from the Files right-click script: show them, there's no terminal."""
    if not sys.stdin.isatty() and shutil.which("notify-send"):
        subprocess.run(["notify-send", "-e", "-t", "3500", "-i", "changes-prevent-symbolic", "MK Lock", text],
                       check=False)  # transient: a status, never left in the list


def cmd_folder(args):
    if not args:
        die("Usage: mk-lock folder add|open|close|toggle|remove|list [PATH]", 2)
    action = args[0]
    if action == "list":
        for folder in read_list(FOLDERS_FILE):
            print(f"{'open  ' if is_open(folder) else 'closed'}  {folder}")
        return
    if len(args) < 2:
        die(f"Usage: mk-lock folder {action} PATH", 2)
    path = Path(os.path.abspath(os.path.expanduser(args[1])))
    try:
        if action == "add":
            folder_add(path)
        elif action == "open":
            folder_open(path)
        elif action == "close":
            folder_close(path)
        elif action == "toggle":
            folder_close(path) if is_open(path) else folder_open(path)
        elif action == "remove":
            folder_remove(path)
        else:
            die("Usage: mk-lock folder add|open|close|toggle|remove|list [PATH]", 2)
    except subprocess.CalledProcessError as e:
        notify_gui(f"{action} failed for {path}")
        die(f"{' '.join(map(str, e.cmd[:2]))} failed ({e.returncode})")
    except SystemExit:
        notify_gui(f"{path}: not opened")
        raise


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if args[0] == "run":
        command = args[2:] if len(args) > 1 and args[1] == "--" else args[1:]
        if not command:
            die("Usage: mk-lock run -- COMMAND...", 2)
        app_id = os.environ.get("MK_LOCK_APP", "")
        if not (unlock_app(app_id) if app_id else confirm_identity()):
            notify_gui(f"{Path(command[0]).name}: not confirmed")
            die(f"Not confirmed; {Path(command[0]).name} didn't start.")
        os.environ.pop("MK_LOCK_APP", None)
        os.execvp(command[0], command)
    if args[0] == "app":
        cmd_app(args[1:])
    elif args[0] == "folder":
        cmd_folder(args[1:])
    elif args[0] == "close-all":
        for folder in read_list(FOLDERS_FILE):
            if is_open(folder):
                folder_close(Path(folder))
    elif args[0] == "reapply":
        cmd_reapply()
    elif args[0] == "password":
        cmd_password(args[1:])
    elif args[0] == "vault":
        cmd_vault()
    else:
        die(f"Unknown command {args[0]!r}. See: mk-lock --help", 2)
    return 0


if __name__ == "__main__":
    sys.exit(main())
