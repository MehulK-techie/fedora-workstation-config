    def _on_lasso_key(self, _ctrl, keyval, _code, state):
        ink = self.ink_canvas
        if ink.active and not state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.ALT_MASK) \
                and not isinstance(self.get_focus(), (Gtk.Text, Gtk.Entry)) \
                and not any(self.get_focus() is box.text_view for box in self.sticky_notes):
            # one-key tools while inking: P pen, H highlighter, E eraser, L lasso, T text box
            tool = {Gdk.KEY_p: "pen", Gdk.KEY_h: "highlighter", Gdk.KEY_e: "eraser", Gdk.KEY_l: "lasso"}.get(
                Gdk.keyval_to_lower(keyval))
            if tool:
                if not self.draw_toggle.get_active():
                    self.draw_toggle.set_active(True)
                self.ink_tool_btns[tool].set_active(True)
                return True
            if Gdk.keyval_to_lower(keyval) == Gdk.KEY_t:
                self.mode_btns["insert"].set_active(True)
                self.add_sticky_note(text_box=True)
                return True
        if not (ink.active and ink.tool == "lasso" and ink.selection):
            return False
        if keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            return ink.delete_selection()
        if keyval == Gdk.KEY_Escape:
            ink.select([], [])
            return True
        return False

    def _on_window_key_pressed(self, _ctrl, keyval, _code, _state):
        if self.selected_img and keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            self.remove_canvas_image(self.selected_img)
            return True
        if self.selected_img and keyval == Gdk.KEY_Escape:
            self.select_canvas_image(None)
            return True
        return False

    def _on_nb_toggle(self, btn):
        vis = btn.get_active()
        self.side_col.set_visible(vis)
        self.sep_side.set_visible(vis)

    def toggle_focus_canvas(self):
        """One click: both side panels away for a wide page; again: back."""
        if self.nb_toggle.get_active() or self.list_toggle.get_active():
            self._before_focus = (self.nb_toggle.get_active(), self.list_toggle.get_active())
            self.nb_toggle.set_active(False)
            self.list_toggle.set_active(False)
        else:
            nb, lst = getattr(self, "_before_focus", (True, True))
            self.nb_toggle.set_active(nb)
            self.list_toggle.set_active(lst)

    def _on_list_toggle(self, btn):
        vis = btn.get_active()
        self.list_col.set_visible(vis)
        self.sep_list.set_visible(vis)

    def _build_ink_subbar(self):
        bar = Gtk.Box(spacing=3, css_classes=["mk-inkbar"])
        self.ink_tool_btns = {}
        grp = None
        for tool, icon, label, tip in (
            ("pen", "document-edit-symbolic", "Pen", "Freehand Pen"),
            ("highlighter", "marker-symbolic", "Highlighter", "Translucent Marker"),
            ("eraser", "edit-clear-symbolic", "Stroke Eraser", "Touch any stroke to erase it"),
            ("lasso", "edit-select-symbolic", "Lasso",
             "Draw round ink, pictures or text to select them: drag to move, a corner to scale, Delete to remove"),
        ):
            b = Gtk.ToggleButton(icon_name=icon, tooltip_text=f"{label}: {tip}", group=grp,
                                 active=tool == "pen", css_classes=["flat", "mk-tool"])
            if tool == "highlighter":   # a chisel-tip marker (the theme has no marker icon)
                b.set_child(Gtk.Label(label="🖍"))
            grp = grp or b
            b.connect("toggled", lambda btn, t=tool: btn.get_active() and self._set_ink_tool(t))
            self.ink_tool_btns[tool] = b
            bar.append(b)
            if tool == "pen":
                self._pen_pop_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=8,
                                            margin_bottom=8, margin_start=8, margin_end=8)
                bar.append(Gtk.MenuButton(icon_name="pan-down-symbolic", css_classes=["flat"],
                                          popover=Gtk.Popover(child=self._pen_pop_box),
                                          tooltip_text="Pen colour and thickness"))
            if tool == "highlighter":
                bar.append(Gtk.MenuButton(icon_name="pan-down-symbolic", css_classes=["flat"],
                                          popover=self._highlighter_popover(), tooltip_text="Highlighter colour and size"))

        bar.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        # the pen's colours and thickness live in its ▾ popover
        pen_row = Gtk.Box(spacing=4)
        self._pen_pop_box.append(pen_row)
        self.ink_swatches = []
        for idx, color in enumerate(INK_COLORS):
            sw = Gtk.Button(css_classes=["mk-swatch", f"mk-ink-{idx}"], valign=Gtk.Align.CENTER)
            sw.connect("clicked", self._pick_ink_color, color)
            self.ink_swatches.append((sw, color))
            pen_row.append(sw)

        ink_rgba = Gdk.RGBA()
        ink_rgba.parse("#3b82f6")
        ink_col_btn = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(title="Pick Ink Color", with_alpha=False),
                                            rgba=ink_rgba, tooltip_text="Custom Ink Color")
        ink_col_btn.connect("notify::rgba", lambda b, _p: setattr(self.ink_canvas, "ink", rgba_to_hex(b.get_rgba())))
        pen_row.append(ink_col_btn)

        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 18, 1)
        scale.set_value(4.0)
        scale.set_size_request(200, -1)
        scale.set_draw_value(True)
        scale.connect("value-changed", lambda s: setattr(self.ink_canvas, "width", s.get_value()))
        self._pen_pop_box.append(Gtk.Label(label="Thickness", xalign=0, css_classes=["caption"]))
        self._pen_pop_box.append(scale)

        for icon, tip, cb in (
            ("edit-undo-symbolic", "Undo Stroke", lambda: self.ink_canvas.undo()),
            ("edit-redo-symbolic", "Redo Stroke", lambda: self.ink_canvas.redo()),
            ("edit-clear-all-symbolic", "Clear All Ink", lambda: self.ink_canvas.clear()),
        ):
            b = Gtk.Button(icon_name=icon, tooltip_text=tip, css_classes=["flat"])
            b.connect("clicked", lambda *_, f=cb: f())
            bar.append(b)

        return bar

    # ---------- the format card over selected text
    def _build_selection_card(self):
        """[Style] B I U [Colour] [List], floating above text you select in
        the page; gone when the selection is or focus leaves the page."""
        row = Gtk.Box(spacing=2, margin_top=2, margin_bottom=2, margin_start=2, margin_end=2)

        def btn(child, fn, tip):
            b = Gtk.Button(child=child, css_classes=["flat"], focus_on_click=False, tooltip_text=tip)
            b.connect("clicked", lambda *_: fn())
            row.append(b)

        def menu(label, items, tip):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=4, margin_bottom=4)
            pop = Gtk.Popover(child=box)
            for text, fn in items:
                b = Gtk.Button(label=text, css_classes=["flat"], focus_on_click=False)
                b.connect("clicked", lambda _b, f=fn: (pop.popdown(), f()))
                box.append(b)
            m = Gtk.MenuButton(label=label, css_classes=["flat"], popover=pop, tooltip_text=tip)
            m.set_focus_on_click(False)
            row.append(m)
        menu("H1 ▾", [(name, lambda i=i: self.style_drop.set_selected(i)) for i, name in
                      enumerate(["Body Text", "Heading 1", "Heading 2", "Heading 3", "Page Title"])], "Paragraph style")
        for markup, name, tip in (("<b>B</b>", "bold", "Bold"), ("<i>I</i>", "italic", "Italic"),
                                  ("<u>U</u>", "underline", "Underline")):
            lab = Gtk.Label()
            lab.set_markup(markup)
            btn(lab, lambda n=name: self.toggle_shortcut_format(n), tip)
        colour_box = self.text_colour_swatches(lambda c: (cpop.popdown(), self._colour_selection(c)))
        cpop = Gtk.Popover(child=colour_box)
        cm = Gtk.MenuButton(child=_colour_a_label(), css_classes=["flat"], popover=cpop, tooltip_text="Text colour")
        cm.set_focus_on_click(False)
        row.append(cm)
        menu("List ▾", [("• Bullets", lambda: self.toggle_line_prefix("• ")),
                        ("1. Numbers", lambda: self.toggle_line_prefix("1. ")),
                        ("☐ Checklist", lambda: self.toggle_line_prefix("☐ "))], "Lists")
        self.sel_card = Gtk.Popover(child=row, autohide=False, has_arrow=True, position=Gtk.PositionType.TOP,
                                    css_classes=["mk-sel-card"])
        self.sel_card.set_parent(self.view)
        self.buffer.connect("mark-set", lambda _b, _i, mark: mark.get_name() in ("insert", "selection_bound")
                            and self._queue_sel_card())
        leave = Gtk.EventControllerFocus()
        leave.connect("leave", lambda *_: GLib.timeout_add(120, self._sel_card_check))
        self.view.add_controller(leave)

    def _queue_sel_card(self):
        if not getattr(self, "_sel_card_id", 0):
            self._sel_card_id = GLib.timeout_add(90, self._sel_card_check)

    def _sel_card_check(self):
        self._sel_card_id = 0
        bounds = self.buffer.get_selection_bounds()
        focus = self.get_focus()
        in_card = focus is not None and focus.is_ancestor(self.sel_card)
        if not bounds or self.ink_canvas.active or getattr(self, "loading", False) or \
                not (focus is self.view or in_card):
            self.sel_card.popdown()
            return False
        rect = self.view.get_iter_location(bounds[0])
        x, y = self.view.buffer_to_window_coords(Gtk.TextWindowType.WIDGET, rect.x, rect.y)
        self.sel_card.set_pointing_to(Gdk.Rectangle(round(x), round(y), max(1, rect.width), rect.height))
        if not self.sel_card.get_visible():
            self.sel_card.popup()
        return False

    def _colour_selection(self, hex_colour):
        _name, tag = self._ensure_fg_tag(hex_colour)
        bounds = self.buffer.get_selection_bounds()
        if bounds:
            self.buffer.apply_tag(tag, *bounds)
            self.dirty = True
            self._queue_save()

    def _highlighter_popover(self):
        """The student highlighter: four pastels, three tip sizes, and
        whether a stroke snaps into a straight bar behind its line of text."""
        self.hl_colour, self.hl_width, self.hl_snap = HIGHLIGHTER_COLOURS[0][1], 24.0, False
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=8, margin_bottom=8,
                      margin_start=8, margin_end=8)
        colours = Gtk.Box(spacing=6)
        for name, colour in HIGHLIGHTER_COLOURS:
            sw = Gtk.Button(tooltip_text=name, css_classes=["mk-swatch"])
            prov = Gtk.CssProvider()
            prov.load_from_string(f"button {{ background: {colour}; }}")
            sw.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 3)
            sw.connect("clicked", lambda _b, c=colour: (setattr(self, "hl_colour", c),
                                                         self.ink_tool_btns["highlighter"].set_active(True)))
            colours.append(sw)
        box.append(colours)
        sizes = Gtk.Box(css_classes=["linked"])
        group = None
        for px in (12, 24, 36):
            b = Gtk.ToggleButton(label=f"{px}px", group=group, active=px == 24)
            group = group or b
            b.connect("toggled", lambda btn, v=px: btn.get_active() and setattr(self, "hl_width", float(v)))
            sizes.append(b)
        box.append(sizes)
        snap = Gtk.CheckButton(label="Snap to the line of text")
        snap.connect("toggled", lambda c: setattr(self, "hl_snap", c.get_active()))
        box.append(snap)
        return Gtk.Popover(child=box)

    def _set_mode(self, name):
        """Ink, Type or Insert: the deck shows; Ink turns the pen on, the
        others turn inking off (strokes stay as they are)."""
        self.deck_stack.set_visible_child_name(name)
        if name == "ink":
            if not (self.shapes_toggle.get_active() or self.laser_toggle.get_active()):
                self.draw_toggle.set_active(True)
        else:
            for t in (self.draw_toggle, self.shapes_toggle, self.laser_toggle, self.quick_hl):
                t.set_active(False)
            self.ink_canvas.set_ink_mode(False)

