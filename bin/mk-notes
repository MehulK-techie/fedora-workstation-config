#!/usr/bin/env python3
"""MK Notes: notes the way Obsidian, Apple Notes and Samsung Notes do them.

Your notes are Markdown files in ~/Notes (an Obsidian-compatible vault):
folders, pins and colours, [[links]] with backlinks and a graph, #tags,
checklists, callouts, paste or capture screenshots, draw and handwrite with a
pen (pressure-sensitive), export to PDF, publish the vault as a website,
version history for every note, and sync with your phone over Wi-Fi.

  mk-notes                open the window
  mk-notes NOTE           open a note (a path inside the vault, or a title)
  mk-notes --daily        open today's note
  mk-notes --quick        a small floating window to jot something into Inbox
  mk-notes --serve        phone sync only, no window
"""
