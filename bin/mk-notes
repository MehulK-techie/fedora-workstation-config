        self.status_bar.append(sb_z_out)

        self.sb_zoom_reset_btn = Gtk.Button(label="100%", tooltip_text="Reset Zoom to 100% (Ctrl+0)", css_classes=["flat"])
        self.sb_zoom_reset_btn.connect("clicked", lambda *_: self.set_zoom(1.0))
        self.status_bar.append(self.sb_zoom_reset_btn)

        sb_z_in = Gtk.Button(icon_name="zoom-in-symbolic", tooltip_text="Zoom In (Ctrl++)", css_classes=["flat"])
        sb_z_in.connect("clicked", lambda *_: self.set_zoom(self.zoom + 0.1))
