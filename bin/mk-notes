def _add_lib_path():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for candidate in (Path(__file__).resolve().parent.parent / "lib",
                      Path(data_home) / "mk-workstation/lib"):
        if (candidate / "mkworkstation").is_dir():
            sys.path.insert(0, str(candidate))
            return


_add_lib_path()
from mkworkstation import notes as nv  # noqa: E402
from mkworkstation import notes_sync  # noqa: E402


def open_uri(uri):
    """Web and mail links: your default browser or mail app (xdg-open)."""
    try:
        Gio.AppInfo.launch_default_for_uri(uri, None)
    except GLib.Error:
        try:
            Gio.Subprocess.new(["xdg-open", uri], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            pass


