        self.view.add_controller(ed_keys)

        ed_click = Gtk.GestureClick(button=1)
        ed_click.connect("released", self._on_editor_click)
        self.view.add_controller(ed_click)

        z_scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        z_scroll.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
