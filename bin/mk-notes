        self.mode.add(Adw.Toggle(name="split", icon_name="view-dual-symbolic", tooltip="Edit with live preview (Ctrl+\\)"))
        self.mode.add(Adw.Toggle(name="read", icon_name="view-reveal-symbolic", tooltip="Read (Ctrl+E)"))
        self.mode.set_active_name("edit")
        self.mode.connect("notify::active-name", lambda *_: self.set_mode(self.mode.get_active_name()))
        note_head.pack_start(self.mode)
        for icon, tip, action in (("camera-photo-symbolic", "Insert screenshot (Ctrl+Shift+S)", "win.screenshot"),
                                  ("document-edit-symbolic", "Draw or handwrite (Ctrl+Shift+P)", "win.draw"),
                                  ("insert-image-symbolic", "Insert image or file", "win.attach")):
            note_head.pack_start(Gtk.Button(icon_name=icon if icon != "document-edit-symbolic" else "applications-graphics-symbolic",
                                            tooltip_text=tip, action_name=action))
        self.calendar = Gtk.Calendar()
        self.calendar.connect("day-selected", self._on_calendar_day)
        self.calendar.connect("notify::month", lambda *_: self._mark_calendar())
        self.calendar.connect("notify::year", lambda *_: self._mark_calendar())
        cal_pop = Gtk.Popover(child=self.calendar)
        cal_pop.connect("show", lambda *_: self._mark_calendar())
        note_head.pack_start(Gtk.MenuButton(icon_name="x-office-calendar-symbolic", popover=cal_pop,
                                            tooltip_text="Daily notes calendar"))
        menu = Gio.Menu()
        section = Gio.Menu()
        for label, action in (("Preferences…", "win.preferences"), ("Focus mode (F11)", "win.focus")):
            section.append(label, action)
        menu.append_section(None, section)
        section = Gio.Menu()
        for label, action in (("Export to PDF…", "win.pdf"), ("Export to Word (.docx)…", "win.docx"),
                              ("Version history…", "win.history"),
                              ("Rename (F2)", "win.rename"), ("Delete note", "win.delete")):
            section.append(label, action)
        menu.append_section(None, section)
        section = Gio.Menu()
        for label, action in (("Graph view", "win.graph"), ("Today's note", "win.daily"),
                              ("Insert template…", "win.template"), ("Publish vault as website…", "win.publish")):
            section.append(label, action)
        menu.append_section(None, section)
        section = Gio.Menu()
        for label, action in (("Phone…", "win.phone"), ("Open vault folder", "win.open-folder"),
                              ("Keyboard shortcuts", "win.shortcuts")):
            section.append(label, action)
        menu.append_section(None, section)
        note_head.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu, tooltip_text="Menu"))
        self.info_toggle = Gtk.ToggleButton(icon_name="sidebar-show-right-symbolic", tooltip_text="Outline, backlinks, tags")
        note_head.pack_end(self.info_toggle)
        self.pin_btn = Gtk.ToggleButton(icon_name="view-pin-symbolic", tooltip_text="Pin")
        self.pin_btn.connect("toggled", self._on_pin_toggled)
        note_head.pack_end(self.pin_btn)
        note_box.append(note_head)

        self.title = Gtk.Entry(css_classes=["mk-title"], margin_start=40, margin_end=40, margin_top=8,
                               placeholder_text="Title")
        self.title.connect("activate", lambda *_: (self._commit_title(), self.view.grab_focus()))
        focus = Gtk.EventControllerFocus()
        focus.connect("leave", lambda *_: self._commit_title())
        self.title.add_controller(focus)
        note_box.append(self.title)
        self.meta = Gtk.Label(xalign=0, css_classes=["mk-status"], margin_start=40, margin_bottom=4)
        note_box.append(self.meta)

        self.formatbar = Gtk.Box(spacing=2, margin_start=36, margin_end=36, margin_bottom=4,
                                 css_classes=["mk-formatbar"])
        for icon, tip, cb in (
                ("format-text-bold-symbolic", "Bold (Ctrl+B)", lambda: self.wrap("**", "**")),
                ("format-text-italic-symbolic", "Italic (Ctrl+I)", lambda: self.wrap("*", "*")),
                ("format-text-strikethrough-symbolic", "Strikethrough", lambda: self.wrap("~~", "~~")),
                ("marker-symbolic", "Highlight", lambda: self.wrap("==", "==")),
                (None, None, None),
                ("format-text-larger-symbolic", "Heading (Ctrl+H)", self.cycle_heading),
                ("view-list-bullet-symbolic", "Bulleted list", lambda: self.line_prefix("- ")),
                ("view-list-ordered-symbolic", "Numbered list", lambda: self.line_prefix("1. ")),
                ("checkbox-checked-symbolic", "Checklist (Ctrl+L)", lambda: self.line_prefix("- [ ] ")),
                ("format-indent-more-symbolic", "Quote", lambda: self.line_prefix("> ")),
                (None, None, None),
                ("insert-link-symbolic", "Link to a note (Ctrl+K)", self.insert_link),
                ("view-grid-symbolic", "Table", self.insert_table),
                ("utilities-terminal-symbolic", "Code block", lambda: self.wrap("```\n", "\n```")),
                ("dialog-information-symbolic", "Callout", lambda: self.insert("> [!note] Title\n> ")),
                ("view-more-horizontal-symbolic", "Divider", lambda: self.insert("\n---\n"))):
            if icon is None:
                self.formatbar.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL, margin_start=4, margin_end=4))
                continue
            b = Gtk.Button(icon_name=icon, tooltip_text=tip, css_classes=["flat"])
            b.connect("clicked", lambda *_, f=cb: (f(), self.view.grab_focus()))
            self.formatbar.append(b)
        self.formatbar.append(Gtk.Box(hexpand=True))
        self.color_box = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        for name, color in [("None", "")] + COLORS:
            sw = Gtk.Button(css_classes=["mk-swatch"], tooltip_text=f"Colour: {name}", valign=Gtk.Align.CENTER)
            if color:
                sw.add_css_class(f"mk-c{[c for _n, c in COLORS].index(color)}")
            else:
                sw.set_icon_name("window-close-symbolic")
                sw.add_css_class("flat")
            sw.connect("clicked", lambda *_, c=color: self.set_color(c))
            self.color_box.append(sw)
        self.formatbar.append(self.color_box)
        note_box.append(self.formatbar)

        GtkSource.init()
        lang = GtkSource.LanguageManager.get_default().get_language("markdown")
        self.buffer = GtkSource.Buffer(language=lang, highlight_syntax=True)
        self._apply_scheme()
        Adw.StyleManager.get_default().connect("notify::dark", lambda *_: self._apply_scheme())
        self.view = GtkSource.View(buffer=self.buffer, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                   left_margin=24, right_margin=24, top_margin=10, bottom_margin=120,
                                   pixels_below_lines=4, css_classes=["mk-editor"], auto_indent=True,
                                   insert_spaces_instead_of_tabs=True, tab_width=4, smart_backspace=True)
        self.view.connect("paste-clipboard", self._on_paste)
        self.buffer.connect("changed", self._on_changed)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_editor_key)
        self.view.add_controller(keys)
        # Capture phase: ahead of the text view's own drop handling, which
        # would insert a dragged file's path as text.
        drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
        drop.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        drop.connect("drop", self._on_drop)
        self.view.add_controller(drop)
        # Ctrl+click a web address or [[link]] in the editor to open it.
        link_click = Gtk.GestureClick(button=1)
        link_click.connect("released", self._on_editor_click)
        self.view.add_controller(link_click)
        # [[ suggests note names as you type; Enter or Tab takes one.
        self._links_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self._links_list.connect("row-activated", lambda _l, row: self._complete_link(row.name))
        self._links_pop = Gtk.Popover(child=self._links_list, autohide=False, has_arrow=False,
                                      position=Gtk.PositionType.BOTTOM)
        self._links_pop.set_parent(self.view)
        self.buffer.connect("changed", lambda *_: GLib.idle_add(lambda: (self._update_links(), False)[1]))
        # Zoom: Ctrl+scroll, a touchpad pinch, Ctrl+plus/minus/0. Text, line
        # length and inline pictures scale together; the note itself is unchanged.
        self.zoom = 1.0
        zoom_scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        zoom_scroll.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        zoom_scroll.connect("scroll", self._on_zoom_scroll)
        self.view.add_controller(zoom_scroll)
        pinch = Gtk.GestureZoom()
        pinch.connect("begin", lambda *_: setattr(self, "_pinch_start", self.zoom))
        pinch.connect("scale-changed", lambda _g, scale: self.set_zoom(self._pinch_start * scale, quiet=True))
        self.view.add_controller(pinch)
        # Pictures under their ![[image]] lines, right in the editor.
        self._inline = []          # (picture, line number)
        self._inline_id = 0
        self._textures = {}        # path -> (mtime, texture)
        # The text keeps a comfortable line length however wide the window is.
        self.clamp = Adw.ClampScrollable(child=self.view, maximum_size=760, tightening_threshold=600)
        self.editor_scroll = Gtk.ScrolledWindow(child=self.clamp, vexpand=True, hexpand=True)

        self.web = WebKit.WebView(vexpand=True)
        settings = self.web.get_settings()
        settings.set_enable_developer_extras(False)
        transparent = Gdk.RGBA()
        transparent.parse("rgba(0,0,0,0)")
        self.web.set_background_color(transparent)
        self.web.connect("decide-policy", self._on_policy)
        manager = self.web.get_user_content_manager()
        manager.register_script_message_handler("mk", None)
        manager.connect("script-message-received::mk", self._on_web_message)

        # Edit, read, or both side by side with a live preview.
        self.web.set_hexpand(True)
        self.panes = Gtk.Paned(start_child=self.editor_scroll, end_child=self.web, wide_handle=False,
                               shrink_start_child=False, shrink_end_child=False)
        self.web.set_visible(False)

        self.info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_start=12, margin_end=12,
                            margin_top=8, width_request=250)
        info_scroll = Gtk.ScrolledWindow(child=self.info, css_classes=["mk-info"], hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.info_revealer = Gtk.Revealer(child=info_scroll, transition_type=Gtk.RevealerTransitionType.SLIDE_LEFT)
        self.info_toggle.bind_property("active", self.info_revealer, "reveal-child", 0)
        self.info_toggle.connect("toggled", lambda *_: self._fill_info())

        body = Gtk.Box()
        self.panes.set_hexpand(True)
        body.append(self.panes)
        body.append(self.info_revealer)
        note_box.append(body)

        self.toast = Adw.ToastOverlay(child=note_box)

        self.list_box = list_box
        inner = Gtk.Paned(start_child=list_box, end_child=self.toast, position=330,
                          shrink_start_child=False, resize_start_child=False)
        self.split = Adw.OverlaySplitView(sidebar=side_box, content=inner, min_sidebar_width=200,
                                          max_sidebar_width=260)
        self.side_toggle.bind_property("active", self.split, "show-sidebar", 2)
        # Narrow window (tablet mode, half screen): the sidebar slides over.
        bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 900sp"))
        bp.add_setter(self.split, "collapsed", True)
        self.add_breakpoint(bp)
        self.set_content(self.split)

    def _apply_scheme(self):
        dark = Adw.StyleManager.get_default().get_dark()
        scheme = GtkSource.StyleSchemeManager.get_default().get_scheme("Adwaita-dark" if dark else "Adwaita")
        if scheme:
            self.buffer.set_style_scheme(scheme)

    # ---------- actions and shortcuts ----------
    def _actions(self):
        table = (
            ("new", self.new_note, ["<Control>n"]),
            ("new-folder", self.new_folder, ["<Control><Shift>n"]),
            ("quick-open", self.quick_open, ["<Control>o"]),
            ("palette", self.palette, ["<Control>p"]),
            ("toggle-mode", lambda: self.mode.set_active_name("edit" if self.reading else "read"), ["<Control>e"]),
            ("find", lambda: self.search.grab_focus(), ["<Control>f"]),
            ("daily", lambda: self.open_note(self.vault.daily()), ["<Control><Shift>d"]),
            ("screenshot", self.screenshot, ["<Control><Shift>s"]),
            ("draw", self.draw, ["<Control><Shift>p"]),
            ("attach", self.attach, []),
            ("edit-image", self.edit_image, ["<Control><Shift>i"]),
            ("zoom-in", lambda: self.set_zoom(self.zoom * 1.1), ["<Control>plus", "<Control>equal"]),
            ("zoom-out", lambda: self.set_zoom(self.zoom / 1.1), ["<Control>minus"]),
            ("zoom-reset", lambda: self.set_zoom(1.0), ["<Control>0"]),
            ("pdf", self.export_pdf, ["<Control><Shift>e"]),
            ("docx", self.export_docx, []),
            ("history", self.show_history, []),
            ("rename", lambda: self.title.grab_focus(), ["F2"]),
            ("delete", self.delete_note, []),
            ("graph", self.show_graph, ["<Control>g"]),
            ("template", self.pick_template, ["<Control>t"]),
            ("publish", self.publish, []),
            ("phone", self.show_phone, []),
            ("open-folder", lambda: Gio.AppInfo.launch_default_for_uri(self.vault.root.as_uri(), None), []),
            ("preferences", self.show_preferences, ["<Control>comma"]),
            ("focus", self.toggle_focus, ["F11"]),
            ("split", lambda: self.mode.set_active_name("edit" if self.mode.get_active_name() == "split" else "split"),
             ["<Control>backslash"]),
            ("shortcuts", self.show_shortcuts, ["<Control>question"]),
            ("toggle-sidebar", lambda: self.side_toggle.set_active(not self.side_toggle.get_active()), ["F9"]),
            ("bold", lambda: self.wrap("**", "**"), ["<Control>b"]),
            ("italic", lambda: self.wrap("*", "*"), ["<Control>i"]),
            ("link", self.insert_link, ["<Control>k"]),
            ("heading", self.cycle_heading, ["<Control>h"]),
            ("checklist", lambda: self.line_prefix("- [ ] "), ["<Control>l"]),
        )
        app = self.get_application()
        for name, cb, accels in table:
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda *_a, f=cb: f())
            self.add_action(action)
            if accels:
                app.set_accels_for_action(f"win.{name}", accels)
        self.commands = [(n.replace("-", " ").capitalize(), ", ".join(a), n) for n, _cb, a in table]

    # ---------- list and sidebar ----------
    def _first_note(self):
        notes = self.vault.notes()
        return notes[0]["rel"] if notes else self.vault.create("", "Untitled")

    def refresh(self, keep_scope=True):
        self._fill_sidebar()
        if self.scope[0] == "tasks":
            self._fill_tasks()
            return
        notes = self._scoped_notes()
        signature = [(n["rel"], n["mtime"]) for n, _s in notes]
        pinned = self.vault.state["pinned"]
        if not self.search.get_text().strip():
            order = look_conf()["SORT"]
            secondary = {"title": lambda n: n["title"].lower(),
                         "folder": lambda n: (n["folder"].lower(), n["title"].lower())}.get(order, lambda n: -n["mtime"])
            notes.sort(key=lambda ns: (ns[0]["rel"] not in pinned,
                                       pinned.index(ns[0]["rel"]) if ns[0]["rel"] in pinned else 0,
                                       secondary(ns[0])))
        while (row := self.list.get_row_at_index(0)) is not None:
            self.list.remove(row)
        self.rows = {}
        for note, snip in notes:
            row = self._row(note, snip)
            self.list.append(row)
            if note["rel"] == self.rel:
                self.list.select_row(row)
        self.count_label.set_text(f"{len(notes)} note{'s' if len(notes) != 1 else ''}")
        self.signature = signature

    def _scoped_notes(self):
        query = self.search.get_text().strip()
        kind, value = self.scope
        if kind == "tag":
            query = f"tag:{value} {query}"
        if query:
            found = self.vault.search(query)
        else:
            found = [(n, None) for n in self.vault.notes()]
        out = []
        for note, snip in found:
            if kind == "pinned" and not self.vault.is_pinned(note["rel"]):
                continue
            if kind == "folder" and not (note["folder"] == value or note["folder"].startswith(value + "/")):
                continue
            if kind == "daily" and note["folder"] != "Daily":
                continue
            out.append((note, snip))
        return out

    def _row(self, note, snip):
        rel = note["rel"]
        key = (rel, note["mtime"])
        if snip is None:
            if key not in self.snippets:
                self.snippets[key] = snippet(self.vault.read(rel))
            snip = self.snippets[key]
        row = Gtk.ListBoxRow()
        row.rel = rel
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        top = Gtk.Box(spacing=6)
        color = self.vault.color(rel)
        if color:
            known = [c for _n, c in COLORS]
            if color in known:
                top.append(Gtk.Box(css_classes=["mk-dot", f"mk-c{known.index(color)}"], valign=Gtk.Align.CENTER))
        title = Gtk.Label(label=note["title"], xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END,
                          css_classes=["mk-row-title"])
        top.append(title)
        if self.vault.is_pinned(rel):
            top.append(Gtk.Image(icon_name="view-pin-symbolic", opacity=0.6))
        box.append(top)
        folder = f"  ·  {note['folder']}" if note["folder"] and self.scope[0] != "folder" else ""
        meta = Gtk.Label(label=f"{when(note['mtime'])}  {snip or 'No additional text'}{folder}", xalign=0,
                         ellipsize=Pango.EllipsizeMode.END, css_classes=["mk-row-meta"])
        box.append(meta)
        row.set_child(box)
        row.labels = (title, meta)
        # right-click / long-press menu
        click = Gtk.GestureClick(button=3)
        click.connect("pressed", lambda g, _n, x, y, r=row: self._row_menu(r, x, y))
        row.add_controller(click)
        press = Gtk.GestureLongPress()
        press.connect("pressed", lambda g, x, y, r=row: self._row_menu(r, x, y))
        row.add_controller(press)
        self.rows[rel] = row
        return row

    def _row_menu(self, row, x, y):
        rel = row.rel
        menu = Gio.Menu()
        menu.append("Unpin" if self.vault.is_pinned(rel) else "Pin", f"win.row-pin::{rel}")
        colors = Gio.Menu()
        for name, color in [("None", "")] + COLORS:
            colors.append(name, f"win.row-color::{rel}|{color}")
        menu.append_submenu("Colour", colors)
        move = Gio.Menu()
        move.append("Vault root", f"win.row-move::{rel}|")
        for folder in self.vault.folders():
            move.append(folder, f"win.row-move::{rel}|{folder}")
        menu.append_submenu("Move to", move)
        menu.append("Export to PDF", f"win.row-pdf::{rel}")
        menu.append("Export to Word", f"win.row-docx::{rel}")
        menu.append("Delete", f"win.row-delete::{rel}")
        for name, cb in (("row-pin", lambda r: (self.vault.set_pinned(r, not self.vault.is_pinned(r)), self.refresh())),
                         ("row-color", lambda v: (self.vault.set_color(*v.split("|", 1)), self.refresh())),
                         ("row-move", self._move),
                         ("row-pdf", lambda r: (self.open_note(r), self.export_pdf())),
                         ("row-docx", lambda r: (self.open_note(r), self.export_docx())),
                         ("row-delete", lambda r: (self.open_note(r), self.delete_note()))):
            if not self.lookup_action(name):
                action = Gio.SimpleAction.new(name, GLib.VariantType("s"))
                action.connect("activate", lambda _a, p, f=cb: f(p.get_string()))
                self.add_action(action)
        pop = Gtk.PopoverMenu.new_from_model(menu)
        pop.set_parent(row)
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = int(x), int(y), 1, 1
        pop.set_pointing_to(rect)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        pop.popup()

    def _move(self, value):
        rel, folder = value.split("|", 1)
        self._save_now()
        new = self.vault.rename(rel, new_folder=folder)
        if rel == self.rel:
            self.rel = new
        self.refresh()

    def _fill_sidebar(self):
        selected = self.scope
        self.sidebar.set_selection_mode(Gtk.SelectionMode.NONE)
        while (row := self.sidebar.get_row_at_index(0)) is not None:
            self.sidebar.remove(row)

        def add(label, icon, scope, indent=0, count=None):
            row = Gtk.ListBoxRow()
            row.scope = scope
            box = Gtk.Box(spacing=8, margin_start=indent * 14)
            box.append(Gtk.Image(icon_name=icon))
            box.append(Gtk.Label(label=label, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END))
            if count is not None:
                box.append(Gtk.Label(label=str(count), css_classes=["dim-label"]))
            row.set_child(box)
            self.sidebar.append(row)
            return row

        def header(text):
            row = Gtk.ListBoxRow(selectable=False, activatable=False)
            row.scope = None
            row.set_child(Gtk.Label(label=text, xalign=0, css_classes=["mk-info-head"], margin_top=8))
            self.sidebar.append(row)

        rows = [add("All notes", "view-list-symbolic", ("all", None), count=len(self.vault.notes())),
                add("Pinned", "view-pin-symbolic", ("pinned", None), count=len(self.vault.state["pinned"])),
                add("Daily notes", "x-office-calendar-symbolic", ("daily", None))]
        # Tasks are managed in the Companion (Super+Shift+N), not here.
        folders = [f for f in self.vault.folders() if f not in ("Daily", "Templates")]
        if folders:
            header("FOLDERS")
            for folder in folders:
                rows.append(add(folder.split("/")[-1], "folder-symbolic", ("folder", folder), folder.count("/")))
        tags = self.vault.all_tags()
        if tags:
            header("TAGS")
            for tag, count in tags[:40]:
                rows.append(add(f"#{tag}", "tag-symbolic", ("tag", tag), count=count))
        self.sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
        for row in rows:
            if row.scope == selected:
                self._quiet_scope = True
                self.sidebar.select_row(row)
                self._quiet_scope = False

    def _set_scope(self, scope, title):
        self.scope = scope
        self.list_title.set_title(title)
        self.refresh()

    def _on_scope(self, _box, row):
        if row is None or row.scope is None or getattr(self, "_quiet_scope", False):
            return
        if row.scope == self.scope:
            return
        self.scope = row.scope
        kind, value = row.scope
        titles = {"all": "All notes", "pinned": "Pinned", "daily": "Daily notes", "tasks": "Tasks"}
        self.list_title.set_title(titles.get(kind) or (f"#{value}" if kind == "tag" else value.split("/")[-1]))
        GLib.idle_add(self.refresh)
        if self.split.get_collapsed():
            self.side_toggle.set_active(False)

    # ---------- open, edit, save ----------
    def open_note(self, rel):
        if not rel:
            return
        self._save_now()
        self._commit_title()
        if not self.vault.path(rel).exists():
            return
        self.rel = rel
        self._rendered = None
        self.loading = True
        self.buffer.begin_irreversible_action()
        self.buffer.set_text(self.vault.read(rel))
        self.buffer.end_irreversible_action()
        self.buffer.place_cursor(self.buffer.get_start_iter())
        self.loading = False
        self.dirty = False
        self.last_written = self.vault.path(rel).stat().st_mtime
        self.title.set_text(Path(rel).stem)
        self._quiet_pin = True
        self.pin_btn.set_active(self.vault.is_pinned(rel))
        self._quiet_pin = False
        self._update_meta()
        self.vault.state["last"] = rel
        self.vault.save_state()
        row = self.rows.get(rel)
        if row:
            self.list.select_row(row)
        if self.reading or getattr(self, "splitting", False):
            self._render()
        self._fill_info()
        self._queue_inline()

    # ---------- zoom ----------
    def _on_zoom_scroll(self, ctrl, _dx, dy):
        if not ctrl.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK:
            return False
        self.set_zoom(self.zoom * (0.9 if dy > 0 else 1.1))
        return True

    def set_zoom(self, zoom, quiet=False):
        zoom = max(0.6, min(2.5, zoom))
        if abs(zoom - self.zoom) < 0.01:
            return
        self.zoom = zoom
        self.apply_look()
        self._queue_inline()
        if not quiet:
            if getattr(self, "_zoom_toast", None):
                self._zoom_toast.dismiss()
            self._zoom_toast = Adw.Toast(title=f"Zoom {round(zoom * 100)}% · Ctrl+0 resets", timeout=1)
            self.toast.add_toast(self._zoom_toast)

    # ---------- pictures inline in the editor ----------
    # Each ![[image.png]] line gets blank space below it (a text tag, so the
    # note's text is untouched and undo isn't affected) with the picture laid
    # over that space. Click a picture to edit it.
    def _queue_inline(self):
        if self._inline_id:
            GLib.source_remove(self._inline_id)
        self._inline_id = GLib.timeout_add(250, self._layout_inline)

    def _inline_texture(self, path):
        mtime = path.stat().st_mtime
        cached = self._textures.get(path)
        if cached and cached[0] == mtime:
            return cached[1]
        try:
            texture = Gdk.Texture.new_from_filename(str(path))
        except GLib.Error:
            return None
        self._textures[path] = (mtime, texture)
        return texture

    def _layout_inline(self):
        self._inline_id = 0
        for picture, _line in self._inline:
            self.view.remove(picture)
        self._inline = []
        table = self.buffer.get_tag_table()
        start, end = self.buffer.get_bounds()
        table.foreach(lambda tag: tag.get_property("name") and tag.get_property("name").startswith("mk-inline-")
                      and self.buffer.remove_tag(tag, start, end))
        if not self.rel:
            return GLib.SOURCE_REMOVE
        width = max(160, self.view.get_width() - 96)
        default = min(width, 520 * self.zoom)
        for line_no in range(self.buffer.get_line_count()):
            ok, it = self.buffer.get_iter_at_line(line_no)
            line_end = it.copy()
            if not line_end.ends_line():
                line_end.forward_to_line_end()
            match = EMBED_LINE.match(self.buffer.get_text(it, line_end, False))
            if not match:
                continue
            name = match.group(1).strip()
            try:
                path = self.vault.path(f"attachments/{name}")
                if not path.is_file():
                    rel = self.vault.resolve(name)
                    path = self.vault.path(rel) if rel else None
            except ValueError:
                path = None
            texture = self._inline_texture(path) if path and path.is_file() else None
            if not texture:
                continue
            # ![[name|300]] sets its width (the reading view honours it too).
            wanted = int(match.group(2)) * self.zoom if match.group(2) else default
            w = round(min(width, wanted, texture.get_width() * max(1.0, self.zoom)))
            h = round(w * texture.get_height() / max(1, texture.get_width()))
            tag_name = f"mk-inline-{h}"
            tag = table.lookup(tag_name) or self.buffer.create_tag(tag_name, pixels_below_lines=h + 14)
            self.buffer.apply_tag(tag, it, line_end)
            picture = Gtk.Picture(paintable=texture, can_shrink=True, content_fit=Gtk.ContentFit.CONTAIN,
                                  css_classes=["mk-inline-image"],
                                  tooltip_text=f"{name} · click to edit · drag the right edge to resize",
                                  cursor=Gdk.Cursor.new_from_name("pointer"), overflow=Gtk.Overflow.HIDDEN)
            picture.set_size_request(w, h)
            click = Gtk.GestureClick()
            click.connect("released", lambda *_a, p=path, n=line_no: self.edit_image(p, n))
            picture.add_controller(click)
            # Resize in place: drag near the right edge; the width goes into the line.
            edge = Gtk.EventControllerMotion()
            edge.connect("motion", lambda _c, x, _y, pic=picture: pic.set_cursor(Gdk.Cursor.new_from_name(
                "ew-resize" if x > pic.get_width() - 18 else "pointer")))
            picture.add_controller(edge)
            drag = Gtk.GestureDrag()
            drag.connect("drag-begin", self._resize_begin, picture, click)
            drag.connect("drag-update", self._resize_update, picture, texture)
            drag.connect("drag-end", self._resize_end, picture, line_no)
            picture.add_controller(drag)
            self.view.add_overlay(picture, 0, 0)
            self._inline.append((picture, line_no))
        # Positions are known once the text has been laid out with the new spacing.
        GLib.idle_add(self._place_inline)
        return GLib.SOURCE_REMOVE

    def _resize_begin(self, gesture, x, _y, picture, click):
        if x < picture.get_width() - 18:
            gesture.set_state(Gtk.EventSequenceState.DENIED)  # an ordinary click: edit
            return
        click.reset()
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        picture._mk_start = picture.get_size_request()[0]

    def _resize_update(self, _g, dx, _dy, picture, texture):
        start = getattr(picture, "_mk_start", None)
        if start is None:
            return
        w = max(60, min(self.view.get_width() - 96, round(start + dx)))
        picture.set_size_request(w, round(w * texture.get_height() / max(1, texture.get_width())))

    def _resize_end(self, _g, _dx, _dy, picture, line_no):
        if getattr(picture, "_mk_start", None) is None:
            return
        picture._mk_start = None
        width = round(picture.get_size_request()[0] / self.zoom)
        ok, start = self.buffer.get_iter_at_line(line_no)
        end = start.copy()
        if not end.ends_line():
            end.forward_to_line_end()
        line = self.buffer.get_text(start, end, False)
        match = EMBED_LINE.match(line)
        if not match:
            return
        new = re.sub(r"!\[\[([^\]|#]+?)(?:\|[^\]]*)?\]\]", lambda m: f"![[{m.group(1)}|{width}]]", line, count=1)
        self.buffer.begin_user_action()
        self.buffer.delete(start, end)
        self.buffer.insert(start, new)
        self.buffer.end_user_action()

    def _place_inline(self):
        for picture, line_no in self._inline:
            ok, it = self.buffer.get_iter_at_line(line_no)
            if not ok:
                continue
            y, height = self.view.get_line_yrange(it)
            _w, h = picture.get_size_request()
            self.view.move_overlay(picture, self.view.get_left_margin(), y + height - h - 8)
        return GLib.SOURCE_REMOVE

    def edit_image(self, path=None, line_no=None):
        """Open the image editor for a picture (or the one on the cursor's line)."""
        if path is None:
            it = self.buffer.get_iter_at_mark(self.buffer.get_insert())
            line_no = it.get_line()
            ok, start = self.buffer.get_iter_at_line(line_no)
            end = start.copy()
            if not end.ends_line():
                end.forward_to_line_end()
            match = EMBED_LINE.match(self.buffer.get_text(start, end, False))
            if not match:
                self.toast.add_toast(Adw.Toast(title="Put the cursor on an ![[image]] line first"))
                return
            rel = self.vault.resolve(match.group(1).strip())
            path = self.vault.path(rel) if rel else None
            if not path:
                return
        try:
            import PIL  # noqa: F401
        except ImportError:
            self.toast.add_toast(Adw.Toast(title="The image editor needs Pillow: sudo dnf install python3-pillow"))
            return

        def saved(data, ext, stem):
            rel = self.vault.save_attachment(data, ext, stem)
            new_name = Path(rel).name
            ok, start = self.buffer.get_iter_at_line(line_no)
            end = start.copy()
            if not end.ends_line():
                end.forward_to_line_end()
            line = self.buffer.get_text(start, end, False)
            if EMBED_LINE.match(line):
                self.buffer.begin_user_action()
                self.buffer.delete(start, end)
                self.buffer.insert(start, re.sub(r"!\[\[[^\]|#]+", f"![[{new_name}", line, count=1))
                self.buffer.end_user_action()
            self.toast.add_toast(Adw.Toast(title=f"Saved {new_name}; the original is kept", timeout=3))
        ImageEditor(self, str(path), saved).present()

    def _update_meta(self):
        if not self.rel:
            return
        text = self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False)
        words = len(re.findall(r"\w+", text))
        folder = Path(self.rel).parent.as_posix()
        folder = "" if folder == "." else f"{folder}  ·  "
        edited = when(self.vault.path(self.rel).stat().st_mtime) if self.vault.path(self.rel).exists() else ""
        minutes = max(1, round(words / 220)) if words else 0
        reading = f"  ·  {minutes} min read" if minutes else ""
        self.meta.set_text(f"{folder}{words} words{reading}  ·  edited {edited}")

    def _on_changed(self, _buf):
        if self.loading or not self.rel:
            return
        self.dirty = True
        self._queue_inline()
        if getattr(self, "splitting", False):
            if getattr(self, "_preview_id", 0):
                GLib.source_remove(self._preview_id)
            self._preview_id = GLib.timeout_add(250, lambda: (setattr(self, "_preview_id", 0), self._render(), False)[2])
        if self.save_id:
            GLib.source_remove(self.save_id)
        self.save_id = GLib.timeout_add(600, self._save_now)

    def _save_now(self):
        if self.save_id:
            GLib.source_remove(self.save_id)
            self.save_id = 0
        if self.dirty and self.rel:
            text = self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False)
            lock = self.server.lock if self.server else None
            if lock:
                lock.acquire()
            try:
                self.vault.write(self.rel, text)
            finally:
                if lock:
                    lock.release()
            self.last_written = self.vault.path(self.rel).stat().st_mtime
            self.dirty = False
            row = self.rows.get(self.rel)
            if row:
                row.labels[1].set_text(f"{when(time.time())}  {snippet(text) or 'No additional text'}")
            self._update_meta()
        return GLib.SOURCE_REMOVE

    def _commit_title(self):
        if not self.rel:
            return
        new = self.title.get_text().strip()
        if not new or new == Path(self.rel).stem:
            return
        self._save_now()
        self.rel = self.vault.rename(self.rel, new)
        self.title.set_text(Path(self.rel).stem)
        self.refresh()

    def _poll(self):
        """Notes changed by Obsidian, the phone or another program."""
        if self.rel and not self.dirty:
            try:
                mtime = self.vault.path(self.rel).stat().st_mtime
                if mtime > self.last_written + 0.01:
                    cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert()).get_offset()
                    self.open_note(self.rel)
                    self.buffer.place_cursor(self.buffer.get_iter_at_offset(cursor))
            except OSError:
                self.rel = None
                self.open_note(self._first_note())
        current = [(n["rel"], n["mtime"]) for n, _s in self._scoped_notes()]
        if self.signature is not None and current != self.signature and not self.search.has_focus():
            if {r for r, _m in current} != {r for r, _m in self.signature}:
                self.refresh()
            else:
                self.signature = current
        return GLib.SOURCE_CONTINUE

    def new_note(self, title="Untitled", text=""):
        self._save_now()
        kind, value = self.scope
        folder = value if kind == "folder" else ""
        if kind == "tag" and not text:
            text = f"\n\n#{value}"
        rel = self.vault.create(folder, title, text)
        self.refresh()
        self.open_note(rel)
        if self.reading:
            self.mode.set_active_name("edit")
        self.title.grab_focus()
        self.title.select_region(0, -1)

    def new_folder(self):
        dialog = Adw.AlertDialog(heading="New folder")
        entry = Gtk.Entry(placeholder_text="Folder name", activates_default=True)
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("create", "Create")
        dialog.set_default_response("create")
        dialog.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)

        def done(d, response):
            if response == "create" and entry.get_text().strip():
                parent = self.scope[1] if self.scope[0] == "folder" else ""
                folder = self.vault.create_folder(entry.get_text().strip(), parent)
                self.scope = ("folder", folder)
                self.list_title.set_title(folder.split("/")[-1])
                self.refresh()
        dialog.connect("response", done)
        dialog.present(self)

    def delete_note(self):
        if not self.rel:
            return
        rel = self.rel
        self._save_now()
        self.vault.delete(rel)
        self.rel = None
        self.refresh()
        self.open_note(self._first_note())
        toast = Adw.Toast(title=f"“{Path(rel).stem}” moved to the vault's trash", button_label="Undo", timeout=6)

        def undo(*_):
            trash = self.vault.root / ".trash" / rel
            if trash.exists():
                self.vault.path(rel).parent.mkdir(parents=True, exist_ok=True)
                trash.rename(self.vault.path(rel))
                self.vault.state["deleted"].pop(rel, None)
                self.vault.save_state()
                self.refresh()
                self.open_note(rel)
        toast.connect("button-clicked", undo)
        self.toast.add_toast(toast)

    def _on_pin_toggled(self, btn):
        if getattr(self, "_quiet_pin", False) or not self.rel:
            return
        self.vault.set_pinned(self.rel, btn.get_active())
        self.refresh()

    def set_color(self, color):
        if self.rel:
            self.vault.set_color(self.rel, color)
            self.refresh()

    # ---------- editing helpers ----------
    def insert(self, text):
        self.buffer.delete_selection(True, True)
        self.buffer.insert_at_cursor(text)

    def wrap(self, before, after):
        if self.reading:
            return
        bounds = self.buffer.get_selection_bounds()
        if bounds:
            start, end = bounds
            text = self.buffer.get_text(start, end, False)
            self.buffer.begin_user_action()
            self.buffer.delete(start, end)
            self.buffer.insert(start, before + text + after)
            self.buffer.end_user_action()
        else:
            self.buffer.insert_at_cursor(before + after)
            it = self.buffer.get_iter_at_mark(self.buffer.get_insert())
            it.backward_chars(len(after))
            self.buffer.place_cursor(it)

    def _selected_lines(self):
        bounds = self.buffer.get_selection_bounds()
        if bounds:
            return bounds[0].get_line(), bounds[1].get_line()
        line = self.buffer.get_iter_at_mark(self.buffer.get_insert()).get_line()
        return line, line

    def line_prefix(self, prefix):
        if self.reading:
            return
        first, last = self._selected_lines()
        self.buffer.begin_user_action()
        number = 1
        for line in range(first, last + 1):
            ok, start = self.buffer.get_iter_at_line(line)
            end = start.copy()
            end.forward_to_line_end()
            text = self.buffer.get_text(start, end, False)
            stripped = re.sub(r"^(\s*)([-*+] \[.\] |[-*+] |\d+\. |> )", r"\1", text)
            want = prefix if prefix != "1. " else f"{number}. "
            if text.lstrip().startswith(want.strip()) and stripped != text and prefix != "1. ":
                new = stripped
            else:
                new = re.match(r"\s*", stripped).group(0) + want + stripped.lstrip()
            number += 1
            self.buffer.delete(start, end)
            self.buffer.insert(start, new)
        self.buffer.end_user_action()

    def cycle_heading(self):
        if self.reading:
            return
        line = self.buffer.get_iter_at_mark(self.buffer.get_insert()).get_line()
        ok, start = self.buffer.get_iter_at_line(line)
        end = start.copy()
        end.forward_to_line_end()
        text = self.buffer.get_text(start, end, False)
        m = re.match(r"^(#{1,6}) ", text)
        level = len(m.group(1)) if m else 0
        body = text[m.end():] if m else text
        new = ("#" * (level + 1) + " " if level < 3 else "") + body
        self.buffer.begin_user_action()
        self.buffer.delete(start, end)
        self.buffer.insert(start, new)
        self.buffer.end_user_action()

    def insert_link(self):
        items = [(n["title"], n["folder"], n["rel"]) for n in self.vault.notes()]
        Picker("Link to a note", items, lambda rel: self.insert(f"[[{Path(rel).stem}]]"),
               "Type a note name…", on_create=lambda name: self.insert(f"[[{name}]]")).present(self)

    def insert_table(self):
        self.insert("\n| Column | Column | Column |\n| --- | --- | --- |\n|  |  |  |\n|  |  |  |\n")

    # ---------- [[link]] suggestions ----------
    def _link_query(self):
        """The text typed after an open [[ on this line, or None."""
        cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        ok, start = self.buffer.get_iter_at_line(cursor.get_line())
        before = self.buffer.get_text(start, cursor, False)
        m = re.search(r"\[\[([^\]|#\[]*)$", before)
        return m.group(1) if m else None

    def _update_links(self):
        query = self._link_query()
        if query is None:
            self._links_pop.popdown()
            return
        q = query.lower()
        names = [n["title"] for n in self.vault.notes()]
        hits = sorted((n for n in names if q in n.lower()), key=lambda n: (not n.lower().startswith(q), n.lower()))[:8]
        while (child := self._links_list.get_first_child()):
            self._links_list.remove(child)
        for name in hits:
            row = Gtk.ListBoxRow()
            row.name = name
            row.set_child(Gtk.Label(label=name, xalign=0, margin_start=8, margin_end=8, margin_top=4, margin_bottom=4))
            self._links_list.append(row)
        if not hits:
            self._links_pop.popdown()
            return
        self._links_list.select_row(self._links_list.get_row_at_index(0))
        cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        rect = self.view.get_iter_location(cursor)
        x, y = self.view.buffer_to_window_coords(Gtk.TextWindowType.WIDGET, rect.x, rect.y)
        self._links_pop.set_pointing_to(Gdk.Rectangle(x=x, y=y, width=1, height=rect.height))
        self._links_pop.popup()

    def _complete_link(self, name):
        query = self._link_query()
        if query is None:
            return
        cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        start = cursor.copy()
        start.backward_chars(len(query))
        self.buffer.begin_user_action()
        self.buffer.delete(start, cursor)
        after = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        close = after.copy()
        has_close = close.forward_chars(2) and self.buffer.get_text(after, close, False) == "]]"
        self.buffer.insert_at_cursor(name if has_close else name + "]]")
        self.buffer.end_user_action()
        self._links_pop.popdown()

    def _links_key(self, keyval):
        """Up/Down/Enter/Tab/Escape while suggestions show."""
        if not self._links_pop.get_visible():
            return False
        row = self._links_list.get_selected_row()
        if keyval in (Gdk.KEY_Down, Gdk.KEY_Up):
            i = (row.get_index() if row else -1) + (1 if keyval == Gdk.KEY_Down else -1)
            nxt = self._links_list.get_row_at_index(max(0, i))
            if nxt:
                self._links_list.select_row(nxt)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_Tab) and row:
            self._complete_link(row.name)
            return True
        if keyval == Gdk.KEY_Escape:
            self._links_pop.popdown()
            return True
        return False

    def _on_editor_key(self, _c, keyval, _code, state):
        """Lists continue on Enter, as in Apple Notes and Obsidian."""
        if self._links_key(keyval):
            return True
        if keyval not in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) or state & (Gdk.ModifierType.SHIFT_MASK | Gdk.ModifierType.CONTROL_MASK):
            return False
        cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        ok, start = self.buffer.get_iter_at_line(cursor.get_line())
        text = self.buffer.get_text(start, cursor, False)
        m = re.match(r"^(\s*)([-*+] \[[ xX]\] |[-*+] |(\d+)\. |> )(.*)$", text)
        if not m:
            return False
        indent, marker, number, rest = m.group(1), m.group(2), m.group(3), m.group(4)
        if not rest.strip():
            # empty item: end the list
            self.buffer.delete(start, cursor)
            return False
        if number:
            marker = f"{int(number) + 1}. "
        elif "[" in marker:
            marker = marker[:2] + "[ ] "
        self.buffer.insert_at_cursor("\n" + indent + marker)
        self.view.scroll_mark_onscreen(self.buffer.get_insert())
        return True

    # ---------- images, screenshots, files, drawings ----------
    def _insert_attachment(self, rel, image=True):
        name = Path(rel).name
        self.insert(f"\n![[{name}]]\n" if image else f"![[{name}]]")

    # Paste, best first: copied files (Files, the file chooser), then an
    # image (screenshots, "Copy image" in a browser, which also offers the
    # image's address as text), then text. Text that is nothing but paths or
    # file:// addresses of existing files attaches those files, so a copied
    # file never lands in the note as "/home/…/Image.png".
    @staticmethod
    def _wl_paste_image():
        """The clipboard's image, read fresh with wl-paste (Wayland): never an
        older picture GTK may still hold. (bytes, ext) or None."""
        if not os.environ.get("WAYLAND_DISPLAY") or not shutil.which("wl-paste"):
            return None
        try:
            types = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True,
                                   timeout=2).stdout.split()
        except (OSError, subprocess.SubprocessError):
            return None
        if "text/uri-list" in types or "x-special/gnome-copied-files" in types:
            return None  # copied files: handled as files
        for mime, ext in (("image/png", ".png"), ("image/jpeg", ".jpg"), ("image/webp", ".webp")):
            if mime in types:
                try:
                    data = subprocess.run(["wl-paste", "--no-newline", "-t", mime], capture_output=True,
                                          timeout=5).stdout
                except (OSError, subprocess.SubprocessError):
                    return None
                return (data, ext) if data else None
        return None

    def _on_paste(self, view):
        clipboard = self.get_clipboard()
        formats = clipboard.get_formats()
        view.stop_emission_by_name("paste-clipboard")
        image = self._wl_paste_image()
        if image:
            rel = self.vault.save_attachment(image[0], image[1])
            self._insert_attachment(rel)
            self.toast.add_toast(Adw.Toast(title="Image pasted", timeout=2))
            return
        if formats.contain_gtype(Gdk.FileList):
            def got_files(c, res):
                try:
                    self._add_files(c.read_value_finish(res).get_files())
                except GLib.Error:
                    self._paste_text(c)
            clipboard.read_value_async(Gdk.FileList, GLib.PRIORITY_DEFAULT, None, got_files)
        elif formats.contain_gtype(Gdk.Texture):
            def got(c, res):
                try:
                    texture = c.read_texture_finish(res)
                except GLib.Error:
                    self._paste_text(c)
                    return
                rel = self.vault.save_attachment(texture.save_to_png_bytes().get_data(), ".png")
                self._insert_attachment(rel)
                self.toast.add_toast(Adw.Toast(title="Image pasted", timeout=2))
            clipboard.read_texture_async(None, got)
        else:
            self._paste_text(clipboard)

    def _paste_text(self, clipboard):
        def got(c, res):
            try:
                text = c.read_text_finish(res)
            except GLib.Error:
                return
            if not text:
                return
            files = self._files_in_text(text)
            if files:
                self._add_files(files)
            elif self.view.get_editable():
                self.buffer.begin_user_action()
                self.buffer.delete_selection(True, True)
                self.buffer.insert_interactive_at_cursor(text, -1, True)
                self.buffer.end_user_action()
                self.view.scroll_mark_onscreen(self.buffer.get_insert())
        clipboard.read_text_async(None, got)

    @staticmethod
    def _files_in_text(text):
        """Gio.Files when every line is a path or file:// address of an existing file."""
        lines = [line.strip() for line in text.strip().splitlines() if line.strip()]
        if not lines or len(lines) > 50:
            return []
        files = []
        for line in lines:
            if line.startswith("file://"):
                gfile = Gio.File.new_for_uri(line)
            elif line.startswith(("/", "~/")):
                gfile = Gio.File.new_for_path(os.path.expanduser(line))
            else:
                return []
            path = gfile.get_path()
            if not path or not os.path.isfile(path):
                return []
            files.append(gfile)
        return files

    def _on_editor_click(self, gesture, _n, x, y):
        if not gesture.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK:
            return
        bx, by = self.view.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, int(x), int(y))
        ok, where = self.view.get_iter_at_location(bx, by)
        if not ok:
            return
        line_start = where.copy()
        line_start.set_line_offset(0)
        line_end = where.copy()
        if not line_end.ends_line():
            line_end.forward_to_line_end()
        line = self.buffer.get_text(line_start, line_end, True)
        column = where.get_line_offset()
        for match in re.finditer(r"\[\[([^\]|#]+)[^\]]*\]\]|(https?://|mailto:)[^\s<>()\[\]]+", line):
            if match.start() <= column <= match.end():
                if match.group(1):
                    target = match.group(1).strip()
                    rel = self.vault.resolve(target)
                    if not rel:
                        rel = self.vault.create("", target)
                        self.refresh()
                    self.open_note(rel)
                else:
                    open_uri(match.group(0).rstrip(".,;:!?'\""))
                gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                return

    def _on_drop(self, _target, value, _x, _y):
        self._add_files(value.get_files())
        return True

    def _add_files(self, files):
        for f in files:
            path = Path(f.get_path() or "")
            if not path.is_file():
                continue
            if path.suffix == ".md" and self.vault.root in path.resolve().parents:
                self.insert(f"[[{path.stem}]]")
                continue
            rel = self.vault.save_attachment(path.read_bytes(), path.suffix.lower(), path.stem)
            self._insert_attachment(rel, path.suffix.lower() in nv.IMAGE_EXT)

    def attach(self):
        dialog = Gtk.FileDialog(title="Insert image or file")

        def chosen(d, res):
            try:
                self._add_files(list(d.open_multiple_finish(res)))
            except GLib.Error:
                pass  # cancelled
        dialog.open_multiple(self, None, chosen)

    def screenshot(self):
        if self.reading:
            self.mode.set_active_name("edit")

        def done(path):
            if not path:
                return
            data = Path(path).read_bytes()
            Path(path).unlink(missing_ok=True)  # the portal saved a copy in Pictures
            rel = self.vault.save_attachment(data, ".png", f"Screenshot {datetime.now():%Y%m%d%H%M%S}")
            self._insert_attachment(rel)
            self.present()
        self.set_visible(False)  # get out of the way while you pick an area
        GLib.timeout_add(250, lambda: (take_screenshot(lambda p: (self.set_visible(True), done(p))), False)[1])

    def draw(self):
        if self.reading:
            self.mode.set_active_name("edit")
        # Editing an existing drawing: the cursor is on its ![[...svg]] line.
        cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        ok, start = self.buffer.get_iter_at_line(cursor.get_line())
        end = start.copy()
        end.forward_to_line_end()
        line = self.buffer.get_text(start, end, False)
        m = re.search(r"!\[\[([^\]]+\.svg)\]\]", line)
        existing = self.vault.resolve(m.group(1)) if m else None
        data = read_drawing(self.vault.path(existing)) if existing else None

        def save(svg):
            if existing:
                self.vault.path(existing).write_bytes(svg)
                if self.reading:
                    self._render()
                self.toast.add_toast(Adw.Toast(title="Drawing updated", timeout=2))
            else:
                rel = self.vault.save_attachment(svg, ".svg", f"Drawing {datetime.now():%Y%m%d%H%M%S}")
                self._insert_attachment(rel)
        dark = Adw.StyleManager.get_default().get_dark()
        DrawingWindow(self, save, strokes=(data or {}).get("strokes"),
                      paper=(data or {}).get("paper", "dark" if dark else "light"),
                      pattern=(data or {}).get("pattern", "plain")).present()

    # ---------- reading view ----------
    # ---------- tasks across the vault ----------
    def _fill_tasks(self):
        while (row := self.list.get_row_at_index(0)) is not None:
            self.list.remove(row)
        self.rows = {}
        query = self.search.get_text().strip().lower()
        tasks = [t for t in self.vault.tasks() if not query or query in t[2].lower()]
        open_count = 0
        for rel, number, text, done in tasks:
            open_count += not done
            row = Gtk.ListBoxRow()
            row.rel = rel
            box = Gtk.Box(spacing=10)
            check = Gtk.CheckButton(active=done, valign=Gtk.Align.START)
            check.connect("toggled", lambda _c, r=rel, n=number: self._toggle_task(r, n))
            box.append(check)
            labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            clean = re.sub(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]", lambda m: m.group(2) or m.group(1), text)
            labels.append(Gtk.Label(label=clean, xalign=0, wrap=True, css_classes=["mk-row-title"] if not done else ["dim-label"]))
            labels.append(Gtk.Label(label=Path(rel).stem, xalign=0, css_classes=["mk-row-meta"]))
            box.append(labels)
            row.set_child(box)
            row.labels = (labels.get_first_child(), labels.get_last_child())
            self.list.append(row)
        self.count_label.set_text(f"{open_count} open · {len(tasks) - open_count} done")
        self.signature = None

    def _toggle_task(self, rel, number):
        if rel == self.rel:
            self._save_now()
        self.vault.toggle_task(rel, number)
        if rel == self.rel:
            self.open_note(rel)
        GLib.idle_add(lambda: (self.refresh(), False)[1])

    # ---------- daily notes calendar ----------
    def _mark_calendar(self):
        self.calendar.clear_marks()
        date = self.calendar.get_date()
        for day in range(1, 32):
            try:
                rel = f"Daily/{date.get_year():04d}-{date.get_month():02d}-{day:02d}.md"
            except ValueError:
                continue
            if self.vault.path(rel).exists():
                self.calendar.mark_day(day)

    def _on_calendar_day(self, calendar):
        date = calendar.get_date()
        rel = self.vault.daily(datetime(date.get_year(), date.get_month(), date.get_day_of_month()))
        self.refresh()
        self.open_note(rel)
        self._mark_calendar()

    # ---------- focus mode ----------
    def toggle_focus(self):
        self.focused = not getattr(self, "focused", False)
        if self.focused:
            self._before_focus = (self.side_toggle.get_active(), self.info_toggle.get_active())
            self.side_toggle.set_active(False)
            self.info_toggle.set_active(False)
            self.fullscreen()
        else:
            self.unfullscreen()
            self.side_toggle.set_active(self._before_focus[0])
            self.info_toggle.set_active(self._before_focus[1])
        self.list_box.set_visible(not self.focused)
        self.formatbar.set_visible(not self.focused and look_conf()["FORMAT_BAR"] != "off")
        if self.focused:
            self.toast.add_toast(Adw.Toast(title="Focus mode · F11 to come back", timeout=2))

    # ---------- preferences ----------
    def apply_look(self):
        conf = look_conf()
        Adw.StyleManager.get_default().set_color_scheme({
            "light": Adw.ColorScheme.FORCE_LIGHT, "dark": Adw.ColorScheme.FORCE_DARK}.get(
            conf["THEME"], Adw.ColorScheme.DEFAULT))
        look = self._look()
        spacing = SPACINGS.get(conf["SPACING"], SPACINGS["comfortable"])[1]
        zoom = getattr(self, "zoom", 1.0)
        css = (f".mk-editor, .mk-editor text {{ font-family: {look['font']}; "
               f"font-size: {look['size'] * zoom:.1f}px; }}")
        if not getattr(self, "_look_css", None):
            self._look_css = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self._look_css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self._look_css.load_from_string(css)
        self.view.set_pixels_below_lines(int(look["size"] * (spacing - 1.2)))
        self.view.set_pixels_inside_wrap(int(look["size"] * (spacing - 1.25)))
        width = WIDTHS.get(conf["WIDTH"], WIDTHS["medium"])[1]
        self.clamp.set_maximum_size(int(width * zoom) if width else 10000)
        if getattr(self, "web", None):
            self.web.set_zoom_level(zoom)
        self.formatbar.set_visible(conf["FORMAT_BAR"] != "off" and not getattr(self, "focused", False))
        self._rendered = None
        if self.reading or getattr(self, "splitting", False):
            self._render()

    def show_preferences(self):
        conf = look_conf()
        dialog = Adw.PreferencesDialog(title="Preferences")
        page = Adw.PreferencesPage(title="Appearance", icon_name="applications-graphics-symbolic")

        def choice(group, title, key, options, subtitle=None):
            keys = list(options)
            row = Adw.ComboRow(title=title, subtitle=subtitle or "",
                               model=Gtk.StringList.new([options[k][0] if isinstance(options[k], tuple) else options[k] for k in keys]))
            row.set_selected(keys.index(conf[key]) if conf[key] in keys else 0)
            row.connect("notify::selected", lambda r, _p: (conf_set(key, keys[r.get_selected()]), self.apply_look(),
                                                          self.refresh()))
            group.add(row)

        looks = Adw.PreferencesGroup(title="Look")
        choice(looks, "Style", "THEME", {"system": "Follow the system", "light": "Light", "dark": "Dark"})
        choice(looks, "Font", "FONT", FONTS)
        size = Adw.SpinRow.new_with_range(12, 26, 1)
        size.set_title("Text size")
        size.set_value(int(conf["FONT_SIZE"] or 16))
        size.connect("notify::value", lambda r, _p: (conf_set("FONT_SIZE", str(int(r.get_value()))), self.apply_look()))
        looks.add(size)
        choice(looks, "Line length", "WIDTH", WIDTHS, "How wide text runs before it wraps")
        choice(looks, "Line spacing", "SPACING", SPACINGS)
        page.add(looks)

        editing = Adw.PreferencesGroup(title="Writing")
        bar = Adw.SwitchRow(title="Formatting bar", active=conf["FORMAT_BAR"] != "off")
        bar.connect("notify::active", lambda r, _p: (conf_set("FORMAT_BAR", "on" if r.get_active() else "off"),
                                                    self.apply_look()))
        editing.add(bar)
        graph = Adw.SwitchRow(title="Graph view", subtitle="Ctrl+G; off keeps it out of the way on slower computers",
                              active=conf.get("GRAPH", "on") != "off")
        graph.connect("notify::active", lambda r, _p: conf_set("GRAPH", "on" if r.get_active() else "off"))
        editing.add(graph)
        choice(editing, "Open notes in", "OPEN_IN", {"edit": "Edit", "split": "Edit with preview", "read": "Read"})
        choice(editing, "Sort notes by", "SORT", {"edited": "Last edited", "title": "Title", "folder": "Folder"})
        page.add(editing)

        vault = Adw.PreferencesGroup(title="Notes folder",
                                     description="Any folder of Markdown files works, an Obsidian vault included.")
        where = Adw.ActionRow(title=str(self.vault.root), subtitle="Where your notes live")
        change = Gtk.Button(label="Change…", valign=Gtk.Align.CENTER)
        where.add_suffix(change)
        vault.add(where)
        history = Adw.SwitchRow(title="Version history", subtitle="Keep earlier versions of every note",
                                active=nv.load_conf().get("HISTORY", "on") != "off")
        history.connect("notify::active", lambda r, _p: (conf_set("HISTORY", "on" if r.get_active() else "off"),
                                                        setattr(self.vault, "history_enabled", r.get_active())))
        vault.add(history)
        page.add(vault)

        def pick_folder(*_):
            def chosen(d, res):
                try:
                    folder = d.select_folder_finish(res)
                except GLib.Error:
                    return
                self._save_now()
                conf_set("NOTES_DIR", folder.get_path())
                self.vault = nv.Vault(folder.get_path())
                if self.server:
                    self.server.vault = self.vault
                where.set_title(str(self.vault.root))
                self.rel = None
                self.scope = ("all", None)
                self.refresh()
                self.open_note(self._first_note())
            Gtk.FileDialog(title="Choose your notes folder").select_folder(self, None, chosen)
        change.connect("clicked", pick_folder)
        dialog.add(page)
        dialog.present(self)

    def set_mode(self, mode):
        """edit, split (edit with a live preview) or read."""
        self._save_now()
        self.reading = mode == "read"
        self.splitting = mode == "split"
        self.formatbar.set_sensitive(not self.reading)
        self.editor_scroll.set_visible(not self.reading)
        self.web.set_visible(mode != "edit")
        if self.splitting:
            GLib.idle_add(lambda: self.panes.set_position(self.panes.get_width() // 2) and False)
        if mode != "edit":
            self._render()
        if not self.reading:
            self.view.grab_focus()

    def set_reading(self, reading):  # kept for callers that only know read/edit
        self.mode.set_active_name("read" if reading else "edit")

    def _look(self):
        conf = look_conf()
        width = WIDTHS.get(conf["WIDTH"], WIDTHS["medium"])[1]
        return {"font": FONTS.get(conf["FONT"], FONTS["sans"])[1], "size": int(conf["FONT_SIZE"] or 16),
                "width": width if not getattr(self, "splitting", False) else 0,
                "spacing": SPACINGS.get(conf["SPACING"], SPACINGS["comfortable"])[1]}

    def _render(self):
        if not self.rel:
            return
        dark = Adw.StyleManager.get_default().get_dark()
        text = self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False)
        if getattr(self, "_rendered", None) == self.rel and self.splitting:
            # Live preview: swap the content in place so the scroll position stays.
            body = json.dumps(self.vault.render(self.rel, text))
            self.web.evaluate_javascript(f"document.getElementById('mk-body').innerHTML = {body};", -1,
                                         None, None, None, None)
            return
        self._rendered = self.rel
        self.web.load_html(self.vault.page(self.rel, text, dark=dark, look=self._look()),
                           self.vault.path(self.rel).parent.as_uri() + "/")

    def _on_policy(self, _web, decision, kind):
        # NEW_WINDOW_ACTION: links meant for a new tab (middle click,
        # target=_blank); they open in the browser the same way.
        if kind not in (WebKit.PolicyDecisionType.NAVIGATION_ACTION, WebKit.PolicyDecisionType.NEW_WINDOW_ACTION):
            return False
        uri = decision.get_navigation_action().get_request().get_uri()
        if uri.startswith(("about:", "file:")) and decision.get_navigation_action().get_navigation_type() == WebKit.NavigationType.OTHER:
            return False
        decision.ignore()
        if uri.startswith("mknote:"):
            target = GLib.uri_unescape_string(uri[7:], None).split("#")[0]
            rel = self.vault.resolve(target)
            if not rel:
                rel = self.vault.create("", target)
                self.refresh()
            self.open_note(rel)
        elif uri.startswith("mktag:"):
            self.search.set_text(f"tag:{uri[6:]}")
        elif uri.startswith(("http:", "https:", "mailto:")):
            open_uri(uri)
        elif uri.startswith("file:"):
            self._open_attachment(Gio.File.new_for_uri(uri))
        return True

    def _open_attachment(self, gfile):
        """Attachments open in their app; anything that could run (scripts,
        programs, launchers) is only shown in Files. Nothing outside the vault."""
        path = Path(gfile.get_path() or "")
        try:
            path.resolve().relative_to(self.vault.root)
        except ValueError:
            return
        risky = {".desktop", ".sh", ".bash", ".py", ".pl", ".rb", ".js", ".jar", ".appimage", ".run", ".bin",
                 ".exe", ".msi", ".bat", ".cmd", ".flatpakref", ".rpm", ".deb"}
        if path.suffix.lower() in risky or os.access(path, os.X_OK):
            bus = Gio.bus_get_sync(Gio.BusType.SESSION)
            bus.call("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1", "org.freedesktop.FileManager1",
                     "ShowItems", GLib.Variant("(ass)", ([path.as_uri()], "")), None, Gio.DBusCallFlags.NONE, -1, None, None)
        else:
            Gio.AppInfo.launch_default_for_uri(path.as_uri(), None)

    def _on_web_message(self, _manager, value):
        message = value.to_string()
        if message.startswith("task:") and self.rel:
            self.vault.toggle_task(self.rel, int(message[5:]))
            self.last_written = self.vault.path(self.rel).stat().st_mtime
            self.loading = True
            self.buffer.set_text(self.vault.read(self.rel))
            self.loading = False

    # ---------- info pane: outline, backlinks, tags ----------
    def _fill_info(self):
        if not self.info_toggle.get_active() or not self.rel:
            return
        while (child := self.info.get_first_child()) is not None:
            self.info.remove(child)
        text = self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False)

        def head(label):
            self.info.append(Gtk.Label(label=label, xalign=0, css_classes=["mk-info-head"]))

        def link(label, cb, indent=0, sub=None):
            b = Gtk.Button(css_classes=["flat"], margin_start=indent * 12)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.append(Gtk.Label(label=label, xalign=0, ellipsize=Pango.EllipsizeMode.END))
            if sub:
                box.append(Gtk.Label(label=sub, xalign=0, ellipsize=Pango.EllipsizeMode.END, css_classes=["mk-row-meta"]))
            b.set_child(box)
            b.connect("clicked", lambda *_: cb())
            self.info.append(b)

        head("OUTLINE")
        for level, heading in self.vault.outline(text) or [(1, "No headings")]:
            link(heading, lambda h=heading: self._jump_to_heading(h), level - 1)
        head("BACKLINKS")
        backlinks = self.vault.backlinks(self.rel)
        for rel, line in backlinks:
            link(Path(rel).stem, lambda r=rel: self.open_note(r), sub=line)
        if not backlinks:
            self.info.append(Gtk.Label(label="No other note links here", xalign=0, css_classes=["dim-label"]))
        head("LINKS")
        for target in dict.fromkeys(self.vault.links(text)):
            link(target, lambda t=target: self.open_note(self.vault.resolve(t) or self.vault.create("", t)))
        head("TAGS")
        for tag in self.vault.tags(text):
            link(f"#{tag}", lambda t=tag: self.search.set_text(f"tag:{t}"))

    def _jump_to_heading(self, heading):
        if self.reading:
            self.mode.set_active_name("edit")
        found = self.buffer.get_start_iter().forward_search(heading, Gtk.TextSearchFlags.TEXT_ONLY, None)
        if found:
            self.buffer.place_cursor(found[0])
            self.view.scroll_to_iter(found[0], 0.1, True, 0, 0.1)

    # ---------- PDF, publish, history, graph, templates ----------
    def export_pdf(self):
        if not self.rel:
            return
        self._save_now()
        dialog = Gtk.FileDialog(title="Export to PDF", initial_name=f"{Path(self.rel).stem}.pdf")
        # Straight to a PDF file (no print dialog), suggested in ~/Documents/Notes.
        docs = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or Path.home() / "Documents") / "Notes"
        try:
            docs.mkdir(parents=True, exist_ok=True)
            dialog.set_initial_folder(Gio.File.new_for_path(str(docs)))
        except OSError:
            pass

        def chosen(d, res):
            try:
                target = d.save_finish(res)
            except GLib.Error:
                return
            rel = self.rel

            def work():
                try:
                    self.vault.pdf(rel, target.get_path())
                    GLib.idle_add(done, None)
                except ImportError:
                    GLib.idle_add(fallback)
                except Exception as e:  # noqa: BLE001 - report any rendering failure
                    GLib.idle_add(done, str(e))

            def done(error):
                if error:
                    self.toast.add_toast(Adw.Toast(title=f"PDF failed: {error}"))
                    return
                self._last_pdf = target.get_uri()
                self.toast.add_toast(Adw.Toast(title=f"Saved {target.get_basename()}", button_label="Open",
                                               action_name="win.open-last-pdf", timeout=5))
                note = Gio.Notification.new("PDF ready")
                note.set_body(target.get_basename())
                note.set_default_action_and_target("app.open-uri", GLib.Variant("s", target.get_uri()))
                self.get_application().send_notification("pdf", note)

            def fallback():
                # No WeasyPrint yet: offer to install it (once), then export,
                # instead of the print dialog.
                ask = Adw.AlertDialog(heading="Install PDF export?",
                                      body="MK Notes makes PDFs with WeasyPrint, which isn't installed yet "
                                           "(about 10 MB). Install it now? Your password is asked once.")
                ask.add_response("cancel", "Cancel")
                ask.add_response("install", "Install and export")
                ask.set_response_appearance("install", Adw.ResponseAppearance.SUGGESTED)

                def answered(dlg, res):
                    if dlg.choose_finish(res) != "install":
                        return
                    self.toast.add_toast(Adw.Toast(title="Installing PDF export…", timeout=3))

                    def install():
                        ok = subprocess.run(["pkexec", "dnf", "install", "-y", "python3-weasyprint"],
                                            capture_output=True).returncode == 0
                        if ok:
                            import importlib
                            importlib.invalidate_caches()
                            work()
                        else:
                            GLib.idle_add(done, "WeasyPrint couldn't be installed (sudo dnf install python3-weasyprint)")
                    threading.Thread(target=install, daemon=True).start()
                ask.choose(self, None, answered)
            threading.Thread(target=work, daemon=True).start()
        if not self.lookup_action("open-last-pdf"):
            action = Gio.SimpleAction.new("open-last-pdf", None)
            action.connect("activate", lambda *_: Gio.AppInfo.launch_default_for_uri(self._last_pdf, None))
            self.add_action(action)
        dialog.save(self, None, chosen)

    def export_docx(self):
        """A Word document (.docx), written directly (no print dialog, no
        extra software), suggested in ~/Documents/Notes."""
        if not self.rel:
            return
        self._save_now()
        dialog = Gtk.FileDialog(title="Export to Word", initial_name=f"{Path(self.rel).stem}.docx")
        docs = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or Path.home() / "Documents") / "Notes"
        try:
            docs.mkdir(parents=True, exist_ok=True)
            dialog.set_initial_folder(Gio.File.new_for_path(str(docs)))
        except OSError:
            pass

        def chosen(d, res):
            try:
                target = d.save_finish(res)
            except GLib.Error:
                return
            from mkworkstation import docx

            def image(name):
                rel = self.vault.resolve(name)
                return self.vault.path(rel) if rel else None
            try:
                docx.write(self.vault.read(self.rel), target.get_path(), image, title=Path(self.rel).stem)
            except (OSError, ValueError) as e:
                self.toast.add_toast(Adw.Toast(title=f"Word export failed: {e}"))
                return
            self._last_pdf = target.get_uri()  # the Open button opens the last export
            self.toast.add_toast(Adw.Toast(title=f"Saved {target.get_basename()}", button_label="Open",
                                           action_name="win.open-last-pdf", timeout=5))
            if not self.lookup_action("open-last-pdf"):
                action = Gio.SimpleAction.new("open-last-pdf", None)
                action.connect("activate", lambda *_: Gio.AppInfo.launch_default_for_uri(self._last_pdf, None))
                self.add_action(action)
        dialog.save(self, None, chosen)

    def publish(self):
        dialog = Gtk.FileDialog(title="Publish to a folder (for GitHub Pages or any web host)")

        def chosen(d, res):
            try:
                folder = d.select_folder_finish(res)
            except GLib.Error:
                return
            out = self.vault.publish(Path(folder.get_path()) / "mk-notes-site")
            Gio.AppInfo.launch_default_for_uri((out / "index.html").as_uri(), None)
            self.toast.add_toast(Adw.Toast(title=f"Website saved in {out}", timeout=5))
        dialog.select_folder(self, None, chosen)

    def show_history(self):
        if not self.rel:
            return
        self._save_now()
        versions = self.vault.history(self.rel)
        dialog = Adw.Dialog(title=f"History · {Path(self.rel).stem}", content_width=860, content_height=600)
        view = Adw.ToolbarView()
        head = Adw.HeaderBar()
        restore = Gtk.Button(label="Restore this version", css_classes=["suggested-action"], sensitive=False)
        head.pack_end(restore)
        view.add_top_bar(head)
        listbox = Gtk.ListBox(css_classes=["navigation-sidebar"])
        preview = Gtk.TextView(editable=False, wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=16, right_margin=16,
                               top_margin=12, monospace=True)
        for stamp, path in versions:
            row = Adw.ActionRow(title=stamp.strftime("%d %b %Y, %H:%M"))
            row.path = path
            listbox.append(row)
        if not versions:
            listbox.set_placeholder(Gtk.Label(label="No earlier versions yet.\nOne is kept every few minutes while you edit.",
                                              css_classes=["dim-label"], margin_top=30, justify=Gtk.Justification.CENTER))

        def selected(_l, row):
            restore.set_sensitive(row is not None)
            if row:
                preview.get_buffer().set_text(row.path.read_text(encoding="utf-8", errors="replace"))
        listbox.connect("row-selected", selected)

        def do_restore(*_):
            row = listbox.get_selected_row()
            if row:
                self.buffer.set_text(row.path.read_text(encoding="utf-8", errors="replace"))
                self._save_now()
                dialog.close()
                self.toast.add_toast(Adw.Toast(title="Version restored (the previous text is in history too)", timeout=4))
        restore.connect("clicked", do_restore)
        paned = Gtk.Paned(start_child=Gtk.ScrolledWindow(child=listbox, width_request=230),
                          end_child=Gtk.ScrolledWindow(child=preview), position=240)
        view.set_content(paned)
        dialog.set_child(view)
        dialog.present(self)

    def show_graph(self):
        if look_conf().get("GRAPH", "on") == "off":
            self.toast.add_toast(Adw.Toast(title="Graph view is off (Preferences › Writing)", timeout=3))
            return
        self._save_now()
        graph = self.vault.graph()
        win = Adw.Window(transient_for=self, title="Graph view", default_width=1000, default_height=720)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        web = WebKit.WebView(vexpand=True)
        rgba = Gdk.RGBA()
        rgba.parse("rgba(0,0,0,0)")
        web.set_background_color(rgba)
        manager = web.get_user_content_manager()
        manager.register_script_message_handler("mk", None)

        def message(_m, value):
            rel = value.to_string()
            win.close()
            self.open_note(rel)
        manager.connect("script-message-received::mk", message)
        dark = Adw.StyleManager.get_default().get_dark()
        def script_json(value):  # safe inside <script>: note names can contain anything
            return json.dumps(value).replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")
        web.load_html(GRAPH_PAGE.replace("@DATA@", script_json(graph))
                      .replace("@CURRENT@", script_json(self.rel or ""))
                      .replace("@SCHEME@", "dark" if dark else "light"), "about:blank")
        view.set_content(web)
        win.set_content(view)
        win.present()

    def pick_template(self):
        names = self.vault.templates()
        if not names:
            self.vault.write("Templates/Meeting.md", "# {{title}}\n\n**Date:** {{date}} {{time}}\n\n## Attendees\n- \n\n## Notes\n\n## Action items\n- [ ] \n")
            self.vault.write("Templates/Project.md", "# {{title}}\n\n> [!info] Goal\n> \n\n## Tasks\n- [ ] \n\n## Links\n\n#project\n")
            names = self.vault.templates()
            self.toast.add_toast(Adw.Toast(title="Added starter templates in Templates/", timeout=3))
        items = [(n, "Template", n) for n in names]
        Picker("Insert template", items, lambda n: self.insert(self.vault.template(n, Path(self.rel or "").stem)),
               "Template name…").present(self)

    def quick_open(self):
        items = [(n["title"], n["folder"], n["rel"]) for n in self.vault.notes()]
        Picker("Open a note", items, self.open_note, "Type to find a note…",
               on_create=lambda name: self.new_note(name)).present(self)

    def palette(self):
        Picker("Commands", self.commands, lambda name: self.activate_action(f"win.{name}", None),
               "Type a command…").present(self)

    def show_shortcuts(self):
        text = "\n".join(f"{keys:<22} {label}" for label, keys, _n in self.commands if keys)
        dialog = Adw.AlertDialog(heading="Keyboard shortcuts")
        label = Gtk.Label(label=text, xalign=0, css_classes=["monospace"], selectable=True)
        dialog.set_extra_child(label)
        dialog.add_response("ok", "OK")
        dialog.present(self)

    # ---------- phone ----------
    def set_sync(self, on):
        conf_set("SYNC", "on" if on else "off")
        if on and not self.server:
            port = nv.load_conf().get("SYNC_PORT", "8765")
            self.server = notes_sync.Server(self.vault, port, on_change=lambda rel: GLib.idle_add(self._phone_changed, rel))
            try:
                self.server.start()
            except OSError as e:
                self.server = None
                self.toast.add_toast(Adw.Toast(title=f"Phone sync couldn't start: {e.strerror}"))
                return
        elif not on and self.server:
            self.server.stop()
            self.server = None
        self.sync_label.set_text(f"📱 Phone sync on\n{self.server.url}" if self.server else "")

    def _phone_changed(self, rel):
        self.refresh()
        if rel == self.rel and not self.dirty:
            self.open_note(rel)
        return False

    def show_phone(self):
        dialog = Adw.Dialog(title="Phone", content_width=520)
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(description="Your phone and this laptop on the same Wi-Fi. Notes you write "
                                                 "on the phone are kept on it and sync whenever both are connected.")
        switch = Adw.SwitchRow(title="Phone sync", subtitle="Runs while MK Notes is open (or: mk-notes --serve)",
                               active=self.server is not None)
        group.add(switch)
        page.add(group)
        pair = Adw.PreferencesGroup(title="Pair a phone")
        codes = Gtk.Box(spacing=12, homogeneous=True)
        picture = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN, height_request=220, can_shrink=True)
        android = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN, height_request=220, can_shrink=True)
        for pic, caption in ((picture, "Phone browser"), (android, "MK Notes Android app")):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            col.append(pic)
            col.append(Gtk.Label(label=caption, css_classes=["dim-label"]))
            codes.append(col)
        url_row = Adw.ActionRow(title="Open on the phone", subtitle_selectable=True)
        steps = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"], margin_top=8, label=(
            "1. Scan the code with the phone's camera (or open the address).\n"
            "2. Android: open the MK Notes app and scan the same code; or in Chrome, ⋮ › Add to Home screen.\n"
            "3. That's it: it keeps a copy on the phone and syncs by itself."))
        pair.add(codes)
        pair.add(url_row)
        pair.add(steps)
        new_key = Gtk.Button(label="New pairing key (unpairs other phones)", css_classes=["flat"], margin_top=6)
        pair.add(new_key)
        page.add(pair)

        def update():
            on = self.server is not None
            pair.set_visible(on)
            if not on:
                return
            url = self.server.pairing_url()
            url_row.set_subtitle(url)
            app_link = (f"mknotes://pair?server={GLib.uri_escape_string(self.server.url, None, False)}"
                        f"&key={notes_sync.token()}" + ("&enc=1" if notes_sync.secret_box() else ""))
            png, png_app = qr_png(url), qr_png(app_link)
            if png:
                picture.set_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(png)))
                android.set_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(png_app)))
            else:
                codes.set_visible(False)
                steps.set_label(steps.get_label() + "\n\n(For a QR code: sudo dnf install python3-qrcode)")
        switch.connect("notify::active", lambda s, _p: (self.set_sync(s.get_active()), update()))
        new_key.connect("clicked", lambda *_: (notes_sync.new_token(), update()))
        update()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        dialog.set_child(view)
        dialog.present(self)

    def _on_close(self, *_):
        self._save_now()
        self._commit_title()
        if self.server:
            self.server.stop()
        return False


def qr_png(text):
    try:
        import io

        import qrcode
    except ImportError:
        return None
    img = qrcode.make(text, box_size=8, border=2)
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    return buf.getvalue()


GRAPH_PAGE = """<!doctype html><html><head><meta charset="utf-8"><style>
:root { color-scheme: @SCHEME@; } html, body { margin: 0; height: 100%; overflow: hidden; background: transparent;
font: 12px Inter, Cantarell, sans-serif; } canvas { display: block; }
#hint { position: fixed; bottom: 10px; left: 0; right: 0; text-align: center; opacity: .5; }
</style></head><body><canvas id="c"></canvas><div id="hint">Drag to move · scroll or pinch to zoom · click a note to open it</div><script>
const data = @DATA@, current = @CURRENT@, dark = '@SCHEME@' === 'dark';
const c = document.getElementById('c'), ctx = c.getContext('2d');
let W, H, scale = 1, ox = 0, oy = 0;
function size() { W = c.width = innerWidth * devicePixelRatio; H = c.height = innerHeight * devicePixelRatio; }
size(); addEventListener('resize', size);
const accent = getComputedStyle(document.body).getPropertyValue('accent-color') || '#2fa8ff';
const nodes = data.nodes.map((n, i) => ({...n, x: Math.cos(i) * 200 * Math.random(), y: Math.sin(i) * 200 * Math.random(), vx: 0, vy: 0, deg: 0}));
const byId = Object.fromEntries(nodes.map(n => [n.id, n]));
const edges = data.edges.filter(e => byId[e.from] && byId[e.to]).map(e => [byId[e.from], byId[e.to]]);
edges.forEach(([a, b]) => { a.deg++; b.deg++; });
let hover = null, drag = null, last = null;
function step() {
  for (const a of nodes) { a.vx -= a.x * 0.002; a.vy -= a.y * 0.002;
    for (const b of nodes) { if (a === b) continue; const dx = a.x - b.x, dy = a.y - b.y, d2 = dx*dx + dy*dy + 0.01;
      if (d2 < 90000) { const f = 900 / d2; a.vx += dx * f; a.vy += dy * f; } } }
  for (const [a, b] of edges) { const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 1, f = (d - 90) * 0.01;
    a.vx += dx / d * f; a.vy += dy / d * f; b.vx -= dx / d * f; b.vy -= dy / d * f; }
  for (const n of nodes) { if (n === drag) continue; n.vx *= 0.82; n.vy *= 0.82; n.x += n.vx; n.y += n.vy; }
}
function toScreen(n) { return [W / 2 + (n.x + ox) * scale * devicePixelRatio, H / 2 + (n.y + oy) * scale * devicePixelRatio]; }
function draw() {
  step(); ctx.clearRect(0, 0, W, H);
  ctx.lineWidth = devicePixelRatio; ctx.strokeStyle = dark ? 'rgba(160,180,210,.25)' : 'rgba(60,80,110,.25)';
  for (const [a, b] of edges) { const [x1, y1] = toScreen(a), [x2, y2] = toScreen(b); ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); }
  for (const n of nodes) { const [x, y] = toScreen(n), r = (4 + Math.sqrt(n.deg) * 2.2) * devicePixelRatio * Math.sqrt(scale);
    ctx.beginPath(); ctx.arc(x, y, r, 0, 7);
    ctx.fillStyle = n.id === current ? '#ffb020' : n === hover ? '#7fd0ff' : (dark ? '#4aa8ff' : '#2f80ff');
    if (n.id === current || n === hover) { ctx.shadowColor = ctx.fillStyle; ctx.shadowBlur = 14; }
    ctx.fill(); ctx.shadowBlur = 0;
    if (scale > 0.6 || n === hover || n.id === current) { ctx.fillStyle = dark ? 'rgba(230,236,245,.85)' : 'rgba(29,35,48,.85)';
      ctx.font = `${12 * devicePixelRatio}px Inter, sans-serif`; ctx.textAlign = 'center'; ctx.fillText(n.label, x, y + r + 14 * devicePixelRatio); } }
  requestAnimationFrame(draw);
}
function pick(ev) { const x = ev.clientX * devicePixelRatio, y = ev.clientY * devicePixelRatio;
  return nodes.find(n => { const [nx, ny] = toScreen(n); return Math.hypot(nx - x, ny - y) < 12 * devicePixelRatio; }); }
c.onmousemove = ev => { hover = pick(ev); c.style.cursor = hover ? 'pointer' : 'grab';
  if (last && ev.buttons) { const dx = (ev.clientX - last[0]) / scale, dy = (ev.clientY - last[1]) / scale;
    if (drag) { drag.x += dx; drag.y += dy; } else { ox += dx; oy += dy; } last = [ev.clientX, ev.clientY]; last.moved = true; } };
c.onmousedown = ev => { drag = pick(ev); last = [ev.clientX, ev.clientY]; };
c.onmouseup = ev => { if (drag && !(last && last.moved)) window.webkit.messageHandlers.mk.postMessage(drag.id); drag = null; last = null; };
c.onwheel = ev => { ev.preventDefault(); scale = Math.min(4, Math.max(0.2, scale * Math.exp(-ev.deltaY * 0.0015))); };
draw();
</script></body></html>"""


class QuickWindow(Adw.Window):
    """Quick capture: type, Ctrl+Enter, gone. It lands at the top of Inbox.md."""

    def __init__(self, app, vault):
        super().__init__(application=app, title="Quick note", default_width=460, default_height=280)
        self.vault = vault
        view = Adw.ToolbarView()
        head = Adw.HeaderBar(title_widget=Adw.WindowTitle(title="Quick note", subtitle="Goes to Inbox"))
        save = Gtk.Button(label="Save", css_classes=["suggested-action"])
        save.connect("clicked", lambda *_: self.save())
        head.pack_end(save)
        view.add_top_bar(head)
        self.text = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=16, right_margin=16,
                                 top_margin=12, bottom_margin=12, css_classes=["mk-editor"])
        view.set_content(Gtk.ScrolledWindow(child=self.text, vexpand=True))
        hint = Gtk.Label(label="Ctrl+Enter save  ·  Esc close", css_classes=["mk-status"], margin_bottom=8)
        view.add_bottom_bar(hint)
        self.set_content(view)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._key)
        self.add_controller(keys)
        self.text.grab_focus()

    def _key(self, _c, keyval, _code, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and state & Gdk.ModifierType.CONTROL_MASK:
            self.save()
            return True
        return False

    def save(self):
        buf = self.text.get_buffer()
        text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        if text.strip():
            self.vault.quick_add(text)
            app = self.get_application()
            if app.window:
                app.window.refresh()
        self.close()


class NotesApp(Adw.Application):
    def __init__(self, target=None):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None
        self.target = target

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # Notifications' click (e.g. "PDF ready"): open what they point at.
        open_uri_action = Gio.SimpleAction.new("open-uri", GLib.VariantType.new("s"))
        open_uri_action.connect("activate", lambda _a, uri: Gio.AppInfo.launch_default_for_uri(uri.get_string(), None))
        self.add_action(open_uri_action)

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        if args[:1] == ["--quick"]:
            vault = self.window.vault if self.window else nv.Vault()
            QuickWindow(self, vault).present()
            return 0
        if self.window is None:
            self.window = NotesWindow(self)
        if args:
            if args[0] == "--daily":
                self.window.open_note(self.window.vault.daily())
                self.window.refresh()
            else:
                name = " ".join(args)
                rel = self.window.vault.resolve(name) or self.window.vault.create("", name)
                self.window.refresh()
                self.window.open_note(rel)
        self.window.present()
        return 0


def main():
    if "--serve" in sys.argv[1:]:
        notes_sync.serve_forever()
        return 0
    if any(a in ("-h", "--help") for a in sys.argv[1:]):
        print(__doc__.strip())
        return 0
    return NotesApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
