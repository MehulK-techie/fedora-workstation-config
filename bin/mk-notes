        ribbon_outer.append(self.shapes_revealer)

        self.doc_col.append(ribbon_outer)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                            margin_start=32, margin_end=32, margin_top=6, margin_bottom=4)
        self.title_entry = Gtk.Entry(placeholder_text="Note Title", css_classes=["mk-title-entry"])
        self.title_entry.connect("activate", lambda *_: (self._commit_title(), self.view.grab_focus()))
        f_ctrl = Gtk.EventControllerFocus()
        f_ctrl.connect("leave", lambda *_: self._commit_title())
        self.title_entry.add_controller(f_ctrl)
        title_box.append(self.title_entry)

        pills_row = Gtk.Box(spacing=6)
        self.meta_label = Gtk.Label(xalign=0, css_classes=["mk-status"])
        pills_row.append(self.meta_label)
        self.links_bar = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
        pills_row.append(self.links_bar)
        self.tags_bar = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
        pills_row.append(self.tags_bar)
        add_tag_btn = Gtk.Button(label="+ Tag", css_classes=["flat", "mk-status"],
                                 tooltip_text="Add a #tag to this note")
        add_tag_btn.connect("clicked", lambda *_: self.prompt_add_tag())
