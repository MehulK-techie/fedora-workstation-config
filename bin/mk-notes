def scratch_eval(text):
    """Each line of the scratchpad worked out: a number, "x = …" (remembered
    for the lines below), "" for blank lines, "?" for what isn't a sum. Only
    arithmetic and a few maths functions: nothing else can run."""
    import ast
    import operator
    ops = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
           ast.Pow: operator.pow, ast.Mod: operator.mod, ast.FloorDiv: operator.floordiv}
    funcs = {"sqrt": math.sqrt, "sin": math.sin, "cos": math.cos, "tan": math.tan, "log": math.log10,
             "ln": math.log, "abs": abs, "round": round, "exp": math.exp}
    names = {"pi": math.pi, "e": math.e}

    def ev(node):
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in ops:
            a, b = ev(node.left), ev(node.right)
            if isinstance(node.op, ast.Pow) and abs(b) > 1000:
                raise ValueError("too big")
            return ops[type(node.op)](a, b)
        if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.USub, ast.UAdd)):
            return -ev(node.operand) if isinstance(node.op, ast.USub) else ev(node.operand)
        if isinstance(node, ast.Name) and node.id in names:
            return names[node.id]
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in funcs \
                and len(node.args) == 1 and not node.keywords:
            return funcs[node.func.id](ev(node.args[0]))
        raise ValueError("not a sum")
    out = []
    for line in text.splitlines():
        expr = line.strip().replace("×", "*").replace("÷", "/").replace("−", "-").replace("^", "**")
        if not expr:
            out.append("")
            continue
        target = None
        if "=" in expr and expr.split("=", 1)[0].strip().isidentifier():
            target, expr = (part.strip() for part in expr.split("=", 1))
        try:
            value = ev(ast.parse(expr, mode="eval").body)
            if target:
                names[target] = value
            out.append(f"= {value:.10g}")
        except (SyntaxError, ValueError, ZeroDivisionError, OverflowError, TypeError, RecursionError):
            out.append("?")
    return out


def _colour_a_label():
    """The text-colour button's face: an A over a red bar (the icon isn't
    in every theme)."""
    label = Gtk.Label()
    label.set_markup('<span underline="double" underline_color="#ed333b"><b>A</b></span>')
    return label


def _png_size(data):
    """(width, height) from a PNG's header, or None."""
    if data[:8] != b"\x89PNG\r\n\x1a\n" or len(data) < 24:
        return None
    return int.from_bytes(data[16:20], "big"), int.from_bytes(data[20:24], "big")
