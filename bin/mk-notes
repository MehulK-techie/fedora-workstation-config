        self.doc_col.append(self.status_bar)
        main_hbox.append(self.doc_col)

        # Window-level key controller (instant Delete / Backspace for canvas images)
        win_keys = Gtk.EventControllerKey()
        win_keys.connect("key-pressed", self._on_window_key_pressed)
