# The main window
# ======================================================================
class NotesWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="MK Notes", default_width=1280, default_height=820)
        self.vault = nv.Vault()
        self.rel = None
        self.dirty = False
        self.loading = False
        self.save_id = 0
        self.last_written = 0.0
        self.scope = ("all", None)
        self.reading = False
        self.rows = {}
        self.snippets = {}
        self.signature = None
        self.server = None
        self._quiet_scope = self._quiet_pin = False

        self._build()
        self._actions()
        self.reading = self.splitting = False
        self.apply_look()
        GLib.timeout_add_seconds(3, self._poll)
        self.connect("close-request", self._on_close)
        self.refresh()
        last = self.vault.state.get("last")
        self.open_note(last if last and self.vault.path(last).exists() else (self._first_note()))
        if look_conf()["OPEN_IN"] in ("split", "read"):
            self.mode.set_active_name(look_conf()["OPEN_IN"])
        if nv.load_conf().get("SYNC", "off") == "on":
            self.set_sync(True)

    # ---------- layout ----------
    def _build(self):
        # Sidebar: places, folders, tags
        self.sidebar = Gtk.ListBox(css_classes=["navigation-sidebar", "mk-sidebar"])
        self.sidebar.connect("row-selected", self._on_scope)
        side_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side_head = Adw.HeaderBar(show_end_title_buttons=False, title_widget=Adw.WindowTitle(title="MK Notes"))
        new_folder = Gtk.Button(icon_name="folder-new-symbolic", tooltip_text="New folder")
        new_folder.connect("clicked", lambda *_: self.new_folder())
        side_head.pack_end(new_folder)
        side_box.append(side_head)
        side_box.append(Gtk.ScrolledWindow(child=self.sidebar, vexpand=True))
        self.sync_label = Gtk.Label(label="", css_classes=["mk-status"], margin_bottom=8, wrap=True)
        side_box.append(self.sync_label)

        # Note list
        list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
