EMBED_RE = re.compile(r"^\s*!\[\[([^\]|#]+?\.(?:png|jpe?g|gif|webp|bmp|svg))(?:\|[^\]]*)?\]\]\s*$", re.I)


def conf_set(key, value):
    path = nv.CONF_FILES[-1]
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = path.read_text().splitlines() if path.exists() else ["# MK Notes (mk-notes)"]
    lines = [ln for ln in lines if not ln.startswith(f"{key}=")] + [f"{key}={value}"]
    path.write_text("\n".join(lines) + "\n")


def look_conf():
    defaults = {
        "THEME_PRESET": "indigo",
        "PAPER_PATTERN": "dots",
        "FONT_SIZE": "16",
        "EXPORT_FORMAT": "pdf",
        "SORT": "edited",
    }
    return {**defaults, **nv.load_conf()}


def when_short(ts):
    dt = datetime.fromtimestamp(ts)
    now = datetime.now()
    if dt.date() == now.date():
        return dt.strftime("%H:%M")
    if (now - dt).days < 7:
        return dt.strftime("%a")
    return dt.strftime("%d %b")


def clean_preview(text):
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith(("---", "```", "![[")):
            continue
        line = re.sub(r"^#{1,6}\s+", "", line)
        line = re.sub(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]", lambda m: m.group(2) or m.group(1), line)
        line = re.sub(r"(\*\*|__|==|~~|`|<[^>]+>)", "", line)
        line = re.sub(r"^[-*+>]\s+(\[.\]\s+)?", "", line)
        if line.strip():
            return line.strip()[:90]
    return "Empty note"


def hex_rgb(color):
    color = color.lstrip("#")
    if len(color) != 6:
        return (0.23, 0.51, 0.96)
    return tuple(int(color[i:i + 2], 16) / 255.0 for i in (0, 2, 4))


def rgba_to_hex(rgba):
    return "#%02x%02x%02x" % (round(rgba.red * 255), round(rgba.green * 255), round(rgba.blue * 255))


def take_screenshot(callback):
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    except GLib.Error:
        callback(None)
        return
    token = f"mknotes{int(time.time() * 1000)}"
    sender = bus.get_unique_name()[1:].replace(".", "_")
    handle = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    sub = [0]

    def on_response(_bus, _sender, _path, _iface, _signal, params):
        bus.signal_unsubscribe(sub[0])
        code, results = params.unpack()
        uri = results.get("uri") if code == 0 else None
        callback(Gio.File.new_for_uri(uri).get_path() if uri else None)

    sub[0] = bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request",
                                  "Response", handle, None, Gio.DBusSignalFlags.NO_MATCH_RULE, on_response)
    options = {"handle_token": GLib.Variant("s", token), "interactive": GLib.Variant("b", True)}
    bus.call("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
             "org.freedesktop.portal.Screenshot", "Screenshot",
             GLib.Variant("(sa{sv})", ("", options)), GLib.VariantType("(o)"),
             Gio.DBusCallFlags.NONE, -1, None, None)


class ImageStudioDialog(Adw.Window):
    PREVIEW = 960

    def __init__(self, parent, path, on_saved):
        super().__init__(transient_for=parent, modal=True, title="Crop & Filter Studio",
                         default_width=880, default_height=660)
        from PIL import Image
        from mkworkstation import photo
        self.photo = photo
        self.path = Path(path)
        self.on_saved = on_saved
        self.base = photo.rgb(Image.open(path))
        self.look = None
        self.drag = None
        self.preview = None

        view = Adw.ToolbarView()
        head = Adw.HeaderBar()
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        head.pack_start(cancel)
        save = Gtk.Button(label="Apply Changes", css_classes=["suggested-action"])
        save.connect("clicked", lambda *_: self.save())
        head.pack_end(save)
        view.add_top_bar(head)

        self.picture = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN, can_shrink=True, hexpand=True, vexpand=True)
        self.overlay_area = Gtk.DrawingArea(hexpand=True, vexpand=True)
        self.overlay_area.set_draw_func(self._draw_crop)
        overlay = Gtk.Overlay(child=self.picture, margin_start=12, margin_end=12, margin_top=12)
        overlay.add_overlay(self.overlay_area)
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._crop_begin)
        drag.connect("drag-update", self._crop_update)
        drag.connect("drag-end", self._crop_end)
        self.overlay_area.add_controller(drag)

        tools = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, margin_top=10)
        for icon, label, cb in (
            ("object-rotate-left-symbolic", "Rotate Left", lambda: self._edit(lambda i: photo.rotate(i, False))),
            ("object-rotate-right-symbolic", "Rotate Right", lambda: self._edit(lambda i: photo.rotate(i, True))),
            ("object-flip-horizontal-symbolic", "Flip", lambda: self._edit(photo.flip)),
        ):
            b = Gtk.Button(icon_name=icon, tooltip_text=label)
            b.connect("clicked", lambda _b, c=cb: c())
            tools.append(b)
        self.crop_btn = Gtk.ToggleButton(label="Drag on picture to Crop", icon_name="edit-cut-symbolic")
        self.crop_btn.connect("toggled", lambda btn: btn.get_active() and self.look and self.original_btn.set_active(True))
        tools.append(self.crop_btn)

        looks = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER, margin_top=8, margin_bottom=14)
        group = None
        for key, label in [(None, "Original")] + [(k, f.label) for k, f in photo.FILTERS.items()]:
            b = Gtk.ToggleButton(label=label, css_classes=["pill"], active=key is None)
            if group:
                b.set_group(group)
            group = group or b
            self.original_btn = group
            b.connect("toggled", lambda btn, k=key: btn.get_active() and self._set_look(k))
            looks.append(b)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(overlay)
        box.append(tools)
        box.append(looks)
        view.set_content(box)
        self.set_content(view)
        self._refresh()

    def _edit(self, fn):
        self.base = fn(self.base)
        self._refresh()

    def _set_look(self, key):
        self.look = key
        self._refresh()

    def _refresh(self):
        small = self.base.copy()
        small.thumbnail((self.PREVIEW, self.PREVIEW))
        self.preview = self.photo.apply(small, self.look) if self.look else small
        buf = io.BytesIO()
        self.preview.save(buf, "PNG")
        self.picture.set_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(buf.getvalue())))
        self.overlay_area.queue_draw()

    def _shown_rect(self):
        w, h = self.overlay_area.get_width(), self.overlay_area.get_height()
        iw, ih = self.preview.size if self.preview else (1, 1)
        k = min(w / max(1, iw), h / max(1, ih))
        return (w - iw * k) / 2, (h - ih * k) / 2, k

    def _crop_begin(self, _g, x, y):
        if self.crop_btn.get_active():
            self.drag = [x, y, x, y]

    def _crop_update(self, _g, dx, dy):
        if self.drag:
            self.drag[2], self.drag[3] = self.drag[0] + dx, self.drag[1] + dy
            self.overlay_area.queue_draw()

    def _crop_end(self, _g, _dx, _dy):
        if not self.drag:
            return
        ox, oy, k = self._shown_rect()
        full = self.base.width / max(1, self.preview.width)
        x0, y0, x1, y1 = self.drag
        if abs(x1 - x0) > 12 and abs(y1 - y0) > 12:
            box = ((x0 - ox) / k * full, (y0 - oy) / k * full, (x1 - ox) / k * full, (y1 - oy) / k * full)
            self._edit(lambda i: self.photo.crop(i, box))
        self.drag = None
        self.crop_btn.set_active(False)

    def _draw_crop(self, _area, cr, w, h):
        if not self.drag:
            return
        x0, y0, x1, y1 = self.drag
        cr.set_source_rgba(0, 0, 0, 0.45)
        cr.rectangle(0, 0, w, h)
        cr.rectangle(min(x0, x1), min(y0, y1), abs(x1 - x0), abs(y1 - y0))
        cr.set_fill_rule(1)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, 0.95)
        cr.set_line_width(2)
        cr.rectangle(min(x0, x1), min(y0, y1), abs(x1 - x0), abs(y1 - y0))
        cr.stroke()

    def save(self):
        out = self.photo.apply(self.base, self.look) if self.look else self.base
        jpeg = self.path.suffix.lower() in (".jpg", ".jpeg")
        buf = io.BytesIO()
        out.save(buf, "JPEG" if jpeg else "PNG", **({"quality": 92} if jpeg else {}))
        self.on_saved(buf.getvalue())
        self.close()


class StickyNoteWidget(Gtk.Box):
    """A text box, as in OneNote or Google Docs: words anywhere on the page,
    with no paper behind them. Selected (being typed in, or its edge
    clicked) it shows a thin blue border, four corner handles and a format
    bar above it (bold, italic, underline, colour, size); otherwise all of
    that fades out and the text sits straight on the printout or picture.
    Drag the border to move it, a corner to resize it; with the border
    selected (Esc from the text) Delete or Backspace removes it.
    The bar's row is always there (transparent while unselected, and clicks
    pass through it), so the text never jumps when it appears: 12 px above
    the text, or below it when the box is near the top of the page. The box
    is a wide single line at first and grows downwards as you type; one
    left empty is removed when you click elsewhere."""
    HANDLE = 10   # a corner handle's size, px
    BAR_GAP = 12  # between the format bar and the box's edge (its handles stay clear)
    BAR_H = 32 + BAR_GAP   # the format bar's row
    MIN_H = 46    # one line

    def __init__(self, item_data, note_win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.START, valign=Gtk.Align.START,
                         focusable=True, css_classes=["mk-textbox"])
        self.data = item_data
        self.win = note_win
        self.selected = False
        self.data.setdefault("x", 480.0)
        self.data.setdefault("y", 80.0)
        self.data.setdefault("w", 340.0)
        self.data.setdefault("h", float(self.MIN_H))
        self.data.setdefault("text", "")
        # y is where the text area starts (v3); v2 kept the bar's row's top, v1 the text's
        if self.data.get("v", 1) == 2:
            self.data["y"] = self.data["y"] + 38
        self.data["v"] = 3
        self.flipped = False
        self.data["color_idx"] = TEXT_BOX

        self.bar = Gtk.Revealer(child=self._format_bar(), transition_type=Gtk.RevealerTransitionType.CROSSFADE,
                                transition_duration=150, reveal_child=False, can_target=False,
                                height_request=self.BAR_H)
        self.append(self.bar)

        self.text_view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, hexpand=True, vexpand=True,
                                      left_margin=4, right_margin=4, top_margin=2, bottom_margin=2)
        buf = self.text_view.get_buffer()
        for name, props in (("b", {"weight": Pango.Weight.BOLD}), ("i", {"style": Pango.Style.ITALIC}),
                            ("u", {"underline": Pango.Underline.SINGLE})):
            buf.create_tag(name, **props)
        self._typing = None      # styles for the next typed letters: None = like the letter before
        self._inserting = False
        self._load_runs()
        buf.connect("changed", lambda *_: self._save())
        buf.connect("apply-tag", lambda *_: GLib.idle_add(self._save_once))
        buf.connect("remove-tag", lambda *_: GLib.idle_add(self._save_once))
        buf.connect("insert-text", self._before_insert)
        buf.connect_after("insert-text", self._after_insert)
        buf.connect("mark-set", self._on_mark_set)
        frame = Gtk.ScrolledWindow(child=self.text_view, hexpand=True, vexpand=True,
                                   hscrollbar_policy=Gtk.PolicyType.NEVER, vscrollbar_policy=Gtk.PolicyType.NEVER,
                                   css_classes=["mk-textbox-frame"])
        self.frame = frame
        self.body = Gtk.Overlay(child=frame, hexpand=True, vexpand=True)
        self.placeholder = Gtk.Label(label="Type note here…", css_classes=["mk-textbox-placeholder"],
                                     halign=Gtk.Align.START, valign=Gtk.Align.START, margin_start=12,
                                     margin_top=9, can_target=False, visible=False)
        self.body.add_overlay(self.placeholder)
        buf.connect("changed", lambda *_: (self._sync_placeholder(), self._queue_grow()))
        # the pointer shows what a drag does: resize at a corner, move on the border
        hover = Gtk.EventControllerMotion()
        hover.connect("motion", self._hover)
        self.body.add_controller(hover)
        for halign, valign in ((Gtk.Align.START, Gtk.Align.START), (Gtk.Align.END, Gtk.Align.START),
                               (Gtk.Align.START, Gtk.Align.END), (Gtk.Align.END, Gtk.Align.END)):
            self.body.add_overlay(Gtk.Box(halign=halign, valign=valign, width_request=self.HANDLE,
                                          height_request=self.HANDLE, css_classes=["mk-textbox-handle"],
                                          can_target=False))
        self.append(self.body)

        focus = Gtk.EventControllerFocus()
        focus.connect("enter", lambda *_: self.select(True))
        focus.connect("leave", lambda *_: GLib.idle_add(self._maybe_unselect))
        self.add_controller(focus)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        self.add_controller(keys)
        menu = Gtk.GestureClick(button=3)
        menu.connect("pressed", lambda g, _n, x, y: self._menu(x, y))
        self.body.add_controller(menu)

        self._css_prov = Gtk.CssProvider()
        self.text_view.get_style_context().add_provider(self._css_prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 2)
        self._apply_palette()
        self.sync_zoom_geometry()

    # ---------- the format bar
    def _format_bar(self):
        bar = Gtk.Box(spacing=2, halign=Gtk.Align.START, valign=Gtk.Align.START, height_request=self.BAR_H - self.BAR_GAP,
                      margin_bottom=self.BAR_GAP, css_classes=["osd", "mk-format-bar"])

        def button(label, tip, fn, markup=True):
            b = Gtk.Button(css_classes=["flat"], tooltip_text=tip, focus_on_click=False)
            lab = Gtk.Label()
            lab.set_markup(label) if markup else lab.set_label(label)
            b.set_child(lab)
            b.connect("clicked", lambda *_: fn())
            bar.append(b)
        button("<b>B</b>", "Bold (Ctrl+B)", lambda: self.toggle_style("b"))
        button("<i>I</i>", "Italic (Ctrl+I)", lambda: self.toggle_style("i"))
        button("<u>U</u>", "Underline (Ctrl+U)", lambda: self.toggle_style("u"))
        pop = Gtk.Popover()
        pop.set_child(self.win.text_colour_swatches(lambda c: (pop.popdown(), self.set_text_color(c))))
        colour = Gtk.MenuButton(child=_colour_a_label(), css_classes=["flat"], popover=pop,
                                tooltip_text="Text colour (the selected words, or the whole box)")
        colour.set_focus_on_click(False)
        bar.append(colour)
        button("A−", "Smaller text", lambda: self.step_size(-1), markup=False)
        button("A+", "Larger text", lambda: self.step_size(1), markup=False)
        self._colour_pop = pop
        return bar

    def toggle_style(self, name):
        """Bold, italic or underline (b, i, u) on the selected words; with
        nothing selected, for the next letters typed."""
        buf = self.text_view.get_buffer()
        tag = buf.get_tag_table().lookup(name)
        bounds = buf.get_selection_bounds()
        if bounds:
            start, end = bounds
            it, whole = start.copy(), True
            while it.compare(end) < 0:
                if not it.has_tag(tag):
                    whole = False
                    break
                it.forward_char()
            (buf.remove_tag if whole else buf.apply_tag)(tag, start, end)
        else:
            current = self._typing if self._typing is not None else self._tags_before_cursor()
            self._typing = current ^ {name}
        self.text_view.grab_focus()

    def _tags_before_cursor(self):
        buf = self.text_view.get_buffer()
        it = buf.get_iter_at_mark(buf.get_insert())
        if not it.backward_char():
            return set()
        return {t.props.name for t in it.get_tags() if t.props.name}

    def _before_insert(self, _buf, location, *_):
        self._inserting = True
        self._insert_at = location.get_offset()  # (the iter handed to the after-handler can't be trusted)
        if self._typing is None:
            self._inherit = self._tags_before_cursor()

    def _after_insert(self, buf, _location, text, _length):
        self._inserting = False
        tags = self._typing if self._typing is not None else self._inherit
        start = buf.get_iter_at_offset(self._insert_at)
        end = buf.get_iter_at_offset(self._insert_at + len(text))
        for t in list(start.get_tags()):
            buf.remove_tag(t, start, end)
        table = buf.get_tag_table()
        for name in tags:
            tag = table.lookup(name)
            if tag:
                buf.apply_tag(tag, start, end)

    def _on_mark_set(self, buf, _iter, mark):
        if mark is buf.get_insert() and not self._inserting:
            self._typing = None  # the cursor moved: type like the letters there

    def _fg_tag(self, hex_colour):
        table = self.text_view.get_buffer().get_tag_table()
        name = f"fg{hex_colour}"
        return table.lookup(name) or self.text_view.get_buffer().create_tag(name, foreground=hex_colour)

    def set_text_color(self, hex_colour):
        """The selected words' colour; with nothing selected, the box's."""
        buf = self.text_view.get_buffer()
        bounds = buf.get_selection_bounds()
        if bounds:
            table = buf.get_tag_table()
            names = []
            table.foreach(lambda t: names.append(t.props.name) if (t.props.name or "").startswith("fg") else None)
            for n in names:
                buf.remove_tag_by_name(n, *bounds)
            buf.apply_tag(self._fg_tag(hex_colour), *bounds)
        else:
            self.data["fg"] = hex_colour
            self._apply_palette()
        self.win.dirty = True
        self.win.save_note_meta()

    def step_size(self, step):
        size = float(self.data.get("size", 1.0))
        self.data["size"] = round(max(0.6, min(3.0, size * (1.15 if step > 0 else 1 / 1.15))), 3)
        self._apply_palette()
        self.win.save_note_meta()

    def _apply_palette(self):
        fg = self.data.get("fg") or STICKY_PALETTES[TEXT_BOX][2]
        size = 0.95 * float(self.data.get("size", 1.0))
        self._css_prov.load_from_string(
            f"textview, textview text {{ background: transparent; color: {fg}; font-size: {size:.3f}em; }}")

    # ---------- saved as runs: [text, "biu", "#colour" or ""]
    def _runs(self):
        buf = self.text_view.get_buffer()
        runs, it = [], buf.get_start_iter()
        while not it.is_end():
            nxt = it.copy()
            if not nxt.forward_to_tag_toggle(None):
                nxt = buf.get_end_iter()
            names = {t.props.name or "" for t in it.get_tags()}
            style = "".join(k for k in "biu" if k in names)
            fg = next((n[2:] for n in names if n.startswith("fg")), "")
            text = buf.get_text(it, nxt, False)
            if runs and runs[-1][1:] == [style, fg]:
                runs[-1][0] += text
            else:
                runs.append([text, style, fg])
            it = nxt
        return runs

    def _load_runs(self):
        buf = self.text_view.get_buffer()
        runs = self.data.get("runs")
        if not runs:
            buf.set_text(self.data.get("text", ""))
            return
        for text, style, fg in runs:
            names = list(style) + ([self._fg_tag(fg).props.name] if fg else [])
            buf.insert_with_tags_by_name(buf.get_end_iter(), text, *names)

    def _save_once(self):
        self._save()
        return False

    def _save(self):
        buf = self.text_view.get_buffer()
        self.data["text"] = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        runs = self._runs()
        if any(style or fg for _t, style, fg in runs):
            self.data["runs"] = runs
        else:
            self.data.pop("runs", None)
        self.win.save_note_meta()

    # ---------- selection
    def select(self, on):
        if on == self.selected:
            return
        self.selected = on
        (self.add_css_class if on else self.remove_css_class)("selected")
        self.bar.set_can_target(on)
        self.bar.set_reveal_child(on)
        self._sync_placeholder()
        if on:
            self.win._active_text_box = self
        elif not self.data.get("text", "").strip() and self in self.win.sticky_notes:
            # left empty: nothing to keep, and no invisible box left to catch clicks
            GLib.idle_add(lambda: (self.win.remove_sticky_note(self), False)[1])

    def _sync_placeholder(self):
        buf = self.text_view.get_buffer()
        self.placeholder.set_visible(self.selected and buf.get_char_count() == 0)

    def _queue_grow(self):
        if not getattr(self, "_grow_id", 0):
            self._grow_id = GLib.idle_add(self._grow)

    def _grow(self):
        """Taller as the text needs (never narrower: the width is yours)."""
        self._grow_id = 0
        z = max(0.5, self.win.zoom)
        width = round(self.data["w"] * z) - 2 * 8
        _m, natural, _b1, _b2 = self.text_view.measure(Gtk.Orientation.VERTICAL, max(20, width))
        need = (natural + 2 * 8) / z
        if need > self.data["h"] + 0.5 or (self.data.get("auto", True) and need < self.data["h"] - 0.5):
            self.data["h"] = round(max(self.MIN_H, need), 1)
            self.sync_zoom_geometry()
            self.win.ensure_page_height_for_images()
        return False

    def _hover(self, _ctrl, x, y):
        corner = self.corner_at(x, y)
        w, h = self.body.get_width(), self.body.get_height()
        if corner:
            name = "nwse-resize" if corner in ((0, 0), (1, 1)) else "nesw-resize"
        elif min(x, y, w - x, h - y) <= 8:
            name = "move"
        else:
            name = None
        cursor = Gdk.Cursor.new_from_name(name) if name else None
        self.frame.set_cursor(cursor if name else Gdk.Cursor.new_from_name("move"))
        self.text_view.set_cursor(cursor if corner else None)

    def _maybe_unselect(self):
        # the colour popover or a bar button doesn't count as leaving
        root = self.get_root()
        focus = root.get_focus() if root else None
        if self._colour_pop.get_visible() or (focus is not None and focus.is_ancestor(self)) or focus is self:
            return False
        self.select(False)
        return False

    def do_contains(self, x, y):
        # the bar's row only takes clicks while the bar shows
        in_bar = y >= self.get_height() - self.BAR_H if self.flipped else y < self.BAR_H
        if not self.selected and in_bar:
            return False
        return 0 <= x < self.get_width() and 0 <= y < self.get_height()

    def corner_at(self, x, y):
        """Which corner handle (hx, hy: 0 left/top, 1 right/bottom) is at
        (x, y) in the text area's own pixels, or None."""
        if not self.selected:
            return None
        w, h, reach = self.body.get_width(), self.body.get_height(), self.HANDLE + 4
        hx = 0 if x <= reach else 1 if x >= w - reach else None
        hy = 0 if y <= reach else 1 if y >= h - reach else None
        return None if hx is None or hy is None else (hx, hy)

    def _on_key(self, _ctrl, keyval, _code, _state):
        focus = self.get_root().get_focus() if self.get_root() else None
        if keyval == Gdk.KEY_Escape and focus is self.text_view:
            self.grab_focus()  # the box itself, so Delete removes it
            return True
        if keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace) and focus is self:
            self.win.remove_sticky_note(self)
            return True
        return False

    def _menu(self, x, y):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=6, margin_bottom=6,
                      margin_start=6, margin_end=6)
        pop = Gtk.Popover(child=box, has_arrow=True, pointing_to=Gdk.Rectangle(round(x), round(y), 1, 1))
        pop.set_parent(self.body)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        box.append(self.win.text_colour_swatches(lambda c: (self.set_text_color(c), pop.popdown())))
        for icon, tip, how in LAYER_ACTIONS:
            row = Gtk.Button(css_classes=["flat"])
            line = Gtk.Box(spacing=8)
            line.append(Gtk.Image(icon_name=icon))
            line.append(Gtk.Label(label=tip))
            row.set_child(line)
            row.connect("clicked", lambda _b, h=how: (pop.popdown(), self.win.restack(self, h)))
            box.append(row)
        rm = Gtk.Button(label="Delete text box", css_classes=["flat", "destructive-action"])
        rm.connect("clicked", lambda *_: (pop.popdown(), self.win.remove_sticky_note(self)))
        box.append(rm)
        pop.popup()

    def sync_zoom_geometry(self):
        z = self.win.zoom
        self.set_size_request(round(self.data["w"] * z), round(self.data["h"] * z) + self.BAR_H)
        top = max(8, round(self.data["y"] * z))          # the text area's top
        flip = top < 50 + self.BAR_H                      # no room above: the bar goes below
        if flip != self.flipped:
            self.flipped = flip
            self.reorder_child_after(self.bar, self.body if flip else None)
            self.bar.set_valign(Gtk.Align.START)
            self.bar.get_child().set_margin_top(self.BAR_GAP if flip else 0)
            self.bar.get_child().set_margin_bottom(0 if flip else self.BAR_GAP)
        px = max(8, round(self.data["x"] * z))
        py = top if flip else top - self.BAR_H
        if self.get_parent() is self.win.canvas_fixed:
            self.win.canvas_fixed.move(self, px, py)

    def place(self):
        """(x, y) for canvas_fixed.put: where the widget's top-left goes."""
        self.sync_zoom_geometry()
        z = self.win.zoom
        top = max(8, round(self.data["y"] * z))
        return max(8, round(self.data["x"] * z)), top if self.flipped else top - self.BAR_H


class StickyPad(Gtk.Box):
    """A sticky note (Sticky in the ribbon): translucent pastel paper with
    a pinned header (drag it to move; the title is editable), a colour
    picker, layer order and ×, and room to write. Unlike a text box it
    stays a note on top of the page; a PDF export lists it in a footnote
    box (Include sticky notes, next to Export). Its bottom-right corner
    resizes it."""
    GRIP_H = 34   # the header's height, the part that drags

    def __init__(self, item_data, note_win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=2, halign=Gtk.Align.START,
                         valign=Gtk.Align.START, css_classes=["mk-pad"])
        self.data = item_data
        self.win = note_win
        for k, v in (("x", 420.0), ("y", 120.0), ("w", 220.0), ("h", 180.0), ("color_idx", 0), ("text", ""),
                     ("title", "Sticky note")):
            self.data.setdefault(k, v)
        head = Gtk.Box(spacing=4, height_request=self.GRIP_H - 6, css_classes=["mk-pad-head"])
        head.append(Gtk.Label(label="📌", margin_start=4, can_target=False))
        title = Gtk.Entry(text=self.data["title"], hexpand=True, has_frame=False, max_length=40,
                          css_classes=["mk-pad-title"])
        title.connect("changed", lambda e: (self.data.__setitem__("title", e.get_text()), self.win.save_note_meta()))
        title.set_position(0)  # show its start, not its end
        head.append(title)
        palette = Gtk.Box(spacing=4, margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        pop = Gtk.Popover(child=palette)
        for i, (name, bg, _fg) in enumerate(STICKY_PALETTES[:TEXT_BOX]):
            sw = Gtk.Button(tooltip_text=name, css_classes=["mk-swatch"])
            prov = Gtk.CssProvider()
            prov.load_from_string(f"button {{ background: {bg}; border: 1px solid alpha(black, 0.25); }}")
            sw.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 3)
            sw.connect("clicked", lambda _b, k=i: (pop.popdown(), self._set_color(k)))
            palette.append(sw)
        head.append(Gtk.MenuButton(icon_name="color-select-symbolic", css_classes=["flat"], popover=pop,
                                   tooltip_text="Paper colour"))
        layers = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=4, margin_bottom=4)
        lpop = Gtk.Popover(child=layers)
        for icon, tip, how in LAYER_ACTIONS:
            row = Gtk.Button(css_classes=["flat"])
            line = Gtk.Box(spacing=8)
            line.append(Gtk.Image(icon_name=icon))
            line.append(Gtk.Label(label=tip))
            row.set_child(line)
            row.connect("clicked", lambda _b, h=how: (lpop.popdown(), self.win.restack(self, h)))
            layers.append(row)
        head.append(Gtk.MenuButton(child=Gtk.Label(label="⇅"), css_classes=["flat"], popover=lpop,
                                   tooltip_text="Layer order"))
        close = Gtk.Button(icon_name="window-close-symbolic", css_classes=["flat"], tooltip_text="Delete this sticky note")
        close.connect("clicked", lambda *_: self.win.remove_pinned_sticky(self))
        head.append(close)
        head.set_cursor(Gdk.Cursor.new_from_name("move"))
        self.append(head)
        self.text_view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, hexpand=True, vexpand=True,
                                      left_margin=8, right_margin=8, top_margin=4, bottom_margin=4)
        self.text_view.get_buffer().set_text(self.data["text"])
        self.text_view.get_buffer().connect("changed", self._on_text)
        self.append(Gtk.ScrolledWindow(child=self.text_view, hexpand=True, vexpand=True,
                                       hscrollbar_policy=Gtk.PolicyType.NEVER))
        self._css = Gtk.CssProvider()
        for w in (self, self.text_view, title):
            w.get_style_context().add_provider(self._css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 2)
        self._apply()
        self.sync_zoom_geometry()

    def _apply(self):
        _name, bg, fg = STICKY_PALETTES[int(self.data.get("color_idx", 0)) % TEXT_BOX]
        self._css.load_from_string(
            f".mk-pad {{ background: alpha({bg}, 0.88); color: {fg}; }}"
            f"textview, textview text, entry.mk-pad-title, entry.mk-pad-title text "
            f"{{ background: transparent; color: {fg}; }}")

    def _set_color(self, idx):
        self.data["color_idx"] = idx
        self._apply()
        self.win.save_note_meta()

    def _on_text(self, buf):
        self.data["text"] = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        self.win.save_note_meta()

    def sync_zoom_geometry(self):
        z = self.win.zoom
        self.set_size_request(round(self.data["w"] * z), round(self.data["h"] * z))
        if self.get_parent() is self.win.canvas_fixed:
            self.win.canvas_fixed.move(self, max(8, round(self.data["x"] * z)), max(8, round(self.data["y"] * z)))


class TableItem(Gtk.Box):
    """A table in the page, Google Docs style: a grid of cells you type in
    (each wraps its text; a row grows to its tallest cell), solid borders,
    column dividers you drag to resize (the pointer turns into <->), a
    ▼ menu for rows and columns, and a ⠿ handle to move the table to
    another place in the text. Tab moves to the next cell, and from the last
    cell adds a row. It sits in the text flow (a child anchor), so text
    above and below never overlaps it. DATA: {"rows": [[text]], "col_w":
    [px at 100 %]}, saved with the note's meta (not as Markdown pipes)."""

    MIN_COL = 56

    def __init__(self, data, note_win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4, css_classes=["mk-table"],
                         halign=Gtk.Align.START, valign=Gtk.Align.START)
        self.win = note_win
        self.data = data
        rows = data.setdefault("rows", [["", ""], ["", ""]])
        width = max(len(r) for r in rows)
        for r in rows:
            r.extend([""] * (width - len(r)))
        data.setdefault("col_w", [140] * width)
        data["col_w"] = (data["col_w"] + [140] * width)[:width]
        self.active = (0, 0)
        self.anchor = None
        self.grid = Gtk.Grid(css_classes=["mk-table-grid"])
        # The selection frame: 8 handles (corners scale both ways, edges one;
        # the left and top ones move the table too), shown while selected.
        frame = Gtk.Overlay(child=self.grid)
        self.handles = []
        for hx, hy, cursor in ((0, 0, "nw-resize"), (1, 0, "n-resize"), (2, 0, "ne-resize"), (0, 1, "w-resize"),
                               (2, 1, "e-resize"), (0, 2, "sw-resize"), (1, 2, "s-resize"), (2, 2, "se-resize")):
            align = (Gtk.Align.START, Gtk.Align.CENTER, Gtk.Align.END)
            h = Gtk.Box(css_classes=["mk-table-handle"], halign=align[hx], valign=align[hy], visible=False,
                        cursor=Gdk.Cursor.new_from_name(cursor))
            g = Gtk.GestureDrag()
            g.connect("drag-begin", self._handle_begin, hx, hy)
            g.connect("drag-update", self._handle_update)
            g.connect("drag-end", lambda *_a: self.win._queue_save_meta())
            h.add_controller(g)
            frame.add_overlay(h)
            self.handles.append(h)
        self.append(frame)
        focus = Gtk.EventControllerFocus()
        focus.connect("enter", lambda *_: self.select(True))
        focus.connect("leave", lambda *_: GLib.timeout_add(150, lambda: (self._maybe_unselect(), False)[1]))
        self.add_controller(focus)
        bar = Gtk.Box(spacing=6)
        move = Gtk.Label(label="⠿ Move table", css_classes=["mk-table-pill"],
                         cursor=Gdk.Cursor.new_from_name("grab"),
                         tooltip_text="Drag to another place in the text")
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._move_begin)
        drag.connect("drag-update", self._move_update)
        drag.connect("drag-end", lambda *_: (self.set_opacity(1.0), self.win.keep_off_gaps(self),
                                             self.win._queue_save_meta(), self.win.ensure_page_height_for_images()))
        move.add_controller(drag)
        bar.append(move)
        menu = Gio.Menu()
        for label, what in (("Add row above", "row-above"), ("Add row below", "row-below"), ("Delete row", "row-del"),
                            ("Add column left", "col-left"), ("Add column right", "col-right"),
                            ("Delete column", "col-del"), ("Delete table", "table-del")):
            menu.append(label, f"table.{what}")
        group = Gio.SimpleActionGroup()
        for what in ("row-above", "row-below", "row-del", "col-left", "col-right", "col-del", "table-del"):
            act = Gio.SimpleAction.new(what, None)
            act.connect("activate", lambda *_a, w=what: self.edit(w))
            group.add_action(act)
        self.insert_action_group("table", group)
        bar.append(Gtk.MenuButton(label="▼", menu_model=menu, css_classes=["mk-table-pill"],
                                  tooltip_text="Rows and columns (for the cell you're in)"))

        self.append(bar)
        self.build()

    # ----- the grid: cells at even columns, dividers between them
    def build(self, focus=None):
        while (child := self.grid.get_first_child()) is not None:
            self.grid.remove(child)
        z = max(0.5, self.win.zoom)
        rows = self.data["rows"]
        self.cells = []
        for r, row in enumerate(rows):
            line = []
            for c, text in enumerate(row):
                view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=6, bottom_margin=6,
                                    left_margin=8, right_margin=8, accepts_tab=False,
                                    css_classes=["mk-table-cell"] + (["mk-table-head"] if r == 0 else []))
                view.set_size_request(round(self.data["col_w"][c] * z), round(self.data.get("row_h", 0) * z) or -1)
                view.get_buffer().set_text(text)
                view.get_buffer().connect("changed", self._typed, r, c)
                keys = Gtk.EventControllerKey()
                keys.connect("key-pressed", self._key, r, c)
                view.add_controller(keys)
                focus_ctl = Gtk.EventControllerFocus()
                focus_ctl.connect("enter", lambda *_a, rc=(r, c): setattr(self, "active", rc))
                view.add_controller(focus_ctl)
                # One click types: take the focus (and put the cursor where
                # the click was) before the page around the table can.
                click = Gtk.GestureClick(propagation_phase=Gtk.PropagationPhase.CAPTURE)
                click.connect("pressed", self._cell_pressed, view)
                view.add_controller(click)
                self.grid.attach(view, 2 * c, r, 1, 1)
                line.append(view)
            self.cells.append(line)
        for c in range(len(rows[0]) - 1):  # the drag handles between columns
            div = Gtk.Box(css_classes=["mk-table-divider"], cursor=Gdk.Cursor.new_from_name("col-resize"),
                          vexpand=True)
            g = Gtk.GestureDrag()
            g.connect("drag-begin", lambda *_a, k=c: setattr(self, "_drag", (k, list(self.data["col_w"]))))
            g.connect("drag-update", self._resize)
            g.connect("drag-end", lambda *_a: self.win._queue_save_meta())
            div.add_controller(g)
            self.grid.attach(div, 2 * c + 1, 0, 1, len(rows))
        if focus:
            r, c = focus
            GLib.idle_add(lambda: (self.cells[r][c].grab_focus(), False)[1])
        self.fit()

    def _cell_pressed(self, _gesture, _n, x, y, view):
        if not view.has_focus():
            view.grab_focus()
            bx, by = view.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, int(x), int(y))
            ok, it = view.get_iter_at_location(bx, by)
            buf = view.get_buffer()
            buf.place_cursor(it if ok else buf.get_end_iter())

    def sync_zoom(self):
        z = max(0.5, self.win.zoom)
        self.sync_position()
        for line in self.cells:
            for c, view in enumerate(line):
                view.set_size_request(round(self.data["col_w"][c] * z), round(self.data.get("row_h", 0) * z) or -1)
        self.fit()

    def _resize(self, _g, dx, _dy):
        """The divider moves: the column on its left grows by as much as the
        one on its right shrinks (the table keeps its width)."""
        k, start = self._drag
        dx /= max(0.5, self.win.zoom)
        total = start[k] + start[k + 1]
        left = max(self.MIN_COL, min(total - self.MIN_COL, start[k] + dx))
        self.data["col_w"][k], self.data["col_w"][k + 1] = round(left), round(total - left)
        self.sync_zoom()

    def _typed(self, buf, r, c):
        self.data["rows"][r][c] = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        self.fit()
        self.win._queue_save_meta()

    def _key(self, _ctl, keyval, _code, state, r, c):
        if keyval not in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            return False
        rows, cols = len(self.data["rows"]), len(self.data["rows"][0])
        back = keyval == Gdk.KEY_ISO_Left_Tab or state & Gdk.ModifierType.SHIFT_MASK
        i = r * cols + c + (-1 if back else 1)
        if i >= rows * cols:  # Tab in the last cell: a new row
            self.active = (r, c)
            self.edit("row-below")
            return True
        i = max(0, i)
        self.cells[i // cols][i % cols].grab_focus()
        return True

    def edit(self, what):
        rows, widths = self.data["rows"], self.data["col_w"]
        r, c = self.active
        r, c = min(r, len(rows) - 1), min(c, len(rows[0]) - 1)
        focus = (r, c)
        if what == "row-above":
            rows.insert(r, [""] * len(rows[0]))
        elif what == "row-below":
            rows.insert(r + 1, [""] * len(rows[0]))
            focus = (r + 1, 0)
        elif what == "row-del" and len(rows) > 1:
            rows.pop(r)
            focus = (min(r, len(rows) - 1), c)
        elif what in ("col-left", "col-right"):
            at = c if what == "col-left" else c + 1
            for row in rows:
                row.insert(at, "")
            widths.insert(at, 120)
            focus = (r, at)
        elif what == "col-del" and len(rows[0]) > 1:
            for row in rows:
                row.pop(c)
            widths.pop(c)
            focus = (r, min(c, len(rows[0]) - 1))
        elif what == "table-del":
            self.win.remove_table(self)
            return
        self.build(focus)
        self.win._queue_save_meta()

    @staticmethod
    def _window_point(gesture):
        """Where the pointer is in the window. GestureDrag's own offsets are
        measured from the widget being dragged, and that widget moves with
        the table: they swing back and forth (the table shook). The
        window's coordinates don't move."""
        event = gesture.get_last_event(gesture.get_last_updated_sequence())
        ok, x, y = event.get_position() if event else (False, 0, 0)
        return (x, y) if ok else None

    def _move_begin(self, gesture, *_a):
        self._start = (self.data.get("x", 56.0), self.data.get("y", 80.0))
        self._origin = self._window_point(gesture)
        self.select(True)
        self.set_opacity(0.6)

    def _move_update(self, gesture, _dx, _dy):
        """Anywhere on the page: follows the pointer, no snapping."""
        here = self._window_point(gesture)
        if not here or not self._origin:
            return
        z = max(0.5, self.win.zoom)
        self.data["x"] = max(0.0, self._start[0] + (here[0] - self._origin[0]) / z)
        self.data["y"] = max(0.0, self._start[1] + (here[1] - self._origin[1]) / z)
        self.sync_position()

    def _handle_begin(self, gesture, _x, _y, hx, hy):
        self._dragging = True
        self._origin = self._window_point(gesture)
        self._which = (hx, hy)
        self._start = (self.data.get("x", 56.0), self.data.get("y", 80.0))
        self._w0 = list(self.data["col_w"])
        self._h0 = self.grid.get_height() / max(0.5, self.win.zoom)

    def _handle_update(self, gesture, _dx, _dy):
        """Corners scale width and height together, edges one of them; the
        left and top handles move the table so its other side stays put."""
        here = self._window_point(gesture)
        if not here or not self._origin:
            return
        z = max(0.5, self.win.zoom)
        dx, dy = (here[0] - self._origin[0]) / z, (here[1] - self._origin[1]) / z
        hx, hy = self._which
        rows = len(self.data["rows"])
        if hx != 1:
            total = sum(self._w0)
            grow = dx if hx == 2 else -dx
            k = max(self.MIN_COL * len(self._w0) / total, (total + grow) / total)
            self.data["col_w"] = [max(self.MIN_COL, round(w * k)) for w in self._w0]
            if hx == 0:
                self.data["x"] = max(0.0, self._start[0] + total - sum(self.data["col_w"]))
        if hy != 1:
            grow = dy if hy == 2 else -dy
            target = max(rows * 24.0, self._h0 + grow)
            self.data["row_h"] = round(target / rows)
            if hy == 0:
                self.data["y"] = max(0.0, self._start[1] + self._h0 - target)
        self.sync_zoom()

    def select(self, on):
        if getattr(self, "selected", False) == on:
            return
        self.selected = on
        for h in self.handles:
            h.set_visible(on)
        (self.add_css_class if on else self.remove_css_class)("mk-table-selected")

    def _maybe_unselect(self):
        if getattr(self, "_dragging", False) or getattr(self, "_all", False):
            self._dragging = False
            return
        root = self.get_root()
        focus = root.get_focus() if root else None
        if not (focus and focus.is_ancestor(self)):
            self.select(False)

    def fit(self):
        """A Gtk.Fixed gives children their minimum size, which squashes
        wrapping cells to one line: ask for the natural size instead (after
        building, typing and resizing)."""
        if getattr(self, "_fit_id", 0):
            return

        def run():
            self._fit_id = 0
            self.set_size_request(-1, -1)
            _mw, nat_w, _b1, _b2 = self.measure(Gtk.Orientation.HORIZONTAL, -1)
            _mh, nat_h, _b3, _b4 = self.measure(Gtk.Orientation.VERTICAL, nat_w)
            self.set_size_request(nat_w, nat_h)
            return False
        self._fit_id = GLib.idle_add(run)

    def sync_position(self):
        z = max(0.5, self.win.zoom)
        if self.get_parent() is self.win.canvas_fixed:
            self.win.canvas_fixed.move(self, round(self.data.get("x", 56.0) * z), round(self.data.get("y", 80.0) * z))

    def to_markdown(self):
        rows = self.data["rows"]
        def cell(t):
            return t.replace("|", "\\|").replace("\n", "<br>")
        out = ["| " + " | ".join(cell(t) for t in rows[0]) + " |", "|" + "---|" * len(rows[0])]
        out += ["| " + " | ".join(cell(t) for t in row) + " |" for row in rows[1:]]
        return "\n".join(out)


class FreeCanvasImage(Gtk.Box):
    PAD_TOP = 32
    PAD_SIDE = 14

    def __init__(self, path, item_data, note_win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=3,
                         halign=Gtk.Align.START, valign=Gtk.Align.START)
        self.path = Path(path)
        self.data = item_data
        self.win = note_win
        self.selected = False
        self.drag_mode = None
        self._surf = None
        self.aspect = 0.75
        self._load_surface()

        if not self.data.get("w"):
            self.data["w"] = 400.0
        if not self.data.get("h"):
            self.data["h"] = round(self.data["w"] * self.aspect)
        self.data.setdefault("x", 48.0)
        self.data.setdefault("y", 140.0)
        self.data.setdefault("angle", 0)

        # Floating Image Toolbar: [ Snap Left | Center | Snap Right | Crop & Filter | Delete ]
        self.toolbar = Gtk.Box(spacing=3, halign=Gtk.Align.CENTER, css_classes=["mk-img-bar"], visible=False)
        snap_l = Gtk.Button(icon_name="format-justify-left-symbolic", tooltip_text="Snap Left", css_classes=["flat"])
        snap_l.connect("clicked", lambda *_: self._snap_x("left"))
        self.toolbar.append(snap_l)

        snap_c = Gtk.Button(icon_name="format-justify-center-symbolic", tooltip_text="Center", css_classes=["flat"])
        snap_c.connect("clicked", lambda *_: self._snap_x("center"))
        self.toolbar.append(snap_c)

        snap_r = Gtk.Button(icon_name="format-justify-right-symbolic", tooltip_text="Snap Right", css_classes=["flat"])
        snap_r.connect("clicked", lambda *_: self._snap_x("right"))
        self.toolbar.append(snap_r)
        for icon, tip, how in LAYER_ACTIONS:
            lb = Gtk.Button(icon_name=icon, tooltip_text=tip, css_classes=["flat"])
            lb.connect("clicked", lambda _b, h=how: self.win.restack(self, h))
            self.toolbar.append(lb)

        # In-canvas Crop & Filter Popover (zero modal popups)
        filter_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                             margin_top=8, margin_bottom=8, margin_start=8, margin_end=8)
        filter_box.append(Gtk.Label(label="✨ In-Canvas Image Filters", xalign=0, css_classes=["mk-row-title"]))
        f_row1 = Gtk.Box(spacing=4)
        for f_lbl, f_fn in (
            ("B&W", self._apply_bw),
            ("Sepia", self._apply_sepia),
            ("Invert", self._apply_invert),
            ("Warm", self._apply_warm),
        ):
            fb = Gtk.Button(label=f_lbl, css_classes=["flat"])
            fb.connect("clicked", lambda _b, fn=f_fn: (self.filter_pop.popdown(), fn()))
            f_row1.append(fb)
        filter_box.append(f_row1)

        f_row2 = Gtk.Box(spacing=4)
        for f_lbl, f_fn in (
            ("Flip ⇄", self._flip),
            ("Flip ⇅", self._flip_v),
            ("Crop 10%", self._crop_margins),
            ("Reset", self._reset_orig),
        ):
            fb = Gtk.Button(label=f_lbl, css_classes=["flat"])
            fb.connect("clicked", lambda _b, fn=f_fn: (self.filter_pop.popdown(), fn()))
            f_row2.append(fb)
        filter_box.append(f_row2)

        self.filter_pop = Gtk.Popover(child=filter_box)
        filter_btn = Gtk.MenuButton(icon_name="applications-graphics-symbolic", popover=self.filter_pop,
                                    tooltip_text="Crop & Filter (In-Canvas)", css_classes=["flat"])
        self.toolbar.append(filter_btn)

        del_btn = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Delete Image (Del)", css_classes=["flat"])
        del_btn.connect("clicked", lambda *_: self._delete())
        self.toolbar.append(del_btn)
        self.append(self.toolbar)

        self.canvas = Gtk.DrawingArea()
        self.canvas.set_draw_func(self._draw)
        self.append(self.canvas)
        self.sync_zoom_geometry()

        click = Gtk.GestureClick(button=1)
        click.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        click.connect("pressed", self._on_press)
        click.connect("released", self._on_release)
        self.canvas.add_controller(click)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        self.canvas.add_controller(motion)

    def _load_surface(self):
        try:
            if self.path.suffix.lower() == ".svg":
                tex = Gdk.Texture.new_from_filename(str(self.path))
                png = tex.save_to_png_bytes().get_data()
                self._surf = cairo.ImageSurface.create_from_png(io.BytesIO(png))
            else:
                from PIL import Image
                pil = Image.open(self.path).convert("RGBA")
                buf = io.BytesIO()
                pil.save(buf, format="PNG")
                buf.seek(0)
                self._surf = cairo.ImageSurface.create_from_png(buf)
            if self._surf and self._surf.get_width() > 0:
                self.aspect = self._surf.get_height() / float(self._surf.get_width())
        except Exception:
            self._surf = None

    def sync_zoom_geometry(self):
        z = self.win.zoom
        self.disp_w = max(50, round(self.data["w"] * z))
        self.disp_h = max(40, round(self.data["h"] * z))
        # Rotated, the image needs its bounding box: the canvas grows by the
        # overhang on each side (ex, ey) and moves back by as much, so the
        # image stays put and its corners are never cut off.
        a = math.radians(self.data.get("angle", 0))
        bw = abs(self.disp_w * math.cos(a)) + abs(self.disp_h * math.sin(a))
        bh = abs(self.disp_w * math.sin(a)) + abs(self.disp_h * math.cos(a))
        self.ex = math.ceil(max(0.0, (bw - self.disp_w) / 2))
        self.ey = math.ceil(max(0.0, (bh - self.disp_h) / 2))
        cw = self.disp_w + 2 * (self.PAD_SIDE + self.ex)
        ch = self.disp_h + self.PAD_TOP + self.PAD_SIDE + 2 * self.ey
        self.canvas.set_size_request(cw, ch)
        self.set_size_request(cw, ch + (38 if self.selected else 0))
        px = max(4, round(self.data["x"] * z) - self.ex)
        py = max(4, round(self.data["y"] * z) - self.ey)
        if self.get_parent() is self.win.canvas_fixed:
            self.win.canvas_fixed.move(self, px, py)
        self.canvas.queue_draw()

    def set_selected(self, sel):
        if self.selected == sel:
            return
        self.selected = sel
        self.toolbar.set_visible(sel)
        self.sync_zoom_geometry()

    def _origin(self):
        """Top-left of the unrotated image inside the canvas."""
        return self.PAD_SIDE + getattr(self, "ex", 0), self.PAD_TOP + getattr(self, "ey", 0)

    def _handles(self, rotated=True):
        """Handle positions; rotated (canvas coordinates) unless asked not to."""
        x0, y0 = self._origin()
        x1, y1 = x0 + self.disp_w, y0 + self.disp_h
        cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
        plain = {
            "nw": (x0, y0),
            "n": (cx, y0),
            "ne": (x1, y0),
            "e": (x1, cy),
            "se": (x1, y1),
            "s": (cx, y1),
            "sw": (x0, y1),
            "w": (x0, cy),
            "rotate": (cx, y0 - 20),
        }
        a = math.radians(self.data.get("angle", 0))
        if not rotated or not a:
            return plain
        ca, sa = math.cos(a), math.sin(a)
        return {k: (cx + (hx - cx) * ca - (hy - cy) * sa, cy + (hx - cx) * sa + (hy - cy) * ca)
                for k, (hx, hy) in plain.items()}

    def hit_handle(self, x, y):
        if not self.selected:
            return "move"
        for name, (hx, hy) in self._handles().items():
            if math.hypot(x - hx, y - hy) <= 14:
                return name
        return "move"

    def _on_press(self, gesture, n_press, _x, _y):
        self.win.select_canvas_image(self)
        if n_press == 2:
            self._open_studio()
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)

    def _on_release(self, gesture, *_):
        if not self.drag_mode:
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)

    def _on_motion(self, _ctrl, x, y):
        h = self.hit_handle(x, y) if self.selected else "pointer"
        cursors = {
            "nw": "nwse-resize", "se": "nwse-resize",
            "ne": "nesw-resize", "sw": "nesw-resize",
            "n": "ns-resize", "s": "ns-resize",
            "e": "ew-resize", "w": "ew-resize",
            "rotate": "grab",
            "move": "move",
        }
        self.canvas.set_cursor(Gdk.Cursor.new_from_name(cursors.get(h, "pointer")))

    def _set_angle(self, deg):
        self.data["angle"] = deg % 360
        self.sync_zoom_geometry()  # the bounding box changes with the angle
        self.win.save_note_meta()

    def _snap_x(self, mode):
        page_w = max(600, (self.win.view.get_width() / max(0.5, self.win.zoom)) - 60)
        if mode == "left":
            self.data["x"] = 36.0
        elif mode == "center":
            self.data["x"] = max(24.0, round((page_w - self.data["w"]) / 2))
        elif mode == "right":
            self.data["x"] = max(24.0, round(page_w - self.data["w"]))
        self.sync_zoom_geometry()
        self.win.save_note_meta()

    def _ensure_backup(self):
        try:
            bak = self.path.with_name(f"{self.path.name}.orig")
            if not bak.exists():
                shutil.copy2(self.path, bak)
        except Exception:
            pass

    def _apply_pil_filter(self, transform_fn):
        if self.path.suffix.lower() == ".svg":
            return
        self._ensure_backup()
        try:
            from PIL import Image
            im = Image.open(self.path).convert("RGBA")
            new_im = transform_fn(im)
            if new_im:
                new_im.save(self.path)
                self._load_surface()
                self.sync_zoom_geometry()
                self.win.save_note_meta()
        except Exception:
            pass

    def _apply_bw(self):
        from PIL import ImageOps
        self._apply_pil_filter(lambda im: ImageOps.grayscale(im).convert("RGBA"))

    def _apply_sepia(self):
        from PIL import ImageOps
        def sepia(im):
            gray = ImageOps.grayscale(im)
            return ImageOps.colorize(gray, black="#2e1c0c", white="#f4ecd8").convert("RGBA")
        self._apply_pil_filter(sepia)

    def _apply_invert(self):
        from PIL import Image, ImageOps
        def invert(im):
            r, g, b, a = im.split()
            rgb = ImageOps.invert(Image.merge("RGB", (r, g, b)))
            nr, ng, nb = rgb.split()
            return Image.merge("RGBA", (nr, ng, nb, a))
        self._apply_pil_filter(invert)

    def _apply_warm(self):
        from PIL import ImageEnhance
        self._apply_pil_filter(lambda im: ImageEnhance.Color(im).enhance(1.45))

    def _flip(self):
        from PIL import ImageOps
        self._apply_pil_filter(ImageOps.mirror)

    def _flip_v(self):
        from PIL import ImageOps
        self._apply_pil_filter(ImageOps.flip)

    def _crop_margins(self):
        def crop(im):
            w, h = im.size
            if w > 30 and h > 30:
                return im.crop((int(w * 0.05), int(h * 0.05), int(w * 0.95), int(h * 0.95)))
            return im
        self._apply_pil_filter(crop)

    def _reset_orig(self):
        bak = self.path.with_name(f"{self.path.name}.orig")
        if bak.exists():
            shutil.copy2(bak, self.path)
            self._load_surface()
            self.sync_zoom_geometry()
            self.win.save_note_meta()

    def _open_studio(self):
        self.filter_pop.popup()

    def _delete(self):
        self.win.remove_canvas_image(self)

    def _draw(self, _area, cr, _w, _h):
        x0, y0 = self._origin()
        cx, cy = x0 + self.disp_w / 2, y0 + self.disp_h / 2
        angle = int(self.data.get("angle", 0))

        if self._surf:
            iw, ih = self._surf.get_width(), self._surf.get_height()
            if iw > 0 and ih > 0:
                cr.save()
                cr.translate(cx, cy)
                if angle:
                    cr.rotate(math.radians(angle))
                cr.scale(self.disp_w / iw, self.disp_h / ih)
                cr.set_source_surface(self._surf, -iw / 2, -ih / 2)
                cr.paint()
                cr.restore()

        if not self.selected:
            return

        # The frame, its handles and the rotate stalk turn with the image.
        cr.save()
        cr.translate(cx, cy)
        cr.rotate(math.radians(angle))
        cr.translate(-cx, -cy)
        cr.set_source_rgba(0.22, 0.58, 0.98, 0.95)
        cr.set_line_width(2.0)
        cr.rectangle(x0, y0, self.disp_w, self.disp_h)
        cr.stroke()
        cr.move_to(cx, y0)
        cr.line_to(cx, y0 - 20)
        cr.stroke()
        for key in ("nw", "n", "ne", "e", "se", "s", "sw", "w"):
            hx, hy = self._handles(rotated=False)[key]
            cr.rectangle(hx - 5, hy - 5, 10, 10)
            cr.set_source_rgb(1, 1, 1)
            cr.fill_preserve()
            cr.set_source_rgba(0.22, 0.58, 0.98, 1.0)
            cr.set_line_width(2.0)
            cr.stroke()
        cr.restore()

        handles = self._handles()
        rx, ry = handles["rotate"]

        # Word-Style Circular Rotation Handle with Curved Arrow ⟳ symbol drawn cleanly
        cr.arc(rx, ry, 9, 0, 2 * math.pi)
        cr.set_source_rgb(1, 1, 1)
        cr.fill_preserve()
        cr.set_source_rgba(0.22, 0.58, 0.98, 1.0)
        cr.set_line_width(2.4)
        cr.stroke()

        # Draw small rotation arrow arc inside handle
        cr.arc(rx, ry, 4.5, -math.pi / 2, math.pi)
        cr.set_source_rgba(0.22, 0.58, 0.98, 1.0)
        cr.set_line_width(1.5)
        cr.stroke()

        if self.drag_mode == "rotate":
            hud = f"{angle}°"
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(12)
            ext = cr.text_extents(hud)
            bw, bh = ext.width + 16, ext.height + 10
            cr.set_source_rgba(0.06, 0.09, 0.16, 0.90)
            cr.rectangle(rx + 12, ry - bh / 2, bw, bh)
            cr.fill()
            cr.set_source_rgb(1, 1, 1)
            cr.move_to(rx + 20, ry + ext.height / 2 - 1)
            cr.show_text(hud)

        if self.drag_mode in ("nw", "n", "ne", "e", "se", "s", "sw", "w", "move"):
            badge = f"{int(self.data['w'])} × {int(self.data['h'])} px"
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(11)
            ext = cr.text_extents(badge)
            bw, bh = ext.width + 16, ext.height + 8
            bx = x0 + self.disp_w - bw
            by = y0 + self.disp_h + 8
            cr.set_source_rgba(0.06, 0.09, 0.16, 0.90)
            cr.rectangle(bx, by, bw, bh)
            cr.fill()
            cr.set_source_rgb(1, 1, 1)
            cr.move_to(bx + 8, by + ext.height + (bh - ext.height) / 2 - 2)
            cr.show_text(badge)


def stroke_outline(points, width):
    if len(points) == 1:
        x, y, p = points[0]
        r = width * (0.35 + 0.8 * p) / 2
        return [(x + r * math.cos(a), y + r * math.sin(a)) for a in [i * math.pi / 6 for i in range(12)]]
    left, right = [], []
    for i, (x, y, p) in enumerate(points):
        x0, y0 = points[max(0, i - 1)][:2]
        x1, y1 = points[min(len(points) - 1, i + 1)][:2]
        dx, dy = x1 - x0, y1 - y0
        length = math.hypot(dx, dy) or 1
        nx, ny = -dy / length, dx / length
        r = width * (0.35 + 0.8 * p) / 2
        left.append((x + nx * r, y + ny * r))
        right.append((x - nx * r, y - ny * r))

    def cap(cx, cy, r, start):
        return [(cx + r * math.cos(start + k * math.pi / 6), cy + r * math.sin(start + k * math.pi / 6))
                for k in range(1, 6)]
    (xe, ye, pe), (xs, ys, ps) = points[-1], points[0]
    ae = math.atan2(left[-1][1] - ye, left[-1][0] - xe)
    as_ = math.atan2(right[0][1] - ys, right[0][0] - xs)
    return (left + cap(xe, ye, width * (0.35 + 0.8 * pe) / 2, ae) + right[::-1]
            + cap(xs, ys, width * (0.35 + 0.8 * ps) / 2, as_))



# Shapes for the drawing layer, OneNote-style: (tool, label) by category.
SHAPES = {
    "Lines": (("line", "Line"), ("arrow", "Arrow"), ("double-arrow", "Double arrow"), ("elbow", "Elbow connector")),
    "Basic shapes": (("rect", "Rectangle"), ("rounded", "Rounded rectangle"), ("circle", "Oval / circle"),
                     ("triangle", "Triangle"), ("diamond", "Diamond")),
    "Graphs": (("xy", "X–Y axes"), ("quadrant", "4-quadrant grid"), ("triad", "3D axes")),
}
SHAPE_TOOLS = {tool for group in SHAPES.values() for tool, _label in group}
LINE_TOOLS = {"line", "arrow", "double-arrow", "elbow"}


def _arrow_head(cr, x0, y0, x1, y1, w):
    """An open arrowhead at (x1, y1), pointing away from (x0, y0)."""
    ang = math.atan2(y1 - y0, x1 - x0)
    head = max(12.0, w * 3.5)
    for side in (-0.5, 0.5):
        cr.move_to(x1, y1)
        cr.line_to(x1 - head * math.cos(ang + side), y1 - head * math.sin(ang + side))
    cr.stroke()


def draw_shape(cr, tool, x0, y0, x1, y1, w):
    """The shapes beyond rectangle, oval, line and arrow, dragged from
    (x0, y0) to (x1, y1), in the current colour and line width."""
    left, top = min(x0, x1), min(y0, y1)
    bw, bh = abs(x1 - x0), abs(y1 - y0)
    cx, cy = left + bw / 2, top + bh / 2
    if tool == "double-arrow":
        cr.move_to(x0, y0)
        cr.line_to(x1, y1)
        cr.stroke()
        _arrow_head(cr, x0, y0, x1, y1, w)
        _arrow_head(cr, x1, y1, x0, y0, w)
    elif tool == "elbow":  # across, then down, with an arrowhead
        cr.move_to(x0, y0)
        cr.line_to(x1, y0)
        cr.line_to(x1, y1)
        cr.stroke()
        if abs(y1 - y0) > 1:
            _arrow_head(cr, x1, y0, x1, y1, w)
    elif tool == "rounded":
        r = min(bw, bh) * 0.2
        cr.new_sub_path()
        cr.arc(left + bw - r, top + r, r, -math.pi / 2, 0)
        cr.arc(left + bw - r, top + bh - r, r, 0, math.pi / 2)
        cr.arc(left + r, top + bh - r, r, math.pi / 2, math.pi)
        cr.arc(left + r, top + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.stroke()
    elif tool == "triangle":
        cr.move_to(cx, top)
        cr.line_to(left + bw, top + bh)
        cr.line_to(left, top + bh)
        cr.close_path()
        cr.stroke()
    elif tool == "diamond":
        cr.move_to(cx, top)
        cr.line_to(left + bw, cy)
        cr.line_to(cx, top + bh)
        cr.line_to(left, cy)
        cr.close_path()
        cr.stroke()
    elif tool in ("xy", "quadrant"):
        if tool == "quadrant":  # a light grid in all four quadrants
            step = max(12.0, min(bw, bh) / 10)
            cr.save()
            cr.set_line_width(max(0.6, w / 4))
            cr.push_group()
            gx = cx - step * math.floor((cx - left) / step)
            while gx <= left + bw:
                cr.move_to(gx, top)
                cr.line_to(gx, top + bh)
                gx += step
            gy = cy - step * math.floor((cy - top) / step)
            while gy <= top + bh:
                cr.move_to(left, gy)
                cr.line_to(left + bw, gy)
                gy += step
            cr.stroke()
            cr.pop_group_to_source()
            cr.paint_with_alpha(0.45)
            cr.restore()
            ox, oy = cx, cy
            cr.move_to(left, oy)
            cr.line_to(left + bw, oy)
            cr.move_to(ox, top + bh)
            cr.line_to(ox, top)
            cr.stroke()
            _arrow_head(cr, left, oy, left + bw, oy, w)
            _arrow_head(cr, left + bw, oy, left, oy, w)
            _arrow_head(cr, ox, top + bh, ox, top, w)
            _arrow_head(cr, ox, top, ox, top + bh, w)
        else:  # first quadrant: origin bottom left, ticks along both axes
            ox, oy = left, top + bh
            cr.move_to(ox, oy)
            cr.line_to(left + bw, oy)
            cr.move_to(ox, oy)
            cr.line_to(ox, top)
            cr.stroke()
            _arrow_head(cr, ox, oy, left + bw, oy, w)
            _arrow_head(cr, ox, oy, ox, top, w)
            step = max(14.0, min(bw, bh) / 8)
            tick = max(4.0, w * 1.5)
            t = step
            while t < bw - step / 2:
                cr.move_to(ox + t, oy - tick)
                cr.line_to(ox + t, oy + tick)
                t += step
            t = step
            while t < bh - step / 2:
                cr.move_to(ox - tick, oy - t)
                cr.line_to(ox + tick, oy - t)
                t += step
            cr.stroke()
        labels = (("x", left + bw + 6, (cy if tool == "quadrant" else top + bh) + 4),
                  ("y", (cx if tool == "quadrant" else left) - 4, top - 8))
        _axis_labels(cr, labels, w)
    elif tool == "triad":  # x right, y up, z towards you (down-left)
        ox, oy = left + bw * 0.4, top + bh * 0.6
        ends = (("x", left + bw, oy), ("y", ox, top), ("z", left, top + bh))
        for _name, ex, ey in ends:
            cr.move_to(ox, oy)
            cr.line_to(ex, ey)
            cr.stroke()
            _arrow_head(cr, ox, oy, ex, ey, w)
        _axis_labels(cr, [(n, ex + (6 if n == "x" else -14 if n == "z" else -4), ey + (4 if n == "x" else 14 if n == "z" else -8))
                          for n, ex, ey in ends], w)


def _axis_labels(cr, labels, w):
    cr.save()
    cr.select_font_face("Sans", cairo.FONT_SLANT_ITALIC, cairo.FONT_WEIGHT_NORMAL)
    cr.set_font_size(max(13.0, w * 3.5))
    for text, x, y in labels:
        cr.move_to(x, y)
        cr.show_text(text)
    cr.restore()

class StudioInkCanvas(Gtk.DrawingArea):
    def __init__(self, note_win):
        super().__init__(hexpand=True, vexpand=True)
        self.win = note_win
        self.strokes = []
        self.redo_stack = []
        self.current = None
        self.laser_trails = []
        self._laser_timer = 0
        self.active = False
        self.tool = "pen"  # 'pen', 'highlighter', 'eraser', 'lasso', 'laser', 'rect', 'circle', 'line', 'arrow'
        self.selection = None   # lasso / Ctrl+A: {"strokes": [stroke dicts], "items": [widgets]}
        self._lasso = None      # the loop being drawn: [(x, y), ...] in page units
        self._grab = None       # moving or scaling the selection
        self.ink = "#3b82f6"
        self.width = 4.0
        self.set_draw_func(self._draw)
        self.set_can_target(False)

        stylus = Gtk.GestureStylus(stylus_only=False)
        stylus.connect("down", self._down)
        stylus.connect("motion", self._motion)
        stylus.connect("up", self._up)
        self.add_controller(stylus)

        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", lambda g, x, y: self._down(g, x, y))
        drag.connect("drag-update", lambda g, dx, dy: self._motion(
            g, g.get_start_point()[1] + dx, g.get_start_point()[2] + dy))
        drag.connect("drag-end", lambda g, dx, dy: self._up(g, 0, 0))
        self.add_controller(drag)

    def set_ink_mode(self, active):
        self.active = active
        self.set_can_target(active)
        self.set_cursor(Gdk.Cursor.new_from_name("crosshair" if active else "default"))
        self.queue_draw()

    def _pressure(self, gesture):
        if isinstance(gesture, Gtk.GestureStylus):
            ok, val = gesture.get_axis(Gdk.AxisUse.PRESSURE)
            if ok and val > 0:
                return min(1.0, val)
        return 0.5

    def _down(self, gesture, x, y):
        if not self.active:
            return
        z = max(0.5, self.win.zoom)
        px, py = x / z, y / z
        if self.tool == "lasso":
            self._lasso_down(px, py)
            return
        if self.tool == "quickhl":   # Quick Highlight: a marker that settles behind the line of text
            self.current = {"tool": "highlighter", "color": self.win.quick_hl_colour, "width": 14.0,
                            "under": True, "points": [[px, py, 0.5]]}
            self.queue_draw()
            return
        if self.tool == "eraser":
            self._erase_at(px, py)
            self.current = {"erasing": True}
            return
        if self.tool == "laser":
            trail = {"points": [(px, py, time.time())]}
            self.laser_trails.append(trail)
            self.current = {"laser": trail}
            self._ensure_laser_timer()
            self.queue_draw()
            return
        if self.tool in SHAPE_TOOLS:
            self.current = {"tool": self.tool, "color": self.ink, "width": self.width,
                            "points": [[px, py, 0.5], [px, py, 0.5]]}
            self.queue_draw()
            return
        self.current = {"tool": self.tool, "color": self.ink, "width": self.width,
                        "points": [[px, py, self._pressure(gesture)]]}
        if self.tool == "highlighter":   # the student highlighter: under the text, in its own colour and size
            self.current.update(color=self.win.hl_colour, width=self.win.hl_width, under=True, v=2)
        self.queue_draw()

    def _motion(self, gesture, x, y):
        if not self.active or not self.current:
            return
        z = max(0.5, self.win.zoom)
        px, py = x / z, y / z
        if self.current.get("lasso"):
            self._lasso_motion(px, py)
            return
        if self.current.get("erasing"):
            self._erase_at(px, py)
            return
        if "laser" in self.current:
            self.current["laser"]["points"].append((px, py, time.time()))
            self.queue_draw()
            return
        if self.current.get("tool") in SHAPE_TOOLS:
            self.current["points"][1] = [px, py, 0.5]
            self.queue_draw()
            return
        last = self.current["points"][-1]
        if math.hypot(px - last[0], py - last[1]) < 1.2:
            return
        self.current["points"].append([px, py, self._pressure(gesture)])
        self.queue_draw()

    def _up(self, *_):
        if not self.active:
            return
        stroke, self.current = self.current, None
        if stroke and stroke.get("lasso"):
            self._lasso_up()
            return
        if not stroke or stroke.get("erasing") or "laser" in stroke:
            self.queue_draw()
            return
        pts = stroke["points"]
        if stroke["tool"] in ("pen", "highlighter") and len(pts) > 2:
            pts = [pts[0]] + [[(a[0] + 2 * b[0] + c[0]) / 4, (a[1] + 2 * b[1] + c[1]) / 4, b[2]]
                              for a, b, c in zip(pts, pts[1:], pts[2:])] + [pts[-1]]
        stroke["points"] = [[round(px, 1), round(py, 1), round(p, 2)] for px, py, p in pts]
        if stroke.get("under") and (self.tool == "quickhl" or self.win.hl_snap):
            stroke = self.win.snap_highlight(stroke)
        if stroke.get("under"):
            # over a printout or picture the layer under the text would be
            # hidden by it: there the stroke is drawn on top, translucent
            cx = sum(p[0] for p in stroke["points"]) / len(stroke["points"])
            cy = sum(p[1] for p in stroke["points"]) / len(stroke["points"])
            for img in self.win.canvas_images:
                x, y, bw, bh = self._item_box(img)
                if x <= cx <= x + bw and y <= cy <= y + bh:
                    stroke["under"] = False
                    break
        self.strokes.append(stroke)
        self.redo_stack.clear()
        self.win.save_note_meta()
        self.queue_draw()

    # ---------- lasso: select ink, pictures, text boxes and tables by drawing round them
    HANDLE = 9  # a selection corner handle, px on screen

    def _item_box(self, w):
        """(x, y, w, h) of a canvas item, page units, where it shows."""
        z = max(0.5, self.win.zoom)
        d = w.data
        if isinstance(w, FreeCanvasImage):
            return d["x"] + w.PAD_SIDE / z, d["y"] + w.PAD_TOP / z, d.get("w", 0), d.get("h", 0)
        if isinstance(w, StickyNoteWidget):
            return d["x"], d["y"], d.get("w", 0), d.get("h", 0)
        return d["x"], d["y"], w.get_width() / z, w.get_height() / z

    def _items(self):
        return self.win.canvas_images + self.win.sticky_notes + self.win.table_items + \
            getattr(self.win, "pinned_stickies", [])

    def selection_box(self):
        """The selection's bounds (x0, y0, x1, y1), page units, or None."""
        sel = self.selection
        if not sel:
            return None
        xs, ys = [], []
        for st in sel["strokes"]:
            pad = st.get("width", 4) / 2
            xs += [p[0] - pad for p in st["points"]] + [p[0] + pad for p in st["points"]]
            ys += [p[1] - pad for p in st["points"]] + [p[1] + pad for p in st["points"]]
        for w in sel["items"]:
            x, y, bw, bh = self._item_box(w)
            xs += [x, x + bw]
            ys += [y, y + bh]
        return (min(xs) - 6, min(ys) - 6, max(xs) + 6, max(ys) + 6) if xs else None

    @staticmethod
    def _inside(poly, x, y):
        """Ray casting: is (x, y) inside the closed polygon POLY?"""
        inside, j = False, len(poly) - 1
        for i, (xi, yi) in enumerate(poly):
            xj, yj = poly[j]
            if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / ((yj - yi) or 1e-9) + xi:
                inside = not inside
            j = i
        return inside

    def select(self, strokes, items):
        self.selection = {"strokes": strokes, "items": items} if strokes or items else None
        self.queue_draw()

    def select_all(self, on):
        self.select(list(self.strokes), list(self._items())) if on else self.select([], [])

    def _corner_at(self, px, py):
        box = self.selection_box()
        if not box:
            return None
        reach = (self.HANDLE + 4) / max(0.5, self.win.zoom)
        for cx, cy, opposite in ((box[0], box[1], (box[2], box[3])), (box[2], box[1], (box[0], box[3])),
                                 (box[0], box[3], (box[2], box[1])), (box[2], box[3], (box[0], box[1]))):
            if abs(px - cx) <= reach and abs(py - cy) <= reach:
                return opposite
        return None

    def _lasso_down(self, px, py):
        box = self.selection_box()
        anchor = self._corner_at(px, py)
        if anchor or (box and box[0] <= px <= box[2] and box[1] <= py <= box[3]):
            # move (inside the box) or scale (a corner) what's selected
            self._grab = {"from": (px, py), "anchor": anchor, "box": box,
                          "strokes": [[list(p) for p in st["points"]] for st in self.selection["strokes"]],
                          "widths": [st.get("width", 4) for st in self.selection["strokes"]],
                          "items": [dict(w.data) for w in self.selection["items"]]}
        else:
            self.select([], [])
            self._lasso = [(px, py)]
        self.current = {"lasso": True}
        self.queue_draw()

    def _lasso_motion(self, px, py):
        if self._lasso is not None:
            last = self._lasso[-1]
            if math.hypot(px - last[0], py - last[1]) >= 2:
                self._lasso.append((px, py))
                self.queue_draw()
            return
        g = self._grab
        if not g:
            return
        if g["anchor"]:   # scale about the opposite corner
            ax, ay = g["anchor"]
            fx, fy = g["from"]
            sx = (px - ax) / ((fx - ax) or 1e-9)
            sy = (py - ay) / ((fy - ay) or 1e-9)
            k = max(0.1, min(sx, sy) if sx > 0 and sy > 0 else 0.1)

            def move(x, y):
                return ax + (x - ax) * k, ay + (y - ay) * k
        else:
            dx, dy = px - g["from"][0], py - g["from"][1]
            k = 1.0

            def move(x, y):
                return x + dx, y + dy
        for st, pts, width in zip(self.selection["strokes"], g["strokes"], g["widths"]):
            st["points"] = [[*move(p[0], p[1]), p[2]] for p in pts]
            st["width"] = round(width * k, 2)
        for w, data in zip(self.selection["items"], g["items"]):
            x, y = move(data["x"], data["y"])
            w.data["x"], w.data["y"] = round(max(0.0, x), 1), round(max(0.0, y), 1)
            if not isinstance(w, TableItem) and data.get("w"):
                w.data["w"], w.data["h"] = round(data["w"] * k, 1), round(data.get("h", 0) * k, 1)
            (w.sync_zoom_geometry if hasattr(w, "sync_zoom_geometry") else w.sync_zoom)()
        self.queue_draw()

    def _lasso_up(self):
        if self._lasso is not None:
            poly, self._lasso = self._lasso, None
            if len(poly) >= 3:
                # a stroke is in when most of its points are; an item when its centre is
                strokes = [st for st in self.strokes
                           if sum(self._inside(poly, p[0], p[1]) for p in st["points"]) * 2 >= len(st["points"])]
                items = []
                for w in self._items():
                    x, y, bw, bh = self._item_box(w)
                    if self._inside(poly, x + bw / 2, y + bh / 2):
                        items.append(w)
                self.select(strokes, items)
        elif self._grab:
            self._grab = None
            self.win.dirty = True
            self.win.save_note_meta()
            self.win.ensure_page_height_for_images()
        self.queue_draw()

    def delete_selection(self):
        """Remove what the lasso (or Ctrl+A) selected. True if anything was."""
        sel, self.selection = self.selection, None
        if not sel:
            return False
        gone = {id(st) for st in sel["strokes"]}
        self.strokes = [st for st in self.strokes if id(st) not in gone]
        for w in sel["items"]:
            if w in self.win.canvas_images:
                self.win.remove_canvas_image(w)
            elif w in self.win.sticky_notes:
                self.win.remove_sticky_note(w)
            elif w in self.win.table_items:
                self.win.remove_table(w)
            elif w in getattr(self.win, "pinned_stickies", []):
                self.win.remove_pinned_sticky(w)
        self.win.dirty = True
        self.win.save_note_meta()
        self.queue_draw()
        return True

    def _draw_selection(self, cr, z):
        if self._lasso and len(self._lasso) > 1:
            cr.set_source_rgba(0.21, 0.52, 0.89, 0.9)
            cr.set_line_width(1.5 / z)
            cr.set_dash([5 / z, 4 / z])
            cr.move_to(*self._lasso[0])
            for p in self._lasso[1:]:
                cr.line_to(*p)
            cr.stroke()
            cr.set_dash([])
        box = self.selection_box()
        if not box:
            return
        x0, y0, x1, y1 = box
        cr.set_source_rgba(0.21, 0.52, 0.89, 0.95)
        cr.set_line_width(1.2 / z)
        cr.set_dash([6 / z, 4 / z])
        cr.rectangle(x0, y0, x1 - x0, y1 - y0)
        cr.stroke()
        cr.set_dash([])
        hs = self.HANDLE / z
        for cx, cy in ((x0, y0), (x1, y0), (x0, y1), (x1, y1)):
            cr.rectangle(cx - hs / 2, cy - hs / 2, hs, hs)
            cr.set_source_rgb(1, 1, 1)
            cr.fill_preserve()
            cr.set_source_rgba(0.21, 0.52, 0.89, 1)
            cr.stroke()

    def _ensure_laser_timer(self):
        if not self._laser_timer:
            self._laser_timer = GLib.timeout_add(30, self._tick_laser)

    def _tick_laser(self):
        now = time.time()
        kept = []
        for tr in self.laser_trails:
            pts = [(x, y, t) for x, y, t in tr["points"] if now - t < 1.6]
            if pts:
                tr["points"] = pts
                kept.append(tr)
        self.laser_trails = kept
        self.queue_draw()
        if not self.laser_trails:
            self._laser_timer = 0
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    def _hit_stroke(self, s, x, y):
        pts = s.get("points", [])
        if not pts:
            return False
        thresh = max(14.0, s.get("width", 4.0) * 2.5)
        if s.get("tool") in SHAPE_TOOLS and len(pts) >= 2:
            x0, y0 = pts[0][0], pts[0][1]
            x1, y1 = pts[-1][0], pts[-1][1]
            for t in [i / 20.0 for i in range(21)]:
                ix, iy = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
                if math.hypot(ix - x, iy - y) < thresh:
                    return True
                if s["tool"] not in LINE_TOOLS:  # boxed shapes: hit along the box
                    if math.hypot(x0 - x, iy - y) < thresh or math.hypot(x1 - x, iy - y) < thresh:
                        return True
                    if math.hypot(ix - x, y0 - y) < thresh or math.hypot(ix - x, y1 - y) < thresh:
                        return True
            return False
        return any(math.hypot(px - x, py - y) < thresh for px, py, _ in pts)

    def _erase_at(self, x, y):
        keep = [s for s in self.strokes if not self._hit_stroke(s, x, y)]
        if len(keep) != len(self.strokes):
            self.redo_stack.clear()
            self.strokes = keep
            self.win.save_note_meta()
            self.queue_draw()

    def undo(self):
        if self.strokes:
            self.redo_stack.append(self.strokes.pop())
            self.win.save_note_meta()
            self.queue_draw()

    def redo(self):
        if self.redo_stack:
            self.strokes.append(self.redo_stack.pop())
            self.win.save_note_meta()
            self.queue_draw()

    def clear(self):
        if self.strokes:
            self.redo_stack.extend(reversed(self.strokes))
            self.strokes = []
            self.win.save_note_meta()
            self.queue_draw()

    def _draw_stroke_or_shape(self, cr, stroke):
        if stroke.get("straight"):
            (x0, y0, _p0), (x1, y1, _p1) = stroke["points"][0], stroke["points"][-1]
            r, g, b = hex_rgb(stroke.get("color", "#facc15"))
            cr.set_source_rgba(r, g, b, 0.42)
            cr.set_line_width(stroke.get("width", 14))
            cr.set_line_cap(1)
            cr.move_to(x0, y0)
            cr.line_to(x1, y1)
            cr.stroke()
            return
        r, g, b = hex_rgb(stroke["color"])
        tool = stroke["tool"]
        pts = stroke["points"]
        w = stroke.get("width", 4.0)

        if tool == "highlighter":
            v2 = stroke.get("v") == 2   # the student highlighter: its width is the tip's; older ones were x 3.5
            cr.set_source_rgba(r, g, b, 0.42 if v2 else 0.36)
            cr.set_line_width(w if v2 else w * 3.5)
            cr.set_line_cap(1)
            cr.set_line_join(1)
            cr.move_to(*pts[0][:2])
            for px, py, _ in pts[1:]:
                cr.line_to(px, py)
            cr.stroke()
            return

        if tool in SHAPE_TOOLS and len(pts) >= 2:
            x0, y0 = pts[0][0], pts[0][1]
            x1, y1 = pts[-1][0], pts[-1][1]
            cr.set_source_rgb(r, g, b)
            cr.set_line_width(w)
            cr.set_line_cap(1)
            cr.set_line_join(1)
            if tool not in ("rect", "circle", "line", "arrow"):
                draw_shape(cr, tool, x0, y0, x1, y1, w)
            elif tool == "rect":
                cr.rectangle(min(x0, x1), min(y0, y1), abs(x1 - x0), abs(y1 - y0))
                cr.stroke()
            elif tool == "circle":
                cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
                rx, ry = max(2.0, abs(x1 - x0) / 2), max(2.0, abs(y1 - y0) / 2)
                cr.save()
                cr.translate(cx, cy)
                cr.scale(rx, ry)
                cr.arc(0, 0, 1.0, 0, 2 * math.pi)
                cr.restore()
                cr.stroke()
            elif tool in ("line", "arrow"):
                cr.move_to(x0, y0)
                cr.line_to(x1, y1)
                cr.stroke()
                if tool == "arrow":
                    ang = math.atan2(y1 - y0, x1 - x0)
                    head_len = max(12.0, w * 3.5)
                    for side in (-0.5, 0.5):
                        cr.move_to(x1, y1)
                        cr.line_to(x1 - head_len * math.cos(ang + side),
                                   y1 - head_len * math.sin(ang + side))
                    cr.stroke()
            return

        cr.set_source_rgb(r, g, b)
        outline = stroke_outline(pts, w)
        cr.move_to(*outline[0])
        for px, py in outline[1:]:
            cr.line_to(px, py)
        cr.close_path()
        cr.fill()

    def _draw(self, _area, cr, w, h):
        z = max(0.5, self.win.zoom)
        if self.active:
            cr.set_source_rgba(0.22, 0.58, 0.98, 0.35)
            cr.set_line_width(2.0)
            cr.rectangle(1, 1, w - 2, h - 2)
            cr.stroke()

        all_s = [s for s in self.strokes if not s.get("under")] + \
            ([self.current] if self.current and "points" in self.current else [])
        self.win.under_ink.queue_draw()
        if all_s:
            cr.save()
            cr.scale(z, z)
            for s in all_s:
                self._draw_stroke_or_shape(cr, s)
            cr.restore()
        if self.selection or self._lasso:
            cr.save()
            cr.scale(z, z)
            self._draw_selection(cr, z)
            cr.restore()

        if self.laser_trails:
            now = time.time()
            cr.save()
            cr.scale(z, z)
            for tr in self.laser_trails:
                pts = tr["points"]
                if len(pts) < 2:
                    continue
                for i in range(1, len(pts)):
                    x0, y0, _t0 = pts[i - 1]
                    x1, y1, t1 = pts[i]
                    age = now - t1
                    alpha = max(0.0, 1.0 - age / 1.6)
                    cr.set_source_rgba(1.0, 0.12, 0.28, alpha * 0.45)
                    cr.set_line_width(11.0)
                    cr.set_line_cap(1)
                    cr.move_to(x0, y0)
                    cr.line_to(x1, y1)
                    cr.stroke()
                    cr.set_source_rgba(1.0, 0.85, 0.88, alpha * 0.95)
                    cr.set_line_width(3.5)
                    cr.move_to(x0, y0)
                    cr.line_to(x1, y1)
                    cr.stroke()
            cr.restore()


class UnderInk(Gtk.DrawingArea):
    """Quick Highlight strokes, drawn between the paper and the text, so the
    letters stay crisp on top of the colour (the ink canvas, above the
    text, draws everything else)."""

    def __init__(self, note_win):
        super().__init__(hexpand=True, vexpand=True, can_target=False)
        self.win = note_win
        self.set_draw_func(self._draw)

    def _draw(self, _a, cr, _w, _h):
        ink = self.win.ink_canvas
        under = [s for s in ink.strokes if s.get("under")]
        if not under:
            return
        z = max(0.5, self.win.zoom)
        cr.save()
        cr.scale(z, z)
        for s in under:
            ink._draw_stroke_or_shape(cr, s)
        cr.restore()


class PassThroughFixed(Gtk.Fixed):
    """The layer for sticky notes and images, laid over the whole page.

    A plain Gtk.Fixed claims every click on its empty area, so the text view
    under it never got clicked or focused (typing seemed locked). This one
    only takes clicks that land on one of its children.
    """

    def do_contains(self, _x, _y):
        return False


class PaperPatternBackground(Gtk.DrawingArea):
    def __init__(self, note_win):
        super().__init__(hexpand=True, vexpand=True)
        self.win = note_win
        self.set_can_target(False)
        self.set_draw_func(self._draw)

    def _draw(self, _area, cr, w, h):
        pattern = look_conf().get("PAPER_PATTERN", "dots")
        preset = THEMES.get(look_conf().get("THEME_PRESET", "obsidian"), THEMES["obsidian"])
        is_dark = preset["dark"]
        # Between two A4 sheets: a gap of the workspace's colour with a soft
        # shadow under the page above, like Google Docs' page breaks.
        page_h = self.win.page_height()
        gap = PAGE_GAP * max(0.5, self.win.zoom)
        r, g, b = hex_rgb(preset["win_bg"])
        y = page_h
        while y < h - 1:
            shade = cairo.LinearGradient(0, y, 0, y + gap)
            shade.add_color_stop_rgba(0, 0, 0, 0, 0.45)
            shade.add_color_stop_rgba(0.25, r, g, b, 1)
            shade.add_color_stop_rgba(1, r, g, b, 1)
            cr.set_source(shade)
            cr.rectangle(0, y - gap / 2, w, gap)
            cr.fill()
            y += page_h
        if pattern == "plain":
            return
        cr.set_source_rgba(1, 1, 1, 0.06) if is_dark else cr.set_source_rgba(0, 0, 0, 0.07)
        step = max(18, round(28 * self.win.zoom))
        if pattern == "dots":
            for x in range(step, w, step):
                for y in range(step, h, step):
                    cr.arc(x, y, 1.2, 0, 2 * math.pi)
                    cr.fill()
        elif pattern == "grid":
            cr.set_line_width(1.0)
            for x in range(0, w, step):
                cr.move_to(x + 0.5, 0)
                cr.line_to(x + 0.5, h)
            for y in range(0, h, step):
                cr.move_to(0, y + 0.5)
                cr.line_to(w, y + 0.5)
            cr.stroke()
        elif pattern == "lined":
            cr.set_line_width(1.0)
            for y in range(step * 2, h, step):
                cr.move_to(24, y + 0.5)
                cr.line_to(w - 24, y + 0.5)
            cr.stroke()


# Notebook colours for the map when a notebook has none of its own.
PASTELS = ["#f9a8d4", "#93c5fd", "#86efac", "#fcd34d", "#c4b5fd", "#fdba74", "#67e8f9"]


class VisualMindMapWindow(Adw.Window):
    def __init__(self, parent, vault, nb_colors, current_rel, on_open, on_link):
        super().__init__(transient_for=parent, title="Visual Mind-Map",
                         default_width=980, default_height=660)
        self.vault = vault
        self.nb_colors = nb_colors
        self.current_rel = current_rel
        self.on_open = on_open
        self.on_link = on_link
        self.scale = 1.0
        self.ox, self.oy = 0.0, 0.0
        self.hover = None
        self.drag_node = None
        self.filter_q = ""

        self._build_nodes()

        view = Adw.ToolbarView()
        head = Adw.HeaderBar(title_widget=Adw.WindowTitle(
            title="Visual Mind-Map",
            subtitle="Click a note to open it · drag to tidy · scroll to zoom · drag the background to pan"))
        search = Gtk.SearchEntry(placeholder_text="Find a note…")
        search.connect("search-changed", lambda e: (setattr(self, "filter_q", e.get_text().strip().lower()),
                                                    self.area.queue_draw()))
        head.pack_start(search)

        link_btn = Gtk.Button(label="+ Connect a Note", css_classes=["suggested-action"])
        link_btn.connect("clicked", lambda *_: (self.close(), self.on_link()))
        head.pack_end(link_btn)

        reset_btn = Gtk.Button(icon_name="zoom-fit-best-symbolic", tooltip_text="Center Map")
        reset_btn.connect("clicked", lambda *_: (setattr(self, "_user_view", False), self._fit(),
                                                 self.area.queue_draw()))
        head.pack_end(reset_btn)
        view.add_top_bar(head)

        self.area = Gtk.DrawingArea(hexpand=True, vexpand=True)
        self.area.set_draw_func(self._draw)
        view.set_content(self.area)
        self.set_content(view)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        self.area.add_controller(motion)

        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._on_drag_begin)
        drag.connect("drag-update", self._on_drag_update)
        drag.connect("drag-end", self._on_drag_end)
        self.area.add_controller(drag)

        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", self._on_scroll)
        self.area.add_controller(scroll)

        self._ticks = 0
        self._timer = GLib.timeout_add(16, self._tick)
        self.connect("close-request", self._on_close)

    def _build_nodes(self):
        """Notes, plus one hub per notebook. Notebooks sit around a ring, their
        notes fanned around the hub; notes outside notebooks in the middle.
        Links between notes are the curved edges; each note hangs from its
        notebook's hub (no web of every-note-to-every-note lines)."""
        raw = self.vault.graph()
        notes_by_rel = {n["rel"]: n for n in self.vault.notes()}
        raw_nodes = [n for n in raw.get("nodes", []) if not n["id"].startswith("Daily/")] or raw.get("nodes", [])
        groups = {}
        for n in raw_nodes:
            groups.setdefault(notes_by_rel.get(n["id"], {}).get("folder", "") or "", []).append(n)
        self.nodes, self.by_id, self.edges = [], {}, []
        books = [g for g in groups if g]
        ring = 90.0 + 70.0 * max(1, len(books))
        used = set()
        for gi, folder in enumerate(books):
            ang = 2 * math.pi * gi / max(1, len(books)) - math.pi / 2
            hx, hy = math.cos(ang) * ring, math.sin(ang) * ring
            color = self.nb_colors.get(folder, PASTELS[gi % len(PASTELS)])
            if color in used:  # two notebooks of one colour: tell them apart here
                color = next((c for c in PASTELS if c not in used), color)
            used.add(color)
            hub = {"id": f"hub:{folder}", "label": folder.split("/")[-1], "folder": folder, "color": color,
                   "x": hx, "y": hy, "vx": 0.0, "vy": 0.0, "deg": 0, "hub": True}
            self.nodes.append(hub)
            members = groups[folder]
            for k, n in enumerate(members):
                a2 = ang + (k - (len(members) - 1) / 2) * min(0.9, 2.6 / max(1, len(members)))
                node = self._note_node(n, folder, color, hx + math.cos(a2) * 120, hy + math.sin(a2) * 120)
                self.edges.append((hub, node, "notebook"))
        loose = groups.get("", [])
        for k, n in enumerate(loose):
            a3 = 2 * math.pi * k / max(1, len(loose))
            r = 0.0 if len(loose) == 1 else 60.0 + 12.0 * len(loose)
            self._note_node(n, "", "#9aa7bd", math.cos(a3) * r, math.sin(a3) * r)
        seen = set()
        for e in raw.get("edges", []):
            na, nb = self.by_id.get(e.get("from")), self.by_id.get(e.get("to"))
            if na and nb and na is not nb:
                pair = tuple(sorted((na["id"], nb["id"])))
                if pair not in seen:
                    seen.add(pair)
                    self.edges.append((na, nb, "link"))
                    na["deg"] += 1
                    nb["deg"] += 1
        # Settle before the window shows: the map opens still, not shaking.
        for _ in range(160):
            self._step()

    def _note_node(self, n, folder, color, x, y):
        node = {"id": n["id"], "label": n["label"], "folder": folder or "Notes", "color": color,
                "x": x, "y": y, "vx": 0.0, "vy": 0.0, "deg": 0, "hub": False}
        self.nodes.append(node)
        self.by_id[n["id"]] = node
        return node

    def _radius(self, n):
        return 22.0 if n["hub"] else 10.0 + min(8.0, math.sqrt(n["deg"]) * 2.5)

    def _on_close(self, *_):
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = 0
        return False

    MIN_GAP = 64.0  # px between bubble centres (plus their sizes): labels never collide

    DAMPING = 0.62   # velocity kept per step: low, so it settles fast and calm

    def _tick(self):
        """Live only while you drag a bubble (and a moment after)."""
        if not self.drag_node and self._ticks > 40:
            return GLib.SOURCE_CONTINUE
        self._ticks += 1
        moving = self._step()
        if not getattr(self, "_user_view", False):
            self._fit()
        self.area.queue_draw()
        if not moving and not self.drag_node:
            self._ticks = 41
        return GLib.SOURCE_CONTINUE

    def _step(self):
        """One step of the layout; False once nothing moves visibly."""
        nodes = self.nodes
        for a in nodes:
            a["vx"] -= a["x"] * 0.0015
            a["vy"] -= a["y"] * 0.0015
        for i, a in enumerate(nodes):
            for b in nodes[i + 1:]:
                dx, dy = a["x"] - b["x"], a["y"] - b["y"]
                d2 = dx * dx + dy * dy + 0.01
                if d2 < 90000:
                    f = 1400.0 / d2
                    a["vx"] += dx * f
                    a["vy"] += dy * f
                    b["vx"] -= dx * f
                    b["vy"] -= dy * f
        for a, b, kind in self.edges:
            dx, dy = b["x"] - a["x"], b["y"] - a["y"]
            d = math.hypot(dx, dy) or 1.0
            target = 120.0 if kind == "notebook" else 170.0
            f = (d - target) * (0.02 if kind == "notebook" else 0.006)
            a["vx"] += dx / d * f
            a["vy"] += dy / d * f
            b["vx"] -= dx / d * f
            b["vy"] -= dy / d * f
        top = 0.0
        for n in nodes:
            if n is self.drag_node:
                continue
            n["vx"] *= self.DAMPING
            n["vy"] *= self.DAMPING
            n["x"] += n["vx"]
            n["y"] += n["vy"]
            top = max(top, abs(n["vx"]) + abs(n["vy"]))
        # hard rule: no two bubbles closer than their sizes plus MIN_GAP
        for _ in range(2):
            for i, a in enumerate(nodes):
                for b in nodes[i + 1:]:
                    dx, dy = b["x"] - a["x"], b["y"] - a["y"]
                    d = math.hypot(dx, dy) or 0.01
                    need = self._radius(a) + self._radius(b) + self.MIN_GAP
                    if d < need:
                        push = (need - d) / 2
                        ux, uy = (dx / d, dy / d) if d > 0.01 else (1.0, 0.0)
                        if a is not self.drag_node:
                            a["x"] -= ux * push
                            a["y"] -= uy * push
                        if b is not self.drag_node:
                            b["x"] += ux * push
                            b["y"] += uy * push
        return top > 0.05

    def _fit(self):
        """Zoom and centre so every bubble and label is in view (until you
        zoom or pan yourself; the centre button does it again)."""
        w, h = self.area.get_width(), self.area.get_height()
        if not self.nodes or w < 50 or h < 50:
            return
        xs = [n["x"] for n in self.nodes]
        ys = [n["y"] for n in self.nodes]
        bw, bh = max(xs) - min(xs) + 160, max(ys) - min(ys) + 120
        self.scale = max(0.35, min(1.6, (w - 40) / bw, (h - 40) / bh))
        self.ox = -(max(xs) + min(xs)) / 2
        self.oy = -(max(ys) + min(ys)) / 2 - 10 / self.scale

    def _to_screen(self, n, w, h):
        return w / 2 + (n["x"] + self.ox) * self.scale, h / 2 + (n["y"] + self.oy) * self.scale

    def _pick(self, x, y):
        w, h = self.area.get_width(), self.area.get_height()
        for n in reversed(self.nodes):
            nx, ny = self._to_screen(n, w, h)
            if math.hypot(x - nx, y - ny) <= max(14, self._radius(n) * self.scale):
                return n
        return None

    def _on_motion(self, _c, x, y):
        p = self._pick(x, y)
        if p is not self.hover:
            self.hover = p
            self.area.set_cursor(Gdk.Cursor.new_from_name("pointer" if p else "grab"))
            self.area.queue_draw()

    def _on_drag_begin(self, _g, x, y):
        self.drag_node = self._pick(x, y)
        self._moved = False
        self._start = (self.drag_node["x"], self.drag_node["y"]) if self.drag_node else (self.ox, self.oy)

    def _on_drag_update(self, _g, dx, dy):
        if math.hypot(dx, dy) > 4:
            self._moved = True
        if self.drag_node:
            self.drag_node["x"] = self._start[0] + dx / self.scale
            self.drag_node["y"] = self._start[1] + dy / self.scale
            self._ticks = 0
        else:
            self._user_view = True
            self.ox = self._start[0] + dx / self.scale
            self.oy = self._start[1] + dy / self.scale
        self.area.queue_draw()

    def _on_drag_end(self, *_):
        if self.drag_node and not getattr(self, "_moved", False) and not self.drag_node["hub"]:
            rel = self.drag_node["id"]
            self.close()
            self.on_open(rel)
        self.drag_node = None

    def _on_scroll(self, _c, _dx, dy):
        self._user_view = True
        self.scale = max(0.4, min(3.0, self.scale * (0.9 if dy > 0 else 1.1)))
        self.area.queue_draw()
        return True

    def _draw(self, _area, cr, w, h):
        dark = Adw.StyleManager.get_default().get_dark()
        cr.set_source_rgb(*((0.07, 0.08, 0.10) if dark else (0.96, 0.97, 0.99)))
        cr.paint()
        # curved connections: a gentle bow, never straight across
        for a, b, kind in self.edges:
            x1, y1 = self._to_screen(a, w, h)
            x2, y2 = self._to_screen(b, w, h)
            mx, my = (x1 + x2) / 2, (y1 + y2) / 2
            nx, ny = -(y2 - y1) * 0.18, (x2 - x1) * 0.18
            r, g, bl = hex_rgb(a["color"] if kind == "notebook" else "#7c9cff")
            cr.set_source_rgba(r, g, bl, 0.55 if kind == "link" else 0.32)
            cr.set_line_width((2.2 if kind == "link" else 1.4) * max(0.6, self.scale))
            cr.move_to(x1, y1)
            cr.curve_to(mx + nx, my + ny, mx + nx, my + ny, x2, y2)
            cr.stroke()
        layout = PangoCairo.create_layout(cr)
        for n in self.nodes:
            if self.filter_q and self.filter_q not in n["label"].lower() and not n["hub"]:
                continue
            x, y = self._to_screen(n, w, h)
            r = self._radius(n) * math.sqrt(self.scale)
            is_cur, is_hov = n["id"] == self.current_rel, n is self.hover
            red, grn, blu = hex_rgb(n["color"])
            cr.new_path()  # the last label left a current point: no line from it
            if is_cur or is_hov:
                cr.arc(x, y, r + 6, 0, 2 * math.pi)
                cr.set_source_rgba(0.98, 0.75, 0.18, 0.3) if is_cur else cr.set_source_rgba(red, grn, blu, 0.3)
                cr.fill()
            cr.arc(x, y, r, 0, 2 * math.pi)
            # notes are pastel bubbles of their notebook's colour; hubs solid
            if n["hub"]:
                cr.set_source_rgb(red, grn, blu)
            else:
                cr.set_source_rgb(red * 0.55 + 0.45, grn * 0.55 + 0.45, blu * 0.55 + 0.45)
            cr.fill_preserve()
            cr.set_source_rgba(1, 1, 1, 0.85 if is_cur or is_hov else 0.35)
            cr.set_line_width(2.0 if is_cur or is_hov else 1.0)
            cr.stroke()
            # the label on a chip under the bubble, cut short when long
            text = n["label"] if len(n["label"]) <= 22 else n["label"][:21] + "…"
            layout.set_font_description(Pango.FontDescription.from_string(
                f"Sans {'Bold ' if n['hub'] or is_cur or is_hov else ''}{10 if not n['hub'] else 11}"))
            layout.set_text(text, -1)
            tw, th = layout.get_pixel_size()
            lx, ly = x - tw / 2, y + r + 6
            cr.set_source_rgba(*((0.12, 0.14, 0.18, 0.85) if dark else (1, 1, 1, 0.9)))
            rr = th / 2 + 1
            cr.new_sub_path()
            cr.arc(lx + rr - 4, ly + rr, rr, math.pi / 2, 3 * math.pi / 2)
            cr.arc(lx + tw - rr + 4, ly + rr, rr, -math.pi / 2, math.pi / 2)
            cr.close_path()
            cr.fill()
            cr.set_source_rgba(*((0.94, 0.96, 1.0, 0.95) if dark else (0.10, 0.13, 0.20, 0.95)))
            cr.move_to(lx, ly + 1)
            PangoCairo.show_layout(cr, layout)


PDF_FONTS = {"title": "Sans Heavy 22", "h1": "Sans Bold 18", "h2": "Sans Bold 15",
             "h3": "Sans Semi-Bold 13", "body": "Sans 11"}


def export_pdf_direct(title, meta_line, lines, images_meta, out_path, resolve_img_fn, stickies=(), tables=(), pads=()):
    """Render a note to PDF with Cairo (no print dialog). LINES: (Pango markup,
    kind) pairs from NotesWindow._export_lines; kind picks the font. STICKIES
    (the note's sticky notes) come after the text as coloured callout cards."""
    PAGE_W, PAGE_H = 595.0, 842.0
    MARGIN = 48.0
    CONTENT_W = PAGE_W - 2 * MARGIN

    surface = cairo.PDFSurface(str(out_path), PAGE_W, PAGE_H)
    surface.set_metadata(cairo.PDFMetadata.TITLE, title)
    cr = cairo.Context(surface)
    y = MARGIN

    def ensure_space(needed):
        nonlocal y
        if y + needed > PAGE_H - MARGIN:
            cr.show_page()
            y = MARGIN

    def draw_text_block(markup, font_str, color=(0.1, 0.12, 0.16), space_after=8.0):
        nonlocal y
        layout = PangoCairo.create_layout(cr)
        layout.set_width(int(CONTENT_W * Pango.SCALE))
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_font_description(Pango.FontDescription(font_str))
        layout.set_markup(markup, -1)
        _ink, logical = layout.get_pixel_extents()
        h = max(16.0, float(logical.height))
        ensure_space(h + space_after)
        cr.set_source_rgb(*color)
        cr.move_to(MARGIN, y)
        PangoCairo.show_layout(cr, layout)
        y += h + space_after

    draw_text_block(GLib.markup_escape_text(title), "Sans Bold 20", color=(0.06, 0.09, 0.18), space_after=4.0)
    draw_text_block(GLib.markup_escape_text(meta_line), "Sans 9", color=(0.42, 0.45, 0.52), space_after=12.0)
    cr.set_source_rgba(0.2, 0.25, 0.35, 0.25)
    cr.set_line_width(1.0)
    cr.move_to(MARGIN, y - 6)
    cr.line_to(PAGE_W - MARGIN, y - 6)
    cr.stroke()
    y += 6

    for markup, kind in lines:
        if not markup.strip():
            y += 6.0
            continue
        heading = kind != "body"
        if heading:
            y += 6.0
        draw_text_block(markup, PDF_FONTS[kind], space_after=8.0 if heading else 5.0)

    for item in images_meta:
        img_path = resolve_img_fn(item.get("name", ""))
        if not (img_path and Path(img_path).is_file()):
            continue
        try:
            # GdkPixbuf reads JPEG, WebP and the rest; Cairo itself only PNG.
            pix = GdkPixbuf.Pixbuf.new_from_file(str(img_path))
            tw = min(CONTENT_W, float(item.get("w", 380)) * 0.72)
            th = min(PAGE_H - 2 * MARGIN, float(item.get("h", pix.get_height() * (tw / pix.get_width()))) * 0.72)
            if pix.get_width() > tw * 2:  # 2 pixels per point is sharp in print; more only bloats the file
                pix = pix.scale_simple(round(tw * 2), max(1, round(th * 2)), GdkPixbuf.InterpType.BILINEAR)
            _ok, png = pix.save_to_bufferv("png", [], [])
            surf = cairo.ImageSurface.create_from_png(io.BytesIO(png))
        except (GLib.Error, cairo.Error):
            continue
        iw, ih = surf.get_width(), surf.get_height()
        if iw > 0 and ih > 0:
            ensure_space(th + 14.0)
            cr.save()
            cr.translate(MARGIN, y)
            cr.scale(tw / iw, th / ih)
            cr.set_source_surface(surf, 0, 0)
            cr.paint()
            cr.restore()
            y += th + 14.0

    for tdata in tables:  # each table as a ruled grid, scaled to the page width
        rows, widths = tdata.get("rows") or [], tdata.get("col_w") or []
        if not rows:
            continue
        k = min(1.0, CONTENT_W / max(1.0, float(sum(widths))))
        cws = [w * k for w in widths]
        for r, row in enumerate(rows):
            layouts = []
            for c, text in enumerate(row):
                lay = PangoCairo.create_layout(cr)
                lay.set_width(int(max(20.0, cws[c] - 10) * Pango.SCALE))
                lay.set_wrap(Pango.WrapMode.WORD_CHAR)
                lay.set_font_description(Pango.FontDescription("Sans Bold 9" if r == 0 else "Sans 9"))
                lay.set_text(text, -1)
                layouts.append(lay)
            row_h = max(18.0, *(lay.get_pixel_extents()[1].height + 10.0 for lay in layouts))
            ensure_space(row_h)
            x = MARGIN
            for c, lay in enumerate(layouts):
                if r == 0:
                    cr.set_source_rgba(0.49, 0.61, 1.0, 0.18)
                    cr.rectangle(x, y, cws[c], row_h)
                    cr.fill()
                cr.set_source_rgba(0.2, 0.25, 0.35, 0.6)
                cr.set_line_width(0.6)
                cr.rectangle(x, y, cws[c], row_h)
                cr.stroke()
                cr.set_source_rgb(0.1, 0.12, 0.16)
                cr.move_to(x + 5, y + 5)
                PangoCairo.show_layout(cr, lay)
                x += cws[c]
            y += row_h
        y += 14.0

    for sticky in stickies:
        text = (sticky.get("text") or "").strip()
        if not text:
            continue
        _name, bg, fg = STICKY_PALETTES[0]  # printed as a light callout, in the box's colour if it shows on it
        if sticky.get("fg") and sticky["fg"] not in ("#ffffff", "#9a9996", "#ff7800"):
            fg = sticky["fg"]
        layout = PangoCairo.create_layout(cr)
        layout.set_width(int((CONTENT_W - 28) * Pango.SCALE))
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_font_description(Pango.FontDescription("Sans 10"))
        markup = ""
        for words, style, colour in sticky.get("runs") or [[text, "", ""]]:
            words = GLib.markup_escape_text(words)
            for k in style:
                words = f"<{k}>{words}</{k}>"
            if colour and colour not in ("#ffffff", "#9a9996"):  # (light colours don't show on paper)
                words = f'<span foreground="{colour}">{words}</span>'
            markup += words
        layout.set_markup(markup.strip(), -1)
        _ink, logical = layout.get_pixel_extents()
        box_h = logical.height + 20.0
        ensure_space(box_h + 12.0)
        cr.new_path()
        r = 8.0
        cr.arc(MARGIN + CONTENT_W - r, y + r, r, -math.pi / 2, 0)
        cr.arc(MARGIN + CONTENT_W - r, y + box_h - r, r, 0, math.pi / 2)
        cr.arc(MARGIN + r, y + box_h - r, r, math.pi / 2, math.pi)
        cr.arc(MARGIN + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.set_source_rgb(*hex_rgb(bg))
        cr.fill()
        cr.set_source_rgb(*hex_rgb(fg))
        cr.rectangle(MARGIN, y + 4, 4, box_h - 8)  # the callout's edge
        cr.fill()
        cr.move_to(MARGIN + 16, y + 10)
        PangoCairo.show_layout(cr, layout)
        y += box_h + 12.0

    # sticky notes (when included): one footnote box at the end, each note
    # a line of its own: 📌 title, its words, small
    notes = [p for p in pads if (p.get("text") or "").strip()]
    if notes:
        layout = PangoCairo.create_layout(cr)
        layout.set_width(int((CONTENT_W - 24) * Pango.SCALE))
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_font_description(Pango.FontDescription("Sans 8.5"))
        layout.set_markup("<b>Sticky notes</b>\n" + "\n".join(
            f"📌 <b>{GLib.markup_escape_text(p.get('title') or 'Sticky note')}</b>: "
            f"{GLib.markup_escape_text(p['text'].strip())}" for p in notes), -1)
        _ink, logical = layout.get_pixel_extents()
        box_h = logical.height + 16.0
        ensure_space(box_h + 12.0)
        cr.set_source_rgb(*hex_rgb(STICKY_PALETTES[0][1]))
        cr.rectangle(MARGIN, y, CONTENT_W, box_h)
        cr.fill()
        cr.set_source_rgb(*hex_rgb(STICKY_PALETTES[0][2]))
        cr.set_line_width(0.6)
        cr.rectangle(MARGIN, y, CONTENT_W, box_h)
        cr.stroke()
        cr.move_to(MARGIN + 12, y + 8)
        PangoCairo.show_layout(cr, layout)
        y += box_h + 12.0

    surface.finish()


class SimpleNotePicker(Adw.Dialog):
    def __init__(self, title, subtitle, items, on_pick, on_create=None):
        super().__init__(title=title, content_width=520, content_height=440)
        self.items, self.on_pick, self.on_create = items, on_pick, on_create
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        if subtitle:
            box.append(Gtk.Label(label=subtitle, xalign=0, wrap=True, css_classes=["dim-label"]))
        self.entry = Gtk.SearchEntry(placeholder_text="Search notes (or type a new note title)…")
        self.entry.connect("search-changed", lambda *_: self._fill())
        self.entry.connect("activate", lambda *_: self._activate(
            self.list.get_selected_row() or self.list.get_row_at_index(0)))
        box.append(self.entry)
        self.list = Gtk.ListBox(css_classes=["navigation-sidebar"], activate_on_single_click=True)
        self.list.connect("row-activated", lambda _l, row: self._activate(row))
        box.append(Gtk.ScrolledWindow(child=self.list, vexpand=True))
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(box)
        self.set_child(view)
        self._fill()
        GLib.idle_add(lambda: self.entry.grab_focus() and False)  # once: True would repeat it forever

    def _fill(self):
        while (r := self.list.get_row_at_index(0)) is not None:
            self.list.remove(r)
        q = self.entry.get_text().strip().lower()
        shown = [it for it in self.items if not q or q in it[0].lower() or q in (it[1] or "").lower()]
        if q and self.on_create and not any(it[0].lower() == q for it in shown):
            shown.append((f"Create & Connect “{self.entry.get_text().strip()}”", "New Note", ("create", self.entry.get_text().strip())))
        for label, sub, val in shown[:60]:
            row = Adw.ActionRow(title=GLib.markup_escape_text(label),
                                subtitle=GLib.markup_escape_text(sub or ""),
                                activatable=True)
            row.value = val
            self.list.append(row)
        first = self.list.get_row_at_index(0)
        if first:
            self.list.select_row(first)

    def _activate(self, row):
        if not row:
            return
        self.close()
        val = row.value
        if isinstance(val, tuple) and val and val[0] == "create":
            self.on_create(val[1])
        else:
            self.on_pick(val)


class NotesWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        # Fits a 1366 x 768 laptop screen with the top bar and dock.
        super().__init__(application=app, title="MK Notes", default_width=1100, default_height=680)
        self.set_size_request(720, 560)
        self.vault = nv.Vault()
        self.rel = None
        self.dirty = False
        self.loading = False
        self.save_id = 0
        self.zoom = 1.0
        self.scope = ("all", None)
        self.rows = {}
        self.canvas_images = []
        self.sticky_notes = []
        self.pinned_stickies = []   # StickyPad: sticky notes (sticky_notes holds the text boxes, an old name)
        self.table_items = []
        self.comments = []
        self.selected_img = None
        self.nav_history = []
        self._unlocked_items = set()
        self._last_activity = time.monotonic()
        activity_keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        activity_keys.connect("key-pressed", lambda *a: (self._note_activity(), False)[1])
        self.add_controller(activity_keys)
        activity_motion = Gtk.EventControllerMotion(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        activity_motion.connect("motion", self._note_activity)
        self.add_controller(activity_motion)
        GLib.timeout_add_seconds(10, self._autolock_tick)
        self.server = None

        self.active_formats = set()
        self.active_para_style = None
        self.active_fg_tag = None

        self._meta_dir = self.vault.root / ".mknotes_v3"
        self._meta_dir.mkdir(parents=True, exist_ok=True)
        self._clean_empty_daily_files()

        self._build_ui()
        self._setup_rich_tags()
        self._setup_overlay_drag_controller()
        self._setup_actions()
        self.apply_theme_and_zoom()

        # Back where you left off: the note, its scroll position and the
        # notebooks sidebar. A locked note is never reopened at launch (no
        # unlock prompt before the window is even up): the newest unlocked one is.
        # Always the three columns at launch (workspace, notes, page); ⤢ folds
        # the first two away for the session.
        self.nb_toggle.set_active(True)
        self.list_toggle.set_active(True)
        self.refresh_lists()
        last = self.vault.state.get("last")
        if not (last and self.vault.path(last).exists()) or self._is_note_protected(last):
            last = self._first_note()
        self.open_note(last)
        scroll = self.vault.state.get("scroll", {}).get(last or "", 0)
        if scroll:
            GLib.timeout_add(150, lambda: self.page_scroll.get_vadjustment().set_value(scroll) and False)
        if nv.load_conf().get("SYNC", "off") == "on":
            self.set_sync(True)
        self.connect("close-request", self._on_close)

    def _clean_empty_daily_files(self):
        daily_dir = self.vault.root / "Daily"
        if not daily_dir.is_dir():
            return
        for md in daily_dir.glob("*.md"):
            try:
                lines = [ln.strip() for ln in md.read_text(encoding="utf-8", errors="replace").splitlines() if ln.strip()]
                if len(lines) <= 2 and all(ln.startswith("# ") or ln in ("- [ ]", "-") for ln in lines):
                    md.unlink(missing_ok=True)
            except OSError:
                pass

    def _setup_overlay_drag_controller(self):
        self._ov_drag_target = None
        self._ov_drag_mode = None
        drag = Gtk.GestureDrag()
        drag.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        drag.connect("drag-begin", self._on_overlay_drag_begin)
        drag.connect("drag-update", self._on_overlay_drag_update)
        drag.connect("drag-end", self._on_overlay_drag_end)
        self.page_overlay.add_controller(drag)

    def _on_overlay_drag_begin(self, gesture, x, y):
        if self.ink_canvas.active:
            gesture.set_state(Gtk.EventSequenceState.DENIED)
            return
        z = max(0.5, self.zoom)
        # a selected text box's corner handle resizes it (before the text
        # under the handle can take the click)
        for st in reversed(self.sticky_notes):
            sx, sy = st.data["x"] * z, st.data["y"] * z  # the text area
            corner = st.corner_at(x - sx, y - sy)
            if corner and 0 <= x - sx <= st.body.get_width() and 0 <= y - sy <= st.body.get_height():
                self._ov_drag_target = ("sticky-size", st)
                self._ov_corner = corner
                self._ov_start = tuple(float(st.data[k]) for k in ("x", "y", "w", "h"))
                gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                return
        # a sticky note: its bottom-right corner resizes it, its header moves it
        for pad in reversed(self.pinned_stickies):
            px, py = pad.data["x"] * z, pad.data["y"] * z
            pw, ph = pad.get_width(), pad.get_height()
            if px + pw - 18 <= x <= px + pw and py + ph - 18 <= y <= py + ph:
                self._ov_drag_target = ("sticky-size", pad)
                self._ov_corner = (1, 1)
                self._ov_start = tuple(float(pad.data[k]) for k in ("x", "y", "w", "h"))
                gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                return
        if self._is_control_at(x, y):
            gesture.set_state(Gtk.EventSequenceState.DENIED)
            return
        for pad in reversed(self.pinned_stickies):
            px, py = pad.data["x"] * z, pad.data["y"] * z
            if px <= x <= px + pad.get_width() and py <= y <= py + pad.GRIP_H:
                self._ov_drag_target = ("sticky", pad)
                self._ov_start_x, self._ov_start_y = float(pad.data["x"]), float(pad.data["y"])
                gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                return

        # a text box's border (the text itself is a control, above) moves it
        for st in reversed(self.sticky_notes):
            sx, sy = st.data["x"] * z, st.data["y"] * z
            if sx <= x <= sx + st.body.get_width() and sy <= y <= sy + st.body.get_height():
                st.grab_focus()
                self._ov_drag_target = ("sticky", st)
                self._ov_start_x = float(st.data["x"])
                self._ov_start_y = float(st.data["y"])
                gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                return

        for img in reversed(self.canvas_images):
            # where the widget really is: moved back by a rotation's overhang
            ix, iy = img.data["x"] * z - getattr(img, "ex", 0), img.data["y"] * z - getattr(img, "ey", 0)
            iw, ih = img.get_width(), img.get_height()
            if ix <= x <= ix + iw and iy <= y <= iy + ih:
                tb_h = 38 if img.selected else 0  # its toolbar sits above it (buttons are skipped above)
                self.select_canvas_image(img)
                local_x = x - ix
                local_y = y - (iy + tb_h)
                mode = img.hit_handle(local_x, local_y)
                img.drag_mode = mode
                self._ov_drag_target = ("image", img)
                self._ov_drag_mode = mode
                self._ov_start_x = float(img.data["x"])
                self._ov_start_y = float(img.data["y"])
                self._ov_start_w = float(img.data["w"])
                self._ov_start_h = float(img.data["h"])
                self._ov_origin_px = x
                self._ov_origin_py = y
                gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                return

        gesture.set_state(Gtk.EventSequenceState.DENIED)

    def _is_control_at(self, x, y):
        """Is there a button, entry or text field under (x, y)? Those take
        the click themselves (a picture's trash button, a table cell, a text
        box): dragging must not swallow it."""
        w = self.page_overlay.pick(x, y, Gtk.PickFlags.DEFAULT)
        while w is not None and w is not self.page_overlay:
            if isinstance(w, (Gtk.Button, Gtk.MenuButton, Gtk.Entry, Gtk.Text, Gtk.Scale, Gtk.Switch)) or \
                    (isinstance(w, Gtk.TextView) and w is not self.view):
                return True
            w = w.get_parent()
        return False

    def _on_overlay_drag_update(self, _gesture, dx, dy):
        if not self._ov_drag_target:
            return
        z = max(0.5, self.zoom)
        kind, widget = self._ov_drag_target
        if kind == "sticky-size":
            x0, y0, w0, h0 = self._ov_start
            hx, hy = self._ov_corner
            w = max(60.0, w0 + (dx if hx else -dx) / z)
            h = max(36.0, h0 + (dy if hy else -dy) / z)
            widget.data.update(w=round(w), h=round(h), x=round(x0 + (0 if hx else w0 - w)),
                               y=round(y0 + (0 if hy else h0 - h)), auto=False)
            widget.sync_zoom_geometry()
            return
        if kind == "sticky":
            widget.data["x"] = max(8.0, round(self._ov_start_x + dx / z))
            widget.data["y"] = max(8.0, round(self._ov_start_y + dy / z))
            widget.sync_zoom_geometry()
            return

        mode = self._ov_drag_mode
        if mode == "move":
            widget.data["x"] = max(8.0, round(self._ov_start_x + dx / z))
            widget.data["y"] = max(8.0, round(self._ov_start_y + dy / z))
            widget.sync_zoom_geometry()
            self.ensure_page_height_for_images()
            return

        if mode == "rotate":
            tb_h = 38 if widget.selected else 0
            cx = (widget.data["x"] * z) + widget.PAD_SIDE + widget.disp_w / 2
            cy = (widget.data["y"] * z) + tb_h + widget.PAD_TOP + widget.disp_h / 2
            cur_x = self._ov_origin_px + dx
            cur_y = self._ov_origin_py + dy
            deg = math.degrees(math.atan2(cur_x - cx, -(cur_y - cy))) % 360
            state = _gesture.get_current_event_state()
            if state & Gdk.ModifierType.SHIFT_MASK:
                deg = round(deg / 15.0) * 15.0
            else:
                for snap in (0, 90, 180, 270, 360):
                    if abs(deg - snap) <= 3:
                        deg = snap % 360
                        break
            widget.data["angle"] = round(deg) % 360
            widget.canvas.queue_draw()
            return

        new_x = self._ov_start_x
        new_y = self._ov_start_y
        new_w = self._ov_start_w
        new_h = self._ov_start_h
        aspect = getattr(widget, "aspect", 0.75) or 0.75

        if mode == "se":
            scale = max(0.15, (self._ov_start_w + dx / z) / max(1.0, self._ov_start_w))
            new_w = max(60.0, min(1400.0, round(self._ov_start_w * scale)))
            new_h = max(45.0, min(1400.0, round(new_w * aspect)))
        elif mode == "sw":
            scale = max(0.15, (self._ov_start_w - dx / z) / max(1.0, self._ov_start_w))
            new_w = max(60.0, min(1400.0, round(self._ov_start_w * scale)))
            new_h = max(45.0, min(1400.0, round(new_w * aspect)))
            new_x = max(8.0, round(self._ov_start_x + (self._ov_start_w - new_w)))
        elif mode == "ne":
            scale = max(0.15, (self._ov_start_w + dx / z) / max(1.0, self._ov_start_w))
            new_w = max(60.0, min(1400.0, round(self._ov_start_w * scale)))
            new_h = max(45.0, min(1400.0, round(new_w * aspect)))
            new_y = max(8.0, round(self._ov_start_y + (self._ov_start_h - new_h)))
        elif mode == "nw":
            scale = max(0.15, (self._ov_start_w - dx / z) / max(1.0, self._ov_start_w))
            new_w = max(60.0, min(1400.0, round(self._ov_start_w * scale)))
            new_h = max(45.0, min(1400.0, round(new_w * aspect)))
            new_x = max(8.0, round(self._ov_start_x + (self._ov_start_w - new_w)))
            new_y = max(8.0, round(self._ov_start_y + (self._ov_start_h - new_h)))
        elif mode == "e":
            new_w = max(60.0, min(1400.0, round(self._ov_start_w + dx / z)))
        elif mode == "w":
            dw = min(self._ov_start_w - 60.0, dx / z)
            new_w = max(60.0, round(self._ov_start_w - dw))
            new_x = max(8.0, round(self._ov_start_x + dw))
        elif mode == "s":
            new_h = max(45.0, min(1400.0, round(self._ov_start_h + dy / z)))
        elif mode == "n":
            dh = min(self._ov_start_h - 45.0, dy / z)
            new_h = max(45.0, round(self._ov_start_h - dh))
            new_y = max(8.0, round(self._ov_start_y + dh))

        widget.data["x"] = new_x
        widget.data["y"] = new_y
        widget.data["w"] = new_w
        widget.data["h"] = new_h
        widget.sync_zoom_geometry()
        self.ensure_page_height_for_images()

    def _on_overlay_drag_end(self, *_):
        if not self._ov_drag_target:
            return
        kind, widget = self._ov_drag_target
        if kind == "image":
            widget.drag_mode = None
            widget.canvas.queue_draw()
        self.keep_off_gaps(widget)
        self._ov_drag_target = None
        self._ov_drag_mode = None
        self.save_note_meta()

    def _nb_colors(self):
        return self.vault.state.setdefault("notebook_colors", {})

    def _get_nb_color(self, folder):
        colors = self._nb_colors()
        if folder not in colors:
            idx = abs(hash(folder)) % len(NOTEBOOK_COLORS)
            colors[folder] = NOTEBOOK_COLORS[idx][1]
        return colors[folder]

    def _locked_folders(self):
        return set(self.vault.state.setdefault("locked_folders", []))

    def _locked_notes(self):
        return set(self.vault.state.setdefault("locked", []))

    def _is_note_protected(self, rel):
        if rel in self._locked_notes() and rel not in self._unlocked_items:
            return True
        folder = Path(rel).parent.as_posix()
        if folder != "." and folder in self._locked_folders() and f"folder:{folder}" not in self._unlocked_items:
            return True
        return False

    def _authenticate(self, heading, on_success):
        """The MK unlock dialog: fingerprint (in the app), the system check, or the PIN."""
        pin_hash = nv.load_conf().get("NOTE_LOCK_HASH", "")

        def check(pin):
            if not pin_hash:
                if len(pin) < 4:
                    return "Use at least 4 characters."
                conf_set("NOTE_LOCK_HASH", auth.hash_pin(pin))
                return True
            if not auth.check_pin(pin, pin_hash):
                return False
            if auth.pin_needs_upgrade(pin_hash):
                conf_set("NOTE_LOCK_HASH", auth.hash_pin(pin))
            return True

        auth.present_unlock(self, heading, check, on_success, creating=not pin_hash)

