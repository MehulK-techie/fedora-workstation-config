        comment_btn.connect("clicked", lambda *_: self.prompt_add_comment())
        ribbon.append(comment_btn)

        link_btn = Gtk.Button(icon_name="insert-link-symbolic",
                              tooltip_text="Connect Another Note (Ctrl+K)", css_classes=["flat"])
