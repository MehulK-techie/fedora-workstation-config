        map_btn = Gtk.Button(icon_name="network-workgroup-symbolic",
                             tooltip_text="Visual Mind-Map (Ctrl+G)", css_classes=["flat"])
        map_btn.connect("clicked", lambda *_: self.show_mind_map())
        ribbon.append(map_btn)

        ribbon.append(Gtk.Box(hexpand=True))

        z_out = Gtk.Button(icon_name="zoom-out-symbolic", tooltip_text="Zoom Out (Ctrl+-)", css_classes=["flat"])
        z_out.connect("clicked", lambda *_: self.set_zoom(self.zoom - 0.1))
        ribbon.append(z_out)
        self.zoom_lbl_btn = Gtk.Button(label="100%", tooltip_text="Reset Zoom (Ctrl+0)", css_classes=["flat"])
        self.zoom_lbl_btn.connect("clicked", lambda *_: self.set_zoom(1.0))
        ribbon.append(self.zoom_lbl_btn)
        z_in = Gtk.Button(icon_name="zoom-in-symbolic", tooltip_text="Zoom In (Ctrl++)", css_classes=["flat"])
        z_in.connect("clicked", lambda *_: self.set_zoom(self.zoom + 0.1))
        ribbon.append(z_in)

        ribbon_outer.append(ribbon)

        self.ink_bar = self._build_ink_subbar()
        self.ink_revealer = Gtk.Revealer(child=self.ink_bar, transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN)
