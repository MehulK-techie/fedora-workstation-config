    def _set_ink_tool(self, tool_name):
        self.ink_canvas.tool = tool_name
        if tool_name != "lasso":
            self.ink_canvas.select([], [])
        self.ink_canvas.set_ink_mode(True)

    def _pick_ink_color(self, _b, color):
        self.ink_canvas.ink = color
        if self.ink_canvas.tool == "eraser":
            self.ink_tool_btns["pen"].set_active(True)
        for sw, c in self.ink_swatches:
            (sw.add_css_class if c == color else sw.remove_css_class)("active")

    def _on_draw_toggled(self, btn):
        active = btn.get_active()
        if active:
            self.shapes_toggle.set_active(False)
            self.laser_toggle.set_active(False)
            self.ink_canvas.tool = "pen"
            self.ink_tool_btns["pen"].set_active(True)
        self.ink_canvas.set_ink_mode(active)

    def _on_shapes_toggled(self, btn):
        active = btn.get_active()
        if active:
            self.draw_toggle.set_active(False)
            self.laser_toggle.set_active(False)
            self.ink_canvas.tool = "rect"
            self.shape_tool_btns["rect"].set_active(True)
        self.shapes_revealer.set_reveal_child(active)
        self.ink_canvas.set_ink_mode(active)

    def _on_laser_toggled(self, btn):
        active = btn.get_active()
        if active:
            self.draw_toggle.set_active(False)
            self.shapes_toggle.set_active(False)
            self.ink_canvas.tool = "laser"
            self.toast.add_toast(Adw.Toast(title="🔴 Presentation Laser Active · Drag on note to point!", timeout=2))
        self.ink_canvas.set_ink_mode(active)

    def _table_picker(self):
        """A Word/OneNote-style grid: hover to size the table (up to 8 x 8),
        click to insert it."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=8, margin_bottom=8,
                      margin_start=8, margin_end=8)
        label = Gtk.Label(label="Insert a table", css_classes=["heading"])
        area = Gtk.DrawingArea(content_width=8 * 22, content_height=8 * 22)
        hover = [0, 0]  # columns, rows

        def draw(_a, cr, _w, _h):
            fg = area.get_color()
            for r in range(8):
                for c in range(8):
                    lit = c < hover[0] and r < hover[1]
                    cr.rectangle(c * 22 + 2, r * 22 + 2, 18, 18)
                    if lit:
                        cr.set_source_rgba(0.21, 0.52, 0.89, 0.55)
                        cr.fill_preserve()
                    cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.85 if lit else 0.3)
                    cr.set_line_width(1)
                    cr.stroke()
        area.set_draw_func(draw)

        def moved(_c, x, y):
            cell = (min(8, int(x // 22) + 1), min(8, int(y // 22) + 1))
            if list(cell) != hover:
                hover[:] = cell
                label.set_label(f"{cell[0]} x {cell[1]} table")
                area.queue_draw()
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", moved)
        area.add_controller(motion)
        click = Gtk.GestureClick()

        def pressed(_g, _n, x, y):
            # sized from where the click is, not the last motion: a tap
            # with no hover before it still inserts
            moved(None, x, y)
            pop.popdown()
            self.insert_table(*hover, centre=True)
        click.connect("pressed", pressed)
        area.add_controller(click)
        box.append(label)
        box.append(area)
        pop = Gtk.Popover(child=box)
        pop.connect("closed", lambda *_: (hover.__setitem__(slice(None), [0, 0]), label.set_label("Insert a table"),
                                          area.queue_draw()))
        return pop

    def _table_menu(self):
        """Right-click items for the Markdown table under the cursor."""
        menu = Gio.Menu()
        section = Gio.Menu()
        for label, name in (("Insert row below", "row-add"), ("Delete row", "row-del"),
                            ("Insert column right", "col-add"), ("Delete column", "col-del"),
                            ("Align column: left", "align-l"), ("Align column: centre", "align-c"),
                            ("Align column: right", "align-r")):
            section.append(label, f"win.table-{name}")
            action = Gio.SimpleAction.new(f"table-{name}", None)
            action.connect("activate", lambda *_a, n=name: self.edit_table(n))
            self.add_action(action)
        menu.append_section("Table", section)
        return menu

    def _table_at_cursor(self):
        """(first line, lines, row index, column index) of the table around
        the cursor, or None. Rows are '| a | b |' lines."""
        buf = self.buffer
        cur = buf.get_iter_at_mark(buf.get_insert())
        lines = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).split("\n")
        row = cur.get_line()
        if row >= len(lines) or not lines[row].lstrip().startswith("|"):
            return None
        top = row
        while top > 0 and lines[top - 1].lstrip().startswith("|"):
            top -= 1
        bottom = row
        while bottom + 1 < len(lines) and lines[bottom + 1].lstrip().startswith("|"):
            bottom += 1
        col = max(0, lines[row][:cur.get_line_offset()].count("|") - 1)
        return top, lines[top:bottom + 1], row - top, col

    def edit_table(self, what):
        found = self._table_at_cursor()
        if not found:
            self.toast.add_toast(Adw.Toast(title="Put the cursor in a table first", timeout=2))
            return
        top, lines, r, c = found
        cells = [[x.strip() for x in ln.strip().strip("|").split("|")] for ln in lines]
        ncol = max(len(row) for row in cells)
        cells = [row + [""] * (ncol - len(row)) for row in cells]
        rule = 1 if len(cells) > 1 and all(set(x) <= set("-: ") and x for x in cells[1]) else None
        c = min(c, ncol - 1)
        if what == "row-add":
            cells.insert(max(r, rule or 0) + 1, [""] * ncol)
        elif what == "row-del" and r != 0 and r != rule and len(cells) > 3:
            cells.pop(r)
        elif what == "col-add":
            for i, row in enumerate(cells):
                row.insert(c + 1, "---" if i == rule else ("Column" if i == 0 else ""))
        elif what == "col-del" and ncol > 1:
            for row in cells:
                row.pop(c)
        elif what.startswith("align") and rule is not None:
            cells[rule][c] = {"align-l": ":---", "align-c": ":---:", "align-r": "---:"}[what]
        ncol = max(len(row) for row in cells)
        widths = [max(3, max(len(row[k]) for j, row in enumerate(cells) if j != rule)) for k in range(ncol)]

        def fmt(j, row):
            if j == rule:
                out = []
                for k, cell in enumerate(row):
                    left, right = cell.startswith(":"), cell.endswith(":") and len(cell) > 1
                    dash = "-" * (widths[k] - left - right)
                    out.append((":" if left else "") + dash + (":" if right else ""))
                return "| " + " | ".join(out) + " |"
            return "| " + " | ".join(cell.ljust(widths[k]) for k, cell in enumerate(row)) + " |"
        text = "\n".join(fmt(j, row) for j, row in enumerate(cells))
        buf = self.buffer
        start = buf.get_iter_at_line(top)[1]
        end = buf.get_iter_at_line(top + len(lines) - 1)[1]
        if not end.ends_line():
            end.forward_to_line_end()
        buf.begin_user_action()
        buf.delete(start, end)
        start = buf.get_iter_at_line(top)[1]
        offset = start.get_offset()
        buf.insert(start, text)
        buf.apply_tag_by_name("mono", buf.get_iter_at_offset(offset), buf.get_iter_at_offset(offset + len(text)))
        buf.end_user_action()
        self.dirty = True
        self._queue_save()

    def style_tables(self):
        """Markdown tables shown as tables: a shaded header, faint column
        lines, the |---| rule row hidden. Display only: the text stays
        Markdown (and these tags aren't saved)."""
        buf = self.buffer
        table = buf.get_tag_table()
        tags = [table.lookup(n) for n in ("table-row", "table-head", "table-pipe", "table-rule")]
        if None in tags:
            return
        row_t, head_t, pipe_t, rule_t = tags
        for t in tags:
            buf.remove_tag(t, buf.get_start_iter(), buf.get_end_iter())
        lines = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).split("\n")
        prev_table = False
        for n, line in enumerate(lines):
            is_row = line.lstrip().startswith("|") and line.rstrip().endswith("|") and len(line.strip()) > 1
            if not is_row:
                prev_table = False
                continue
            start = buf.get_iter_at_line(n)[1]
            end = start.copy()
            if not end.ends_line():
                end.forward_to_line_end()
            if set(line.strip()) <= set("|-: ") and prev_table:
                buf.apply_tag(rule_t, start, end)
                prev_table = True
                continue
            buf.apply_tag(row_t, start, end)
            if not prev_table:
                buf.apply_tag(head_t, start, end)
            off = start.get_offset()
            for i, ch in enumerate(line):
                if ch == "|":
                    buf.apply_tag(pipe_t, buf.get_iter_at_offset(off + i), buf.get_iter_at_offset(off + i + 1))
            prev_table = True

    def _queue_table_style(self):
        if getattr(self, "_table_style_id", 0):
            return
        def run():
            self._table_style_id = 0
            self.style_tables()
            return False
        self._table_style_id = GLib.timeout_add(250, run)

    def _table_tab(self):
        """Tab in a table: the next cell; at the end of the last row, a new row."""
        found = self._table_at_cursor()
        if not found:
            return False
        top, lines, r, _c = found
        buf = self.buffer
        cur = buf.get_iter_at_mark(buf.get_insert())
        line = lines[r]
        nxt = line.find("|", cur.get_line_offset())
        if nxt != -1 and nxt < len(line.rstrip()) - 1:
            buf.place_cursor(buf.get_iter_at_line_offset(cur.get_line(), min(len(line), nxt + 2))[1])
            return True
        if r == len(lines) - 1:
            self.edit_table("row-add")
        buf.place_cursor(buf.get_iter_at_line_offset(top + min(r + 1, len(lines)), 2)[1])
        return True

    def insert_table(self, cols, rows, centre=False):
        """A COLS x ROWS table (TableItem): a header row, then ROWS - 1 empty
        rows, under the cursor's line, or with CENTRE in the middle of what's
        on screen. Drag it by ⠿ Move anywhere; saved with the note."""
        z = max(0.5, self.zoom)
        col_w = max(TableItem.MIN_COL, min(140, round((self.page_width() / z - 112) / cols)))
        if centre:
            adj = self.page_scroll.get_vadjustment()
            x = max(16.0, round((self.page_width() / z - col_w * cols) / 2))
            y = max(16.0, round((adj.get_value() + adj.get_page_size() / 2) / z - rows * 18))
        else:
            loc = self.view.get_iter_location(self.buffer.get_iter_at_mark(self.buffer.get_insert()))
            x, y = 56.0, round((loc.y + loc.height) / z + 16)
        data = {"rows": [[f"Column {i + 1}" for i in range(cols)]] + [[""] * cols for _ in range(max(1, rows - 1))],
                "col_w": [col_w] * cols, "x": x, "y": y, "z": self._next_z()}
        widget = self._add_table(data)
        widget.select(True)
        self.dirty = True
        self.save_note_meta()
        self.ensure_page_height_for_images()

    def _add_table(self, data):
        widget = TableItem(data, self)
        widget.anchor = None
        z = max(0.5, self.zoom)
        self.canvas_fixed.put(widget, round(data.get("x", 56.0) * z), round(data.get("y", 80.0) * z))
        self.table_items.append(widget)
        return widget

    def _clear_tables(self):
        for old in self.table_items:
            if old.get_parent() is self.canvas_fixed:
                self.canvas_fixed.remove(old)
        self.table_items = []

    def remove_table(self, widget):
        if widget.get_parent() is self.canvas_fixed:
            self.canvas_fixed.remove(widget)
        if widget in self.table_items:
            self.table_items.remove(widget)
        self.dirty = True
        self.save_note_meta()

    def _queue_save_meta(self):
        if getattr(self, "_meta_id", 0):
            return

        def run():
            self._meta_id = 0
            self.save_note_meta()
            return False
        self._meta_id = GLib.timeout_add(400, run)

    def _live_tables(self):
        return self.table_items

    def insert_divider_line(self):
        divider_text = "\n────────────────────────────────────────\n"
        self.buffer.insert_at_cursor(divider_text)
        self.dirty = True
        self._queue_save()
        self.view.grab_focus()

    def _setup_rich_tags(self):
        table = self.buffer.get_tag_table()

        def add_tag(name, **props):
            t = table.lookup(name)
            if not t:
                t = self.buffer.create_tag(name, **props)
            return t

        add_tag("bold", weight=Pango.Weight.BOLD)
        add_tag("italic", style=Pango.Style.ITALIC)
        add_tag("underline", underline=Pango.Underline.SINGLE)
        add_tag("strike", strikethrough=True)
        add_tag("mono", family="Monospace")
        add_tag("table-row", family="Monospace", paragraph_background="rgba(255,255,255,0.04)",
                pixels_above_lines=3, pixels_below_lines=3, wrap_mode=Gtk.WrapMode.NONE)
        add_tag("table-head", weight=Pango.Weight.BOLD, paragraph_background="rgba(124,156,255,0.16)")
        add_tag("table-pipe", foreground="rgba(160,170,190,0.45)")
        # The |---| row stays in the text (it's Markdown) but shrinks to a hairline.
        add_tag("table-rule", foreground="rgba(0,0,0,0)", scale=0.25, pixels_above_lines=0, pixels_below_lines=0)
        add_tag("pdf-chip", background="rgba(239,68,68,0.18)", foreground="#ffb4b4", weight=Pango.Weight.BOLD,
                underline=Pango.Underline.SINGLE)
        add_tag("h1", weight=Pango.Weight.BOLD, scale=1.60, pixels_above_lines=10, pixels_below_lines=6)
        add_tag("h2", weight=Pango.Weight.BOLD, scale=1.35, pixels_above_lines=8, pixels_below_lines=4)
        add_tag("h3", weight=Pango.Weight.semibold if hasattr(Pango.Weight, "semibold") else Pango.Weight.BOLD,
                scale=1.16, pixels_above_lines=6, pixels_below_lines=3)
        add_tag("title", weight=Pango.Weight.HEAVY, scale=1.90, pixels_above_lines=12, pixels_below_lines=8)

        for tname, _name, colour in HIGHLIGHTS:  # translucent, so text stays readable
            hl_rgba = Gdk.RGBA()
            hl_rgba.parse(colour)
            hl_rgba.alpha = 0.42
            add_tag(tname, background_rgba=hl_rgba)

        cm_rgba = Gdk.RGBA()
        cm_rgba.parse("rgba(245, 158, 11, 0.28)")
        add_tag("comment-mark", background_rgba=cm_rgba, underline=Pango.Underline.SINGLE)

    def _ensure_fg_tag(self, hex_color):
        tname = f"fg-{hex_color.lstrip('#').lower()}"
        table = self.buffer.get_tag_table()
        tag = table.lookup(tname)
        if not tag:
            rgba = Gdk.RGBA()
            rgba.parse(hex_color)
            tag = self.buffer.create_tag(tname, foreground_rgba=rgba)
        return tname, tag

    def _on_text_color_picked(self, btn, _pspec):
        hex_c = rgba_to_hex(btn.get_rgba())
        tname, tag = self._ensure_fg_tag(hex_c)
        self.active_fg_tag = tname
        bounds = self.buffer.get_selection_bounds()
        if bounds:
            self.buffer.apply_tag(tag, bounds[0], bounds[1])
            self.dirty = True
            self._queue_save()
        self.view.grab_focus()

    def _on_format_btn_toggled(self, tag_name, is_active):
        if getattr(self, "_syncing_ribbon", False):
            return
        if is_active:
            self.active_formats.add(tag_name)
        else:
            self.active_formats.discard(tag_name)

        bounds = self.buffer.get_selection_bounds()
        tag = self.buffer.get_tag_table().lookup(tag_name)
        if bounds and tag:
            if is_active:
                self.buffer.apply_tag(tag, bounds[0], bounds[1])
            else:
                self.buffer.remove_tag(tag, bounds[0], bounds[1])
            self.dirty = True
            self._queue_save()
        self.view.grab_focus()

    def _pick_highlight(self, tname):
        """The highlighter's colour: the selection gets it at once (any other
        highlight there goes), and so does what you type next."""
        old = self.hl_tag
        self.hl_tag = tname
        bounds = self.buffer.get_selection_bounds()
        table = self.buffer.get_tag_table()
        if bounds:
            for t, _n, _c in HIGHLIGHTS:
                self.buffer.remove_tag(table.lookup(t), *bounds)
            self.buffer.apply_tag(table.lookup(tname), *bounds)
            self.dirty = True
            self._queue_save()
        if old in self.active_formats:
            self.active_formats.discard(old)
            self.active_formats.add(tname)
        self._syncing_ribbon = True
        self.hl_btn.set_active(bool(bounds) or tname in self.active_formats)
        self._syncing_ribbon = False
        self.view.grab_focus()

    def toggle_shortcut_format(self, tag_name):
        # typing in a text box: Ctrl+B/I/U are for its words
        focus = self.get_focus()
        for box in self.sticky_notes:
            if focus is box.text_view and tag_name in ("bold", "italic", "underline"):
                box.toggle_style(tag_name[0])
                return
        btn_map = {
            "bold": self.bold_btn,
            "italic": self.italic_btn,
            "underline": self.under_btn,
            "strike": self.strike_btn,
            "hl-yellow": self.hl_btn,  # Ctrl+Shift+H: the highlighter, in its current colour
        }
        btn = btn_map.get(tag_name)
        if btn:
            btn.set_active(not btn.get_active())

    def _on_style_selected(self, drop, _pspec):
        if getattr(self, "_syncing_ribbon", False):
            return
        idx = drop.get_selected()
        style_map = {0: None, 1: "h1", 2: "h2", 3: "h3", 4: "title"}
        chosen = style_map.get(idx)
        self.active_para_style = chosen

        bounds = self.buffer.get_selection_bounds()
        if bounds:
            line_start, line_end = bounds[0].copy(), bounds[1].copy()
        else:
            cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
            line_start, line_end = cursor.copy(), cursor.copy()
        line_start.set_line_offset(0)
        if not line_end.ends_line():
            line_end.forward_to_line_end()

        table = self.buffer.get_tag_table()
        for h_name in ("h1", "h2", "h3", "title"):
            t = table.lookup(h_name)
            if t:
                self.buffer.remove_tag(t, line_start, line_end)
        if chosen and line_start.get_offset() < line_end.get_offset():
            t = table.lookup(chosen)
            if t:
                self.buffer.apply_tag(t, line_start, line_end)
        self.dirty = True
        self._queue_save()
        self.view.grab_focus()

    def _on_after_insert_text(self, buf, location, text, length):
        if self.loading:
            return
        if text == "\n":
            loc_prev = location.copy()
            loc_prev.backward_char()
            table = buf.get_tag_table()
            for h_name in ("h1", "h2", "h3", "title"):
                t = table.lookup(h_name)
                if t:
                    buf.remove_tag(t, loc_prev, location)
            self._reset_typing_style()
            return
        char_len = len(text)
        start = location.copy()
        start.backward_chars(char_len)
        table = buf.get_tag_table()
        for tname in self.active_formats:
            t = table.lookup(tname)
            if t:
                buf.apply_tag(t, start, location)
        if self.active_para_style:
            t = table.lookup(self.active_para_style)
            if t:
                buf.apply_tag(t, start, location)
        if self.active_fg_tag:
            t = table.lookup(self.active_fg_tag)
            if t:
                buf.apply_tag(t, start, location)

    def _reset_typing_style(self):
        """A new paragraph (or a line emptied with Backspace) starts as plain
        body text: bold, italic, colour or a heading don't carry over unless
        you switch them on again."""
        self.active_formats.clear()
        self.active_para_style = None
        self.active_fg_tag = None
        self._syncing_ribbon = True
        try:
            for btn in (self.bold_btn, self.italic_btn, self.under_btn, self.strike_btn, self.hl_btn):
                btn.set_active(False)
            self.style_drop.set_selected(0)
        finally:
            self._syncing_ribbon = False

    def clear_selection_formatting(self):
        self.active_formats.clear()
        self.active_para_style = None
        self.active_fg_tag = None
        bounds = self.buffer.get_selection_bounds()
        if bounds:
            self.buffer.remove_all_tags(bounds[0], bounds[1])
            self.dirty = True
            self._queue_save()
        self._sync_ribbon_state()

    def _on_cursor_moved(self, _buf, _iter, mark):
        if mark != self.buffer.get_insert():
            return
        it = self.buffer.get_iter_at_mark(mark)
        if it.starts_line() and it.ends_line():  # an empty line: plain body text
            self._reset_typing_style()
            return
        if not it.starts_line() and it.get_line_offset() > 0:
            check_it = it.copy()
            check_it.backward_char()
            self._sync_ribbon_from_iter(check_it)
        else:
            self._sync_ribbon_from_iter(it)

    def _sync_ribbon_from_iter(self, it):
        self._syncing_ribbon = True
        try:
            table = self.buffer.get_tag_table()
            for btn, tname in (
                (self.bold_btn, "bold"),
                (self.italic_btn, "italic"),
                (self.under_btn, "underline"),
                (self.strike_btn, "strike"),
                (self.hl_btn, self.hl_tag),
            ):
                t = table.lookup(tname)
                has = bool(t and it.has_tag(t))
                btn.set_active(has)
                if has:
                    self.active_formats.add(tname)
                else:
                    self.active_formats.discard(tname)

            for idx, hname in ((1, "h1"), (2, "h2"), (3, "h3"), (4, "title")):
                t = table.lookup(hname)
                if t and it.has_tag(t):
                    self.style_drop.set_selected(idx)
                    self.active_para_style = hname
                    break
            else:
                self.style_drop.set_selected(0)
                self.active_para_style = None
        finally:
            self._syncing_ribbon = False

    def _sync_ribbon_state(self):
        it = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        self._sync_ribbon_from_iter(it)

    def toggle_line_prefix(self, prefix):
        cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        ok, start = self.buffer.get_iter_at_line(cursor.get_line())
        end = start.copy()
        if not end.ends_line():
            end.forward_to_line_end()
        line = self.buffer.get_text(start, end, False)
        if line.startswith(prefix):
            new_line = line[len(prefix):]
        else:
            cleaned = re.sub(r"^(• |☐ |☑ |\d+\. )", "", line)
            new_line = prefix + cleaned
        self.buffer.begin_user_action()
        self.buffer.delete(start, end)
        self.buffer.insert(start, new_line)
        self.buffer.end_user_action()
        self.dirty = True
        self._queue_save()

    def add_sticky_note(self, item_data=None, text_box=False):
        # one sticky per click, however fast the clicks come
        if item_data is None:
            now = time.monotonic()
            if now - getattr(self, "_last_sticky", 0) < 0.6:
                return
            self._last_sticky = now
        scroll_y = self.page_scroll.get_vadjustment().get_value() / max(0.5, self.zoom)
        data = item_data or {
            "text": "",
            "x": float(80 + (len(self.sticky_notes) * 28) % 180),
            "y": float(max(110, round(scroll_y + 110))),
            "w": 340.0,
            "h": float(StickyNoteWidget.MIN_H),
            "v": 3,
            "color_idx": TEXT_BOX,
            "z": self._next_z(),
        }
        if not item_data:  # inside the sheet, however narrow it is
            data["x"] = float(max(16, min(data["x"], self.page_width() / max(0.5, self.zoom) - data["w"] - 16)))
        st = StickyNoteWidget(data, self)
        self.canvas_fixed.put(st, *st.place())
        self.sticky_notes.append(st)
        if item_data is None:
            self.dirty = True
            self.save_note_meta()
            GLib.idle_add(lambda: st.text_view.grab_focus() and False)  # once: True would repeat it forever

    # ---------- layers: every picture and sticky has a z; higher is in front
    def _layers(self):
        items = self.canvas_images + self.sticky_notes + self.table_items + self.pinned_stickies
        return sorted(items, key=lambda w: (w.data.get("z", 0), items.index(w)))

    def _next_z(self):
        return 1 + max((w.data.get("z", 0) for w in self.canvas_images + self.sticky_notes + self.table_items
                        + self.pinned_stickies),
                       default=0)

    def _apply_z_order(self):
        """Re-add the items in z order: a Gtk.Fixed draws its last child on top."""
        for w in self._layers():
            if w.get_parent() is self.canvas_fixed:
                self.canvas_fixed.remove(w)
            self.canvas_fixed.put(w, *(w.place() if hasattr(w, "place") else
                                       (round(w.data["x"] * self.zoom), round(w.data["y"] * self.zoom))))

    def restack(self, widget, how):
        """Bring Forward / Send Backward one step, or to the front / back."""
        order = self._layers()
        if widget not in order:
            return
        i = order.index(widget)
        order.pop(i)
        j = {"forward": i + 1, "backward": i - 1, "front": len(order), "back": 0}[how]
        order.insert(max(0, min(len(order), j)), widget)
        for z, w in enumerate(order):
            w.data["z"] = z
        self._apply_z_order()
        self.dirty = True
        self.save_note_meta()

    def add_pinned_sticky(self):
        scroll_y = self.page_scroll.get_vadjustment().get_value() / max(0.5, self.zoom)
        z = max(0.5, self.zoom)
        data = {"x": float(max(16, self.page_width() / z - 260 - 24 * (len(self.pinned_stickies) % 5))),
                "y": float(max(60, round(scroll_y + 80 + 24 * (len(self.pinned_stickies) % 5)))),
                "z": self._next_z(), "color_idx": len(self.pinned_stickies) % TEXT_BOX}
        pad = StickyPad(data, self)
        self.canvas_fixed.put(pad, round(data["x"] * self.zoom), round(data["y"] * self.zoom))
        self.pinned_stickies.append(pad)
        self.dirty = True
        self.save_note_meta()
        self._sync_export_toggle()
        GLib.idle_add(lambda: pad.text_view.grab_focus() and False)

    def remove_pinned_sticky(self, pad):
        if pad in self.pinned_stickies:
            self.pinned_stickies.remove(pad)
            if pad.get_parent() is self.canvas_fixed:
                self.canvas_fixed.remove(pad)
            self.dirty = True
            self.save_note_meta()
            self._sync_export_toggle()

    def has_sticky_notes(self):
        return bool(self.pinned_stickies)

    def _sync_export_toggle(self):
        """'Include sticky notes' only means something when there are some."""
        check = getattr(self, "export_pads", None)
        if check:
            check.set_sensitive(self.has_sticky_notes())
            check.set_tooltip_text(None if self.has_sticky_notes() else "This note has no sticky notes")

    def _on_quick_hl(self, btn):
        if btn.get_active():
            for other in (self.draw_toggle, self.shapes_toggle, self.laser_toggle):
                other.set_active(False)
            self.ink_canvas.tool = "quickhl"
            self.ink_canvas.set_ink_mode(True)
        elif self.ink_canvas.tool == "quickhl":
            self.ink_canvas.set_ink_mode(False)

    def _start_lasso(self):
        self.quick_hl.set_active(False)
        if not self.draw_toggle.get_active():
            self.draw_toggle.set_active(True)
        self.ink_tool_btns["lasso"].set_active(True)

    def snap_highlight(self, stroke):
        """A Quick Highlight stroke becomes a straight bar behind the line of
        text it was drawn along: as wide as the swipe, as tall as the line."""
        z = max(0.5, self.zoom)
        pts = stroke["points"]
        xs = [p[0] for p in pts]
        y = sum(p[1] for p in pts) / len(pts)
        # (the view's own coordinates are the page's; its text, "buffer", ones start below its margins)
        bx, by = self.view.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, round(sum(xs) / len(xs) * z),
                                                   round(y * z))
        ok, it = self.view.get_iter_at_location(bx, by)
        if ok:
            rect = self.view.get_iter_location(it)
            _wx, wy = self.view.buffer_to_window_coords(Gtk.TextWindowType.WIDGET, rect.x, rect.y)
            y, height = (wy + rect.height / 2) / z, rect.height / z
        else:
            height = 18.0
        stroke.update(points=[[round(min(xs), 1), round(y, 1), 0.5], [round(max(xs), 1), round(y, 1), 0.5]],
                      width=round(height * 0.9, 1), straight=True)
        return stroke

    def _scratchpad(self):
        """A card for sums: one per line (2*(3+4), sqrt(2), x = 5 then x^2);
        the answers show on the right. Kept with the note."""
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=8, margin_bottom=8,
                       margin_start=8, margin_end=8, width_request=340)
        card.append(Gtk.Label(label="Scratchpad", xalign=0, css_classes=["heading"]))
        row = Gtk.Box(spacing=8)
        self.scratch_view = Gtk.TextView(monospace=True, hexpand=True, top_margin=4, left_margin=6,
                                         wrap_mode=Gtk.WrapMode.NONE)
        self.scratch_out = Gtk.Label(xalign=1, yalign=0, css_classes=["monospace", "dim-label"], margin_top=4,
                                     selectable=True)
        row.append(Gtk.ScrolledWindow(child=self.scratch_view, min_content_height=160, hexpand=True))
        row.append(self.scratch_out)
        card.append(row)
        card.append(Gtk.Label(label="+ − × ÷ ^ %, sqrt sin cos tan log ln abs, pi e; x = 5", xalign=0,
                              css_classes=["caption", "dim-label"]))
        self.scratch_view.get_buffer().connect("changed", lambda b: self._scratch_changed(b))
        pop = Gtk.Popover(child=card)
        pop.connect("show", lambda *_: GLib.idle_add(lambda: self.scratch_view.grab_focus() and False))
        return pop

    def _scratch_changed(self, buf):
        text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        self.scratch_out.set_label("\n".join(scratch_eval(text)))
        if not getattr(self, "loading", False) and getattr(self, "rel", None):
            self.scratch_text = text
            self.save_note_meta()

    def text_colour_swatches(self, pick):
        """A row of TEXT_COLOURS swatches; PICK(hex) on a click."""
        row = Gtk.Box(spacing=4, margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        for name, hex_colour in TEXT_COLOURS:
            sw = Gtk.Button(tooltip_text=name, css_classes=["mk-swatch"])
            prov = Gtk.CssProvider()
            prov.load_from_string(f"button {{ background: {hex_colour}; border: 1px solid alpha(gray, 0.6); }}")
            sw.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 3)
            sw.connect("clicked", lambda _b, c=hex_colour: pick(c))
            row.append(sw)
        return row

    def _colour_text_box(self, hex_colour):
        box = getattr(self, "_active_text_box", None)
        if box not in self.sticky_notes:
            self.toast.add_toast(Adw.Toast(title="Click a text box first", timeout=2))
            return
        box.set_text_color(hex_colour)

    def remove_sticky_note(self, st):
        if st in self.sticky_notes:
            self.sticky_notes.remove(st)
            try:
                self.canvas_fixed.remove(st)
            except Exception:
                pass
            self.dirty = True
            self.save_note_meta()

    def prompt_add_comment(self):
        bounds = self.buffer.get_selection_bounds()
        quote = ""
        if bounds:
            quote = self.buffer.get_text(bounds[0], bounds[1], False).strip()[:60]
        else:
            cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
            ok, ls = self.buffer.get_iter_at_line(cursor.get_line())
            le = ls.copy()
            if not le.ends_line():
                le.forward_to_line_end()
            quote = self.buffer.get_text(ls, le, False).strip()[:60]

        # One draft at a time: a second click goes back to the open card.
        if getattr(self, "_comment_draft", None) is not None:
            self._open_comment_margin()
            self._comment_draft.grab_focus()
            return
        # A slim card at the top of the comments margin, not a dialog.
        self._open_comment_margin()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["mk-comment-card"])
        card.append(Gtk.Label(label=f"“{quote or 'This section'}”", xalign=0, ellipsize=Pango.EllipsizeMode.END,
                              css_classes=["mk-row-meta"]))
        entry = Gtk.Entry(placeholder_text="Add a comment…")
        card.append(entry)
        self._comment_draft = entry
        row = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel", css_classes=["flat"])
        add = Gtk.Button(label="Comment", css_classes=["suggested-action"])
        row.append(cancel)
        row.append(add)
        card.append(row)
        self.comments_list.prepend(card)
        marks = (self.buffer.create_mark(None, bounds[0], True), self.buffer.create_mark(None, bounds[1], False)) \
            if bounds else None

        def done(*_):
            txt = entry.get_text().strip()
            if txt:
                if marks:
                    t = self.buffer.get_tag_table().lookup("comment-mark")
                    if t:
                        self.buffer.apply_tag(t, self.buffer.get_iter_at_mark(marks[0]),
                                              self.buffer.get_iter_at_mark(marks[1]))
                self.comments.append({
                    "quote": quote or "Note comment",
                    "text": txt,
                    "time": datetime.now().strftime("%d %b, %H:%M"),
                })
                self.dirty = True
                self.save_note_meta()
            self._rebuild_comments_panel()
        add.connect("clicked", done)
        entry.connect("activate", done)
        cancel.connect("clicked", lambda *_: self._rebuild_comments_panel())
        GLib.idle_add(lambda: entry.grab_focus() and False)  # once: True would repeat it forever

    def _on_comments_toggled(self, btn):
        self.comments_sidebar.set_visible(btn.get_active())
        # the side panels come back when the margin they made room for closes
        if not btn.get_active() and getattr(self, "_panels_for_comments", False):
            self._panels_for_comments = False
            self.nb_toggle.set_active(True)
            self.list_toggle.set_active(True)

    def _open_comment_margin(self):
        """Show the comments margin; on a small window the side panels step
        aside so the page keeps its width (⤢ brings them back)."""
        if not self.comments_sidebar.get_visible() and self.get_width() < 1400:
            self._panels_for_comments = self.nb_toggle.get_active() or self.list_toggle.get_active()
            self.nb_toggle.set_active(False)
            self.list_toggle.set_active(False)
        self.comments_sidebar.set_visible(True)
        self.comments_toggle.set_active(True)

    def focus_comment_at(self, it):
        """A click on highlighted text: open the margin and point at its comment."""
        tag = self.buffer.get_tag_table().lookup("comment-mark")
        if not tag or not it.has_tag(tag):
            return False
        start, end = it.copy(), it.copy()
        if not start.starts_tag(tag):
            start.backward_to_tag_toggle(tag)
        if not end.ends_tag(tag):
            end.forward_to_tag_toggle(tag)
        text = self.buffer.get_text(start, end, False).strip()
        self._open_comment_margin()
        child, i = self.comments_list.get_first_child(), 0
        while child:
            cm = self.comments[i] if i < len(self.comments) else {}
            hit = bool(cm) and (cm.get("quote", "") in text or text[:60] == cm.get("quote", ""))
            (child.add_css_class if hit else child.remove_css_class)("mk-comment-active")
            if hit:
                child.grab_focus()
            child, i = child.get_next_sibling(), i + 1
        return True

    def _rebuild_comments_panel(self):
        self._comment_draft = None
        while (c := self.comments_list.get_first_child()) is not None:
            self.comments_list.remove(c)
        if not self.comments:
            self.comments_list.append(Gtk.Label(label="No comments yet.",
                                                css_classes=["dim-label"], margin_top=24))
            return
        for idx, cm in enumerate(self.comments):
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, css_classes=["mk-comment-card"])
            top = Gtk.Box(spacing=4)
            q_lbl = Gtk.Label(label=f"“{cm.get('quote', '')}”", xalign=0, hexpand=True,
                              ellipsize=Pango.EllipsizeMode.END, css_classes=["mk-row-meta"])
            top.append(q_lbl)
            res_btn = Gtk.Button(icon_name="object-select-symbolic", css_classes=["flat"],
                                 tooltip_text="Resolve Comment")
            res_btn.connect("clicked", lambda _b, i=idx: self._resolve_comment(i))
            top.append(res_btn)
            del_btn = Gtk.Button(icon_name="user-trash-symbolic", css_classes=["flat"],
                                 tooltip_text="Delete Comment")
            del_btn.connect("clicked", lambda _b, i=idx: self._delete_comment(i))
            top.append(del_btn)
            card.append(top)
            body_lbl = Gtk.Label(label=cm.get("text", ""), xalign=0, wrap=True, css_classes=["mk-row-title"])
            card.append(body_lbl)
            time_lbl = Gtk.Label(label=cm.get("time", ""), xalign=0, css_classes=["mk-status"])
            card.append(time_lbl)
            self.comments_list.append(card)

    def _resolve_comment(self, idx):
        if 0 <= idx < len(self.comments):
            self.comments.pop(idx)
            self._rebuild_comments_panel()
            self.dirty = True
            self.save_note_meta()
            self.toast.add_toast(Adw.Toast(title="Comment resolved ✓", timeout=2))

    def _delete_comment(self, idx):
        if 0 <= idx < len(self.comments):
            self.comments.pop(idx)
            self._rebuild_comments_panel()
            self.dirty = True
            self.save_note_meta()
            self.toast.add_toast(Adw.Toast(title="Comment deleted", timeout=2))

    def _on_zoom_scroll(self, ctrl, _dx, dy):
        if not ctrl.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK:
            return False
        # glide there: each frame closes 35 % of the gap to the target (lerp),
        # and further notches move the target, not the page
        base = getattr(self, "_zoom_target", None) or self.zoom
        self._zoom_target = max(0.65, min(2.2, base * (1 / 1.08 if dy > 0 else 1.08)))
        if not getattr(self, "_zoom_tick", 0):
            self._zoom_tick = self.page_scroll.add_tick_callback(self._zoom_glide)
        return True

    def _zoom_glide(self, *_):
        target = self._zoom_target
        gap = target - self.zoom
        move = math.copysign(max(0.011, abs(gap) * 0.35), gap)   # (set_zoom ignores steps under 0.01)
        step = target if abs(gap) <= abs(move) else self.zoom + move
        self.set_zoom(step, quiet=True)
        if step == target or abs(target - self.zoom) < 0.01:
            self._zoom_target, self._zoom_tick = None, 0
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    def set_zoom(self, zoom, quiet=False):
        zoom = max(0.65, min(2.2, round(zoom, 3)))
        if abs(zoom - self.zoom) < 0.01:
            return
        self.zoom = zoom
        self.zoom_lbl_btn.set_label(f"{round(zoom * 100)}%")
        if hasattr(self, "sb_zoom_reset_btn"):
            self.sb_zoom_reset_btn.set_label(f"{round(zoom * 100)}%")
        self.apply_theme_and_zoom()
        for img_w in self.canvas_images:
            img_w.sync_zoom_geometry()
        for st in self.sticky_notes + self.pinned_stickies:
            st.sync_zoom_geometry()
        for t in self._live_tables():
            t.sync_zoom()
        self.pages = 0
        self._update_pages()
        self.paper_bg.queue_draw()
        self.ink_canvas.queue_draw()
        if not quiet:
            if getattr(self, "_z_toast", None):
                self._z_toast.dismiss()
            self._z_toast = Adw.Toast(title=f"Page Zoom {round(zoom * 100)}%", timeout=1)
            self.toast.add_toast(self._z_toast)

    def apply_theme_and_zoom(self):
        conf = look_conf()
        preset_key = conf.get("THEME_PRESET", "obsidian")
        preset = THEMES.get(preset_key, THEMES["obsidian"])
        Adw.StyleManager.get_default().set_color_scheme(
            Adw.ColorScheme.FORCE_DARK if preset["dark"] else Adw.ColorScheme.FORCE_LIGHT
        )
        base_size = int(conf.get("FONT_SIZE") or 16)
        z = self.zoom
        css = f"""
        window {{ background: {preset['win_bg']}; color: {preset['fg']}; }}
        .mk-sidebar {{ background: {preset['side_bg']}; }}
        .mk-list-col {{ background: {preset['list_bg']}; }}
        .mk-page-col {{ background: {preset['win_bg']}; }}
        .mk-sheet {{ background: {preset['page_bg']}; }}
        .mk-ribbon {{ background: {preset['ribbon_bg']}; }}
        .mk-editor, .mk-editor text {{ font-size: {base_size * z:.1f}px; color: {'#ffffff' if preset['dark'] else preset['fg']}; }}
        """
        if not getattr(self, "_dyn_css", None):
            self._dyn_css = Gtk.CssProvider()
            disp = Gdk.Display.get_default()
            if disp:
                Gtk.StyleContext.add_provider_for_display(
                    disp, self._dyn_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1
                )
        self._dyn_css.load_from_string(css)
        self.view.set_left_margin(round(32 * z))
        self.view.set_right_margin(round(32 * z))
        self.view.set_top_margin(round(16 * z))
        self.view.set_pixels_below_lines(round(6 * z))
        if hasattr(self, "paper_bg"):
            self.paper_bg.queue_draw()

    def _meta_file(self, rel=None):
        rel = rel or self.rel
        if not rel:
            return None
        safe = re.sub(r"[^a-zA-Z0-9_.-]", "_", rel)
        return self._meta_dir / f"{safe}.json"

    def _load_meta(self, rel):
        f = self._meta_file(rel)
        if f and f.is_file():
            try:
                return json.loads(f.read_text(encoding="utf-8"))
            except Exception:
                return {}
        return {}

    def save_note_meta(self):
        if not self.rel or self.loading:
            return
        f = self._meta_file(self.rel)
        if not f:
            return
        spans = []
        table = self.buffer.get_tag_table()
        tag_names = ["bold", "italic", "underline", "strike", "mono", "pdf-chip", "h1", "h2", "h3", "title",
                     *(h[0] for h in HIGHLIGHTS),
                     "comment-mark"]
        table.foreach(lambda t: t.get_property("name") and t.get_property("name").startswith("fg-") and tag_names.append(t.get_property("name")))

        for tname in tag_names:
            tag = table.lookup(tname)
            if not tag:
                continue
            it = self.buffer.get_start_iter()
            while not it.is_end():
                if not it.starts_tag(tag):
                    if not it.forward_to_tag_toggle(tag):
                        break
                if it.starts_tag(tag):
                    s_off = it.get_offset()
                    if not it.forward_to_tag_toggle(tag):
                        e_off = self.buffer.get_end_iter().get_offset()
                    else:
                        e_off = it.get_offset()
                    if e_off > s_off:
                        spans.append([tname, s_off, e_off])

        data = {
            "spans": spans,
            "images": [w.data for w in self.canvas_images],
            "stickies": [s.data for s in self.sticky_notes],
            "pinned_stickies": [p.data for p in self.pinned_stickies],
            "tables": [dict(t.data) for t in self._live_tables()],
            "comments": self.comments,
            "strokes": self.ink_canvas.strokes,
            "scratch": getattr(self, "scratch_text", ""),
            "links": getattr(self, "note_links", []),
            "tags": getattr(self, "note_tags", []),
        }
        f.write_text(json.dumps(data), encoding="utf-8")

    def _import_markdown_to_clean_doc(self, raw_md):
        extracted_images = []
        extracted_links = []
        extracted_tags = []
        clean_lines = []
        line_styles = []

        img_y = 140.0
        for raw_line in raw_md.splitlines():
            m_img = EMBED_RE.match(raw_line)
            if m_img:
                img_name = m_img.group(1).strip()
                extracted_images.append({"name": img_name, "x": 48.0, "y": img_y, "w": 400.0, "angle": 0})
                img_y += 260.0
                continue
            if raw_line.strip() == "---":
                continue

            def repl_link(m):
                target = m.group(1).strip()
                label = (m.group(2) or target).strip()
                if not target.lower().endswith((".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg")):
                    if target not in extracted_links:
                        extracted_links.append(target)
                return label

            line = re.sub(r"!\[\[[^\]]+\]\]", "", raw_line)
            line = re.sub(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]", repl_link, line)

            for tm in re.finditer(r"(?<!\w)#([a-zA-Z][a-zA-Z0-9_-]*)", line):
                t = tm.group(1)
                if t not in extracted_tags:
                    extracted_tags.append(t)
            line = re.sub(r"(?<!\w)#[a-zA-Z][a-zA-Z0-9_-]*\s*", "", line)

            line_idx = len(clean_lines)
            if line.startswith("# "):
                line = line[2:].strip()
                line_styles.append((line_idx, "h1"))
            elif line.startswith("## "):
                line = line[3:].strip()
                line_styles.append((line_idx, "h2"))
            elif line.startswith("### "):
                line = line[4:].strip()
                line_styles.append((line_idx, "h3"))

            line = re.sub(r"^(\s*)[-*+]\s+\[\s\]\s+", r"\1☐ ", line)
            line = re.sub(r"^(\s*)[-*+]\s+\[[xX]\]\s+", r"\1☑ ", line)
            line = re.sub(r"^(\s*)[-*+]\s+", r"\1• ", line)
            line = re.sub(r"^>\s*(\[!.*?\]\s*)?", "", line)
            line = re.sub(r"<u>(.*?)</u>", r"\1", line)
            line = re.sub(r"\*\*(.*?)\*\*", r"\1", line)
            line = re.sub(r"==(.*?)==", r"\1", line)
            clean_lines.append(line)

        clean_text = "\n".join(clean_lines).strip()
        return clean_text, line_styles, extracted_images, extracted_links, extracted_tags

    def _first_note(self):
        """The newest note you can open without unlocking (Daily notes last);
        a new empty one when every note is locked."""
        notes = [n for n in self.vault.notes() if not self._is_note_protected(n["rel"])]
        notes.sort(key=lambda n: (n["folder"] == "Daily", -n.get("mtime", 0)))
        if notes:
            return notes[0]["rel"]
        return self.vault.create("", "Welcome" if not self.vault.notes() else "Untitled")

    def open_note(self, rel, record_history=True):
        if not rel:
            return
        self._save_now()
        self._commit_title()
        if not self.vault.path(rel).exists():
            return

        if self._is_note_protected(rel):
            folder = Path(rel).parent.as_posix()
            is_folder_lock = folder != "." and folder in self._locked_folders() and f"folder:{folder}" not in self._unlocked_items
            heading = f"Unlock Notebook “{folder}”" if is_folder_lock else f"Unlock Note “{Path(rel).stem}”"

            def on_unlocked():
                if is_folder_lock:
                    self._unlocked_items.add(f"folder:{folder}")
                self._unlocked_items.add(rel)
                self.refresh_lists()
                self.open_note(rel, record_history=record_history)

            self._authenticate(heading, on_unlocked)
            return

        if record_history and self.rel and self.rel != rel:
            self.nav_history.append(self.rel)
            self.back_btn.set_visible(True)

        self.rel = rel
        self.loading = True
        raw_md = self.vault.read(rel)
        meta = self._load_meta(rel)
        if meta and meta.get("tables"):  # the Markdown copy of the tables isn't text to edit
            raw_md = raw_md.split(TABLES_MARK.strip())[0].rstrip() + "\n"

        if not meta:
            clean_txt, line_styles, ext_imgs, ext_links, ext_tags = self._import_markdown_to_clean_doc(raw_md)
            self.buffer.set_text(clean_txt)
            table = self.buffer.get_tag_table()
            for l_idx, tname in line_styles:
                ok, s_it = self.buffer.get_iter_at_line(l_idx)
                if ok:
                    e_it = s_it.copy()
                    if not e_it.ends_line():
                        e_it.forward_to_line_end()
                    t = table.lookup(tname)
                    if t:
                        self.buffer.apply_tag(t, s_it, e_it)
            self.note_links = ext_links
            self.note_tags = ext_tags
            self.comments = []
            self._clear_tables()
            self._rebuild_canvas_objects(ext_imgs, [])
            self.ink_canvas.strokes = []
            self.loading = False
            self.save_note_meta()
        else:
            clean_txt, _ls, _ei, _el, _et = self._import_markdown_to_clean_doc(raw_md)
            self.buffer.set_text(clean_txt)
            self._clear_tables()
            # Tables saved inside the text (older MK Notes) each took one
            # character there: shift the formatting back, put them on the page.
            anchors = sorted(int(t["offset"]) for t in meta.get("tables", []) if "offset" in t)

            def unshift(o):
                return o - sum(1 for a in anchors if a < o)
            if anchors:
                meta["spans"] = [[n, unshift(a), unshift(b)] for n, a, b in meta.get("spans", [])]
            pending_tables = meta.get("tables", [])
            table = self.buffer.get_tag_table()
            end_off = self.buffer.get_end_iter().get_offset()
            for tname, s_off, e_off in meta.get("spans", []):
                if tname.startswith("fg-"):
                    _, t = self._ensure_fg_tag("#" + tname[3:])
                else:
                    t = table.lookup(tname)
                if t and 0 <= s_off < e_off <= end_off:
                    self.buffer.apply_tag(t, self.buffer.get_iter_at_offset(s_off), self.buffer.get_iter_at_offset(e_off))
            self.note_links = list(meta.get("links", []))
            self.note_tags = list(meta.get("tags", []))
            self.scratch_text = meta.get("scratch", "")
            if hasattr(self, "scratch_view"):
                self.scratch_view.get_buffer().set_text(self.scratch_text)
            self.comments = list(meta.get("comments", []))
            self._rebuild_canvas_objects(meta.get("images", []), meta.get("stickies", []),
                                         meta.get("pinned_stickies", []))
            for t in pending_tables:
                data = {k: v for k, v in t.items() if k != "offset"}
                if "y" not in data:  # an older in-text table: where its line was
                    it = self.buffer.get_iter_at_offset(min(unshift(int(t.get("offset", 0))), end_off))
                    data["x"], data["y"] = 56.0, round(self.view.get_iter_location(it).y / max(0.5, self.zoom))
                self._add_table(data)
            self.ink_canvas.strokes = list(meta.get("strokes", []))
            self.loading = False

        self._rebuild_comments_panel()
        self.comments_toggle.set_active(bool(self.comments))
        self.ink_canvas.redo_stack.clear()
        self.ink_canvas.queue_draw()
        self.title_entry.set_text(Path(rel).stem)
        self._quiet_pin = True
        self.pin_btn.set_active(self.vault.is_pinned(rel))
        self._quiet_pin = False
        self.dirty = False
        self.vault.state["last"] = rel
        self.vault.save_state()
        row = self.rows.get(rel)
        if row:
            self.list.select_row(row)
        self._refresh_header_pills()
        if not self.ink_canvas.active:
            GLib.idle_add(lambda: self.view.grab_focus() and False)  # once: True would repeat it forever

    def _rebuild_canvas_objects(self, images_list, stickies_list, pads_list=()):
        for w in self.canvas_images + self.sticky_notes + self.pinned_stickies:
            try:
                self.canvas_fixed.remove(w)
            except Exception:
                pass
        self.canvas_images = []
        self.sticky_notes = []
        self.pinned_stickies = []
        for item in pads_list:
            pad = StickyPad(dict(item), self)
            self.canvas_fixed.put(pad, round(pad.data["x"] * self.zoom), round(pad.data["y"] * self.zoom))
            self.pinned_stickies.append(pad)
        self._sync_export_toggle()
        self.selected_img = None

        for item in images_list:
            name = item.get("name", "")
            path = self._resolve_attachment(name)
            if path and path.is_file():
                widget = FreeCanvasImage(path, dict(item), self)
                self.canvas_fixed.put(widget, round(widget.data["x"] * self.zoom), round(widget.data["y"] * self.zoom))
                self.canvas_images.append(widget)

        for s_item in stickies_list:  # sticky notes are text boxes now: same words, no paper
            st = StickyNoteWidget(dict(s_item, color_idx=TEXT_BOX), self)
            self.canvas_fixed.put(st, *st.place())
            self.sticky_notes.append(st)

        self._apply_z_order()
        self.ensure_page_height_for_images()

    # ---------- pages
    def page_width(self):
        """PAGE_W at the zoom, narrower when the editor column is (keeping
        the A4 shape), with room for the workspace around it."""
        avail = self.page_scroll.get_width() - 48
        full = PAGE_W * max(0.5, self.zoom)
        return round(min(full, avail) if avail > 300 else full)

    def page_height(self):
        return self.page_width() * 1.414

    def _queue_pages(self):
        if getattr(self, "_pages_id", 0):
            return

        def run():
            self._pages_id = 0
            self._update_pages()
            return False
        self._pages_id = GLib.timeout_add(150, run)

    def _content_bottom(self):
        """How far down the note's text, tables, pictures and text boxes
        reach, in page units (zoom 100 %)."""
        z = max(0.5, self.zoom)
        _min, text_h, _b1, _b2 = self.view.measure(Gtk.Orientation.VERTICAL, self.page_width())
        bottom = (text_h - self.view.get_bottom_margin()) / z + 40  # (the margin is room for the items)
        for w in self.canvas_images + self.sticky_notes + self.pinned_stickies:
            bottom = max(bottom, w.data.get("y", 0) + w.data.get("h", 160) + PAGE_GAP / 2)
        for t in self.table_items:
            bottom = max(bottom, t.data.get("y", 0) + t.get_height() / z + PAGE_GAP / 2)
        return bottom

    # ---------- pagination: nothing on a page gap
    def _paginate(self):
        """Word-style page breaks in the one text view: a paragraph that would
        run into the gap between two sheets (or their PAGE_PAD margins) is
        pushed whole to the top of the next sheet, by space above it (a tag
        of its own, so nothing is added to the text). A heading that would
        be left at the bottom of a page goes over with the line after it.
        Positions are worked out from where every paragraph would be with no
        pushes at all, so running it again changes nothing."""
        z = max(0.5, self.zoom)
        page_h, gap, pad = self.page_height(), PAGE_GAP * z, PAGE_PAD * z
        usable = page_h - gap - 2 * pad
        buf, table = self.buffer, self.buffer.get_tag_table()
        pushes = getattr(self, "_pb_push", {})  # pb tag name -> its push, px
        lines = []                                # (natural top, natural height, heading?, current push, base)
        shift = 0.0
        for n in range(buf.get_line_count()):
            _ok, it = buf.get_iter_at_line(n)
            y, h = self.view.get_line_yrange(it)
            y = self.view.buffer_to_window_coords(Gtk.TextWindowType.WIDGET, 0, y)[1]   # on the page
            tags = it.get_tags()
            push = sum(pushes.get(t.props.name or "", 0) for t in tags)
            base = next((t.props.pixels_above_lines for t in reversed(tags)
                         if not (t.props.name or "").startswith("pb-") and t.props.pixels_above_lines_set),
                        self.view.get_pixels_above_lines())
            heading = any((t.props.name or "") in ("title", "h1", "h2", "h3") for t in tags)
            lines.append((y - shift, h - push, heading, push, base))
            shift += push
        want, offset = [0.0] * len(lines), 0.0

        def push_to_next(i, top):
            k = math.floor(top / page_h)
            return (k + 1) * page_h + gap / 2 + pad - top
        i = 0
        while i < len(lines):
            top, h, heading, _p, _b = lines[i]
            top += offset
            k = math.floor(top / page_h)
            limit = (k + 1) * page_h - gap / 2 - pad
            need = 0.0
            if k >= 1 and top < k * page_h + gap / 2 + pad and h <= usable:   # starts in the gap or its margin
                need = k * page_h + gap / 2 + pad - top
            elif h <= usable:
                # a heading needs room for the first line after it too
                after = min(lines[i + 1][1], 28 * z) if heading and i + 1 < len(lines) else 0
                if top + h + after > limit:
                    need = push_to_next(i, top)
            if need > 0.5:
                want[i] = round(need)
                offset += round(need)
            i += 1
        if [round(p) for *_x, p, _b in lines] == want:
            return
        # apply: one tag per pushed paragraph, the previous ones removed
        for name in list(pushes):
            tag = table.lookup(name)
            if tag:
                buf.remove_tag(tag, buf.get_start_iter(), buf.get_end_iter())
                table.remove(tag)
        self._pb_push = {}
        for n, (line, q) in enumerate(zip(lines, want)):
            if not q:
                continue
            _ok, start = buf.get_iter_at_line(n)
            end = start.copy()
            if not end.forward_line():
                end = buf.get_end_iter()
            if start.equal(end):
                continue   # an empty last line: nothing to hang the space on
            name = f"pb-{n}-{q}"
            buf.apply_tag(buf.create_tag(name, pixels_above_lines=line[4] + q), start, end)
            self._pb_push[name] = q

    def keep_off_gaps(self, widget):
        """A picture, text box or table dropped across a page gap moves to
        the top of the next sheet (when it's shorter than a sheet)."""
        z = max(0.5, self.zoom)
        page_h = self.page_height() / z
        if isinstance(widget, FreeCanvasImage):
            lead, h = FreeCanvasImage.PAD_TOP / z, widget.data.get("h", 0)
        elif isinstance(widget, StickyNoteWidget):
            lead, h = 0.0, widget.data.get("h", 0)
        else:
            lead, h = 0.0, widget.get_height() / z
        top = widget.data.get("y", 0) + lead
        if h > page_h - PAGE_GAP - 2 * 8:
            return
        k = math.floor(top / page_h)
        if k >= 1 and top < k * page_h + PAGE_GAP / 2:
            widget.data["y"] = k * page_h + PAGE_GAP / 2 + 8 - lead
        elif top + h > (k + 1) * page_h - PAGE_GAP / 2:
            widget.data["y"] = (k + 1) * page_h + PAGE_GAP / 2 + 8 - lead
        else:
            return
        if hasattr(widget, "sync_zoom_geometry"):
            widget.sync_zoom_geometry()
        elif hasattr(widget, "sync_zoom"):
            widget.sync_zoom()
        self.dirty = True

    def _update_pages(self):
        """As many A4 sheets as the text, tables, pictures and stickies need:
        a new page appears as soon as anything passes the last one's bottom."""
        self._paginate()
        z = max(0.5, self.zoom)
        width = self.page_width()
        self.page_overlay.set_size_request(width, -1)
        pages = max(1, math.ceil(self._content_bottom() * z / self.page_height()))
        if pages != getattr(self, "pages", 0) or width != getattr(self, "_sheet_w", 0):
            self.pages, self._sheet_w = pages, width
            self.paper_bg.set_size_request(width, round(pages * self.page_height()))
            self.paper_bg.queue_draw()
        self._update_badge()

    def _update_badge(self):
        pages = getattr(self, "pages", 1)
        adj = self.page_scroll.get_vadjustment()
        here = adj.get_value() + adj.get_page_size() / 2 - 24
        current = max(1, min(pages, int(here // self.page_height()) + 1))
        self.page_badge.set_label(f"{current} of {pages}")

    def ensure_page_height_for_images(self):
        max_bottom = 260
        for w in self.canvas_images:
            b = int((w.data.get("y", 0) + w.data.get("h", 200) + 140) * self.zoom)
            if b > max_bottom:
                max_bottom = b
        for s in self.sticky_notes:
            b = int((s.data.get("y", 0) + s.data.get("h", 160) + 120) * self.zoom)
            if b > max_bottom:
                max_bottom = b
        for t in self.table_items:
            b = int(t.data.get("y", 0) * self.zoom + t.get_height() + 120)
            if b > max_bottom:
                max_bottom = b
        self.view.set_bottom_margin(max_bottom)
        self._queue_pages()

    def select_canvas_image(self, target):
        self.selected_img = target
        for w in self.canvas_images:
            w.set_selected(w is target)

    def remove_canvas_image(self, widget):
        if widget in self.canvas_images:
            self.canvas_images.remove(widget)
            try:
                self.canvas_fixed.remove(widget)
            except Exception:
                pass
            self.selected_img = None
            self.dirty = True
            self.save_note_meta()
            self._save_now()

    def _resolve_attachment(self, name):
        if not name:
            return None
        p = self.vault.path(f"attachments/{name}")
        if p.is_file():
            return p
        rel = self.vault.resolve(name)
        return self.vault.path(rel) if rel else None

    def _sync_padlock(self):
        """🔓 while the open note is locked (itself or by its notebook) but
        unlocked for now; 🔒 otherwise."""
        rel = self.rel
        if not rel or not hasattr(self, "lock_btn"):
            return
        folder = Path(rel).parent.as_posix()
        locked = rel in self._locked_notes() or (folder != "." and folder in self._locked_folders())
        open_now = locked and not self._is_note_protected(rel)
        self.lock_btn.set_icon_name("changes-allow-symbolic" if open_now else "changes-prevent-symbolic")
        self.lock_btn.set_tooltip_text("Unlocked for now: Lock Now or change the lock" if open_now
                                       else "Lock / Unlock Note or Entire Notebook")

    def _refresh_header_pills(self):
        self._sync_padlock()
        if not self.rel:
            return
        txt = self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False)
        words = len(re.findall(r"\w+", txt))
        nb = Path(self.rel).parent.as_posix()
        nb_str = "Notes" if nb == "." else nb
        self.meta_label.set_text(f"📚 {nb_str}  ·  {words} words")

        while (c := self.links_bar.get_first_child()) is not None:
            self.links_bar.remove(c)
        for target in getattr(self, "note_links", []):
            pill_box = Gtk.Box(spacing=2, css_classes=["mk-link-pill"])
            open_b = Gtk.Button(label=f"🔗 {target}", css_classes=["flat"],
                                tooltip_text=f"Jump to connected note “{target}”")
            open_b.connect("clicked", lambda _b, t=target: self.open_note(self.vault.resolve(t) or self.vault.create("", t)))
            del_b = Gtk.Button(label="×", css_classes=["flat"], tooltip_text="Remove link")
            del_b.connect("clicked", lambda _b, t=target: self._remove_link(t))
            pill_box.append(open_b)
            pill_box.append(del_b)
            self.links_bar.append(pill_box)

        while (c := self.tags_bar.get_first_child()) is not None:
            self.tags_bar.remove(c)
        for tag in getattr(self, "note_tags", []):
            t_box = Gtk.Box(spacing=2, css_classes=["mk-tag-pill"])
            tb = Gtk.Button(label=f"#{tag}", css_classes=["flat"], tooltip_text=f"Filter by #{tag}")
            tb.connect("clicked", lambda _b, t=tag: self.set_scope(("tag", t), f"#{t}"))
            xb = Gtk.Button(label="×", css_classes=["flat"], tooltip_text=f"Remove #{tag}")
            xb.connect("clicked", lambda _b, t=tag: self._remove_tag(t))
            t_box.append(tb)
            t_box.append(xb)
            self.tags_bar.append(t_box)

    def _on_buffer_changed(self, _buf):
        if self.loading or not self.rel:
            return
        self.dirty = True
        self._queue_save()
        if hasattr(self, "save_stat_lbl"):
            self.save_stat_lbl.set_text("Saving…")
        # Counting re-reads the whole note: once typing pauses, not per key.
        if getattr(self, "_stats_id", 0):
            GLib.source_remove(self._stats_id)
        self._stats_id = GLib.timeout_add(300, self._update_doc_stats)

    def _update_doc_stats(self):
        self._stats_id = 0
        txt = self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False)
        words = len(txt.split())
        chars = len(txt)
        if hasattr(self, "doc_stat_lbl"):
            self.doc_stat_lbl.set_text(f"{words} words · {chars} chars")
        return False

    def _queue_save(self):
        if self.save_id:
            GLib.source_remove(self.save_id)
        self.save_id = GLib.timeout_add(500, self._save_now)

    def _save_now(self):
        if self.save_id:
            GLib.source_remove(self.save_id)
            self.save_id = 0
        if not self.rel or self.loading or not self.dirty:
            return GLib.SOURCE_REMOVE
        body = self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False).rstrip()
        tail = []
        for lnk in getattr(self, "note_links", []):
            tail.append(f"[[{lnk}]]")
        for tg in getattr(self, "note_tags", []):
            tail.append(f"#{tg}")
        for w in self.canvas_images:
            tail.append(f"![[{w.data['name']}]]")
        full_md = body + ("\n\n" + "\n".join(tail) if tail else "") + "\n"
        # The tables as Markdown at the end, so the file reads well in other
        # apps and on the phone; MK Notes keeps them in the meta and drops
        # this copy when it opens the note.
        if self._live_tables():
            full_md += TABLES_MARK + "\n" + "\n\n".join(t.to_markdown() for t in self.table_items) + "\n"
        self.vault.write(self.rel, full_md)
        self.save_note_meta()
        self.dirty = False
        if hasattr(self, "save_stat_lbl"):
            self.save_stat_lbl.set_text("Saved ✓")
        row = self.rows.get(self.rel)
        if row:
            row.sub_lbl.set_text(f"{when_short(time.time())}  ·  {clean_preview(body)}")
        self._refresh_header_pills()
        return GLib.SOURCE_REMOVE

    def _commit_title(self):
        if not self.rel:
            return
        new_t = self.title_entry.get_text().strip()
        old_stem = Path(self.rel).stem
        if not new_t or new_t == old_stem:
            return
        self._save_now()
        old_meta = self._meta_file(self.rel)
        new_rel = self.vault.rename(self.rel, new_t)
        new_meta = self._meta_file(new_rel)
        if old_meta and old_meta.is_file() and new_meta:
            old_meta.rename(new_meta)
        self.rel = new_rel
        self.title_entry.set_text(Path(self.rel).stem)
        self.refresh_lists()

    def _on_editor_click(self, _gesture, _n, x, y):
        if getattr(self, "_all_selected", False):
            self._select_everything(False)
        if self.selected_img:
            self.select_canvas_image(None)
        bx, by = self.view.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, int(x), int(y))
        ok, it = self.view.get_iter_at_location(bx, by)
        if not ok:
            return
        line_s = it.copy()
        line_s.set_line_offset(0)
        line_e = it.copy()
        if not line_e.ends_line():
            line_e.forward_to_line_end()
        line = self.buffer.get_text(line_s, line_e, False)
        if self.focus_comment_at(it):
            return
        chip = self.buffer.get_tag_table().lookup("pdf-chip")
        if chip and it.has_tag(chip) and line.startswith("📎 "):
            # Only a PDF that MK Notes attached: attachments/<name>.pdf, a
            # regular file inside the vault, by its exact name (no search).
            name = line[2:].strip()
            raw = self.vault.root / "attachments" / name
            if ("/" not in name and name.lower().endswith(".pdf") and not raw.is_symlink()
                    and raw.is_file() and raw.resolve().parent == (self.vault.root / "attachments").resolve()):
                Gio.AppInfo.launch_default_for_uri(raw.as_uri(), None)
            return
        if it.get_line_offset() <= 3 and line.lstrip().startswith(("☐ ", "☑ ")):
            swapped = line.replace("☐ ", "☑ ", 1) if "☐ " in line[:4] else line.replace("☑ ", "☐ ", 1)
            self.buffer.begin_user_action()
            self.buffer.delete(line_s, line_e)
            self.buffer.insert(line_s, swapped)
            self.buffer.end_user_action()
            self.dirty = True
            self._queue_save()

    # ---------- Ctrl+A: the whole page
    def _select_everything(self, on):
        """Outline every table, picture and text box (the text is selected by
        the editor itself); off again on the next other key or click."""
        self._all_selected = on
        self.ink_canvas.select_all(on)   # the ink too, in one dashed box
        for w in self.canvas_images + self.sticky_notes + self.pinned_stickies:
            (w.add_css_class if on else w.remove_css_class)("mk-all-selected")
        for t in self.table_items:
            t._all = on
            t.select(on)

    def _delete_everything(self):
        if self.ink_canvas.strokes:
            self.ink_canvas.strokes = []
            self.ink_canvas.queue_draw()
        self.ink_canvas.selection = None
        for w in list(self.canvas_images):
            self.remove_canvas_image(w)
        for st in list(self.sticky_notes):
            self.remove_sticky_note(st)
        for pad in list(self.pinned_stickies):
            self.remove_pinned_sticky(pad)
        for t in list(self.table_items):
            self.remove_table(t)
        self._all_selected = False
        self.save_note_meta()

    def _on_editor_key(self, _ctrl, keyval, _code, state):
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        if ctrl and keyval in (Gdk.KEY_a, Gdk.KEY_A):
            self._select_everything(True)
            return False  # the editor selects all the text itself
        if getattr(self, "_all_selected", False):
            if keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
                self._delete_everything()  # and the editor deletes the selected text
                return False
            if keyval not in (Gdk.KEY_Control_L, Gdk.KEY_Control_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R):
                self._select_everything(False)
        if keyval == Gdk.KEY_Tab and not (state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK)):
            if self._table_tab():
                return True
        if self.selected_img and keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            self.remove_canvas_image(self.selected_img)
            return True
        if self.selected_img and keyval == Gdk.KEY_Escape:
            self.select_canvas_image(None)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and not (state & Gdk.ModifierType.SHIFT_MASK):
            # If current line is a heading, revert next line to standard Body text
            cursor = self.buffer.get_iter_at_mark(self.buffer.get_insert())
            table = self.buffer.get_tag_table()
            for h_name in ("h1", "h2", "h3", "title"):
                t = table.lookup(h_name)
                if t and cursor.has_tag(t):
                    self.active_para_style = None
                    self._syncing_ribbon = True
                    self.style_drop.set_selected(0)
                    self._syncing_ribbon = False
                    break
            ok, start = self.buffer.get_iter_at_line(cursor.get_line())
            line = self.buffer.get_text(start, cursor, False)
            m = re.match(r"^(\s*)(• |☐ |☑ |(\d+)\. )(.*)$", line)
            if m:
                indent, marker, num, rest = m.group(1), m.group(2), m.group(3), m.group(4)
                if not rest.strip():
                    self.buffer.delete(start, cursor)
                    return False
                nxt = f"{int(num) + 1}. " if num else ("☐ " if marker in ("☐ ", "☑ ") else "• ")
                self.buffer.insert_at_cursor("\n" + indent + nxt)
                return True
        return False

    def _on_list_key(self, _ctrl, keyval, _code, _state):
        if keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            row = self.list.get_selected_row()
            if row and getattr(row, "rel", None):
                self.confirm_delete_note(row.rel)
                return True
        return False

    def _add_image_bytes(self, data, ext, stem_prefix="Image"):
        stamp = f"{stem_prefix}_{datetime.now():%Y%m%d_%H%M%S_%f}"
        rel = self.vault.save_attachment(data, ext, stamp)
        name = Path(rel).name
        path = self.vault.path(rel)
        scroll_y = self.page_scroll.get_vadjustment().get_value() / max(0.5, self.zoom)
        item = {"name": name, "x": 56.0, "y": max(80.0, round(scroll_y + 90.0)), "w": 400.0, "angle": 0,
                "z": self._next_z()}
        widget = FreeCanvasImage(path, item, self)
        self.canvas_fixed.put(widget, round(item["x"] * self.zoom), round(item["y"] * self.zoom))
        self.canvas_images.append(widget)
        self.select_canvas_image(widget)
        self.ensure_page_height_for_images()
        self.dirty = True
        self.save_note_meta()
        self._save_now()
        self.toast.add_toast(Adw.Toast(
            title="Image added · Drag anywhere to move, drag corners/handles to resize!",
            timeout=3,
        ))

    @staticmethod
    def _wl_paste_image():
        if not os.environ.get("WAYLAND_DISPLAY") or not shutil.which("wl-paste"):
            return None
        try:
            types = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True, timeout=2).stdout.split()
        except Exception:
            return None
        for mime, ext in (("image/png", ".png"), ("image/jpeg", ".jpg"), ("image/webp", ".webp")):
            if mime in types:
                try:
                    data = subprocess.run(["wl-paste", "--no-newline", "-t", mime], capture_output=True, timeout=4).stdout
                    if data:
                        return data, ext
                except Exception:
                    return None
        return None

    @staticmethod
    def _x11_paste_image():
        if not shutil.which("xclip"):
            return None
        try:
            targets = subprocess.run(["xclip", "-selection", "clipboard", "-t", "TARGETS", "-o"],
                                     capture_output=True, text=True, timeout=2).stdout
            for mime, ext in (("image/png", ".png"), ("image/jpeg", ".jpg"), ("image/webp", ".webp")):
                if mime in targets:
                    data = subprocess.run(["xclip", "-selection", "clipboard", "-t", mime, "-o"],
                                          capture_output=True, timeout=4).stdout
                    if data:
                        return data, ext
        except Exception:
            return None
        return None

    def _on_paste(self, view):
        img = self._wl_paste_image() or self._x11_paste_image()
        if img:
            view.stop_emission_by_name("paste-clipboard")
            self._add_image_bytes(img[0], img[1], "Pasted")
            return
        clipboard = self.get_clipboard()
        formats = clipboard.get_formats()
        if formats.contain_gtype(Gdk.Texture) or formats.contain_mime_type("image/png"):
            view.stop_emission_by_name("paste-clipboard")

            def got(c, res):
                try:
                    tex = c.read_texture_finish(res)
                    if tex:
                        png_bytes = tex.save_to_png_bytes().get_data()
                        GLib.idle_add(lambda: self._add_image_bytes(png_bytes, ".png", "Pasted"))
                except Exception:
                    pass
            clipboard.read_texture_async(None, got)

    def attach_image(self):
        dlg = Gtk.FileDialog(title="Insert Image into Note")

        def chosen(d, res):
            try:
                files = list(d.open_multiple_finish(res))
            except GLib.Error:
                return
            for f in files:
                p = Path(f.get_path() or "")
                if p.is_file() and p.suffix.lower() in nv.IMAGE_EXT:
                    self._add_image_bytes(p.read_bytes(), p.suffix.lower(), p.stem)
                elif p.is_file() and p.suffix.lower() == ".pdf":
                    self.insert_pdf(p)
        dlg.open_multiple(self, None, chosen)

    def insert_pdf(self, src):
        """OneNote's choice: a file chip in the text, or the pages laid on the
        page as pictures you can draw on."""
        dlg = Adw.AlertDialog(heading=f"Insert “{src.name}”",
                              body="Attach it as a file, or lay its pages on the note to write on them.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("attach", "📎 Attach file")
        dlg.add_response("printout", "📄 Insert as printout")
        dlg.set_response_appearance("printout", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("printout")

        def answered(_d, response):
            if response == "attach":
                self._attach_pdf_chip(src)
            elif response == "printout":
                self._insert_printout(src)
        dlg.connect("response", answered)
        dlg.present(self)

    def _attach_pdf_chip(self, src):
        rel = self.vault.save_attachment(src.read_bytes(), ".pdf", src.stem)
        name = Path(rel).name
        buf = self.buffer
        if not buf.get_iter_at_mark(buf.get_insert()).starts_line():
            buf.insert_at_cursor("\n")
        start = buf.get_iter_at_mark(buf.get_insert()).get_offset()
        chip = f"📎 {name}"
        buf.insert_at_cursor(chip + "\n")
        buf.apply_tag_by_name("pdf-chip", buf.get_iter_at_offset(start), buf.get_iter_at_offset(start + len(chip)))
        self.dirty = True
        self._queue_save()
        self.toast.add_toast(Adw.Toast(title=f"Attached {name}: click it to open", timeout=3))

    def _insert_printout(self, src):
        """Every page (up to 30) as a picture, one under the other, made in a
        sandbox (the PDF may come from anywhere)."""
        rel = self.vault.save_attachment(src.read_bytes(), ".pdf", src.stem)
        self.toast.add_toast(Adw.Toast(title="Laying out the pages…", timeout=2))

        def work():
            pages = self.vault.pdf_pages(rel)
            GLib.idle_add(lambda: (self._place_printout(src.stem, pages), False)[1])
        threading.Thread(target=work, daemon=True).start()

    def _place_printout(self, stem, pages):
        if not pages:
            self.toast.add_toast(Adw.Toast(title="Couldn't read that PDF's pages (needs bubblewrap and poppler-utils)",
                                           timeout=4))
            return
        # One PDF page per A4 sheet, starting on the first sheet below
        # everything already on the note: each page centred on its sheet,
        # 24 px from the sheet's edges and the page-break gaps.
        z = max(0.5, self.zoom)
        sheet_w, sheet_h = self.page_width() / z, self.page_height() / z
        first = math.ceil(self._content_bottom() / sheet_h)
        box_w, box_h = sheet_w - 2 * 24, sheet_h - PAGE_GAP - 2 * 24
        for i, data in enumerate(pages):
            pw, ph = _png_size(data) or (595, 842)
            scale = min(box_w / pw, box_h / ph)
            w, h = pw * scale, ph * scale
            top = (first + i) * sheet_h + PAGE_GAP / 2 + 24
            prel = self.vault.save_attachment(data, ".png", f"{stem} page {i + 1}")
            # (a picture is drawn inside its frame's padding: offset by it)
            item = {"name": Path(prel).name, "x": round((sheet_w - w) / 2 - FreeCanvasImage.PAD_SIDE / z),
                    "y": round(top + (box_h - h) / 2 - FreeCanvasImage.PAD_TOP / z),
                    "w": round(w), "h": round(h), "angle": 0, "printout": True, "z": self._next_z()}
            widget = FreeCanvasImage(self.vault.path(prel), item, self)
            self.canvas_fixed.put(widget, round(item["x"] * self.zoom), round(item["y"] * self.zoom))
            self.canvas_images.append(widget)
        self.ensure_page_height_for_images()
        self._update_pages()
        self.dirty = True
        self.save_note_meta()
        self._save_now()
        self.toast.add_toast(Adw.Toast(title=f"{len(pages)} page(s) inserted: draw on them with Draw", timeout=3))

    def take_note_screenshot(self):
        def done(path):
            if not path:
                return
            data = Path(path).read_bytes()
            Path(path).unlink(missing_ok=True)
            self._add_image_bytes(data, ".png", "Screenshot")
            self.present()
        self.set_visible(False)
        GLib.timeout_add(250, lambda: (take_screenshot(lambda p: (self.set_visible(True), done(p))), False)[1])

    def set_scope(self, scope, title):
        if scope[0] == "folder":
            folder = scope[1]
            if folder in self._locked_folders() and f"folder:{folder}" not in self._unlocked_items:
                def unlocked():
                    self._unlocked_items.add(f"folder:{folder}")
                    self.set_scope(scope, title)
                self._authenticate(f"Unlock Notebook “{folder}”", unlocked)
                return
        self.scope = scope
        self.scope_title.set_text(title)
        self.scope_title.set_tooltip_text(title)
        self.show_all_btn.set_visible(scope[0] != "all")
        self.refresh_lists()

    def refresh_lists(self):
        self._populate_notebooks_sidebar()
        notes = self._filtered_notes()
        pinned = self.vault.state["pinned"]
        notes.sort(key=lambda ns: (ns[0]["rel"] not in pinned, -ns[0]["mtime"]))

        while (r := self.list.get_row_at_index(0)) is not None:
            self.list.remove(r)
        self.rows = {}
        for note, _snip in notes:
            row = self._build_note_row(note)
            self.list.append(row)
            if note["rel"] == self.rel:
                self.list.select_row(row)
        self.count_label.set_text(f"{len(notes)} note{'s' if len(notes) != 1 else ''}")

    def _filtered_notes(self):
        q = self.search.get_text().strip()
        kind, val = self.scope
        q_norm = re.sub(r"#([a-zA-Z0-9_-]+)", r"tag:\1", q)
        if kind == "tag":
            q_norm = f"tag:{val} {q_norm}".strip()
        found = self.vault.search(q_norm) if q_norm else [(n, None) for n in self.vault.notes()]
        out = []
        for note, snip in found:
            rel = note["rel"]
            folder = note["folder"]
            if kind == "all" and not q and folder == "Daily":
                continue
            if kind == "pinned" and not self.vault.is_pinned(rel):
                continue
            if kind == "folder" and not (folder == val or folder.startswith(val + "/")):
                continue
            if kind == "daily" and folder != "Daily":
                continue
            out.append((note, snip))
        return out

    def _build_note_row(self, note):
        rel = note["rel"]
        locked = self._is_note_protected(rel)
        raw = "" if locked else self.vault.read(rel)
        preview = "🔒 Locked Note" if locked else clean_preview(raw)
        row = Gtk.ListBoxRow(activatable=True, tooltip_text=note["title"])
        row.rel = rel
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        top = Gtk.Box(spacing=6)

        folder = note["folder"]
        if folder and folder not in ("Daily", "Templates"):
            nb_col = self._get_nb_color(folder)
            idx = next((i for i, (_n, c) in enumerate(NOTEBOOK_COLORS) if c == nb_col), 0)
            top.append(Gtk.Box(css_classes=["mk-nb-dot", f"mk-nb-{idx}"], valign=Gtk.Align.CENTER))

        t_lbl = Gtk.Label(label=note["title"], xalign=0, hexpand=True,
                          ellipsize=Pango.EllipsizeMode.END, css_classes=["mk-row-title"])
        top.append(t_lbl)
        if rel in self._locked_notes() or (folder in self._locked_folders()):
            top.append(Gtk.Image(icon_name="changes-prevent-symbolic", opacity=0.75))
        if self.vault.is_pinned(rel):
            top.append(Gtk.Image(icon_name="view-pin-symbolic", opacity=0.65))
        vbox.append(top)

        nb_badge = f" · {folder}" if folder and self.scope[0] != "folder" else ""
        sub_lbl = Gtk.Label(label=f"{when_short(note['mtime'])}{nb_badge}  ·  {preview}",
                            xalign=0, ellipsize=Pango.EllipsizeMode.END, css_classes=["mk-row-meta"])
        vbox.append(sub_lbl)
        row.sub_lbl = sub_lbl
        row.set_child(vbox)

        rclick = Gtk.GestureClick(button=3)
        rclick.connect("pressed", lambda _g, _n, x, y, r=row: self._popup_note_menu(r, x, y))
        row.add_controller(rclick)
        self.rows[rel] = row
        return row

    def _populate_notebooks_sidebar(self):
        while (r := self.sidebar.get_row_at_index(0)) is not None:
            self.sidebar.remove(r)

        def section(title):
            r = Gtk.ListBoxRow(selectable=False, activatable=False)
            r.scope = None
            r.set_child(Gtk.Label(label=title, xalign=0, ellipsize=Pango.EllipsizeMode.END,
                                  css_classes=["mk-section-head"], margin_start=6))
            self.sidebar.append(r)

        def item(label, icon, scope, count=None, nb_folder=None):
            r = Gtk.ListBoxRow(activatable=True, tooltip_text=nb_folder or label)
            r.scope = scope
            box = Gtk.Box(spacing=8)
            if nb_folder:
                col = self._get_nb_color(nb_folder)
                idx = next((i for i, (_n, c) in enumerate(NOTEBOOK_COLORS) if c == col), 0)
                box.append(Gtk.Box(css_classes=["mk-nb-dot", f"mk-nb-{idx}"], valign=Gtk.Align.CENTER))
            else:
                box.append(Gtk.Image(icon_name=icon))
            lbl = Gtk.Label(label=label, xalign=0, hexpand=True,
                            ellipsize=Pango.EllipsizeMode.END, max_width_chars=16)
            box.append(lbl)
            if nb_folder and nb_folder in self._locked_folders():
                box.append(Gtk.Image(icon_name="changes-prevent-symbolic", opacity=0.75))
            if count is not None:
                box.append(Gtk.Label(label=str(count), css_classes=["dim-label"]))
            r.set_child(box)
            if nb_folder:
                rc = Gtk.GestureClick(button=3)
                rc.connect("pressed", lambda _g, _n, x, y, row=r, f=nb_folder: self._popup_notebook_menu(row, f, x, y))
                r.add_controller(rc)
            self.sidebar.append(r)

        all_n = self.vault.notes()
        main_cnt = sum(1 for n in all_n if n["folder"] != "Daily")
        daily_cnt = sum(1 for n in all_n if n["folder"] == "Daily")

        section("WORKSPACE")
        item("All Notes", "view-list-symbolic", ("all", None), count=main_cnt)
        item("Pinned Notes", "view-pin-symbolic", ("pinned", None), count=len(self.vault.state["pinned"]))
        item("Daily Journal", "x-office-calendar-symbolic", ("daily", None), count=daily_cnt)

        folders = [f for f in self.vault.folders() if f not in ("Daily", "Templates", ".ink", ".mknotes_v3")]
        section("NOTEBOOKS")
        for folder in folders:
            cnt = sum(1 for n in all_n if n["folder"] == folder or n["folder"].startswith(folder + "/"))
            item(folder.split("/")[-1], "folder-symbolic", ("folder", folder), count=cnt, nb_folder=folder)

        tags = self.vault.all_tags()
        if tags:
            section("TAGS")
            for tag, cnt in tags[:30]:
                item(f"#{tag}", "tag-symbolic", ("tag", tag), count=cnt)

    def _on_sidebar_row(self, _box, row):
        if not row or not getattr(row, "scope", None):
            return
        kind, val = row.scope
        titles = {"all": "All Notes", "pinned": "Pinned Notes", "daily": "Daily Journal"}
        t = titles.get(kind) or (f"#{val}" if kind == "tag" else f"📚 {val.split('/')[-1]}")
        self.set_scope(row.scope, t)

    def _popup_notebook_menu(self, row, folder, x, y):
        menu = Gio.Menu()
        is_locked = folder in self._locked_folders()
        menu.append("🔓 Unlock Notebook" if is_locked else "🔒 Lock Entire Notebook", f"win.nb-lock::{folder}")
        c_menu = Gio.Menu()
        for name, hex_c in NOTEBOOK_COLORS:
            c_menu.append(name, f"win.nb-color::{folder}|{hex_c}")
        menu.append_submenu("🎨 Change Notebook Color", c_menu)

        if not self.lookup_action("nb-lock"):
            a_lock = Gio.SimpleAction.new("nb-lock", GLib.VariantType("s"))
            a_lock.connect("activate", lambda _a, p: self._toggle_folder_lock(p.get_string()))
            self.add_action(a_lock)
        if not self.lookup_action("nb-color"):
            a_col = Gio.SimpleAction.new("nb-color", GLib.VariantType("s"))
            a_col.connect("activate", lambda _a, p: self._set_notebook_color(*p.get_string().split("|", 1)))
            self.add_action(a_col)

        pop = Gtk.PopoverMenu.new_from_model(menu)
        pop.set_parent(row)
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = int(x), int(y), 1, 1
        pop.set_pointing_to(rect)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        pop.popup()

    def _set_notebook_color(self, folder, hex_c):
        self._nb_colors()[folder] = hex_c
        self.vault.save_state()
        self.refresh_lists()

    def _toggle_folder_lock(self, folder):
        lf = self.vault.state.setdefault("locked_folders", [])
        if folder in lf:
            def do_unlock():
                lf.remove(folder)
                self._unlocked_items.discard(f"folder:{folder}")
                self.vault.save_state()
                self.refresh_lists()
                self.toast.add_toast(Adw.Toast(title=f"Notebook “{folder}” unlocked", timeout=2))
            self._authenticate(f"Remove Lock from Notebook “{folder}”", do_unlock)
        else:
            def do_lock():
                if folder not in lf:
                    lf.append(folder)
                self._unlocked_items.discard(f"folder:{folder}")
                self.vault.save_state()
                self.refresh_lists()
                self.toast.add_toast(Adw.Toast(title=f"Notebook “{folder}” locked 🔒", timeout=2))
                if self.rel and Path(self.rel).parent.as_posix() == folder:
                    self.open_note(self._first_note(), record_history=False)
            if nv.load_conf().get("NOTE_LOCK_HASH", ""):
                do_lock()
            else:  # the first lock sets up the PIN
                self._authenticate(f"Lock Entire Notebook “{folder}”", do_lock)

    def _popup_note_menu(self, row, x, y):
        rel = row.rel
        menu = Gio.Menu()
        menu.append("Unpin" if self.vault.is_pinned(rel) else "Pin to Top", f"win.row-pin::{rel}")
        if rel in self._locked_notes():
            if rel in self._unlocked_items:
                menu.append("Lock Now 🔒", f"win.row-relock::{rel}")
            menu.append("Remove Lock Permanently", f"win.row-lock::{rel}")
        else:
            menu.append("Lock Note 🔒", f"win.row-lock::{rel}")
        move = Gio.Menu()
        move.append("Main Workspace", f"win.row-move::{rel}|")
        for f in self.vault.folders():
            if f not in ("Daily", "Templates", ".ink", ".mknotes_v3"):
                move.append(f"📚 {f}", f"win.row-move::{rel}|{f}")
        menu.append_submenu("Move to Notebook", move)
        menu.append("Export to PDF / DOCX", f"win.row-exp::{rel}")
        menu.append("Delete Note…", f"win.row-del::{rel}")

        for name, cb in (
            ("row-pin", lambda r: (self.vault.set_pinned(r, not self.vault.is_pinned(r)), self.refresh_lists())),
            ("row-lock", self._toggle_specific_note_lock),
            ("row-relock", self.relock_note),
            ("row-move", self._move_note_to_folder),
            ("row-exp", lambda r: (self.open_note(r), self.quick_export())),
            ("row-del", self.confirm_delete_note),
        ):
            if not self.lookup_action(name):
                act = Gio.SimpleAction.new(name, GLib.VariantType("s"))
                act.connect("activate", lambda _a, p, fn=cb: fn(p.get_string()))
                self.add_action(act)

        pop = Gtk.PopoverMenu.new_from_model(menu)
        pop.set_parent(row)
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = int(x), int(y), 1, 1
        pop.set_pointing_to(rect)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        pop.popup()

    def _move_note_to_folder(self, val):
        rel, folder = val.split("|", 1)
        self._save_now()
        old_m = self._meta_file(rel)
        new_rel = self.vault.rename(rel, new_folder=folder)
        new_m = self._meta_file(new_rel)
        if old_m and old_m.is_file() and new_m:
            old_m.rename(new_m)
        if rel == self.rel:
            self.rel = new_rel
        self.refresh_lists()

    def new_note(self, title="Untitled Note"):
        self._save_now()
        folder = self.scope[1] if self.scope[0] == "folder" else ""
        rel = self.vault.create(folder, title, "")
        self.refresh_lists()
        self.open_note(rel)
        self.title_entry.grab_focus()
        self.title_entry.select_region(0, -1)

    def new_notebook_dialog(self):
        dlg = Adw.AlertDialog(heading="New Notebook", body="Choose a name and color for your Notebook:")
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        entry = Gtk.Entry(placeholder_text="Notebook Name (e.g. College, Projects, Personal)", activates_default=True)
        vbox.append(entry)

        chosen_color = [NOTEBOOK_COLORS[0][1]]
        c_row = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        sw_list = []
        for idx, (cname, chex) in enumerate(NOTEBOOK_COLORS):
            b = Gtk.Button(css_classes=["mk-swatch", f"mk-nb-{idx}"], tooltip_text=cname)
            if idx == 0:
                b.add_css_class("active")
            sw_list.append((b, chex))

            def pick(_btn, c=chex, button=b):
                chosen_color[0] = c
                for sb, _sc in sw_list:
                    (sb.add_css_class if sb is button else sb.remove_css_class)("active")

            b.connect("clicked", pick)
            c_row.append(b)
        vbox.append(c_row)
        dlg.set_extra_child(vbox)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("create", "Create Notebook")
        dlg.set_default_response("create")
        dlg.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)

        def done(_d, res):
            name = entry.get_text().strip()
            if res == "create" and name:
                folder = self.vault.create_folder(name, "")
                self._nb_colors()[folder] = chosen_color[0]
                self.vault.save_state()
                self.set_scope(("folder", folder), f"📚 {folder}")

        dlg.connect("response", done)
        dlg.present(self)

    def prompt_link_note(self):
        items = [(n["title"], f"📚 {n['folder'] or 'Notes'}", Path(n["rel"]).stem)
                 for n in self.vault.notes() if n["rel"] != self.rel and n["folder"] != "Daily"]

        def add_link(stem):
            if not hasattr(self, "note_links"):
                self.note_links = []
            if stem not in self.note_links:
                self.note_links.append(stem)
            self.dirty = True
            self._save_now()
            self._refresh_header_pills()
            self.toast.add_toast(Adw.Toast(title=f"Connected to “{stem}”", timeout=2))

        def create_and_link(name):
            new_rel = self.vault.create("", name, "")
            self.refresh_lists()
            add_link(Path(new_rel).stem)

        SimpleNotePicker(
            "Connect / Link a Note",
            "Pick any note below to add a 1-click connection pill under your note title:",
            items,
            add_link,
            on_create=create_and_link,
        ).present(self)

    def _remove_link(self, target):
        if target in getattr(self, "note_links", []):
            self.note_links.remove(target)
            self.dirty = True
            self._save_now()
            self._refresh_header_pills()

    def prompt_add_tag(self):
        dlg = Adw.AlertDialog(heading="Add Tag", body="Type a tag name to group related notes:")
        entry = Gtk.Entry(placeholder_text="e.g. important, exam, ideas", activates_default=True)
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("add", "Add Tag")
        dlg.set_default_response("add")
        dlg.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)

        def done(_d, res):
            t = re.sub(r"[^a-zA-Z0-9_-]", "", entry.get_text().strip().lstrip("#"))
            if res == "add" and t:
                if not hasattr(self, "note_tags"):
                    self.note_tags = []
                if t not in self.note_tags:
                    self.note_tags.append(t)
                self.dirty = True
                self._save_now()
                self.refresh_lists()
                self._refresh_header_pills()

        dlg.connect("response", done)
        dlg.present(self)
        GLib.idle_add(lambda: entry.grab_focus() and False)

    def _remove_tag(self, tag):
        if tag in getattr(self, "note_tags", []):
            self.note_tags.remove(tag)
            self.dirty = True
            self._save_now()
            self.refresh_lists()
            self._refresh_header_pills()

    def show_mind_map(self):
        self._save_now()
        VisualMindMapWindow(self, self.vault, self._nb_colors(), self.rel or "",
                            self.open_note, self.prompt_link_note).present()

    def _toggle_specific_note_lock(self, rel):
        locked = self.vault.state.setdefault("locked", [])
        if rel in locked:
            def do_unlock():
                locked.remove(rel)
                self.vault.save_state()
                self.refresh_lists()
                self.toast.add_toast(Adw.Toast(title="Note unlocked 🔓", timeout=2))
            self._authenticate(f"Unlock Note “{Path(rel).stem}”", do_unlock)
        else:
            def do_lock():
                if rel not in locked:
                    locked.append(rel)
                self._unlocked_items.discard(rel)  # locked now, not after the next restart
                self.vault.save_state()
                self.refresh_lists()
                self.toast.add_toast(Adw.Toast(title="Note locked 🔒", timeout=2))
                if self.rel == rel:  # don't leave it on screen
                    self.open_note(self._first_note(), record_history=False)
            # Locking asks nothing; only the very first lock sets up the PIN.
            if nv.load_conf().get("NOTE_LOCK_HASH", ""):
                do_lock()
            else:
                self._authenticate(f"Lock Note “{Path(rel).stem}”", do_lock)

    def relock_note(self, rel=None):
        """Close what was unlocked: the note (or all of them) asks again."""
        if rel:
            self._unlocked_items.discard(rel)
        else:
            self._unlocked_items.clear()
        # Note or notebook lock alike: if what's on screen is protected again,
        # save it, blank the page (detached from the note, so the blank can't
        # be saved over it), then show a note that isn't locked.
        if self.rel and self._is_note_protected(self.rel):
            self._save_now()
            self.loading = True
            self.rel = None
            self.buffer.set_text("")
            self.loading = False
            self.dirty = False
            self.open_note(self._first_note(), record_history=False)
        self.refresh_lists()
        self._sync_padlock()

    def _note_activity(self, *_):
        self._last_activity = time.monotonic()

    def _autolock_tick(self):
        """Unlocked notes lock again after a minute without typing or the pointer."""
        if self._unlocked_items and time.monotonic() - getattr(self, "_last_activity", time.monotonic()) > AUTOLOCK_S:
            self.relock_note()
            self.toast.add_toast(Adw.Toast(title="Locked again after a minute away 🔒", timeout=3))
        return GLib.SOURCE_CONTINUE

    def _toggle_current_note_lock(self):
        if self.rel:
            self._toggle_specific_note_lock(self.rel)

    def _toggle_current_nb_lock(self):
        folder = self.scope[1] if self.scope[0] == "folder" else (Path(self.rel).parent.as_posix() if self.rel else ".")
        if not folder or folder == ".":
            self.toast.add_toast(Adw.Toast(title="Select or move this note into a Notebook first to lock a Notebook!", timeout=3))
            return
        self._toggle_folder_lock(folder)

    def _change_pin_dialog(self):
        if nv.load_conf().get("NOTE_LOCK_HASH", ""):
            # The current PIN (or fingerprint) first: else anyone at the window could reset it.
            self._authenticate("Confirm it's you", self._new_pin_dialog)
        else:
            self._new_pin_dialog()

    def _new_pin_dialog(self):
        dlg = Adw.AlertDialog(heading="Set New Lock PIN", body="Enter a new PIN (4+ characters) for your locked Notebooks and Notes:")
        entry = Gtk.PasswordEntry(placeholder_text="New PIN…", show_peek_icon=True)
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("save", "Save PIN")
        dlg.set_default_response("save")
        dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def save_it(*_):
            val = entry.get_text().strip()
            if len(val) >= 4:
                conf_set("NOTE_LOCK_HASH", auth.hash_pin(val))
                dlg.close()
                self.toast.add_toast(Adw.Toast(title="Lock PIN updated ✓", timeout=2))

        entry.connect("activate", save_it)
        dlg.connect("response", lambda _d, r: r == "save" and save_it())
        dlg.present(self)
        GLib.idle_add(lambda: entry.grab_focus() and False)  # once: True would repeat it forever

    def _on_pin_toggled(self, btn):
        if getattr(self, "_quiet_pin", False) or not self.rel:
            return
        self.vault.set_pinned(self.rel, btn.get_active())
        self.refresh_lists()

    def _go_back(self):
        while self.nav_history:
            prev = self.nav_history.pop()
            if prev != self.rel and self.vault.path(prev).exists():
                self.back_btn.set_visible(bool(self.nav_history))
                self.open_note(prev, record_history=False)
                return
        self.back_btn.set_visible(False)

    def confirm_delete_note(self, target_rel=None):
        rel = target_rel or self.rel
        if not rel:
            return
        stem = Path(rel).stem
        dlg = Adw.AlertDialog(
            heading=f"Delete “{stem}”?",
            body=f"Are you sure you want to delete “{stem}”? You can still undo immediately after.",
        )
        dlg.add_response("no", "No, Keep It")
        dlg.add_response("yes", "Yes, Delete")
        dlg.set_default_response("no")
        dlg.set_response_appearance("yes", Adw.ResponseAppearance.DESTRUCTIVE)

        def on_resp(_d, res):
            if res == "yes":
                self._execute_delete(rel)

        dlg.connect("response", on_resp)
        dlg.present(self)

    def _execute_delete(self, rel):
        """Delete REL for good: nothing pending may write it back. Pending
        saves are cancelled and, for the open note, the page and its tables,
        pictures and stickies are cleared before the file goes."""
        if rel == self.rel:
            for attr in ("save_id", "_meta_id", "_pages_id"):
                if getattr(self, attr, 0):
                    GLib.source_remove(getattr(self, attr))
                    setattr(self, attr, 0)
            self.loading = True
            self.rel = None
            self.dirty = False
            self.buffer.set_text("")
            self._clear_tables()
            self._rebuild_canvas_objects([], [], [])
            self.ink_canvas.strokes = []
            self.comments = []
            self.loading = False
        else:
            self._save_now()
        self.vault.delete(rel)
        meta = self._meta_file(rel)
        if meta and meta.is_file():
            meta.unlink()
        if self.rel is None:
            self.open_note(self._first_note(), record_history=False)
        self.nav_history = [r for r in getattr(self, "nav_history", []) if r != rel]
        self.refresh_lists()
        self.toast.add_toast(Adw.Toast(title=f"Deleted “{Path(rel).stem}”", timeout=3))

    def _mark_calendar(self):
        self.calendar.clear_marks()
        d = self.calendar.get_date()
        for day in range(1, 32):
            try:
                rel = f"Daily/{d.get_year():04d}-{d.get_month():02d}-{day:02d}.md"
            except ValueError:
                continue
            if self.vault.path(rel).exists():
                self.calendar.mark_day(day)

    def _on_cal_preview(self, cal):
        d = cal.get_date()
        rel = f"Daily/{d.get_year():04d}-{d.get_month():02d}-{d.get_day_of_month():02d}.md"
        if self.vault.path(rel).exists():
            self.cal_status.set_text(f"📓 Entry exists: {clean_preview(self.vault.read(rel))}")
        else:
            self.cal_status.set_text(f"No entry for {d.get_year():04d}-{d.get_month():02d}-{d.get_day_of_month():02d} yet.")

    def _open_cal_date(self):
        d = self.calendar.get_date()
        dt = datetime(d.get_year(), d.get_month(), d.get_day_of_month())
        rel = self.vault.daily(dt)
        self.cal_pop.popdown()
        self.refresh_lists()
        self.open_note(rel)

    def _export_lines(self):
        """The note as (Pango markup, kind) per line, read from the buffer's
        tags. Main thread only: GTK widgets aren't thread-safe."""
        styles = {"bold": 'weight="bold"', "italic": 'style="italic"', "underline": 'underline="single"',
                  "strike": 'strikethrough="true"',
                  **{t: f'bgcolor="{c}" bgalpha="60%"' for t, _n, c in HIGHLIGHTS}}
        out = []
        for n in range(self.buffer.get_line_count()):
            _ok, it = self.buffer.get_iter_at_line(n)
            end = it.copy()
            if not end.ends_line():
                end.forward_to_line_end()
            names = {t.props.name for t in it.get_tags()}
            kind = next((k for k in ("title", "h1", "h2", "h3") if k in names), "body")
            parts = []
            while it.compare(end) < 0:
                nxt = it.copy()
                if not nxt.forward_to_tag_toggle(None) or nxt.compare(end) > 0:
                    nxt = end.copy()
                text = GLib.markup_escape_text(self.buffer.get_text(it, nxt, False))
                attrs = []
                for t in it.get_tags():
                    name = t.props.name or ""
                    if name in styles:
                        attrs.append(styles[name])
                    elif re.fullmatch(r"fg-[0-9a-f]{6}", name):
                        attrs.append(f'foreground="#{name[3:]}"')
                parts.append(f"<span {' '.join(attrs)}>{text}</span>" if attrs else text)
                it = nxt
            out.append(("".join(parts), kind))
        return out

    def _export_job(self, out_path, fmt):
        """Collect everything on the main thread; the returned function writes
        the file and may run on a worker thread."""
        title = Path(self.rel).stem
        imgs = [dict(w.data) for w in self.canvas_images]
        resolve = self._resolve_attachment
        if fmt == "docx":
            body = self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False)
            md_lines = [body] + [t.to_markdown() for t in self._live_tables()] + [f"![[{it['name']}]]" for it in imgs]

            def write_docx():
                from mkworkstation import docx
                docx.write("\n\n".join(md_lines), str(out_path), resolve, title=title)
            return write_docx
        try:
            edited = datetime.fromtimestamp(self.vault.path(self.rel).stat().st_mtime).strftime("%d %b %Y, %H:%M")
        except OSError:
            edited = "?"
        meta = f"Last edited {edited} · Exported {datetime.now().strftime('%d %b %Y, %H:%M')}"
        tags = getattr(self, "note_tags", [])
        if tags:
            meta += " · " + " ".join(f"#{t}" for t in tags)
        lines = self._export_lines()
        stickies = [dict(st.data) for st in self.sticky_notes]
        tables = [dict(t.data) for t in self._live_tables()]
        pads = [dict(p.data) for p in self.pinned_stickies] if self.export_pads.get_active() else []
        return lambda: export_pdf_direct(title, meta, lines, imgs, out_path, resolve, stickies, tables, pads)

    def _do_export(self, out_path, fmt):
        self._export_job(out_path, fmt)()

    def quick_export(self):
        if not self.rel:
            return
        self._save_now()
        fmt = "docx" if self.fmt_drop.get_selected() == 1 else "pdf"
        sub = "PDFs" if fmt == "pdf" else "DOCXs"
        docs = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or Path.home() / "Documents") / "Notes" / sub
        docs.mkdir(parents=True, exist_ok=True)
        title_stem = re.sub(r'[^\w\- ]', '_', Path(self.rel).stem).strip() or "Untitled"
        out_path = docs / f"{title_stem}.{fmt}"  # one file per note, refreshed by each export

        if not self.lookup_action("open-last-export"):
            act = Gio.SimpleAction.new("open-last-export", None)
            act.connect("activate", lambda *_: Gio.AppInfo.launch_default_for_uri(self._last_export_uri, None))
            self.add_action(act)

        job = self._export_job(out_path, fmt)

        def work():
            try:
                job()
                GLib.idle_add(done, None)
            except Exception as e:
                GLib.idle_add(done, str(e))

        def done(err):
            if err:
                self.toast.add_toast(Adw.Toast(title=f"Export failed: {err}", timeout=4))
                return
            self._last_export_uri = out_path.as_uri()
            self.toast.add_toast(Adw.Toast(
                title=f"Saved {out_path.name} → ~/Documents/Notes/{sub}",
                button_label="Open",
                action_name="win.open-last-export",
                timeout=5,
            ))

        threading.Thread(target=work, daemon=True).start()

    def export_as_dialog(self):
        if not self.rel:
            return
        self._save_now()
        fmt = "docx" if self.fmt_drop.get_selected() == 1 else "pdf"
        dlg = Gtk.FileDialog(title=f"Save as {fmt.upper()}", initial_name=f"{Path(self.rel).stem}.{fmt}")
        docs = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or Path.home() / "Documents") / "Notes"
        docs.mkdir(parents=True, exist_ok=True)
        dlg.set_initial_folder(Gio.File.new_for_path(str(docs)))

        def chosen(d, res):
            try:
                target = d.save_finish(res)
            except GLib.Error:
                return
            out = Path(target.get_path())
            self._do_export(out, fmt)
            self._last_export_uri = out.as_uri()
            self.toast.add_toast(Adw.Toast(title=f"Saved {out.name}", timeout=4))
        dlg.save(self, None, chosen)

    def show_history(self):
        if not self.rel:
            return
        self._save_now()
        versions = self.vault.history(self.rel)
        dlg = Adw.Dialog(title=f"Version History · {Path(self.rel).stem}", content_width=820, content_height=560)
        view = Adw.ToolbarView()
        head = Adw.HeaderBar()
        restore = Gtk.Button(label="Restore Version", css_classes=["suggested-action"], sensitive=False)
        head.pack_end(restore)
        view.add_top_bar(head)
        lbox = Gtk.ListBox(css_classes=["navigation-sidebar"])
        preview = Gtk.TextView(editable=False, wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=16, right_margin=16, top_margin=12)
        for stamp, path in versions:
            r = Adw.ActionRow(title=stamp.strftime("%d %b %Y, %H:%M"), activatable=True)
            r.path = path
            lbox.append(r)
        if not versions:
            lbox.set_placeholder(Gtk.Label(label="No earlier versions yet.", css_classes=["dim-label"], margin_top=30))

        def on_sel(_l, row):
            restore.set_sensitive(row is not None)
            if row:
                txt, *_ = self._import_markdown_to_clean_doc(row.path.read_text(encoding="utf-8", errors="replace"))
                preview.get_buffer().set_text(txt)
        lbox.connect("row-selected", on_sel)

        def do_rest(*_):
            row = lbox.get_selected_row()
            if row:
                txt, *_ = self._import_markdown_to_clean_doc(row.path.read_text(encoding="utf-8", errors="replace"))
                self.buffer.set_text(txt)
                self.dirty = True
                self._save_now()
                dlg.close()
                self.toast.add_toast(Adw.Toast(title="Version restored", timeout=3))
        restore.connect("clicked", do_rest)
        view.set_content(Gtk.Paned(start_child=Gtk.ScrolledWindow(child=lbox, width_request=220),
                                   end_child=Gtk.ScrolledWindow(child=preview), position=230))
        dlg.set_child(view)
        dlg.present(self)

    def insert_starter_template(self):
        items = [
            ("Meeting Notes", "Date, Attendees, Key Points & Action Items",
             "Attendees:\n• \n\nDiscussion Points:\n• \n\nAction Items:\n☐ "),
            ("Lecture / Study Note", "Key Concepts, Summary & Review Questions",
             "Core Concepts:\n• \n\nDetailed Notes:\n\nReview Checklist:\n☐ "),
            ("Project Plan", "Goal, Milestones & Tasks",
             "Project Goal:\n\nMilestones:\n1. \n2. \n\nTasks:\n☐ "),
        ]
        SimpleNotePicker(
            "Insert Starter Template",
            "Pick a clean layout to insert into your current note:",
            items,
            lambda tpl: (self.buffer.insert_at_cursor("\n" + tpl + "\n"), setattr(self, "dirty", True), self._save_now()),
        ).present(self)

    def set_sync(self, on):
        conf_set("SYNC", "on" if on else "off")
        if on and not self.server:
            port = nv.load_conf().get("SYNC_PORT", "8765")
            self.server = notes_sync.Server(self.vault, port, on_change=lambda r: GLib.idle_add(self.refresh_lists))
            try:
                self.server.start()
            except OSError:
                self.server = None
                return
        elif not on and self.server:
            self.server.stop()
            self.server = None
        self.sync_label.set_text(f"📱 Phone Sync Active\n{self.server.url}" if self.server else "")

    def show_phone_dialog(self):
        dlg = Adw.Dialog(title="Phone Wi-Fi Sync", content_width=460, content_height=280)
        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup(title="Sync Notes Over Wi-Fi")
        sw = Adw.SwitchRow(title="Enable Phone Sync", subtitle="Sync notes with your phone browser on the same Wi-Fi",
                           active=self.server is not None)
        url_row = Adw.ActionRow(title="Phone Address", subtitle=self.server.pairing_url() if self.server else "Turn on sync above")
        sw.connect("notify::active", lambda s, _p: (
            self.set_sync(s.get_active()),
            url_row.set_subtitle(self.server.pairing_url() if self.server else "Off"),
        ))
        grp.add(sw)
        grp.add(url_row)
        page.add(grp)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        dlg.set_child(view)
        dlg.present(self)

    def _setup_actions(self):
        acts = (
            ("new", self.new_note, ["<Control>n"]),
            ("new-nb", self.new_notebook_dialog, ["<Control><Shift>n"]),
            ("bold", lambda: self.toggle_shortcut_format("bold"), ["<Control>b"]),
            ("italic", lambda: self.toggle_shortcut_format("italic"), ["<Control>i"]),
            ("underline", lambda: self.toggle_shortcut_format("underline"), ["<Control>u"]),
            ("checklist", lambda: self.toggle_line_prefix("☐ "), ["<Control>l"]),
            ("draw", lambda: self.draw_toggle.set_active(not self.draw_toggle.get_active()), ["<Control><Shift>p"]),
            ("comment", self.prompt_add_comment, ["<Control><Alt>m"]),
            ("link", self.prompt_link_note, ["<Control>k"]),
            ("graph", self.show_mind_map, ["<Control>g"]),
            ("pdf", self.quick_export, ["<Control><Shift>e"]),
            ("export-as", self.export_as_dialog, []),
            ("history", self.show_history, []),
            ("template", self.insert_starter_template, ["<Control>t"]),
            ("phone", self.show_phone_dialog, []),
            ("open-folder", lambda: Gio.AppInfo.launch_default_for_uri(self.vault.root.as_uri(), None), []),
            ("delete", lambda: self.confirm_delete_note(self.rel), []),
            ("toggle-list", lambda: self.list_toggle.set_active(not self.list_toggle.get_active()), ["F8"]),
            ("toggle-nb", lambda: self.nb_toggle.set_active(not self.nb_toggle.get_active()), ["F9"]),
            ("fullscreen", self.toggle_fullscreen, ["F11"]),
            ("focus-canvas", self.toggle_focus_canvas, ["<Control><Shift>f"]),
            ("zoom-in", lambda: self.set_zoom(self.zoom + 0.1), ["<Control>plus", "<Control>equal"]),
            ("zoom-out", lambda: self.set_zoom(self.zoom - 0.1), ["<Control>minus"]),
            ("zoom-reset", lambda: self.set_zoom(1.0), ["<Control>0"]),
            ("back", self._go_back, ["<Alt>Left"]),
            ("shortcuts", self.show_shortcuts, ["<Control>question"]),
        )
        app = self.get_application()
        for name, cb, accels in acts:
            a = Gio.SimpleAction.new(name, None)
            a.connect("activate", lambda *_a, fn=cb: fn())
            self.add_action(a)
            if accels:
                app.set_accels_for_action(f"win.{name}", accels)
        self._shortcut_list = [(n.replace("-", " ").title(), ", ".join(ac)) for n, _c, ac in acts if ac]

    def toggle_fullscreen(self):
        if self.is_fullscreen():
            self.unfullscreen()
        else:
            self.fullscreen()

    def show_shortcuts(self):
        txt = "\n".join(f"{k:<20} {lbl}" for lbl, k in self._shortcut_list)
        dlg = Adw.AlertDialog(heading="Keyboard Shortcuts")
        dlg.set_extra_child(Gtk.Label(label=txt, xalign=0, css_classes=["monospace"]))
        dlg.add_response("ok", "OK")
        dlg.present(self)

    def _on_close(self, *_):
        self._save_now()
        self._commit_title()
        if self.rel:
            scrolls = self.vault.state.setdefault("scroll", {})
            scrolls[self.rel] = round(self.page_scroll.get_vadjustment().get_value())
            if len(scrolls) > 50:  # remember the 50 most recent notes
                for old in list(scrolls)[:-50]:
                    scrolls.pop(old)
        self.vault.state["sidebar"] = self.nb_toggle.get_active()
        self.vault.save_state()
        if self.server:
            self.server.stop()
        return False


class NotesApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        prov = Gtk.CssProvider()
        prov.load_from_string(BASE_CSS)
        disp = Gdk.Display.get_default()
        if disp:
            Gtk.StyleContext.add_provider_for_display(
                disp, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        if self.window is None:
            self.window = NotesWindow(self)
        if args:
            if args[0] == "--daily":
                self.window.open_note(self.window.vault.daily())
                self.window.refresh_lists()
            else:
                name = " ".join(args)
                rel = self.window.vault.resolve(name) or self.window.vault.create("", name)
                self.window.refresh_lists()
                self.window.open_note(rel)
        self.window.present()
        return 0


def main():
    if "--serve" in sys.argv[1:]:
        notes_sync.serve_forever()
        return 0
    return NotesApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
