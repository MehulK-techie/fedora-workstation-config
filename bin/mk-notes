        self.side_toggle = Gtk.ToggleButton(icon_name="sidebar-show-symbolic", active=True,
                                            tooltip_text="Folders and tags (F9)")
        list_head.pack_start(self.side_toggle)
        new_btn = Gtk.Button(icon_name="document-new-symbolic", tooltip_text="New note (Ctrl+N)")
        new_btn.connect("clicked", lambda *_: self.new_note())
        list_head.pack_end(new_btn)
        self.list_title = Adw.WindowTitle(title="All notes")
        list_head.set_title_widget(self.list_title)
        list_box.append(list_head)
        self.search = Gtk.SearchEntry(placeholder_text="Search (tag:x  path:y)", margin_start=8,
                                      margin_end=8, margin_bottom=6)
        self.search.connect("search-changed", lambda *_: self.refresh())
        list_box.append(self.search)
        self.list = Gtk.ListBox(css_classes=["mk-list"])
        self.list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.list.connect("row-activated", lambda _l, row: self.open_note(row.rel))
        self.list.set_placeholder(Gtk.Label(label="No notes here", css_classes=["dim-label"], margin_top=40))
        list_box.append(Gtk.ScrolledWindow(child=self.list, vexpand=True))
        self.count_label = Gtk.Label(css_classes=["mk-status"], margin_bottom=8)
        list_box.append(self.count_label)

        # Note: title, format bar, editor / reader, info pane
        note_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        note_head = Adw.HeaderBar(show_start_title_buttons=False, title_widget=Gtk.Label())
        self.mode = Adw.ToggleGroup()
