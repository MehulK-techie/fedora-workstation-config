#!/usr/bin/env python3
"""Reminder checker for Companion notes and tasks.

  mk-reminders                 fire every reminder that's due (run each minute
                               by the mk-reminders.timer user unit)
  mk-reminders snooze ID SECS  remind about item ID again in SECS seconds
"""
import os
import sys
from pathlib import Path


def _add_lib_path():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for candidate in (Path(__file__).resolve().parent.parent / "lib",
                      Path(data_home) / "mk-workstation/lib"):
        if (candidate / "mkworkstation").is_dir():
            sys.path.insert(0, str(candidate))
            return


_add_lib_path()
from mkworkstation import companion  # noqa: E402

if __name__ == "__main__":
    args = sys.argv[1:]
    if not args:
        companion.check()
    elif args[0] == "snooze" and len(args) == 3 and args[2].isdigit():
        companion.snooze(args[1], int(args[2]))
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
