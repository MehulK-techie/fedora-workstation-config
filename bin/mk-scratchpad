#!/usr/bin/env bash
set -euo pipefail

NOTES_FILE="$HOME/.mk_scratchpad.md"
[ -f "$NOTES_FILE" ] || printf "# ⚡ MK Workspace Scratchpad\n\n## 📝 Quick Notes\n- \n\n## ✅ To-Do Tasks\n- [ ] Task 1\n- [ ] Task 2\n" > "$NOTES_FILE"

ACTION=$(zenity --list --title="⚡ MK Workspace Companion" \
  --width=540 --height=380 \
  --column="Tool" --column="Description" \
  "Scratchpad" "Open Markdown Notes & To-Do List" \
  "Timer"      "Set Quick Focus / Break Reminder" \
  "View Tasks" "Quick Peek at Active To-Dos" \
  2>/dev/null || true)

case "$ACTION" in
  "Scratchpad")
    zenity --text-info --title="MK Quick Scratchpad & To-Do" --filename="$NOTES_FILE" --editable --width=600 --height=450 2>/dev/null > "${NOTES_FILE}.tmp"
    if [ -s "${NOTES_FILE}.tmp" ]; then
      mv "${NOTES_FILE}.tmp" "$NOTES_FILE"
      notify-send -t 2000 "MK Workspace" "Notes and tasks saved successfully."
    fi
    rm -f "${NOTES_FILE}.tmp"
    ;;
  "Timer")
    MINS=$(zenity --entry --title="Focus Timer" --text="Remind me in (minutes):" --entry-text="25" 2>/dev/null || echo "")
    if [[ -n "$MINS" && "$MINS" =~ ^[0-9]+$ ]]; then
      MSG=$(zenity --entry --title="Reminder Label" --text="What are you working on?" --entry-text="Coding / Debugging / Reading" 2>/dev/null || echo "Focus session complete!")
      (
        sleep $((MINS * 60))
        notify-send -u critical -t 12000 "⏰ Focus Timer Expired ($MINS min)" "$MSG"
        canberra-gtk-play -i complete-media-burn 2>/dev/null || true
      ) &
      notify-send -t 2500 "Timer Started" "Countdown active for $MINS minutes."
    fi
    ;;
  "View Tasks")
    TASKS=$(grep -E '^\s*- \[[ x]\]' "$NOTES_FILE" 2>/dev/null || echo "No tasks found.")
    zenity --info --title="Active To-Do Checklist" --text="$TASKS" --width=400 --height=300 2>/dev/null || true
    ;;
esac
