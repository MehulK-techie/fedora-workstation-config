#!/usr/bin/env bash
set -euo pipefail

NOTES_FILE="$HOME/.mk_scratchpad.txt"
[ -f "$NOTES_FILE" ] || echo -e "# MK Workspace Scratchpad\n- [ ] Priority 1\n- [ ] Priority 2" > "$NOTES_FILE"

ACTION=$(zenity --list --title="⚡ MK Companion" \
  --width=420 --height=280 \
  --column="Mode" --column="Description" \
  "Notes" "Open Scratchpad" \
  "Timer" "Set Reminder Countdown" 2>/dev/null || true)

case "$ACTION" in
  "Notes")
    zenity --text-info --title="Quick Notes" --filename="$NOTES_FILE" --editable --width=520 --height=380 2>/dev/null > "${NOTES_FILE}.tmp"
    if [ -s "${NOTES_FILE}.tmp" ]; then
      mv "${NOTES_FILE}.tmp" "$NOTES_FILE"
      notify-send -t 1500 "Notes Saved" "Updated successfully."
    fi
    rm -f "${NOTES_FILE}.tmp"
    ;;
  "Timer")
    MINS=$(zenity --entry --title="Timer" --text="Remind me in (minutes):" --entry-text="25" 2>/dev/null || echo "")
    if [[ -n "$MINS" && "$MINS" =~ ^[0-9]+$ ]]; then
      MSG=$(zenity --entry --title="Label" --text="Reminder label:" --entry-text="Break / Standup" 2>/dev/null || echo "Timer Done!")
      (
        sleep $((MINS * 60))
        notify-send -u critical -t 10000 "⏰ Timer: $MSG" "Completed $MINS min session."
        canberra-gtk-play -i complete-media-burn 2>/dev/null || true
      ) &
      notify-send -t 2000 "Timer Started" "Alerting in $MINS minutes."
    fi
    ;;
esac
