#!/usr/bin/env python3
"""MK screensaver: a full-screen scene when you step away from the computer.

  mk-screensaver               start watching (login does this): shows a scene
                               after DELAY seconds without input
  mk-screensaver show [SCENE]  show one now (aurora, web, knight, matrix, random)
  mk-screensaver settings      pick a scene from previews, or shuffle; on/off; delay
  mk-screensaver list          the scenes

Settings: config/screensaver.conf, yours in ~/.config/mk-workstation/screensaver.conf
(SCREENSAVER=on|off, DELAY=seconds, SCENE=random|aurora|web|knight|matrix).
GNOME still blanks and locks the screen at its own time (Settings › Power
and Privacy): the scene plays before that. It stays away while a video, a call
or Caffeine keeps the screen awake, and while the focus timer runs (it has
its own). The first touch of the mouse, touchpad or keyboard ends it.
"""
import json
import os
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_foreign("cairo")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402


def _add_lib_path():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for candidate in (Path(__file__).resolve().parent.parent / "lib",
                      Path(data_home) / "mk-workstation/lib"):
        if (candidate / "mkworkstation").is_dir():
            sys.path.insert(0, str(candidate))
            return


_add_lib_path()
from mkworkstation import scenes  # noqa: E402

APP_ID = "io.github.mehulk.MkScreensaver"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "mk-workstation"
DATA = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "mk-workstation"
TIMER_STATE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "mk-workstation/timer.json"
FPS = 30
IDLE = ("org.gnome.Mutter.IdleMonitor", "/org/gnome/Mutter/IdleMonitor/Core", "org.gnome.Mutter.IdleMonitor")


def conf():
    values = {"SCREENSAVER": "on", "DELAY": "180", "SCENE": "random"}
    for path in (DATA / "config/screensaver.conf", CONFIG / "screensaver.conf"):
        try:
            for line in path.read_text().splitlines():
                if "=" in line and not line.lstrip().startswith("#"):
                    key, value = line.split("=", 1)
                    values[key.strip()] = value.strip()
        except OSError:
            pass
    return values


def set_conf(key, value):
    """Write KEY=VALUE to your screensaver.conf (the watcher picks it up at once)."""
    path = CONFIG / "screensaver.conf"
    try:
        lines = path.read_text().splitlines()
    except OSError:
        lines = ["# Screensaver: your choices (Screensaver settings, mk screensaver)"]
    for i, line in enumerate(lines):
        if line.split("=", 1)[0].strip() == key and not line.lstrip().startswith("#"):
            lines[i] = f"{key}={value}"
            break
    else:
        lines.append(f"{key}={value}")
    CONFIG.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")


def screen_kept_awake(bus):
    """A video, a call or Caffeine is keeping the screen awake."""
    sm = ("org.gnome.SessionManager", "/org/gnome/SessionManager", "org.gnome.SessionManager")
    try:
        paths = bus.call_sync(*sm, "GetInhibitors", None, GLib.VariantType("(ao)"), 0, 1000, None).unpack()[0]
        for path in paths:
            flags = bus.call_sync(sm[0], path, "org.gnome.SessionManager.Inhibitor", "GetFlags", None,
                                  GLib.VariantType("(u)"), 0, 1000, None).unpack()[0]
            if flags & 8:
                return True
    except GLib.Error:
        pass
    return False


def focus_timer_running():
    try:
        return bool(json.loads(TIMER_STATE.read_text()).get("running"))
    except (OSError, ValueError):
        return False


class SaverWindow(Gtk.ApplicationWindow):
    def __init__(self, app, name):
        super().__init__(application=app, title="Screensaver", decorated=False)
        self.scene = scenes.pick(name)
        self.started = time.monotonic()
        self.pointer = None
        area = Gtk.DrawingArea(hexpand=True, vexpand=True)
        area.set_draw_func(self._draw)
        self.last_frame = 0.0
        area.add_tick_callback(self._tick)
        self.set_child(area)
        self.set_cursor(Gdk.Cursor.new_from_name("none"))
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._motion)
        self.add_controller(motion)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda *_: self._wake())
        self.add_controller(keys)
        click = Gtk.GestureClick(button=0)
        click.connect("pressed", lambda *_: self._wake())
        self.add_controller(click)
        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.BOTH_AXES)
        scroll.connect("scroll", lambda *_: self._wake())
        self.add_controller(scroll)
        self.fullscreen()

    def _tick(self, widget, clock):
        now = time.monotonic()
        if now - self.last_frame >= 1 / FPS - 0.002:  # 30 fps is plenty, and kinder
            self.last_frame = now
            widget.queue_draw()
        return GLib.SOURCE_CONTINUE

    def _draw(self, _area, cr, w, h):
        self.scene.draw(cr, w, h, time.monotonic() - self.started)

    def _motion(self, _c, x, y):
        if self.pointer is None:
            self.pointer = (x, y)
        elif abs(x - self.pointer[0]) + abs(y - self.pointer[1]) > 10:
            self._wake()

    def _wake(self):
        if time.monotonic() - self.started > 0.7:  # ignore the input that arrives while going full screen
            self.close()


class Saver(Gtk.Application):
    def __init__(self, show=None):
        super().__init__(application_id=APP_ID if show is None else None,
                         flags=Gio.ApplicationFlags.NON_UNIQUE if show else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.show_now = show
        self.window = None
        self.watch = 0

    def do_activate(self):
        if self.show_now is not None:
            self.open(self.show_now)
            return
        self.hold()  # keep watching without a window
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.bus.signal_subscribe(IDLE[0], IDLE[2], "WatchFired", IDLE[1], None,
                                  Gio.DBusSignalFlags.NONE, self._fired)
        self._arm()
        # Settings changes (mk screensaver, Companion) apply without restarting.
        self.monitor = Gio.File.new_for_path(str(CONFIG / "screensaver.conf")).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_: self._arm())

    def _arm(self):
        if self.watch:
            try:
                self.bus.call_sync(*IDLE, "RemoveWatch", GLib.Variant("(u)", (self.watch,)), None, 0, 1000, None)
            except GLib.Error:
                pass
            self.watch = 0
        c = conf()
        if c["SCREENSAVER"] == "off":
            return
        delay = max(30, int(c.get("DELAY") or 180)) * 1000
        self.watch = self.bus.call_sync(*IDLE, "AddIdleWatch", GLib.Variant("(t)", (delay,)),
                                        GLib.VariantType("(u)"), 0, 1000, None).unpack()[0]

    def _fired(self, _bus, _sender, _path, _iface, _signal, params):
        if params.unpack()[0] != self.watch or self.window:
            return
        if screen_kept_awake(self.bus) or focus_timer_running():
            return
        self.open(conf()["SCENE"])

    def open(self, name):
        self.window = SaverWindow(self, name)
        self.window.connect("close-request", self._closed)
        self.window.present()

    def _closed(self, *_):
        self.window = None
        return False


SETTINGS_CSS = b"""
.mk-scene-card { border-radius: 14px; padding: 8px; }
.mk-scene-card.selected { box-shadow: inset 0 0 0 3px @accent_color; background: alpha(@accent_color, 0.12); }
.mk-scene-thumb { border-radius: 10px; }
"""


class SceneCard(Gtk.Button):
    """A live, small preview of a scene (or of all of them, for Shuffle)."""
    W, H = 256, 144

    def __init__(self, key, label):
        super().__init__(css_classes=["flat", "mk-scene-card"])
        self.key = key
        self.names = list(scenes.SCENES) if key == "random" else [key]
        self.scenes = {}
        self.started = time.monotonic()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.area = Gtk.DrawingArea(content_width=self.W, content_height=self.H, css_classes=["mk-scene-thumb"],
                                    overflow=Gtk.Overflow.HIDDEN)
        self.area.set_draw_func(self._draw)
        self.area.add_tick_callback(self._tick)
        self.last = 0.0
        box.append(self.area)
        row = Gtk.Box(spacing=8)
        row.append(Gtk.Label(label=label, xalign=0, hexpand=True, css_classes=["heading"]))
        self.check = Gtk.Image(icon_name="object-select-symbolic", visible=False)
        row.append(self.check)
        box.append(row)
        self.set_child(box)

    def _tick(self, widget, _clock):
        now = time.monotonic()
        if now - self.last >= 1 / 15:  # thumbnails at 15 fps: smooth enough, light
            self.last = now
            widget.queue_draw()
        return GLib.SOURCE_CONTINUE

    def _draw(self, _area, cr, w, h):
        t = time.monotonic() - self.started
        name = self.names[int(t / 4) % len(self.names)]  # Shuffle: a new scene every 4 s
        scene = self.scenes.get(name) or self.scenes.setdefault(name, scenes.SCENES[name]())
        # Drawn at 1280x720 and scaled down, so the thumbnail looks like the real thing.
        cr.scale(w / 1280, h / 720)
        scene.draw(cr, 1280, 720, t + 3)

    def set_selected(self, on):
        self.check.set_visible(on)
        (self.add_css_class if on else self.remove_css_class)("selected")


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Screensaver", default_width=980, default_height=760)
        provider = Gtk.CssProvider()
        provider.load_from_data(SETTINGS_CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        c = conf()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        general = Adw.PreferencesGroup(
            description="Plays when you step away. GNOME still dims and locks at its own time "
                        "(Settings › Power and Privacy); the focus timer uses the scene you pick here.")
        on = Adw.SwitchRow(title="Screensaver", active=c["SCREENSAVER"] != "off")
        on.connect("notify::active", lambda r, _p: set_conf("SCREENSAVER", "on" if r.get_active() else "off"))
        general.add(on)
        delay = Adw.SpinRow.new_with_range(1, 60, 1)
        delay.set_title("Start after (minutes without input)")
        delay.set_value(max(1, round(int(c.get("DELAY") or 180) / 60)))
        delay.connect("notify::value", lambda r, _p: set_conf("DELAY", str(int(r.get_value()) * 60)))
        general.add(delay)
        page.add(general)

        gallery = Adw.PreferencesGroup(title="Scene", description="Click one to use it, or Shuffle for a different one each time.")
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=2, min_children_per_line=2,
                           column_spacing=12, row_spacing=12, homogeneous=True)
        self.cards = []
        current = c.get("SCENE", "random") if c.get("SCENE") in scenes.SCENES else "random"
        for key, label in [("random", "Shuffle")] + [(n, cls.label) for n, cls in scenes.SCENES.items()]:
            card = SceneCard(key, label)
            card.set_selected(key == current)
            card.connect("clicked", self._chosen)
            menu_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            menu_box.append(card)
            preview = Gtk.Button(label="Preview full screen", css_classes=["flat"], halign=Gtk.Align.CENTER)
            preview.connect("clicked", lambda _b, k=key: Gio.Subprocess.new([os.path.abspath(__file__), "show", k], Gio.SubprocessFlags.NONE))
            menu_box.append(preview)
            flow.append(menu_box)
            self.cards.append(card)
        gallery.add(flow)
        page.add(gallery)
        view.set_content(page)
        self.set_content(view)

    def _chosen(self, card):
        set_conf("SCENE", card.key)
        for other in self.cards:
            other.set_selected(other is card)


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID + "Settings")

    def do_activate(self):
        window = self.get_active_window() or SettingsWindow(self)
        window.present()


def main():
    args = sys.argv[1:]
    if args and args[0] == "list":
        for name, cls in scenes.SCENES.items():
            print(f"{name:8} {cls.label}")
        return 0
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if args and args[0] == "settings":
        return SettingsApp().run([sys.argv[0]])
    if args and args[0] == "show":
        return Saver(show=args[1] if len(args) > 1 else conf()["SCENE"]).run([sys.argv[0]])
    return Saver().run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
