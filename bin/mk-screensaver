#!/usr/bin/env python3
"""MK screensaver: a full-screen scene when you step away from the computer.

  mk-screensaver               start watching (login does this): shows a scene
                               after DELAY seconds without input
  mk-screensaver show [SCENE]  show one now (aurora, web, knight, matrix, random)
  mk-screensaver settings      pick a scene from previews, or shuffle; on/off; delay
  mk-screensaver list          the scenes
  (mk-screensaver frames SCENE W H FILE: frames for the lock screen, used by
   mk-indicator; LOCKSCREEN=on|off in screensaver.conf)

Settings: config/screensaver.conf, yours in ~/.config/mk-workstation/screensaver.conf
(SCREENSAVER=on|off, DELAY=seconds, SCENE=random|aurora|web|knight|matrix).
GNOME still blanks and locks the screen at its own time (Settings › Power
and Privacy): the scene plays before that. It stays away while a video, a call
or Caffeine keeps the screen awake, and while the focus timer runs (it has
its own). The first touch of the mouse, touchpad or keyboard ends it.
"""
import os
import subprocess
import sys
from pathlib import Path

from gi.repository import Gio, GLib


def _add_lib_path():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for candidate in (Path(__file__).resolve().parent.parent / "lib",
                      Path(data_home) / "mk-workstation/lib"):
        if (candidate / "mkworkstation").is_dir():
            sys.path.insert(0, str(candidate))
            return


_add_lib_path()
from mkworkstation.saver_conf import CONFIG, conf, focus_timer_running, screen_kept_awake  # noqa: E402

APP_ID = "io.github.mehulk.MkScreensaver"
IDLE = ("org.gnome.Mutter.IdleMonitor", "/org/gnome/Mutter/IdleMonitor/Core", "org.gnome.Mutter.IdleMonitor")


class Watcher:
    """Waits for idle time with GNOME's idle monitor and starts the scene as a
    separate process. No GTK here: watching all day costs a few MB."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.watch = 0
        self.child = None
        self.bus.signal_subscribe(IDLE[0], IDLE[2], "WatchFired", IDLE[1], None,
                                  Gio.DBusSignalFlags.NONE, self._fired)
        self._arm()
        # Settings changes (Screensaver app, mk screensaver) apply without restarting.
        self.monitor = Gio.File.new_for_path(str(CONFIG / "screensaver.conf")).monitor_file(
            Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_: self._arm())

    def _arm(self):
        if self.watch:
            try:
                self.bus.call_sync(*IDLE, "RemoveWatch", GLib.Variant("(u)", (self.watch,)), None, 0, 1000, None)
            except GLib.Error:
                pass
            self.watch = 0
        c = conf()
        if c["SCREENSAVER"] == "off":
            return
        delay = max(30, int(c.get("DELAY") or 180)) * 1000
        self.watch = self.bus.call_sync(*IDLE, "AddIdleWatch", GLib.Variant("(t)", (delay,)),
                                        GLib.VariantType("(u)"), 0, 1000, None).unpack()[0]

    def _fired(self, _bus, _sender, _path, _iface, _signal, params):
        if params.unpack()[0] != self.watch or (self.child and self.child.poll() is None):
            return
        if screen_kept_awake(self.bus) or focus_timer_running():
            return
        self.child = subprocess.Popen([sys.executable, os.path.abspath(__file__), "show", conf()["SCENE"]])


def watch():
    loop = GLib.MainLoop()
    # One watcher per session: a second one exits at once.
    Gio.bus_own_name(Gio.BusType.SESSION, APP_ID, Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
                     None, lambda *_: Watcher(), lambda *_: loop.quit())
    loop.run()
    return 0


def frames(name, w, h, out):
    """For the lock screen and the live wallpaper (mk-indicator): render SCENE at WxH into OUT, 15
    times a second, as raw premultiplied BGRA (cairo ARGB32). Each frame is
    written next to OUT and renamed over it, so the shell never reads half a
    frame. Runs until the shell stops it (it does on unlock)."""
    import time

    import cairo

    from mkworkstation import scenes
    scenes.SHOW_CAPTION = False
    if out.parent != Path(GLib.get_user_runtime_dir()) or not out.name.startswith(("mk-lockscene", "mk-livewall")):
        print("frames: OUT must be $XDG_RUNTIME_DIR/mk-lockscene* or mk-livewall*", file=sys.stderr)
        return 2
    scene = scenes.pick(name)
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    cr = cairo.Context(surface)
    tmp = out.with_suffix(".tmp")
    start = time.monotonic()
    parent = os.getppid()
    while os.getppid() == parent:  # the shell went away (crash, logout): stop
        tick = time.monotonic()
        cr.save()
        scenes.burn_in_shift(cr, w, h, tick - start, amplitude=3)  # frames are half the screen's size
        scene.draw(cr, w, h, tick - start)
        cr.restore()
        surface.flush()
        tmp.write_bytes(bytes(surface.get_data()))
        os.replace(tmp, out)
        time.sleep(max(0.0, 1 / 15 - (time.monotonic() - tick)))
    return 0


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if args and args[0] == "list":
        from mkworkstation import scenes
        for name, cls in scenes.SCENES.items():
            print(f"{name:8} {cls.label}")
        return 0
    if args and args[0] == "frames" and len(args) == 5:
        return frames(args[1], int(args[2]), int(args[3]), Path(args[4]))
    if args and args[0] == "settings":
        from mkworkstation import saver_gui
        return saver_gui.SettingsApp().run([sys.argv[0]])
    if args and args[0] == "show":
        from mkworkstation import saver_gui
        return saver_gui.ShowApp(args[1] if len(args) > 1 else conf()["SCENE"]).run([sys.argv[0]])
    return watch()


if __name__ == "__main__":
    sys.exit(main())
