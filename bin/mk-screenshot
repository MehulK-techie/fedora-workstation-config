#!/usr/bin/env python3
"""mk-screenshot: screenshots from a terminal, a script or a launcher.

  mk-screenshot --instant   the whole screen, now: saved as
                            ~/Pictures/Screenshots/Screenshot_YYYY-MM-DD_HH-MM-SS.png,
                            copied to the clipboard as a PNG (Ctrl+V pastes it),
                            and a notification says so
  mk-screenshot --area      GNOME's screenshot tool (drag an area, or pick a window);
                            what you take is saved and copied the same way

It goes through the desktop's screenshot portal (org.freedesktop.portal.Screenshot):
GNOME only lets its own tools call the shell's screenshot service directly.
The keys stay GNOME's own: Shift+Print (instantly), Print and Super+Shift+S
(pick an area); Quick Settings has a Screenshot tile.
"""
import fcntl
import os
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path


from gi.repository import Gio, GLib  # noqa: E402

PORTAL = "org.freedesktop.portal.Desktop"
PATH = "/org/freedesktop/portal/desktop"


def portal_screenshot(interactive):
    """The portal's screenshot (its file), or raises."""
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    token = f"mk{os.getpid()}"
    sender = bus.get_unique_name()[1:].replace(".", "_")
    handle = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    loop = GLib.MainLoop()
    result = {}

    def on_response(_conn, _sender, _path, _iface, _signal, params):
        code, results = params.unpack()
        result["code"], result["uri"] = code, results.get("uri")
        loop.quit()

    sub = bus.signal_subscribe(PORTAL, "org.freedesktop.portal.Request", "Response", handle, None,
                               Gio.DBusSignalFlags.NO_MATCH_RULE, on_response)
    options = {"handle_token": GLib.Variant("s", token), "interactive": GLib.Variant("b", interactive),
               "modal": GLib.Variant("b", False)}
    bus.call_sync(PORTAL, PATH, "org.freedesktop.portal.Screenshot", "Screenshot",
                  GLib.Variant("(sa{sv})", ("", options)), None, Gio.DBusCallFlags.NONE, -1, None)
    GLib.timeout_add_seconds(120 if interactive else 20, loop.quit)
    loop.run()
    bus.signal_unsubscribe(sub)
    if result.get("code") != 0 or not result.get("uri"):
        raise RuntimeError("cancelled" if result.get("code") == 1 else "the screenshot portal didn't answer")
    return Path(Gio.File.new_for_uri(result["uri"]).get_path())


def target():
    pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or str(Path.home() / "Pictures")
    folder = Path(pictures) / "Screenshots"
    folder.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    path, i = folder / f"Screenshot_{stamp}.png", 1
    while path.exists():
        path, i = folder / f"Screenshot_{stamp}-{i}.png", i + 1
    return path


def copy_to_clipboard(path):
    if not shutil.which("wl-copy"):
        return False
    with open(path, "rb") as f:
        # wl-copy stays in the background serving the clipboard; it lets go when something else is copied
        return subprocess.run(["wl-copy", "--type", "image/png"], stdin=f, check=False).returncode == 0


def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "--app-name=Screenshot", "--icon=camera-photo-symbolic", title, body],
                       check=False)


def main(argv):
    if not argv or argv[0] not in ("--instant", "--area"):
        print(__doc__.strip())
        return 2
    # one at a time: pressed again while one is still open, the new one waits up to 3 s for it
    # and then gives up (a lock on a file in your runtime folder; it's let go when this exits,
    # however it exits, so a cancelled or crashed one never blocks the next)
    lock = open(Path(GLib.get_user_runtime_dir()) / "mk-screenshot.lock", "w")
    for _ in range(30):
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            GLib.usleep(100000)
    else:
        print("mk-screenshot: another screenshot is still open", file=sys.stderr)
        return 1
    try:
        shot = portal_screenshot(interactive=argv[0] == "--area")
    except (RuntimeError, GLib.Error) as e:
        print(f"mk-screenshot: {e}", file=sys.stderr)
        return 1
    path = target()
    shutil.move(str(shot), path)
    copied = copy_to_clipboard(path)
    notify("Screenshot saved & copied to clipboard" if copied else "Screenshot saved", path.name)
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
