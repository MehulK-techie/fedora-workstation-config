#!/usr/bin/env python3
"""mk-storage-sense: free disk space the safe way.

  mk-storage-sense             clean what's yours (the weekly timer runs this)
  mk-storage-sense --deep      also the system's parts (asks for your password once)
  mk-storage-sense --dry-run   say what would go, delete nothing
  mk-storage-sense --last      the last run: when and how much came back

Yours (no password):
  * files in ~/.cache untouched for 14 days (not MK's own caches, and
    nothing that isn't a plain file);
  * thumbnails (~/.cache/thumbnails) of files that no longer exist;
  * your user journal, down to 100 MB;
  * Flatpak runtimes no app of yours uses (flatpak --user uninstall --unused).
The system's (--deep, through pkexec): the system journal down to 100 MB,
system Flatpak runtimes nothing uses, and dnf's downloaded packages.
Each run is recorded in ~/.local/state/mk-workstation/storage-sense.json
(the Control Center card shows it).
"""
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path

HOME = Path.home()
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache")
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "mk-workstation/storage-sense.json"
STALE_DAYS = 14
KEEP = {"mk-workstation", "mk-dev", "thumbnails"}   # MK's own; thumbnails are judged by their source


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n} B"


def stale_cache(dry):
    """Plain files in CACHE not modified or read for STALE_DAYS."""
    cutoff, freed = time.time() - STALE_DAYS * 86400, 0
    for top in CACHE.iterdir() if CACHE.is_dir() else ():
        if top.name in KEEP or top.is_symlink():
            continue
        paths = [top] if top.is_file() else (p for p in top.rglob("*"))
        for p in paths:
            try:
                st = p.lstat()
                if not p.is_file() or p.is_symlink() or max(st.st_mtime, st.st_atime) > cutoff:
                    continue
                if not dry:
                    p.unlink()
                freed += st.st_size
            except OSError:
                continue
    if not dry:   # the folders that are now empty
        for d in sorted((p for p in CACHE.rglob("*") if p.is_dir() and not p.is_symlink()),
                        key=lambda p: len(p.parts), reverse=True):
            if d.relative_to(CACHE).parts[0] not in KEEP:
                try:
                    d.rmdir()
                except OSError:
                    pass
    return freed


def _thumb_source(path):
    """The Thumb::URI a thumbnail PNG names (its tEXt chunk), or None."""
    try:
        data = path.read_bytes()
    except OSError:
        return None
    i = 8   # after the PNG signature: length, type, data, CRC, ...
    while i + 8 <= len(data):
        length, kind = int.from_bytes(data[i:i + 4], "big"), data[i + 4:i + 8]
        if kind == b"tEXt":
            key, _sep, value = data[i + 8:i + 8 + length].partition(b"\x00")
            if key == b"Thumb::URI":
                return value.decode("utf-8", "replace")
        if kind == b"IDAT":
            return None   # the text chunks come first
        i += 12 + length
    return None


def orphan_thumbnails(dry):
    freed = 0
    for p in (CACHE / "thumbnails").rglob("*.png") if (CACHE / "thumbnails").is_dir() else ():
        uri = _thumb_source(p)
        if not uri or not uri.startswith("file://"):
            continue
        if Path(urllib.parse.unquote(uri[7:])).exists():
            continue
        try:
            size = p.stat().st_size
            if not dry:
                p.unlink()
            freed += size
        except OSError:
            pass
    return freed


def _du(path):
    try:
        return sum(f.stat().st_size for f in Path(path).rglob("*") if f.is_file() and not f.is_symlink())
    except OSError:
        return 0


def run(argv, dry):
    if dry or not shutil.which(argv[0]):
        return
    subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=900)


def user_journal(dry):
    jdir = Path("/var/log/journal")
    before = sum(_du(d) for d in jdir.glob("*/user-%d*.journal" % os.getuid())) if jdir.is_dir() else 0
    run(["journalctl", "--user", "--vacuum-size=100M"], dry)
    after = sum(_du(d) for d in jdir.glob("*/user-%d*.journal" % os.getuid())) if jdir.is_dir() else 0
    return max(0, before - after)


def user_flatpaks(dry):
    base = HOME / ".local/share/flatpak"
    before = _du(base) if base.is_dir() else 0
    run(["flatpak", "--user", "uninstall", "--unused", "-y", "--noninteractive"], dry)
    return max(0, before - (_du(base) if base.is_dir() else 0))


def deep(dry):
    """The system's share, in one pkexec (one password prompt)."""
    if dry:
        print("  --deep would also: vacuum the system journal to 100 MB, remove unused system Flatpak "
              "runtimes, clean dnf's packages")
        return 0
    if not shutil.which("pkexec"):
        print("[-] pkexec isn't installed; skipping the system's part", file=sys.stderr)
        return 0
    df = shutil.disk_usage("/")
    script = ("journalctl --vacuum-size=100M >/dev/null 2>&1; "
              "command -v flatpak >/dev/null && flatpak --system uninstall --unused -y --noninteractive >/dev/null 2>&1; "
              "dnf clean packages >/dev/null 2>&1; true")
    subprocess.run(["pkexec", "sh", "-c", script])
    return max(0, shutil.disk_usage("/").free - df.free)


def main():
    args = sys.argv[1:]
    if "--last" in args:
        try:
            last = json.loads(STATE.read_text())
            print(f"Last run {time.strftime('%d %b %Y %H:%M', time.localtime(last['when']))}: "
                  f"{human(last['freed'])} freed")
        except (OSError, ValueError, KeyError):
            print("Storage Sense hasn't run yet.")
        return
    if args and not set(args) <= {"--deep", "--dry-run"}:
        print(__doc__.strip())
        sys.exit(2)
    dry = "--dry-run" in args
    parts = [("Old cache files", stale_cache), ("Thumbnails of deleted files", orphan_thumbnails),
             ("Your journal", user_journal), ("Unused Flatpak runtimes (yours)", user_flatpaks)]
    total = 0
    for i, (label, fn) in enumerate(parts, 1):
        freed = fn(dry)
        total += freed
        print(f"[{i}/{len(parts)}] {label}: {human(freed)}", flush=True)
    if "--deep" in args:
        freed = deep(dry)
        total += freed
        print(f"System: {human(freed)}", flush=True)
    verb = "Would free" if dry else "Freed"
    print(f"✔ {verb} {human(total)}")
    if not dry:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps({"when": time.time(), "freed": total, "deep": "--deep" in args}))


if __name__ == "__main__":
    main()
