#!/usr/bin/env python3
"""MK tour: a short walkthrough of the desktop, its gestures and tools.

  mk-tour              open the tour (also mk tour, Super+Shift+/ or the app grid)
  mk-tour --first-run  open it once after setup, then never by itself again

Arrow keys or the buttons move between pages; each page can open what it
describes, so you can try it right away.
"""
import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "io.github.mehulk.MkTour"
BIN = Path.home() / ".local/bin"
DONE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "mk-workstation/tour-done"

# (icon, title, text, [(button label, command)])
PAGES = [
    ("starred-symbolic", "Welcome to your workstation",
