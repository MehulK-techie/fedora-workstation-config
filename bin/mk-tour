#!/usr/bin/env python3
"""MK tour: the workstation in six slides, GNOME Tour style.

  mk-tour              the six-slide tour (also mk tour, Super+Shift+/,
                       MK Control Center or the app grid)
  mk-tour --reference  the MK Quick Reference: a searchable cheat sheet
  mk-tour --full       the long walkthrough, every page
  mk-tour --first-run  the tour once after setup, then never by itself again

Arrow keys or the buttons move between pages; each page can open what it
describes, so you can try it right away.
"""
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

def _add_lib_path():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for candidate in (Path(__file__).resolve().parent.parent / "lib",
                      Path(data_home) / "mk-workstation/lib"):
        if (candidate / "mkworkstation").is_dir():
            sys.path.insert(0, str(candidate))
            return


_add_lib_path()
import mkworkstation  # noqa: E402

APP_ID = "io.github.mehulk.MkTour"
BIN = Path.home() / ".local/bin"
DONE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "mk-workstation/tour-done"

