SHOW_CSS = b"""
.mk-slide-art { min-width: 140px; min-height: 140px; border-radius: 70px; color: white;
                box-shadow: 0 10px 30px alpha(black, 0.35); }
.mk-art-0 { background: linear-gradient(135deg, #3c6eb4, #51a2da); }
.mk-art-1 { background: linear-gradient(135deg, #0ea5e9, #22d3ee); }
.mk-art-2 { background: linear-gradient(135deg, #f59e0b, #f97316); }
.mk-art-3 { background: linear-gradient(135deg, #8b5cf6, #ec4899); }
.mk-art-4 { background: linear-gradient(135deg, #ef4444, #1e3a8a); }
.mk-art-5 { background: linear-gradient(135deg, #10b981, #0ea5e9); }
.mk-slide-title { font-size: 26px; font-weight: 800; }
.mk-slide-text { font-size: 15px; opacity: 0.8; }
.mk-tour-arrow { min-width: 44px; min-height: 44px; border-radius: 22px; padding: 0;
                 background: alpha(@window_fg_color, 0.10); transition: background 150ms ease-out; }
.mk-tour-arrow:hover { background: alpha(@window_fg_color, 0.22); }
"""


class Showcase(Adw.ApplicationWindow):
    """GNOME Tour style: a centred card of slides, page dots on top, round
    arrows at the sides. Left/Right, Space or Enter move; Esc closes."""

    def __init__(self, app):
        super().__init__(application=app, title="MK Workstation Tour", default_width=740, default_height=530)
        css = Gtk.CssProvider()
        css.load_from_data(SHOW_CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.toast = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        head = Adw.HeaderBar()  # the page dots are its title
        self.carousel = Adw.Carousel(hexpand=True, vexpand=True, allow_scroll_wheel=True)
        head.set_title_widget(Adw.CarouselIndicatorDots(carousel=self.carousel))
        view.add_top_bar(head)
        for n, (icon, title, text, action) in enumerate(SLIDES):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, valign=Gtk.Align.CENTER,
                           halign=Gtk.Align.CENTER, margin_start=72, margin_end=72)
            art = Gtk.Box(css_classes=["mk-slide-art", f"mk-art-{n}"], halign=Gtk.Align.CENTER)
            art.append(Gtk.Image(icon_name=icon, pixel_size=72, hexpand=True, vexpand=True))
            page.append(art)
            page.append(Gtk.Label(label=title, css_classes=["mk-slide-title"], wrap=True,
                                  justify=Gtk.Justification.CENTER))
            page.append(Gtk.Label(label=text, css_classes=["mk-slide-text"], wrap=True, max_width_chars=52,
                                  justify=Gtk.Justification.CENTER))
            if action:
                label, what = action
                b = Gtk.Button(label=label, css_classes=["pill", "suggested-action"], halign=Gtk.Align.CENTER,
                               margin_top=8)
                b.connect("clicked", lambda _b, w=what: self.act(w))
                page.append(b)
            self.carousel.append(page)
        stage = Gtk.Overlay(child=self.carousel)
        self.prev = Gtk.Button(icon_name="go-previous-symbolic", css_classes=["mk-tour-arrow"],
                               halign=Gtk.Align.START, valign=Gtk.Align.CENTER, margin_start=14,
                               tooltip_text="Back (←)")
        self.prev.connect("clicked", lambda *_: self.step(-1))
        self.next = Gtk.Button(icon_name="go-next-symbolic", css_classes=["mk-tour-arrow"],
                               halign=Gtk.Align.END, valign=Gtk.Align.CENTER, margin_end=14,
                               tooltip_text="Next (→)")
        self.next.connect("clicked", lambda *_: self.step(1))
        stage.add_overlay(self.prev)
        stage.add_overlay(self.next)
        self.toast.set_child(stage)
        view.set_content(self.toast)
        self.set_content(view)
        self.carousel.connect("page-changed", lambda *_: self.sync())
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.sync()

    def position(self):
        return round(self.carousel.get_position())

    def step(self, delta):
        target = self.position() + delta
        if 0 <= target < self.carousel.get_n_pages():
            self.carousel.scroll_to(self.carousel.get_nth_page(target), True)

    def sync(self):
        pos = self.position()
        self.prev.set_visible(pos > 0)
        self.next.set_visible(pos < self.carousel.get_n_pages() - 1)

    def on_key(self, _c, keyval, _code, _state):
        if keyval in (Gdk.KEY_Right, Gdk.KEY_space, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if keyval != Gdk.KEY_Right and self.position() == self.carousel.get_n_pages() - 1:
                self.close()
            else:
                self.step(1)
        elif keyval == Gdk.KEY_Left:
            self.step(-1)
        elif keyval == Gdk.KEY_Escape:
            self.close()
        else:
            return False
        return True

    def act(self, what):
        if what == "done":
            self.close()
        elif what == "face":
            self.try_face()
        else:
            run(what)

    def try_face(self):
        """A real check with the MK unlock window; a friendly word when
        there's nothing to check with yet."""
        try:
            from mkworkstation import auth
        except ImportError:
            auth = None
        if not auth or not auth.face_available():
            hint = ("Face ID isn't set up yet: MK Control Center › MK Lock › Face & Fingerprint › Add a face"
                    if shutil.which("howdy") else "Face ID needs Howdy: run ./setup.sh, then add your face")
            self.toast.add_toast(Adw.Toast(title=hint, timeout=5))
            return
        dialog = auth.UnlockDialog("Try Face ID", None,
                                   lambda: self.toast.add_toast(Adw.Toast(title="It's you ✓", timeout=3)))
        dialog.present(self)


class TourApp(Adw.Application):
    def __init__(self, mode):
        super().__init__(application_id=APP_ID)
        self.mode = mode

    def show(self, pages):
        Tour(self, pages).present()

    def do_activate(self):
        window = self.get_active_window()
        if window:
            window.present()
        elif self.mode == "cheatsheet":
            CheatSheet(self).present()
        elif self.mode == "full":
            self.show(PAGES)
        else:
            Showcase(self).present()


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__.strip())
        return 0
    first_time = not DONE.exists()
    if "--first-run" in sys.argv and not first_time:
        return 0
    if first_time:
        DONE.parent.mkdir(parents=True, exist_ok=True)
        DONE.write_text("shown\n")
    mode = "full" if "--full" in sys.argv else "cheatsheet" if "--reference" in sys.argv else "showcase"
    return TourApp(mode).run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
