def has_fingerprint_reader():
    try:
        out = subprocess.run(["fprintd-list", os.environ.get("USER", "")], capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False, False
    return "Device at" in out or "Using device" in out, " - #" in out


def has_camera():
    return any(Path("/dev").glob("video*"))


def signin_page():
    """The text and buttons for this computer: only what its hardware can do.
    Two faces can be enrolled (you and one other person), each as themselves."""
    reader, enrolled = has_fingerprint_reader()
    text, buttons = [], []
    if reader:
        text.append("Your fingerprint reader is ready." if enrolled else
                    "This computer has a fingerprint reader: enroll a finger and it unlocks the "
                    "screen, sudo and locked folders.")
        buttons.append(("Enroll a finger", "terminal:mk fingerprint"))
    if has_camera():
        text.append("Face unlock signs you in with the camera; it can know two faces (you and "
                    "one other person, each with their own account).")
        buttons.append(("Set up face unlock", "terminal:mk face"))
        buttons.append(("Add a second face", "terminal:read -rp 'Their account name: ' u && mk face --user \"$u\""))
    if not text:
        text.append("This computer has no fingerprint reader or camera: your password signs you in.")
    return " ".join(text), buttons


def show_overview():
    """GNOME Shell's overview, through its public D-Bus property."""
    Gio.bus_get_sync(Gio.BusType.SESSION).call(
        "org.gnome.Shell", "/org/gnome/Shell", "org.freedesktop.DBus.Properties", "Set",
        GLib.Variant("(ssv)", ("org.gnome.Shell", "OverviewActive", GLib.Variant("b", True))),
        None, Gio.DBusCallFlags.NONE, 1000, None)


def run(command):
    if command == "overview":
        try:
            show_overview()
        except GLib.Error:
            pass
        return
    if command.startswith("terminal:"):
        inner = command[len("terminal:"):]
        term = next((t for t in ("ptyxis", "kgx", "gnome-terminal") if shutil.which(t)), "xdg-terminal-exec")
        argv = [term] + (["--"] if term != "xdg-terminal-exec" else []) + \
            ["bash", "-c", f"{inner}; read -rp 'Press Enter to close'"]
    else:
        argv = command.split()
        exe = BIN / argv[0]
        if exe.exists():
            argv[0] = str(exe)
    try:
        subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


class Tour(Adw.ApplicationWindow):
    def __init__(self, app, pages=PAGES):
        super().__init__(application=app, title="Tour", default_width=720, default_height=520)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar(show_title=False))
        self.carousel = Adw.Carousel(hexpand=True, vexpand=True, allow_scroll_wheel=True)
        for icon, title, text, buttons in pages:
            if text == "SIGNIN":
                text, buttons = signin_page()
            page = Adw.StatusPage(icon_name=icon, title=title, description=text, hexpand=True)
            if buttons:
                row = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
                for label, command in buttons:
                    button = Gtk.Button(label=label, css_classes=["pill"])
                    button.connect("clicked", lambda _b, c=command: run(c))
                    row.append(button)
                page.set_child(row)
            self.carousel.append(page)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.carousel)
        nav = Gtk.Box(spacing=12, margin_start=18, margin_end=18, margin_bottom=18, margin_top=6)
        self.back = Gtk.Button(label="Back", css_classes=["pill"])
        self.back.connect("clicked", lambda *_: self.step(-1))
        nav.append(self.back)
        nav.append(Adw.CarouselIndicatorDots(carousel=self.carousel, hexpand=True))
        self.next = Gtk.Button(label="Next", css_classes=["pill", "suggested-action"])
        self.next.connect("clicked", lambda *_: self.step(1))
        nav.append(self.next)
        box.append(nav)
        view.set_content(box)
        self.set_content(view)
        self.carousel.connect("page-changed", lambda *_: self.sync())
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.sync()

    def position(self):
        return round(self.carousel.get_position())

    def step(self, delta):
        target = self.position() + delta
        if target >= self.carousel.get_n_pages():
            self.close()
            return
        if target >= 0:
            self.carousel.scroll_to(self.carousel.get_nth_page(target), True)

    def sync(self):
        pos = self.position()
        self.back.set_sensitive(pos > 0)
        self.next.set_label("Done" if pos == self.carousel.get_n_pages() - 1 else "Next")

    def on_key(self, _c, keyval, _code, _state):
        if keyval in (Gdk.KEY_Right, Gdk.KEY_space):
            self.step(1)
        elif keyval == Gdk.KEY_Left:
            self.step(-1)
        elif keyval == Gdk.KEY_Escape:
            self.close()
        else:
            return False
        return True


def gtk_accel(key):
    """Mutter's Above_Tab is the key above Tab: ` on most keyboards."""
    return key.replace("Above_Tab", "grave")


def pretty_keys(keys):
    """'<Super><Shift>n' -> 'Super+Shift+N', for search; the labels themselves
    are drawn by Gtk.ShortcutLabel."""
    out = []
    for k in keys:
        ok, key, mods = Gtk.accelerator_parse(gtk_accel(k))
        out.append(Gtk.accelerator_get_label(key, mods) if ok and (key or mods) else k)
    return out


class CheatSheet(Adw.ApplicationWindow):
    """MK Quick Reference: every shortcut from the live catalogue (your changes
    included), the handy commands, and a way back to the full tour."""

    def __init__(self, app):
        super().__init__(application=app, title="MK Quick Reference", default_width=760, default_height=720)
        head = Adw.HeaderBar()
        full = Gtk.Button(label="Full tour")
        full.connect("clicked", lambda *_: (self.get_application().show(PAGES), self.close()))
        head.pack_start(full)
        welcome = Gtk.Button(label="Welcome again")
        welcome.connect("clicked", lambda *_: (Showcase(self.get_application()).present(), self.close()))
        head.pack_start(welcome)
        self.search = Gtk.SearchEntry(placeholder_text="Find a shortcut or command…", width_chars=30)
        head.set_title_widget(self.search)
        self.page = Adw.PreferencesPage()
        self.rows = []
        groups = {}
        for sc in mkworkstation.load_shortcuts():
            if not sc.hidden and sc.keys:
                groups.setdefault(sc.group, []).append(sc)
        for name, shortcuts in groups.items():
            group = Adw.PreferencesGroup(title=name)
            for sc in shortcuts:
                row = Adw.ActionRow(title=GLib.markup_escape_text(sc.label))
                keys = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER)
                for i, k in enumerate(sc.keys[:2]):
                    if i:
                        keys.append(Gtk.Label(label="or", css_classes=["dim-label"]))
                    keys.append(Gtk.ShortcutLabel(accelerator=gtk_accel(k)))
                row.add_suffix(keys)
                group.add(row)
                self.rows.append((row, group, f"{name} {sc.label} {' '.join(pretty_keys(sc.keys))}".lower()))
            self.page.add(group)
        group = Adw.PreferencesGroup(title="Commands", description="In a terminal; mk alone lists them all")
        for cmd, what in COMMANDS:
            row = Adw.ActionRow(title=what, subtitle=cmd, subtitle_selectable=True)
            group.add(row)
            self.rows.append((row, group, f"commands {cmd} {what}".lower()))
        self.page.add(group)
        self.search.connect("search-changed", self._filter)
        view = Adw.ToolbarView(content=self.page)
        view.add_top_bar(head)
        self.set_content(view)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, kv, *_: kv == Gdk.KEY_Escape and (self.close() or True))
        self.add_controller(keys)
        GLib.idle_add(lambda: self.search.grab_focus() and False)  # once: True would repeat it forever

    def _filter(self, entry):
        query = entry.get_text().strip().lower()
        shown = {}
        for row, group, text in self.rows:
            visible = all(word in text for word in query.split())
            row.set_visible(visible)
            shown[group] = shown.get(group, False) or visible
        for group, any_visible in shown.items():
            group.set_visible(any_visible)



