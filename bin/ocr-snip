#!/bin/bash
TMP_IMG="/tmp/ocr_snip.png"
rm -f "$TMP_IMG"

# Capture area screenshot via native GNOME Wayland tool
gnome-screenshot -a -f "$TMP_IMG" 2>/dev/null

if [ -s "$TMP_IMG" ]; then
    TEXT=$(tesseract "$TMP_IMG" stdout 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    if [ -n "$TEXT" ]; then
        echo -n "$TEXT" | wl-copy
        notify-send "OCR Text Extractor" "Copied to clipboard:\n$TEXT" -i edit-paste
    else
        notify-send "OCR Text Extractor" "No readable text detected." -i dialog-warning
    fi
fi
rm -f "$TMP_IMG"
