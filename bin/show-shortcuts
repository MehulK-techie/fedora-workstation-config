#!/usr/bin/env bash
# MK Workstation shortcut cheat sheet (Super+/). Every value is read live from
# GNOME, so it always matches what your keyboard actually does.
set -euo pipefail

TMP_HUD=$(mktemp /tmp/mk_hud_XXXXXX.txt)
trap 'rm -f "$TMP_HUD"' EXIT

MEDIA_KEYS="org.gnome.settings-daemon.plugins.media-keys"
CUSTOM_PATH="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings"

# "['<Super><Shift>s', 'Print']" -> "Super+Shift+S  /  Print"
pretty() {
    sed -E -e "s/@as //; s/[][]//g; s/', '/  \/  /g; s/'//g" \
        -e 's/></+/g; s/>/+/g; s/<//g; s/\+([a-z])( |$)/+\U\1\2/g' \
        -e 's/Control/Ctrl/g; s/period/./g; s/slash/\//g; s/Escape/Esc/g; s/BackSpace/Backspace/g; s/Page_Up/PageUp/g; s/Page_Down/PageDown/g' \
        -e 's#  /  [^/]*KP_[0-9]##g' <<< "$1"
}
get_key() {
    local val
    val=$(gsettings get "$1" "$2" 2>/dev/null || echo "[]")
    val=$(pretty "$val")
    echo "${val:-—}"
}
get_custom() {
    local val
    val=$(gsettings get "$MEDIA_KEYS.custom-keybinding:$CUSTOM_PATH/mk-$1/" binding 2>/dev/null || echo "''")
    val=$(pretty "$val")
    echo "${val:-—}"
}
# Tiling Assistant keeps its keys in its own schema.
TA_DIR="$HOME/.local/share/gnome-shell/extensions/tiling-assistant@leleat-on-github/schemas"
get_ta() {
    local val
    val=$(gsettings --schemadir "$TA_DIR" get org.gnome.shell.extensions.tiling-assistant "$1" 2>/dev/null || echo "[]")
    val=$(pretty "$val")
    echo "${val:-—}"
}
row() { printf '  %-30s %s\n' "$1" "$2"; }

{
cat << 'HEADER'
════════════════════════════════════════════════════════════════════════════
                    MK WORKSTATION · KEYBOARD SHORTCUTS
                (read live from GNOME: always what your keys do)
════════════════════════════════════════════════════════════════════════════
HEADER

echo ""
echo "WINDOWS & WORKSPACES"
row "Switch windows (all spaces)" "$(get_key org.gnome.desktop.wm.keybindings switch-windows)"
row "Switch apps"                 "$(get_key org.gnome.desktop.wm.keybindings switch-applications)"
if [[ -d "$TA_DIR" ]] && gnome-extensions info tiling-assistant@leleat-on-github 2>/dev/null | grep -q 'State: ACTIVE'; then
    row "Snap left / right half"  "$(get_ta tile-left-half)  ·  $(get_ta tile-right-half)"
    row "Quarter (Windows style)" "Snap left/right, then Super+Up / Super+Down"
    row "Maximize / restore"      "$(get_ta tile-maximize)  ·  $(get_ta restore-window)"
    row "Snap layouts"            "$(get_ta search-popup-layout)"
    row "Centre window"           "$(get_ta center-window)"
else
    row "Snap left / right"       "$(get_key org.gnome.mutter.keybindings toggle-tiled-left)  ·  $(get_key org.gnome.mutter.keybindings toggle-tiled-right)"
    row "Maximize / restore"      "$(get_key org.gnome.desktop.wm.keybindings maximize)  ·  $(get_key org.gnome.desktop.wm.keybindings unmaximize)"
fi
row "Always on top"               "$(get_key org.gnome.desktop.wm.keybindings toggle-above)"
row "Full screen"                 "$(get_key org.gnome.desktop.wm.keybindings toggle-fullscreen)"
row "Minimize / close"            "$(get_key org.gnome.desktop.wm.keybindings minimize)  ·  $(get_key org.gnome.desktop.wm.keybindings close)"
row "Show desktop"                "$(get_key org.gnome.desktop.wm.keybindings show-desktop)"
row "Workspace left / right"      "$(get_key org.gnome.desktop.wm.keybindings switch-to-workspace-left)"
row "Go to workspace 1-4"         "$(get_key org.gnome.desktop.wm.keybindings switch-to-workspace-1) to 4"
row "New desktop"                 "$(get_key org.gnome.desktop.wm.keybindings switch-to-workspace-last)  (add Shift to take the window)"
row "Open dock app 1-9"           "$(get_key org.gnome.shell.keybindings switch-to-application-1) to 9"

echo ""
echo "TOUCHPAD"
row "Switch workspace"            "4 fingers left / right"
row "Switch window"               "3 fingers left / right"
row "Overview / app grid"         "3 fingers up"
row "Maximize / restore window"   "4 fingers up / down"
row "Show desktop · volume"       "4-finger pinch  ·  3-finger pinch"

echo ""
echo "SCREENSHOTS  (saved to ~/Pictures/Screenshots and copied)"
row "Full screen, instantly"      "$(get_key org.gnome.shell.keybindings screenshot)"
row "Pick an area / window"       "$(get_key org.gnome.shell.keybindings show-screenshot-ui)"
row "Current window"              "$(get_key org.gnome.shell.keybindings screenshot-window)"
row "Copy text from screen (OCR)" "$(get_custom ocr)"

echo ""
echo "SYSTEM"
row "Search / overview"           "Super  ·  $(get_key org.gnome.shell.keybindings toggle-overview)"
row "All apps"                    "$(get_key org.gnome.shell.keybindings toggle-application-view)"
row "Files"                       "$(get_key $MEDIA_KEYS home)"
row "Settings"                    "$(get_key $MEDIA_KEYS control-center)"
row "Quick settings"              "$(get_key org.gnome.shell.keybindings toggle-quick-settings)"
row "Notifications"               "$(get_key org.gnome.shell.keybindings toggle-message-tray)"
row "Clipboard history"           "Super+V"
row "Run a command"               "$(get_key org.gnome.desktop.wm.keybindings panel-run-dialog)"
row "Terminal"                    "$(get_custom terminal)"
row "System Monitor"              "$(get_custom taskmgr)"
row "Lock screen"                 "$(get_key $MEDIA_KEYS screensaver)"
row "Shut down / restart"         "$(get_key $MEDIA_KEYS shutdown)"

echo ""
echo "APPS"
row "Notes (Obsidian)"            "$(get_custom obsidian)"
row "Web browser"                 "$(get_custom browser)"
echo ""
echo "MK TOOLS"
row "Emoji board"                 "$(get_custom emoji)"
row "Notes & focus timer"         "$(get_custom notes)"
row "Camera controls"             "$(get_custom camera)"
row "This cheat sheet"            "$(get_custom hud)"

echo ""
echo "TIPS"
echo "  • In Files, select a file and press Space to preview it (Quick Look)."
echo "  • Ctrl+Alt+←/→ is left free for Zen Browser workspaces."
echo "  • Terminal: mk update (update everything) · mk save (keep what you added) · mk doctor"
echo "════════════════════════════════════════════════════════════════════════════"
} > "$TMP_HUD"

ACTION=$(zenity --text-info \
    --title="MK Workstation · Keyboard Shortcuts" \
    --filename="$TMP_HUD" \
    --font="monospace 10" \
    --width=820 --height=760 \
    --ok-label="Close" --extra-button="Open Keyboard Settings" 2>/dev/null || true)

if [[ "$ACTION" == "Open Keyboard Settings" ]]; then
    gnome-control-center keyboard &
fi
