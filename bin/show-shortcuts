#!/usr/bin/env python3
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Pango

class CheatSheetWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="⌨️ Workstation Hotkey Cheat Sheet")
        self.set_default_size(580, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(vbox)

        title = Gtk.Label()
        title.set_markup("<span size='large' weight='bold'>🚀 FEDORA WORKSTATION SHORTCUTS</span>")
        vbox.pack_start(title, False, False, 4)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        vbox.pack_start(scrolled, True, True, 0)

        text_view = Gtk.TextView()
        text_view.set_editable(False)
        text_view.set_cursor_visible(False)
        text_view.set_wrap_mode(Gtk.WrapMode.WORD)
        text_view.set_left_margin(16)
        text_view.set_right_margin(16)
        text_view.set_top_margin(12)
        text_view.set_bottom_margin(12)

        buffer = text_view.get_buffer()
        tag_cat = buffer.create_tag("category", font="Sans Bold 11")
        tag_item = buffer.create_tag("item", font="Sans 10")

        shortcuts_data = [
            ("📌 SYSTEM & NAVIGATION", [
                ("Super", "Open Application Overview & Search"),
                ("Alt + Tab", "Global Window Switcher (Across ALL Workspaces)"),
                ("Super + Tab / Super + S", "Workspace Overview Grid Matrix"),
                ("Super + .", "Emoji & Character Board"),
                ("Super + /", "Toggle Hotkey Cheat Sheet Popup")
            ]),
            ("🖥️ WORKSPACE & WINDOW MANAGEMENT", [
                ("Super + Left / Right", "Switch Workspace Left / Right"),
                ("Super + Shift + Left / Right", "Move Active Window to Workspace Left / Right"),
                ("Super + Shift + C", "Close ALL Apps in Current Workspace"),
                ("Super + Up / Down", "Maximize / Minimize Window")
            ]),
            ("✂️ UTILITIES & PRODUCTIVITY", [
                ("Super + Shift + T", "OCR Text Snippet Extractor"),
                ("PrintScreen", "Native Screen Capture & Recorder"),
                ("Super + Z / Super + X", "System Hibernate / Instant Shutdown")
            ]),
            ("🖱️ TOUCHPAD GESTURES", [
                ("3-Finger Swipe Left / Right", "Switch Workspaces"),
                ("3-Finger Swipe Up", "Open App Grid Overview"),
                ("Touchpad Tap", "Tap-to-Click Anywhere")
            ])
        ]

        for i, (category, items) in enumerate(shortcuts_data):
            iter_end = buffer.get_end_iter()
            prefix = "" if i == 0 else "\n"
            buffer.insert_with_tags(iter_end, f"{prefix}{category}\n", tag_cat)
            for hk, desc in items:
                iter_end = buffer.get_end_iter()
                buffer.insert_with_tags(iter_end, f"  • {hk} : {desc}\n", tag_item)

        scrolled.add(text_view)

        btn = Gtk.Button(label="Close")
        btn.connect("clicked", Gtk.main_quit)
        vbox.pack_start(btn, False, False, 0)

win = CheatSheetWindow()
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
