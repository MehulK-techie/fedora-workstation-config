#!/usr/bin/env python3
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk

class CheatSheetWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="⌨️ Workstation Hotkey Cheat Sheet")
        self.set_default_size(580, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(18)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(vbox)

        title = Gtk.Label()
        title.set_markup("<big><b>🚀 FEDORA WORKSTATION SHORTCUTS</b></big>")
        vbox.pack_start(title, False, False, 0)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        vbox.pack_start(scrolled, True, True, 0)

        label = Gtk.Label()
        label.set_selectable(True)
        label.set_line_wrap(True)
        label.set_xalign(0)
        label.set_yalign(0)

        text = (
            "<b>📌 SYSTEM & NAVIGATION</b>\n"
            "  • <b>Super</b> : Open Application Overview & Search\n"
            "  • <b>Alt + Tab</b> : Global Window Switcher (Across ALL Workspaces)\n"
            "  • <b>Super + Tab / Super + S</b> : Workspace Overview Matrix\n"
            "  • <b>Super + .</b> : Emoji & Character Picker Board\n"
            "  • <b>Super + /</b> : Toggle Hotkey Cheat Sheet Popup\n\n"
            "<b>🖥️ WORKSPACE & WINDOW MANAGEMENT</b>\n"
            "  • <b>Super + Left / Right</b> : Switch Workspace Left / Right\n"
            "  • <b>Super + Shift + Left / Right</b> : Move Active Window to Workspace Left / Right\n"
            "  • <b>Super + Shift + C</b> : 🧹 Close ALL Apps in Current Workspace\n"
            "  • <b>Super + Up / Down</b> : Maximize / Minimize Window\n\n"
            "<b>✂️ UTILITIES & PRODUCTIVITY</b>\n"
            "  • <b>Super + Shift + T</b> : Frog OCR Text Snippet Extractor\n"
            "  • <b>PrintScreen</b> : Native Screen Capture & Recorder\n"
            "  • <b>Super + Z</b> : System Hibernate\n"
            "  • <b>Super + X</b> : Instant Shutdown\n\n"
            "<b>🖱️ TOUCHPAD GESTURES</b>\n"
            "  • <b>3-Finger Swipe Left / Right</b> : Switch Workspaces\n"
            "  • <b>3-Finger Swipe Up</b> : Open App Grid Overview\n"
            "  • <b>Touchpad Tap</b> : Tap-to-Click Anywhere"
        )
        label.set_markup(text)
        scrolled.add_with_viewport(label)

        btn = Gtk.Button(label="Close")
        btn.connect("clicked", Gtk.main_quit)
        vbox.pack_start(btn, False, False, 0)

window = CheatSheetWindow()
window.connect("destroy", Gtk.main_quit)
window.show_all()
Gtk.main()
