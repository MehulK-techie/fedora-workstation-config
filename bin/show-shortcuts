#!/usr/bin/env bash
# ==============================================================================
# MK Workstation: Interactive Keyboard Shortcuts HUD
# ==============================================================================

SHORTCUTS_DATA=$(cat << 'LIST'
KEYBOARD SHORTCUTS REFERENCE:

[Window Management]
  Alt + Tab              Cycle through all windows across all workspaces
  Super + Q / Alt + F4   Close active application window
  Super + Arrow Keys     Snap windows (Left / Right / Maximize)

[Screenshots & Captures]
  Print                  Instant full-screen screenshot (auto-saved)
  Alt + Print            Instant active window screenshot
  Shift + Print          Area selection tool
  Super + Shift + S      Interactive screen snippet

[Productivity & Utilities]
  Super + Shift + T      PowerToys OCR Text Extractor (Select & Copy text)
  Super + .              Emoji & Symbol Palette
  Super + /              Open this Shortcuts Cheat Sheet

[How to Customize]
  Click 'Open Settings' below or go to Settings -> Keyboard -> Keyboard Shortcuts.
LIST
)

zenity --info \
    --title="MK Workstation Shortcuts HUD" \
    --width=540 \
    --height=420 \
    --text="$SHORTCUTS_DATA" \
    --ok-label="Close" \
    --extra-button="Customize in Settings" 2>/dev/null

if [[ $? -eq 0 ]] || [[ "${PIPESTATUS[0]}" -eq 0 ]]; then
    exit 0
fi

gnome-control-center keyboard &
