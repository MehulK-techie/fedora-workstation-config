#!/usr/bin/env bash
set -euo pipefail

TMP_HUD=$(mktemp /tmp/mk_hud_XXXXXX.txt)
trap 'rm -f "$TMP_HUD"' EXIT

get_key() {
    local val
    val=$(gsettings get "$1" "$2" 2>/dev/null || echo "[]")
    val=$(echo "$val" | sed -E "s/@as //;s/[\[\]']//g;s/,/ /g")
    echo "${val:-Disabled}"
}

cat << REGISTRY > "$TMP_HUD"
==================================================================================
                 ⚡ MK WORKSTATION LIVE SHORTCUT REGISTRY ⚡
               (Values queried dynamically in real-time from GNOME)
==================================================================================

[ 🪟 WINDOW MANAGEMENT & TILING ]
  • Alt + Tab              : $(get_key org.gnome.desktop.wm.keybindings switch-windows)
  • Snap Window Left       : $(get_key org.gnome.mutter.keybindings toggle-tiled-left)
  • Snap Window Right      : $(get_key org.gnome.mutter.keybindings toggle-tiled-right)
  • Maximize / Restore     : Super+Up / Super+Down
  • Close Active Window    : $(get_key org.gnome.desktop.wm.keybindings close)

[ 📸 SCREENSHOT & SNIP SUITE ]
  • Instant Fullscreen     : $(get_key org.gnome.shell.keybindings screenshot)
  • Instant Window         : $(get_key org.gnome.shell.keybindings screenshot-window)
  • Interactive Area Snip  : $(get_key org.gnome.shell.keybindings show-screenshot-ui)

[ 🚀 ERGONOMICS & APPS ]
  • PowerToys OCR Snip     : Super + Shift + T
  • Notes & Timers         : Super + N
  • Camera Controls Studio : Super + C
  • Shortcuts HUD          : Super + /
  • Zen Browser Workspaces : Ctrl + Alt + Left / Right
  • Emoji Board            : Super + .

[ 🛠️ CLI SUITE ]
  • mk update    : Pulls git updates and synchronizes environment
  • mk sync      : Syncs current settings to repo
  • mk shortcuts : Opens this cheat sheet
==================================================================================
REGISTRY

ACTION=$(zenity --text-info \
    --title="⚡ MK Workstation - Shortcuts HUD" \
    --filename="$TMP_HUD" \
    --width=720 --height=520 \
    --ok-label="Close" --extra-button="Open Settings" 2>/dev/null || true)

if [[ "$ACTION" == "Open Settings" ]]; then
    gnome-control-center keyboard &
fi
