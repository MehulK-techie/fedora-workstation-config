# dconf path: /org/gnome/shell/extensions/coverflowalttab/
[/]
animation-time=0.25
bind-to-switch-applications=false
bind-to-switch-windows=true
current-workspace-only='all-currentfirst'
dim-factor=0.55
easing-function='ease-out-quint'
hide-panel=false
highlight-color=(0.0, 0.85, 1.0)
highlight-mouse-over=true
highlight-use-theme-color=false
icon-add-remove-effects='Fade Only'
icon-has-shadow=true
icon-style='Overlay'
overlay-icon-opacity=0.9
overlay-icon-size=96.0
position='Bottom'
preview-to-monitor-ratio=0.55
raise-mouse-over=true
switcher-background-color=(0.03, 0.05, 0.12)
switcher-looping-method='Carousel'
switcher-style='Timeline'
timeline-preview-angle=24.0
timeline-preview-distance=110.0
timeline-preview-scale-with-distance=true
timeline-preview-tilt-angle=12.0
tint-blend=0.35
tint-color=(0.04, 0.09, 0.22)
tint-use-theme-color=false
use-tint=true
