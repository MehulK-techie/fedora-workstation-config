# dconf path: /org/gnome/shell/extensions/blur-my-shell/
[/]
brightness=0.75
hacks-level=1
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_73275251689028'>, 'params': <{'unscaled_radius': <17>, 'brightness': <0.75>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <@av []>}, 'pipeline_be948078-d0ce-471b-9ed7-d4aec0f7891d': {'name': <'Liquid glass'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_16419184764399'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_28316083119337'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.18333333730697632)>, 'blend_mode': <0>}>}>, <{'type': <'noise'>, 'id': <'effect_76250281090372'>, 'params': <{'noise': <0.050000000000000003>}>}>]>}, 'pipeline_migrated_dynamic_blur': {'name': <'Migrated dynamic blur'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_migrated_dynamic_blur'>, 'params': <{'unscaled_radius': <60>, 'brightness': <0.75>}>}>]>}}
rounded-blur-found=false
settings-version=7
sigma=16

[appfolder]
blur=true
pipeline='pipeline_default'
style-dialogs=1

[applications]
blur=false
corner-when-maximized=true
pipeline='pipeline_default'
static-blur=true

[coverflow-alt-tab]
pipeline='pipeline_default'

[dash-to-dock]
blur=true
override-background=true
pipeline='pipeline_default'
static-blur=true
style-dash-to-dock=2

[dash-to-panel]
blur-original-panel=false

[hidetopbar]
compatibility=true

[lockscreen]
blur=false
pipeline='pipeline_default'

[osd]
blur=true

[overview]
blur=true
pipeline='pipeline_default'
style-components=2

[panel]
blur=false
brightness=0.84999999999999998
corner-radius=0
customize=true
force-light-text=true
override-background=true
override-background-dynamically=false
pipeline='pipeline_default'
sigma=30
static-blur=true
style-panel=0
unblur-in-overview=true

[popup]
blur=true
override-background=true
pipeline='pipeline_default_rounded'
preserve-shell-theme=true
static-blur=false

[popups]
blur=true
blur-type='static'
customize-unselected=false
pipeline='pipeline_default'

[screenshot]
pipeline='pipeline_default'

[window-list]
blur=true
brightness=0.59999999999999998
pipeline='pipeline_migrated_dynamic_blur'

[window-switcher]
blur=true
