# dconf path: /org/gnome/shell/extensions/clipboard-indicator/
# Super+V opens the menu under its top-bar icon (never at the pointer); type
# to search, arrows to move. A click copies the entry back to the clipboard
# and moves it to the top: nothing is typed for you, paste it with Ctrl+V.
# Copied images are kept with a preview button; per-entry buttons are pin,
# edit (change the text before you paste it), delete and preview; Clear
# History at the bottom. Ctrl+F11/F12
# cycle entries without opening it. Password managers' copies never enter history.
[/]
cache-images=true
enable-keybindings=true
excluded-apps=['KeePassXC', 'org.keepassxc.KeePassXC', 'Bitwarden', '1Password', 'Proton Pass']
move-item-first=true
next-history-clear=-1
notify-on-cycle=false
open-at-cursor=false
paste-button=false
paste-on-select=false
show-clear-history-button=true
show-delete-button=true
show-edit-button=true
show-pin-button=true
show-preview-button=true
show-search-bar=true
show-tag-button=false
toggle-menu=@as []
