# dconf path: /org/gnome/shell/extensions/dash-to-dock/
[/]
animation-time=0.20000000000000001
autohide=true
background-opacity=0.29999999999999999
click-action='minimize-or-previews'
custom-theme-shrink=true
customize-alphas=true
dash-max-icon-size=38
disable-overview-on-startup=true
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
hide-delay=0.25
hide-tooltip=true
hot-keys=false
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
intellihide=true
isolate-monitors=true
isolate-workspaces=true
pressure-threshold=8.0
require-pressure-to-show=false
running-indicator-dominant-color=true
running-indicator-style='DOTS'
scroll-action='cycle-windows'
show-delay=0.10000000000000001
show-favorites=true
show-icons-emblems=true
show-icons-notifications-counter=true
show-mounts-only-mounted=true
show-mounts=true
show-running=true
show-title=false
show-trash=true
show-windows-preview=true
transparency-mode='FIXED'
