# dconf path: /org/gnome/shell/extensions/touchpad-gesture-customization/
[/]
alttab-all-workspaces=true
alttab-delay=60
horizontal-swipe-3-fingers-gesture='WINDOW_SWITCHING'
horizontal-swipe-4-fingers-gesture='WORKSPACE_SWITCHING'
pinch-3-finger-gesture='VOLUME_CONTROL'
pinch-4-finger-gesture='SHOW_DESKTOP'
vertical-swipe-3-fingers-gesture='OVERVIEW_NAVIGATION'
vertical-swipe-4-fingers-gesture='WINDOW_MANIPULATION'
