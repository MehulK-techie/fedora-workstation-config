[a11y/interface]
high-contrast=false

[a11y/keyboard]
mousekeys-enable=false

[a11y/magnifier]
cross-hairs-length=58

[a11y/mouse]
dwell-click-enabled=false

[app-folders]
folder-children=['System', 'Utilities', 'YaST', 'Pardus']

[app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[app-folders/folders/System]
apps=['org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.Logs.desktop', 'org.freedesktop.MalcontentControl.desktop', 'org.gnome.SystemMonitor.desktop']
name='X-GNOME-Shell-System.directory'
translate=true

[app-folders/folders/Utilities]
apps=['org.gnome.Decibels.desktop', 'org.gnome.Connections.desktop', 'org.gnome.Papers.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Loupe.desktop']
name='X-GNOME-Shell-Utilities.directory'
translate=true

[app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file://__USER_HOME__/.local/share/backgrounds/2026-10-06-21-52-21-spiderman-into-the-spider-verse-wallpaper.jpg'
picture-uri-dark='file://__USER_HOME__/.local/share/backgrounds/2026-10-06-21-52-21-spiderman-into-the-spider-verse-wallpaper.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[break-reminders/eyesight]
play-sound=true

[break-reminders/movement]
duration-seconds=uint32 300
interval-seconds=uint32 1800
play-sound=true

[calendar]
show-weekdate=false

[datetime]
automatic-timezone=false

[file-sharing]
require-password='never'

[input-sources]
current=uint32 0
sources=[('xkb', 'us')]

[interface]
accent-color='blue'
clock-format='12h'
clock-show-seconds=false
clock-show-weekday=true
color-scheme='prefer-dark'
enable-animations=true
enable-hot-corners=true
font-antialiasing='grayscale'
font-hinting='slight'
gtk-key-theme='Default'
gtk-theme='Adwaita-dark'
locate-pointer=true
show-battery-percentage=true
toolkit-accessibility=false

[lockdown]
disable-lock-screen=false

[notifications]
application-children=['org-gnome-software', 'org-gnome-nautilus', 'org-gnome-decibels', 'app-zen-browser-zen', 'org-gnome-ptyxis', 'com-spotify-client', 'gnome-about-panel', 'org-gnome-settings', 'org-gnome-showtime', 'com-visualstudio-code', 'org-mozilla-firefox', 'gnome-power-panel', 'com-github-hluk-copyq', 'org-gnome-extensions', 'org-gnome-baobab', 'com-rtosta-zapzap', 'com-microsoft-vscode', 'org-flameshot-flameshot', 'org-gnome-characters']
show-banners=true

[notifications/application/app-zen-browser-zen]
application-id='app.zen_browser.zen.desktop'

[notifications/application/com-github-hluk-copyq]
application-id='com.github.hluk.copyq.desktop'

[notifications/application/com-microsoft-vscode]
application-id='com.microsoft.VSCode.desktop'

[notifications/application/com-rtosta-zapzap]
application-id='com.rtosta.zapzap.desktop'

[notifications/application/com-spotify-client]
application-id='com.spotify.Client.desktop'

[notifications/application/com-visualstudio-code]
application-id='com.visualstudio.code.desktop'

[notifications/application/gnome-about-panel]
application-id='gnome-about-panel.desktop'

[notifications/application/gnome-power-panel]
application-id='gnome-power-panel.desktop'

[notifications/application/org-flameshot-flameshot]
application-id='org.flameshot.Flameshot.desktop'

[notifications/application/org-gnome-Shell-screenshot]
enable=false
show-banners=false

[notifications/application/org-gnome-baobab]
application-id='org.gnome.baobab.desktop'

[notifications/application/org-gnome-characters]
application-id='org.gnome.Characters.desktop'

[notifications/application/org-gnome-decibels]
application-id='org.gnome.Decibels.desktop'

[notifications/application/org-gnome-extensions]
application-id='org.gnome.Extensions.desktop'

[notifications/application/org-gnome-nautilus]
application-id='org.gnome.Nautilus.desktop'

[notifications/application/org-gnome-ptyxis]
application-id='org.gnome.Ptyxis.desktop'

[notifications/application/org-gnome-settings]
application-id='org.gnome.Settings.desktop'

[notifications/application/org-gnome-showtime]
application-id='org.gnome.Showtime.desktop'

[notifications/application/org-gnome-software]
application-id='org.gnome.Software.desktop'

[notifications/application/org-mozilla-firefox]
application-id='org.mozilla.firefox.desktop'

[peripherals/mouse]
accel-profile='default'
double-click=331
natural-scroll=false
speed=-0.11934156378600824

[peripherals/tablets/04f3:2af1]
area=[0.0, 0.0, 0.0, 0.0]
keep-aspect=false
mapping='absolute'
output=['AUO', '0xdb8c', '0x00000000', 'eDP-1']

[peripherals/touchpad]
click-method='fingers'
disable-while-typing=false
natural-scroll=true
send-events='enabled'
speed=0.33333333333333326
tap-to-click=true
two-finger-scrolling-enabled=true

[privacy]
report-technical-problems=true

[screen-time-limits]
daily-limit-seconds=uint32 28800

[screensaver]
color-shading-type='solid'
lock-delay=uint32 0
lock-enabled=true
picture-options='zoom'
picture-uri='file://__USER_HOME__/.local/share/backgrounds/2026-10-06-21-52-21-spiderman-into-the-spider-verse-wallpaper.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[search-providers]
disable-external=false
disabled=@as []
sort-order=['org.gnome.Settings.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Calculator.desktop']

[session]
idle-delay=uint32 300

[sound]
allow-volume-above-100-percent=true
event-sounds=true
input-feedback-sounds=true

[wm/keybindings]
close=['<Super>q', '<Alt>F4']
maximize=@as []
move-to-workspace-1=['<Super><Shift><Alt>1']
move-to-workspace-2=['<Super><Shift><Alt>2']
move-to-workspace-3=['<Super><Shift><Alt>3']
move-to-workspace-4=['<Super><Shift><Alt>4']
move-to-workspace-down=@as []
move-to-workspace-left=['<Super><Shift>Page_Up', '<Super><Shift><Alt>Left']
move-to-workspace-right=['<Super><Shift>Page_Down', '<Super><Shift><Alt>Right']
move-to-workspace-up=@as []
panel-run-dialog=['<Alt>F2', '<Super>r']
show-desktop=['<Super>d']
switch-applications=['<Super>Tab']
switch-applications-backward=['<Shift><Super>Tab']
switch-group=@as []
switch-group-backward=@as []
switch-to-workspace-1=['<Super><Alt>1']
switch-to-workspace-2=['<Super><Alt>2']
switch-to-workspace-3=['<Super><Alt>3']
switch-to-workspace-4=['<Super><Alt>4']
switch-to-workspace-down=@as []
switch-to-workspace-left=['<Super>Page_Up', '<Super><Alt>Left', '<Super><Control>Left']
switch-to-workspace-right=['<Super>Page_Down', '<Super><Alt>Right', '<Super><Control>Right']
switch-to-workspace-up=@as []
switch-windows=['<Alt>Tab']
switch-windows-backward=['<Shift><Alt>Tab']
toggle-above=['<Super><Control>t']
unmaximize=@as []

[wm/preferences]
auto-raise=false
button-layout='appmenu:minimize,maximize,close'
focus-mode='click'
num-workspaces=4
raise-on-click=true
workspace-names=['1: Dev', '2: Web', '3: Terminal', '4: Chat']
