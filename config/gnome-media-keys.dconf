[/]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']
next=['AudioNext']
play=['XF86AudioPlay']
previous=['AudioPrev']
rfkill=@as []
rfkill-bluetooth=@as []
screensaver=['<Super>l']
volume-down=['AudioLowerVolume']
volume-mute=@as []
volume-up=['AudioRaiseVolume']

[custom-keybindings/close-workspace]
binding='<Super><Shift>c'
command='/home/mehulkumar/.local/bin/close-workspace-apps'
name='Close Workspace Apps'

[custom-keybindings/custom-ocr]
binding='<Super><Shift>t'
command='/home/mehulkumar/.local/bin/ocr-snip'
name='Snip Text Extraction'

[custom-keybindings/custom0]
binding='<Super><Shift>c'
command='/home/mehulkumar/.local/bin/close-workspace-apps'
name='Close Workspace Apps'

[custom-keybindings/custom1]
binding='<Super>period'
command='gnome-characters'
name='Emoji Board'

[custom-keybindings/custom2]
binding='<Super>slash'
command='/home/mehulkumar/.local/bin/show-shortcuts'
name='Shortcut Cheat Sheet'

[custom-keybindings/custom3]
binding='<Super><Shift>c'
command='/home/mehulkumar/.local/bin/close-workspace-apps'
name='Close All Workspace Apps'

[custom-keybindings/hibernate]
binding='<Super>z'
command='systemctl hibernate'
name='Hibernate'

[custom-keybindings/shutdown]
